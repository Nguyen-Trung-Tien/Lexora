; =====================================================================
; Lexora - Inno Setup Packaging Script
; WinUI 3 Unpackaged (Self-Contained x64)
; =====================================================================

#ifndef MyAppVersion
  #define MyAppVersion "1.0.0"
#endif

#ifndef MyAppSourceDir
  #define MyAppSourceDir "..\publish\win-x64"
#endif

#ifndef MyOutputDir
  #define MyOutputDir "..\publish\installer"
#endif

#define MyAppName "Lexora"
#define MyAppPublisher "Lexora Team"
#define MyAppURL "https://github.com/Nguyen-Trung-Tien/Lexora"
#define MyAppExeName "Lexora.Presentation.exe"
#define MyAppIcon "..\src\Lexora.Presentation\Assets\AppIcon.ico"

[Setup]
; Unique App ID (DO NOT CHANGE across versions to maintain update compatibility)
AppId={{4E7A7D6C-8451-409B-89E2-7D6195E95E4A}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} v{#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
AllowNoIcons=yes
OutputDir={#MyOutputDir}
OutputBaseFilename=Lexora-Setup-v{#MyAppVersion}
SetupIconFile={#MyAppIcon}
WizardImageFile=wizard-large.bmp
WizardSmallImageFile=wizard-small.bmp
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern

; 64-bit Windows configuration
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible

; Dual-mode installation: allows per-user (no admin) or all-users (admin)
PrivilegesRequiredOverridesAllowed=commandline dialog

; Close running instance of Lexora before upgrade/uninstall
CloseApplications=yes
CloseApplicationsFilter=Lexora.Presentation.exe,Lexora.exe
RestartApplications=yes

; Add/Remove Programs metadata
UninstallDisplayIcon={app}\{#MyAppExeName}
UninstallDisplayName={#MyAppName}

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "{#MyAppSourceDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs; Excludes: "*.pdb"
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"; WorkingDir: "{app}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon; WorkingDir: "{app}"

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall; Check: not WizardSilent; WorkingDir: "{app}"
Filename: "{app}\{#MyAppExeName}"; Flags: nowait; Check: WizardSilent; WorkingDir: "{app}"

[UninstallDelete]
Type: filesandordirs; Name: "{app}\logs"
Type: files; Name: "{app}\*.log"

[Code]
// Custom routine to optionally prompt user to keep their SQLite database & user progress
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  DataDir: String;
  TempUpdateDir: String;
  PromptMsg: String;
begin
  if CurUninstallStep = usPostUninstall then
  begin
    // 1. Clean up temporary download caches generated by the auto-update engine
    TempUpdateDir := ExpandConstant('{localappdata}\Temp\Lexora');
    if DirExists(TempUpdateDir) then
    begin
      DelTree(TempUpdateDir, True, True, True);
    end;

    // 2. Prompt user about their personal learning database (Default to NO to prevent accidental loss)
    // Do not prompt modal dialog if running silent uninstallation (e.g. automated CI/CD or enterprise deployment)
    if not UninstallSilent then
    begin
      DataDir := ExpandConstant('{localappdata}\Lexora');
      if DirExists(DataDir) then
      begin
        PromptMsg := 'Do you want to delete your personal study data, vocabulary, and streak history?' + #13#10 +
                     'Bạn có muốn xóa dữ liệu học tập, từ vựng và chuỗi ngày học streak không?' + #13#10#13#10 +
                     '• Choose "No" (Recommended): Keeps your learning database safe for future reinstalls.' + #13#10 +
                     '• Chọn "No" (Khuyến nghị): Giữ lại dữ liệu học tập để dùng tiếp khi cài lại.' + #13#10#13#10 +
                     '• Choose "Yes": Permanently deletes all vocabulary and database files.' + #13#10 +
                     '• Chọn "Yes": Xóa vĩnh viễn toàn bộ cơ sở dữ liệu trên máy.';

        if MsgBox(PromptMsg, mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES then
        begin
          DelTree(DataDir, True, True, True);
        end;
      end;
    end;
  end;
end;
