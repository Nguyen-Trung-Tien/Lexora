<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Lexora.Presentation.Helpers">

    <!-- ================================================================= -->
    <!-- LEXORA MODERN FLUENT 2 DESIGN SYSTEM                              -->
    <!-- Strictly follows WinUI 3 ThemeResource guidelines & zero hardcode -->
    <!-- ================================================================= -->

    <!-- Light / Dark surface depth tokens -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Hero card border: soft accent-tinted stroke for depth vs Mica in light mode -->
            <SolidColorBrush x:Key="LexoraHeroCardBorderBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.35" />
            <!-- Crisp border & surface tokens for Light mode (eliminates washed out cards, chips & badges) -->
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#000000" Opacity="0.13" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#EEF2F6" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#475467" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#667085" />
            <!-- High-contrast semantic solid brushes for Light mode badges, chips & stats -->
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#087443" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#D92D20" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#B54708" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0066CC" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0052A3" />
            <!-- Advisor card accent border -->
            <SolidColorBrush x:Key="LexoraAdvisorBorderBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.65" />
            <!-- Flashcard crisp border for tactile elevation in light mode -->
            <SolidColorBrush x:Key="LexoraFlashcardBorderBrush" Color="#000000" Opacity="0.12" />
            <!-- Floating Toast notification tokens (100% opaque, zero bleed-through) -->
            <SolidColorBrush x:Key="LexoraToastBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LexoraToastBorderBrush" Color="#000000" Opacity="0.15" />
            <!-- Modal Dialog & Floating Overlay tokens (100% opaque, zero bleed-through) -->
            <SolidColorBrush x:Key="LexoraModalBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LexoraModalBorderBrush" Color="#000000" Opacity="0.14" />
            <!-- Modal Backdrop token for visual depth & focus -->
            <SolidColorBrush x:Key="LexoraOverlayBackdropBrush" Color="#000000" Opacity="0.35" />
            <!-- Semantic state background fills -->
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#DFF6DD" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FDE7E9" />
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#FFF4CE" />
            <!-- Formula card & syntax tokens for Grammar & Test -->
            <SolidColorBrush x:Key="LexoraFormulaCardBackgroundBrush" Color="#F0F6FF" />
            <SolidColorBrush x:Key="LexoraFormulaCardBorderBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.35" />
            <SolidColorBrush x:Key="LexoraOptionSelectedBackgroundBrush" Color="#EBF3FC" />
            <SolidColorBrush x:Key="LexoraThemeCardSelectedBorderBrush" Color="{ThemeResource SystemAccentColor}" />
            <!-- Activity Heatmap Level Brushes -->
            <SolidColorBrush x:Key="HeatmapLevel0Brush" Color="#E1DFDD" />
            <SolidColorBrush x:Key="HeatmapLevel1Brush" Color="#9BE9A8" />
            <SolidColorBrush x:Key="HeatmapLevel2Brush" Color="#40C463" />
            <SolidColorBrush x:Key="HeatmapLevel3Brush" Color="#30A14E" />
            <SolidColorBrush x:Key="HeatmapLevel4Brush" Color="#216E39" />
            <!-- CEFR Level Semantic Brushes -->
            <SolidColorBrush x:Key="LexoraCefrA1A2Brush" Color="#087443" />
            <SolidColorBrush x:Key="LexoraCefrB1B2Brush" Color="#0066CC" />
            <SolidColorBrush x:Key="LexoraCefrC1C2Brush" Color="#B54708" />
        </ResourceDictionary>
        <!-- In WinUI 3, 'Default' is the standard theme dictionary key representing the Dark theme -->
        <ResourceDictionary x:Key="Default">
            <!-- Hero card border: glowing accent stroke for depth in dark mode -->
            <SolidColorBrush x:Key="LexoraHeroCardBorderBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.42" />
            <!-- Fluent 2 surface & text depth tokens for Dark / Default mode -->
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FFFFFF" Opacity="0.09" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#FFFFFF" Opacity="0.06" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5C5C5" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFD580" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#60CDFF" />
            <!-- Advisor card accent border -->
            <SolidColorBrush x:Key="LexoraAdvisorBorderBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.65" />
            <!-- Flashcard glowing border for tactile elevation in dark mode -->
            <SolidColorBrush x:Key="LexoraFlashcardBorderBrush" Color="{ThemeResource SystemChromeDisabledLowColor}" Opacity="0.7" />
            <SolidColorBrush x:Key="LexoraThemeCardSelectedBorderBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <!-- Floating Toast notification tokens (100% opaque, zero bleed-through) -->
            <SolidColorBrush x:Key="LexoraToastBackgroundBrush" Color="#282828" />
            <SolidColorBrush x:Key="LexoraToastBorderBrush" Color="{ThemeResource SystemChromeDisabledLowColor}" Opacity="0.65" />
            <!-- Modal Dialog & Floating Overlay tokens (100% opaque, zero bleed-through) -->
            <SolidColorBrush x:Key="LexoraModalBackgroundBrush" Color="#282828" />
            <SolidColorBrush x:Key="LexoraModalBorderBrush" Color="{ThemeResource SystemChromeDisabledLowColor}" Opacity="0.65" />
            <!-- Modal Backdrop token for visual depth & focus -->
            <SolidColorBrush x:Key="LexoraOverlayBackdropBrush" Color="#000000" Opacity="0.55" />
            <!-- Semantic state background fills -->
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#123524" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#442726" />
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#433519" />
            <!-- Formula card & syntax tokens for Grammar & Test -->
            <SolidColorBrush x:Key="LexoraFormulaCardBackgroundBrush" Color="#0A192F" />
            <SolidColorBrush x:Key="LexoraFormulaCardBorderBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.45" />
            <SolidColorBrush x:Key="LexoraOptionSelectedBackgroundBrush" Color="#0C2548" />
            <!-- Activity Heatmap Level Brushes -->
            <SolidColorBrush x:Key="HeatmapLevel0Brush" Color="#2D333B" />
            <SolidColorBrush x:Key="HeatmapLevel1Brush" Color="#0E4429" />
            <SolidColorBrush x:Key="HeatmapLevel2Brush" Color="#006D32" />
            <SolidColorBrush x:Key="HeatmapLevel3Brush" Color="#26A641" />
            <SolidColorBrush x:Key="HeatmapLevel4Brush" Color="#39D353" />
            <!-- CEFR Level Semantic Brushes -->
            <SolidColorBrush x:Key="LexoraCefrA1A2Brush" Color="#0E8A4C" />
            <SolidColorBrush x:Key="LexoraCefrB1B2Brush" Color="#0078D4" />
            <SolidColorBrush x:Key="LexoraCefrC1C2Brush" Color="#D95700" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="LexoraHeroCardBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LexoraAdvisorBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LexoraFlashcardBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LexoraThemeCardSelectedBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <!-- Floating Toast notification tokens (100% opaque, zero bleed-through) -->
            <SolidColorBrush x:Key="LexoraToastBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LexoraToastBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <!-- Modal Dialog & Floating Overlay tokens (100% opaque, zero bleed-through) -->
            <SolidColorBrush x:Key="LexoraModalBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LexoraModalBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LexoraOverlayBackdropBrush" Color="{ThemeResource SystemColorWindowColor}" Opacity="0.80" />
            <!-- Semantic state background fills -->
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <!-- Formula card & syntax tokens for Grammar & Test -->
            <SolidColorBrush x:Key="LexoraFormulaCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LexoraFormulaCardBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LexoraOptionSelectedBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <!-- Activity Heatmap Level Brushes -->
            <SolidColorBrush x:Key="HeatmapLevel0Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HeatmapLevel1Brush" Color="{ThemeResource SystemColorHighlightColor}" Opacity="0.3" />
            <SolidColorBrush x:Key="HeatmapLevel2Brush" Color="{ThemeResource SystemColorHighlightColor}" Opacity="0.5" />
            <SolidColorBrush x:Key="HeatmapLevel3Brush" Color="{ThemeResource SystemColorHighlightColor}" Opacity="0.8" />
            <SolidColorBrush x:Key="HeatmapLevel4Brush" Color="{ThemeResource SystemColorHighlightColor}" />
            <!-- CEFR Level Semantic Brushes -->
            <SolidColorBrush x:Key="LexoraCefrA1A2Brush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LexoraCefrB1B2Brush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LexoraCefrC1C2Brush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Radii Tokens (Strict Fluent 2 Tokens) -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">12</CornerRadius>

    <!-- Typography Scale Tokens -->
    <Style x:Key="LexoraHeroHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LexoraSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="LexoraCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="LexoraBodyStrongStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="LexoraBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LexoraCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- Syntax & Formula Display Card -->
    <Style x:Key="LexoraFormulaCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LexoraFormulaCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LexoraFormulaCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
        <Setter Property="Padding" Value="18,14" />
    </Style>

    <!-- Circular Icon Button -->
    <Style x:Key="CircleIconButton" TargetType="Button">
        <Setter Property="helpers:CursorHelper.Cursor" Value="Hand" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- SM-2 Rating Buttons -->
    <Style x:Key="RatingAgainButton" TargetType="Button">
        <Setter Property="helpers:CursorHelper.Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="RatingHardButton" TargetType="Button">
        <Setter Property="helpers:CursorHelper.Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCautionBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="RatingGoodButton" TargetType="Button">
        <Setter Property="helpers:CursorHelper.Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="RatingEasyButton" TargetType="Button">
        <Setter Property="helpers:CursorHelper.Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Empty State Style -->
    <Style x:Key="EmptyStateCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="40,32" />
        <Setter Property="MinHeight" Value="320" />
    </Style>

    <!-- Standard Lexora Button Styles -->
    <Style x:Key="LexoraStandardButtonStyle" TargetType="Button">
        <Setter Property="helpers:CursorHelper.Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="LexoraAccentButtonStyle" TargetType="Button">
        <Setter Property="helpers:CursorHelper.Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="LexoraDangerButtonStyle" TargetType="Button">
        <Setter Property="helpers:CursorHelper.Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="LexoraSubtleButtonStyle" TargetType="Button">
        <Setter Property="helpers:CursorHelper.Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Standard Lexora Input Styles -->
    <Style TargetType="Button">
        <Setter Property="helpers:CursorHelper.Cursor" Value="Hand" />
    </Style>

    <Style TargetType="HyperlinkButton">
        <Setter Property="helpers:CursorHelper.Cursor" Value="Hand" />
    </Style>

    <Style TargetType="ToggleButton">
        <Setter Property="helpers:CursorHelper.Cursor" Value="Hand" />
    </Style>
    <Style x:Key="LexoraTextBoxStyle" TargetType="TextBox">
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="LexoraComboBoxStyle" TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="LexoraCompactButtonStyle" TargetType="Button">
        <Setter Property="helpers:CursorHelper.Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="LexoraSplitButtonStyle" TargetType="SplitButton">
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="LexoraComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="LexoraMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>

    <!-- Implicit App-Wide Dropdown & Menu Polish -->
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource LexoraComboBoxItemStyle}" />
    <Style TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource LexoraMenuFlyoutPresenterStyle}" />

    <!-- Specialized Typography Tokens -->
    <Style x:Key="LexoraDisplayTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Theme Selector Visual Mockup Brushes -->
    <SolidColorBrush x:Key="LexoraMockupLightWindowBrush" Color="#F2F3F5" />
    <SolidColorBrush x:Key="LexoraMockupLightSidebarBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="LexoraMockupLightCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LexoraMockupLightStrokeBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="LexoraMockupLightBarBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="LexoraMockupLightAccentBrush" Color="#0078D4" />

    <SolidColorBrush x:Key="LexoraMockupDarkWindowBrush" Color="#18191B" />
    <SolidColorBrush x:Key="LexoraMockupDarkSidebarBrush" Color="#222428" />
    <SolidColorBrush x:Key="LexoraMockupDarkCardBrush" Color="#2C2E33" />
    <SolidColorBrush x:Key="LexoraMockupDarkStrokeBrush" Color="#3F4248" />
    <SolidColorBrush x:Key="LexoraMockupDarkBarBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="LexoraMockupDarkAccentBrush" Color="#60CDFF" />
</ResourceDictionary>