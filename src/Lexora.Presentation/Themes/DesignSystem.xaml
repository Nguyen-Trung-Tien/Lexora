<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- LEXORA MODERN FLUENT 2 DESIGN SYSTEM                              -->
    <!-- Strictly follows WinUI 3 ThemeResource guidelines & zero hardcode -->
    <!-- ================================================================= -->

    <!-- Light / Dark surface depth tokens -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Hero card border: soft accent-tinted stroke for depth vs Mica in light mode -->
            <SolidColorBrush x:Key="LexoraHeroCardBorderBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.28" />
            <!-- Metric stat card border: crisp edge so cards pop against light Mica -->
            <SolidColorBrush x:Key="LexoraMetricCardBorderBrush" Color="{ThemeResource SystemChromeDisabledLowColor}" Opacity="0.32" />
            <!-- Advisor card accent border -->
            <SolidColorBrush x:Key="LexoraAdvisorBorderBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.65" />
            <!-- Subtle card stroke token -->
            <SolidColorBrush x:Key="LexoraCardStrokeSubtleBrush" Color="{ThemeResource SystemChromeDisabledLowColor}" Opacity="0.3" />
            <!-- Input background & border tokens for crisp contrast -->
            <SolidColorBrush x:Key="LexoraInputBackgroundBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="LexoraInputBorderBrush" Color="{ThemeResource SystemChromeDisabledLowColor}" Opacity="0.4" />
            <!-- Flashcard crisp border for tactile elevation in light mode -->
            <SolidColorBrush x:Key="LexoraFlashcardBorderBrush" Color="{ThemeResource SystemChromeDisabledLowColor}" Opacity="0.45" />
            <SolidColorBrush x:Key="LexoraElevatedBorderBrush" Color="{ThemeResource SystemChromeDisabledLowColor}" Opacity="0.38" />
            <!-- Floating Toast notification tokens (100% opaque, zero bleed-through) -->
            <SolidColorBrush x:Key="LexoraToastBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LexoraToastBorderBrush" Color="{ThemeResource SystemChromeDisabledLowColor}" Opacity="0.45" />
            <!-- Modal Dialog & Floating Overlay tokens (100% opaque, zero bleed-through) -->
            <SolidColorBrush x:Key="LexoraModalBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LexoraModalBorderBrush" Color="{ThemeResource SystemChromeDisabledLowColor}" Opacity="0.4" />
            <!-- Semantic state background fills -->
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#DFF6DD" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FDE7E9" />
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#FFF4CE" />
            <!-- Formula card & syntax tokens for Grammar & Test -->
            <SolidColorBrush x:Key="LexoraFormulaCardBackgroundBrush" Color="#F0F6FF" />
            <SolidColorBrush x:Key="LexoraFormulaCardBorderBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.35" />
            <SolidColorBrush x:Key="LexoraCodeTokenConditionBrush" Color="#006687" />
            <SolidColorBrush x:Key="LexoraCodeTokenResultBrush" Color="#107C41" />
            <SolidColorBrush x:Key="LexoraOptionSelectedBorderBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="LexoraOptionSelectedBackgroundBrush" Color="#EBF3FC" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <!-- Hero card border: glowing accent stroke for depth in dark mode -->
            <SolidColorBrush x:Key="LexoraHeroCardBorderBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.42" />
            <!-- Metric stat card border: luminous edge so cards don't dissolve in dark background -->
            <SolidColorBrush x:Key="LexoraMetricCardBorderBrush" Color="{ThemeResource SystemChromeDisabledLowColor}" Opacity="0.65" />
            <!-- Advisor card accent border -->
            <SolidColorBrush x:Key="LexoraAdvisorBorderBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.65" />
            <!-- Subtle card stroke token -->
            <SolidColorBrush x:Key="LexoraCardStrokeSubtleBrush" Color="{ThemeResource SystemChromeDisabledLowColor}" Opacity="0.5" />
            <!-- Input background & border tokens for dark mode -->
            <SolidColorBrush x:Key="LexoraInputBackgroundBrush" Color="#242424" />
            <SolidColorBrush x:Key="LexoraInputBorderBrush" Color="{ThemeResource SystemChromeDisabledLowColor}" Opacity="0.55" />
            <!-- Flashcard glowing border for tactile elevation in dark mode -->
            <SolidColorBrush x:Key="LexoraFlashcardBorderBrush" Color="{ThemeResource SystemChromeDisabledLowColor}" Opacity="0.7" />
            <SolidColorBrush x:Key="LexoraElevatedBorderBrush" Color="{ThemeResource SystemChromeDisabledLowColor}" Opacity="0.65" />
            <SolidColorBrush x:Key="LexoraThemeCardSelectedBorderBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <!-- Floating Toast notification tokens (100% opaque, zero bleed-through) -->
            <SolidColorBrush x:Key="LexoraToastBackgroundBrush" Color="#282828" />
            <SolidColorBrush x:Key="LexoraToastBorderBrush" Color="{ThemeResource SystemChromeDisabledLowColor}" Opacity="0.65" />
            <!-- Modal Dialog & Floating Overlay tokens (100% opaque, zero bleed-through) -->
            <SolidColorBrush x:Key="LexoraModalBackgroundBrush" Color="#282828" />
            <SolidColorBrush x:Key="LexoraModalBorderBrush" Color="{ThemeResource SystemChromeDisabledLowColor}" Opacity="0.65" />
            <!-- Semantic state background fills -->
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#393D1B" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#442726" />
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#433519" />
            <!-- Formula card & syntax tokens for Grammar & Test -->
            <SolidColorBrush x:Key="LexoraFormulaCardBackgroundBrush" Color="#0A192F" />
            <SolidColorBrush x:Key="LexoraFormulaCardBorderBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.45" />
            <SolidColorBrush x:Key="LexoraCodeTokenConditionBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="LexoraCodeTokenResultBrush" Color="#39D353" />
            <SolidColorBrush x:Key="LexoraOptionSelectedBorderBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="LexoraOptionSelectedBackgroundBrush" Color="#0C2548" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="LexoraHeroCardBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LexoraMetricCardBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LexoraAdvisorBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LexoraCardStrokeSubtleBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LexoraInputBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LexoraInputBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LexoraFlashcardBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LexoraElevatedBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LexoraThemeCardSelectedBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <!-- Floating Toast notification tokens (100% opaque, zero bleed-through) -->
            <SolidColorBrush x:Key="LexoraToastBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LexoraToastBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <!-- Modal Dialog & Floating Overlay tokens (100% opaque, zero bleed-through) -->
            <SolidColorBrush x:Key="LexoraModalBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LexoraModalBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <!-- Semantic state background fills -->
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <!-- Formula card & syntax tokens for Grammar & Test -->
            <SolidColorBrush x:Key="LexoraFormulaCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LexoraFormulaCardBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LexoraCodeTokenConditionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LexoraCodeTokenResultBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LexoraOptionSelectedBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LexoraOptionSelectedBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Radii Tokens -->
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">14</CornerRadius>
    <CornerRadius x:Key="RadiusCard">16</CornerRadius>
    <CornerRadius x:Key="RadiusPill">20</CornerRadius>

    <!-- Typography Scale Tokens -->
    <Style x:Key="LexoraHeroHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LexoraSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="LexoraCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="LexoraBodyStrongStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="LexoraBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LexoraCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- Card & Surface Hierarchy -->
    <Style x:Key="ModernElevatedCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="ModernHeroCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="ModernSubtleCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="ModernInteractiveCard" TargetType="Border" BasedOn="{StaticResource ModernElevatedCard}">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- Syntax & Formula Display Card -->
    <Style x:Key="LexoraFormulaCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LexoraFormulaCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LexoraFormulaCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
        <Setter Property="Padding" Value="18,14" />
    </Style>

    <!-- Exam Option Card Style -->
    <Style x:Key="LexoraOptionCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- Filter Buttons (Pills) -->
    <Style x:Key="PillFilterButton" TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="PillFilterActiveButton" TargetType="Button" BasedOn="{StaticResource PillFilterButton}">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>

    <!-- Circular Icon Button -->
    <Style x:Key="CircleIconButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- SM-2 Rating Buttons -->
    <Style x:Key="RatingAgainButton" TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style x:Key="RatingHardButton" TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCautionBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style x:Key="RatingGoodButton" TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style x:Key="RatingEasyButton" TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <!-- Badges & Chips -->
    <Style x:Key="BadgeLevelCefr" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style x:Key="BadgePartOfSpeech" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorNeutralBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style x:Key="BadgeExamTag" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- Empty State Style -->
    <Style x:Key="EmptyStateCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="40,32" />
        <Setter Property="MinHeight" Value="320" />
    </Style>

    <!-- Standard Lexora Button Styles -->
    <Style x:Key="LexoraStandardButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="LexoraAccentButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="LexoraSubtleButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Standard Lexora Input Styles -->
    <Style x:Key="LexoraTextBoxStyle" TargetType="TextBox">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="LexoraComboBoxStyle" TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Specialized Typography Tokens -->
    <Style x:Key="LexoraDisplayTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="LexoraMetricNumberStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Theme Selector Visual Mockup Brushes -->
    <SolidColorBrush x:Key="LexoraMockupLightWindowBrush" Color="#F2F3F5" />
    <SolidColorBrush x:Key="LexoraMockupLightSidebarBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="LexoraMockupLightCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LexoraMockupLightStrokeBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="LexoraMockupLightBarBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="LexoraMockupLightAccentBrush" Color="#0078D4" />

    <SolidColorBrush x:Key="LexoraMockupDarkWindowBrush" Color="#18191B" />
    <SolidColorBrush x:Key="LexoraMockupDarkSidebarBrush" Color="#222428" />
    <SolidColorBrush x:Key="LexoraMockupDarkCardBrush" Color="#2C2E33" />
    <SolidColorBrush x:Key="LexoraMockupDarkStrokeBrush" Color="#3F4248" />
    <SolidColorBrush x:Key="LexoraMockupDarkBarBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="LexoraMockupDarkAccentBrush" Color="#60CDFF" />

</ResourceDictionary>
