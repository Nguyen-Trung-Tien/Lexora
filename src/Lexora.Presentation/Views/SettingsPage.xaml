<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    KeyboardAcceleratorPlacementMode="Hidden"
    Loaded="SettingsPage_Loaded"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="28,20" HorizontalAlignment="Stretch">
            <StackPanel Spacing="22" MaxWidth="1100" HorizontalAlignment="Stretch">
                <!-- Page Title -->
                <TextBlock Text="{x:Bind Loc.GetString('Settings_Title')}" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" FontSize="26" />

                <!-- Top Profile & System Status Hero Card -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource LexoraHeroCardBorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="24,20">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                        <Border Width="52" Height="52" CornerRadius="26"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="LX" FontSize="20" FontWeight="Bold"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Lexora Scholar" FontWeight="Bold" FontSize="18" />
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE753;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        <TextBlock Text="Offline-First Engine" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.DatabasePath, Mode=OneWay}"
                                       FontFamily="Consolas, Cascadia Code, Segoe UI Variable"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="14,8">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.TotalWordsCount, Mode=OneWay}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Settings_DbWordsUnit')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="14,8">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.TotalGrammarCount, Mode=OneWay}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Settings_DbGrammarUnit')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Contextual Help Button -->
                            <Button x:Name="SettingsHelpButton" Click="SettingsHelpButton_Click" CornerRadius="12" Padding="10,8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    ToolTipService.ToolTip="{x:Bind Loc.GetString('Settings_Help_Title')}">
                                <FontIcon Glyph="&#xE897;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <TeachingTip x:Name="SettingsHelpTeachingTip"
                             Target="{x:Bind SettingsHelpButton}"
                             Title="{x:Bind Loc.GetString('Settings_Help_Title')}"
                             Subtitle="{x:Bind Loc.GetString('Settings_Help_Subtitle')}"
                             IsOpen="False"
                             IsLightDismissEnabled="True"
                             PreferredPlacement="BottomRight">
                    <TeachingTip.Content>
                        <StackPanel Spacing="10" MaxWidth="320">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_Help_Content')}" TextWrapping="Wrap" FontSize="13" />
                            <Button Style="{ThemeResource AccentButtonStyle}"
                                    Click="OpenFullGuide_Click"
                                    Tag="BackupAndSettings"
                                    CornerRadius="8" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_OpenFullGuide')}" FontWeight="SemiBold" FontSize="12" />
                                    <FontIcon Glyph="&#xE76C;" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </TeachingTip.Content>
                </TeachingTip>

                <!-- Appearance Theme Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="24,20">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE790;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_Theme')}" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_ThemeSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!-- Visual Theme Selector Cards -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16" Margin="0,4,0,0">
                            <!-- 1. System Theme Card -->
                            <Button x:Name="ThemeSystemButton"
                                    Click="ThemeSystemButton_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0"
                                    CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid Padding="14">
                                    <StackPanel Spacing="10">
                                        <!-- Mini Window Mockup System (Dual split Light/Dark) -->
                                        <Border Height="95" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Grid ColumnDefinitions="*,*">
                                                <!-- Left half: Light -->
                                                <Grid Background="{StaticResource LexoraMockupLightWindowBrush}">
                                                    <Grid ColumnDefinitions="24,*">
                                                        <Border Background="{StaticResource LexoraMockupLightSidebarBrush}">
                                                            <StackPanel Spacing="4" Margin="4,8,4,4">
                                                                <Border Height="3" CornerRadius="1.5" Background="{StaticResource LexoraMockupLightAccentBrush}" />
                                                                <Border Height="3" CornerRadius="1.5" Background="{StaticResource LexoraMockupLightBarBrush}" Opacity="0.6" />
                                                                <Border Height="3" CornerRadius="1.5" Background="{StaticResource LexoraMockupLightBarBrush}" Opacity="0.4" />
                                                            </StackPanel>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="6,8,4,4" Spacing="5">
                                                            <Border Height="4" Width="28" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource LexoraMockupLightBarBrush}" />
                                                            <Border Background="{StaticResource LexoraMockupLightCardBrush}" BorderThickness="1" BorderBrush="{StaticResource LexoraMockupLightStrokeBrush}" CornerRadius="4" Padding="4">
                                                                <StackPanel Spacing="3">
                                                                    <Border Height="3" Width="36" HorizontalAlignment="Left" CornerRadius="1.5" Background="{StaticResource LexoraMockupLightAccentBrush}" />
                                                                    <Border Height="2" Width="24" HorizontalAlignment="Left" CornerRadius="1" Background="{StaticResource LexoraMockupLightBarBrush}" Opacity="0.5" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                                <!-- Right half: Dark -->
                                                <Grid Grid.Column="1" Background="{StaticResource LexoraMockupDarkWindowBrush}">
                                                    <Grid ColumnDefinitions="24,*">
                                                        <Border Background="{StaticResource LexoraMockupDarkSidebarBrush}">
                                                            <StackPanel Spacing="4" Margin="4,8,4,4">
                                                                <Border Height="3" CornerRadius="1.5" Background="{StaticResource LexoraMockupDarkAccentBrush}" />
                                                                <Border Height="3" CornerRadius="1.5" Background="{StaticResource LexoraMockupDarkBarBrush}" Opacity="0.6" />
                                                                <Border Height="3" CornerRadius="1.5" Background="{StaticResource LexoraMockupDarkBarBrush}" Opacity="0.4" />
                                                            </StackPanel>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="6,8,4,4" Spacing="5">
                                                            <Border Height="4" Width="28" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource LexoraMockupDarkBarBrush}" />
                                                            <Border Background="{StaticResource LexoraMockupDarkCardBrush}" BorderThickness="1" BorderBrush="{StaticResource LexoraMockupDarkStrokeBrush}" CornerRadius="4" Padding="4">
                                                                <StackPanel Spacing="3">
                                                                    <Border Height="3" Width="36" HorizontalAlignment="Left" CornerRadius="1.5" Background="{StaticResource LexoraMockupDarkAccentBrush}" />
                                                                    <Border Height="2" Width="24" HorizontalAlignment="Left" CornerRadius="1" Background="{StaticResource LexoraMockupDarkBarBrush}" Opacity="0.5" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Label & Selection Badge -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_Theme_System')}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_Theme_SystemDesc')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border x:Name="ThemeSystemCheck" Grid.Column="1" Width="22" Height="22" CornerRadius="11" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Visibility="Collapsed">
                                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 2. Light Theme Card -->
                            <Button x:Name="ThemeLightButton"
                                    Grid.Column="1"
                                    Click="ThemeLightButton_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0"
                                    CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid Padding="14">
                                    <StackPanel Spacing="10">
                                        <!-- Mini Window Mockup Light -->
                                        <Border Height="95" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource LexoraMockupLightStrokeBrush}" Background="{StaticResource LexoraMockupLightWindowBrush}">
                                            <Grid ColumnDefinitions="32,*">
                                                <Border Background="{StaticResource LexoraMockupLightSidebarBrush}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource LexoraMockupLightStrokeBrush}">
                                                    <StackPanel Spacing="5" Margin="6,10,6,6">
                                                        <Border Height="4" CornerRadius="2" Background="{StaticResource LexoraMockupLightAccentBrush}" />
                                                        <Border Height="4" CornerRadius="2" Background="{StaticResource LexoraMockupLightBarBrush}" Opacity="0.6" />
                                                        <Border Height="4" CornerRadius="2" Background="{StaticResource LexoraMockupLightBarBrush}" Opacity="0.4" />
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,8,8,6" Spacing="6">
                                                    <Border Height="5" Width="55" HorizontalAlignment="Left" CornerRadius="2.5" Background="{StaticResource LexoraMockupLightBarBrush}" />
                                                    <Border Background="{StaticResource LexoraMockupLightCardBrush}" BorderThickness="1" BorderBrush="{StaticResource LexoraMockupLightStrokeBrush}" CornerRadius="6" Padding="6">
                                                        <StackPanel Spacing="4">
                                                            <Border Height="4" Width="70" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource LexoraMockupLightAccentBrush}" />
                                                            <Border Height="3" Width="48" HorizontalAlignment="Left" CornerRadius="1.5" Background="{StaticResource LexoraMockupLightBarBrush}" Opacity="0.5" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Label & Selection Badge -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_Theme_Light')}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_Theme_LightDesc')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border x:Name="ThemeLightCheck" Grid.Column="1" Width="22" Height="22" CornerRadius="11" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Visibility="Collapsed">
                                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 3. Dark Theme Card -->
                            <Button x:Name="ThemeDarkButton"
                                    Grid.Column="2"
                                    Click="ThemeDarkButton_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0"
                                    CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid Padding="14">
                                    <StackPanel Spacing="10">
                                        <!-- Mini Window Mockup Dark -->
                                        <Border Height="95" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource LexoraMockupDarkStrokeBrush}" Background="{StaticResource LexoraMockupDarkWindowBrush}">
                                            <Grid ColumnDefinitions="32,*">
                                                <Border Background="{StaticResource LexoraMockupDarkSidebarBrush}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource LexoraMockupDarkStrokeBrush}">
                                                    <StackPanel Spacing="5" Margin="6,10,6,6">
                                                        <Border Height="4" CornerRadius="2" Background="{StaticResource LexoraMockupDarkAccentBrush}" />
                                                        <Border Height="4" CornerRadius="2" Background="{StaticResource LexoraMockupDarkBarBrush}" Opacity="0.6" />
                                                        <Border Height="4" CornerRadius="2" Background="{StaticResource LexoraMockupDarkBarBrush}" Opacity="0.4" />
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,8,8,6" Spacing="6">
                                                    <Border Height="5" Width="55" HorizontalAlignment="Left" CornerRadius="2.5" Background="{StaticResource LexoraMockupDarkBarBrush}" />
                                                    <Border Background="{StaticResource LexoraMockupDarkCardBrush}" BorderThickness="1" BorderBrush="{StaticResource LexoraMockupDarkStrokeBrush}" CornerRadius="6" Padding="6">
                                                        <StackPanel Spacing="4">
                                                            <Border Height="4" Width="70" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource LexoraMockupDarkAccentBrush}" />
                                                            <Border Height="3" Width="48" HorizontalAlignment="Left" CornerRadius="1.5" Background="{StaticResource LexoraMockupDarkBarBrush}" Opacity="0.5" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Label & Selection Badge -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_Theme_Dark')}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_Theme_DarkDesc')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border x:Name="ThemeDarkCheck" Grid.Column="1" Width="22" Height="22" CornerRadius="11" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Visibility="Collapsed">
                                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>
                </StackPanel>
            </Border>

            <!-- Language Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="24,20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF2B7;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_Language')}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_LanguageSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="LangViButton" Click="LangViButton_Click" CornerRadius="8" Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="TextLangVi" Text="🇻🇳 Tiếng Việt" VerticalAlignment="Center" />
                                    <FontIcon x:Name="CheckLangVi" Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LangEnButton" Click="LangEnButton_Click" CornerRadius="8" Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="TextLangEn" Text="🇬🇧 English" VerticalAlignment="Center" />
                                    <FontIcon x:Name="CheckLangEn" Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Study Experience & Notifications Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="24,20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE767;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_StudyExperience')}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_StudyExperienceSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- Setting Row 1: Auto Play Audio -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_AutoPlayAudio')}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_AutoPlayAudioSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      IsOn="{x:Bind ViewModel.AutoPlayAudio, Mode=OneWay}"
                                      Toggled="AutoPlayToggle_Toggled"
                                      OffContent="{x:Bind Loc.GetString('Settings_Toggle_Off')}"
                                      OnContent="{x:Bind Loc.GetString('Settings_Toggle_On')}"
                                      MinWidth="76"
                                      HorizontalAlignment="Right" />
                    </Grid>

                    <MenuFlyoutSeparator />

                    <!-- Setting Row 2: Due Reminder -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_DueReminder')}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_DueReminderSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      IsOn="{x:Bind ViewModel.EnableReviewReminder, Mode=OneWay}"
                                      Toggled="ReminderToggle_Toggled"
                                      OffContent="{x:Bind Loc.GetString('Settings_Toggle_Off')}"
                                      OnContent="{x:Bind Loc.GetString('Settings_Toggle_On')}"
                                      MinWidth="76"
                                      HorizontalAlignment="Right" />
                    </Grid>

                    <MenuFlyoutSeparator />

                    <!-- Setting Row 3: Pronunciation Preference (UK vs US) -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_PronunciationPreference')}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_PronunciationSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button x:Name="AccentUkButton" Click="AccentUkButton_Click" CornerRadius="8" Padding="14,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="TextAccentUk" Text="{x:Bind Loc.GetString('Settings_Accent_UK')}" VerticalAlignment="Center" FontSize="13" />
                                        <FontIcon x:Name="CheckAccentUk" Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AccentUsButton" Click="AccentUsButton_Click" CornerRadius="8" Padding="14,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="TextAccentUs" Text="{x:Bind Loc.GetString('Settings_Accent_US')}" VerticalAlignment="Center" FontSize="13" />
                                        <FontIcon x:Name="CheckAccentUs" Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Voice Engine Diagnostic & Test Panel -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,2">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Settings_VoiceDiagnostic_Title')}" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="OpenSpeechSettings_Click" Padding="10,4" CornerRadius="6" Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Loc.GetString('Settings_Voice_InstallHelp')}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <!-- UK Voice Info -->
                                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                        <TextBlock Text="🇬🇧 British English (UK)" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.UkVoiceStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <Button Grid.Row="2" Click="TestVoiceUk_Click" HorizontalAlignment="Left" Padding="10,4" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_TestVoice_UK')}" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- US Voice Info -->
                                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                        <TextBlock Text="🇺🇸 American English (US)" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.UsVoiceStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <Button Grid.Row="2" Click="TestVoiceUs_Click" HorizontalAlignment="Left" Padding="10,4" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_TestVoice_US')}" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <MenuFlyoutSeparator />

                    <!-- Setting Row 4: Speech Playback Speed -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_SpeechRate')}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_SpeechRateSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="SpeechRateCombo" Width="160" VerticalAlignment="Center" HorizontalAlignment="Right" SelectionChanged="SpeechRateCombo_SelectionChanged" CornerRadius="8">
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Settings_Speed_Slow')}" Tag="0.75" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Settings_Speed_Normal')}" Tag="1.0" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Settings_Speed_Fast')}" Tag="1.25" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Settings_Speed_VeryFast')}" Tag="1.5" />
                        </ComboBox>
                    </Grid>

                    <MenuFlyoutSeparator />

                    <!-- Setting Row 4: Typing Practice Drill -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_TypingPractice')}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_TypingPracticeSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      IsOn="{x:Bind ViewModel.EnableTypingPractice, Mode=OneWay}"
                                      Toggled="TypingPracticeToggle_Toggled"
                                      OffContent="{x:Bind Loc.GetString('Settings_Toggle_Off')}"
                                      OnContent="{x:Bind Loc.GetString('Settings_Toggle_On')}"
                                      MinWidth="76"
                                      HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Spaced Repetition Algorithm & Target Retention Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="24,20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_Algorithm')}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_AlgorithmSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- Algorithm Selection Grid (SM-2 vs FSRS v5) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <!-- Card 1: SM-2 -->
                        <Button x:Name="AlgorithmSm2Button"
                                Click="AlgorithmSm2Button_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="16,14"
                                CornerRadius="10"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Settings_Algorithm_SM2')}" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <Border x:Name="AlgorithmSm2Check" Grid.Column="1" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Visibility="Visible">
                                    <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                           Text="{x:Bind Loc.GetString('Settings_Algorithm_SM2Desc')}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <!-- Card 2: FSRS v5 -->
                        <Button x:Name="AlgorithmFsrsButton"
                                Grid.Column="1"
                                Click="AlgorithmFsrsButton_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="16,14"
                                CornerRadius="10"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE958;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Settings_Algorithm_FSRS')}" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <Border x:Name="AlgorithmFsrsCheck" Grid.Column="1" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Visibility="Collapsed">
                                    <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                           Text="{x:Bind Loc.GetString('Settings_Algorithm_FSRSDesc')}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                        </Button>
                    </Grid>

                    <MenuFlyoutSeparator Margin="0,2,0,2" />

                    <!-- Target Retention Selector Row -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_TargetRetention')}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_TargetRetentionSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="TargetRetentionCombo" Grid.Column="1"
                                  SelectionChanged="TargetRetentionCombo_SelectionChanged"
                                  MinWidth="280" CornerRadius="8">
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Settings_Retention_85')}" Tag="0.85" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Settings_Retention_90')}" Tag="0.90" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Settings_Retention_95')}" Tag="0.95" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Database & Backup Management Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="24,20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_DatabaseManagement')}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_DatabaseManagementSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{x:Bind Loc.GetString('Settings_RefreshStats')}" Click="RefreshStatsButton_Click" CornerRadius="8" />
                    </Grid>

                    <!-- Database Stats Grid -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="18,14">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="140,*,Auto" RowSpacing="10" ColumnSpacing="12">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_DbLocation')}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DatabasePath, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                            <Button x:Name="BtnCopyDbPath" Grid.Column="2" Click="CopyDbPath_Click" ToolTipService.ToolTip="{x:Bind Loc.GetString('Action_Copy')}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon x:Name="IconCopyDbPath" Glyph="&#xE8C8;" FontSize="12" />
                                    <TextBlock x:Name="TextCopyDbPath" Text="{x:Bind Loc.GetString('Action_Copy')}" FontSize="11" />
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Row="1" Text="{x:Bind Loc.GetString('Settings_DbSize')}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DatabaseSizeFormatted, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Text="{x:Bind Loc.GetString('Settings_DbTotalData')}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.TotalWordsCount, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Loc.GetString('Settings_DbWordsUnit')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.TotalGrammarCount, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        <TextBlock Text="{x:Bind Loc.GetString('Settings_DbGrammarUnit')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Backup Actions -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Style="{ThemeResource AccentButtonStyle}" Click="BackupButton_Click" CornerRadius="8" Padding="18,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEA35;" FontSize="13" />
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_CreateBackupBtn')}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Click="RestoreButton_Click" CornerRadius="8" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE777;" FontSize="13" />
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_RestoreBackupBtn')}" />
                            </StackPanel>
                        </Button>
                        <Button Click="OpenDataHealthCenter_Click" CornerRadius="8" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE958;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Loc.GetString('DataHealth_Title')}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.BackupStatusMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Voice & Pronunciation Test Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="24,20">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8D2;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_TtsTitle')}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_TtsSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <TextBox PlaceholderText="{x:Bind Loc.GetString('Settings_TtsPlaceholder')}" Text="{x:Bind ViewModel.TestVoiceTerm, Mode=TwoWay}" VerticalAlignment="Center" CornerRadius="8" Padding="12,8" />
                        <Button Grid.Column="1" Click="TestUkVoice_Click" CornerRadius="8" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_TestUkVoice')}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Click="TestUsVoice_Click" CornerRadius="8" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_TestUsVoice')}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Keyboard Shortcuts Reference Guide -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="24,20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE765;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_ShortcutsTitle')}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_ShortcutsSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="16" RowSpacing="12">
                        <!-- Ctrl + 1-5 -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Ctrl + 1 / 2 / 3 / 4 / 5" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_Nav')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <!-- Ctrl + F -->
                        <Border Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Ctrl + F" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_Search')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <!-- Ctrl + N -->
                        <Border Grid.Row="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Ctrl + N" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                        </Border>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_AddWord')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <!-- Ctrl + E -->
                        <Border Grid.Row="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Ctrl + E" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                        </Border>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_EditWord')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <!-- Delete -->
                        <Border Grid.Row="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Delete" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                        </Border>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_DeleteWord')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <!-- Space -->
                        <Border Grid.Row="5" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Space" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                        </Border>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_Flip')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <!-- 1, 2, 3, 4 -->
                        <Border Grid.Row="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="1, 2, 3, 4" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                        </Border>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_Rate')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <!-- U / S -->
                        <Border Grid.Row="7" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="U / S" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                        </Border>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_Audio')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <!-- Enter -->
                        <Border Grid.Row="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="Enter" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                        </Border>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_Enter')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Software Updates Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="24,20">
                <StackPanel Spacing="16">
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_UpdateTitle')}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_UpdateSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <!-- Check for Updates Button -->
                        <Button Grid.Column="2"
                                Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                CornerRadius="8" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingUpdate, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsCheckingUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                              Width="16" Height="16" />
                                <FontIcon Glyph="&#xE777;" FontSize="12"
                                          Visibility="{x:Bind ViewModel.IsCheckingUpdate, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_CheckForUpdates')}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Auto-check for updates Toggle Row -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="4,0">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_AutoCheckUpdates')}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_AutoCheckUpdatesDesc')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.AutoCheckUpdates, Mode=TwoWay}"
                                      OffContent="{x:Bind Loc.GetString('Settings_Toggle_Off')}"
                                      OnContent="{x:Bind Loc.GetString('Settings_Toggle_On')}"
                                      VerticalAlignment="Center" Margin="0" />
                    </Grid>

                    <!-- Version Status Bar -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_CurrentVersion')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentAppVersion, Mode=OneWay}" FontWeight="Bold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.UpdateStatusMessage, Mode=OneWay}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!-- Update Available Details Section -->
                    <Border Visibility="{x:Bind ViewModel.UpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{ThemeResource SystemFillColorSuccessBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{x:Bind ViewModel.AvailableUpdate.NewVersion, Mode=OneWay}"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                       FontWeight="Bold" FontSize="11" />
                                        </Border>
                                        <TextBlock Text="{x:Bind ViewModel.AvailableUpdate.ReleaseTitle, Mode=OneWay}"
                                                   FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <!-- Download Button (Visible when not downloaded and not ready to install) -->
                                    <Button Command="{x:Bind ViewModel.DownloadUpdateCommand}"
                                            Visibility="{x:Bind ViewModel.UpdateReadyToInstall, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            CornerRadius="8" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE896;" FontSize="12" />
                                            <TextBlock Text="{x:Bind Loc.GetString('Settings_DownloadUpdate')}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Install & Restart Button (Visible when download completed) -->
                                    <Button Command="{x:Bind ViewModel.InstallUpdateCommand}"
                                            Visibility="{x:Bind ViewModel.UpdateReadyToInstall, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            CornerRadius="8" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                                            <TextBlock Text="{x:Bind Loc.GetString('Settings_InstallUpdate')}" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Download Progress Bar (Visible while downloading) -->
                            <StackPanel Visibility="{x:Bind ViewModel.IsDownloadingUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{x:Bind Loc.GetString('Settings_DownloadingUpdate')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DownloadProgressText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Grid>
                                <ProgressBar Value="{x:Bind ViewModel.DownloadProgressPercentage, Mode=OneWay}" Maximum="100" Height="6" CornerRadius="3" />
                            </StackPanel>

                            <!-- Release Notes Preview -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12,10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Loc.GetString('Settings_ReleaseNotes')}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.AvailableUpdate.ReleaseNotes, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" MaxHeight="120" />
                                </StackPanel>
                            </Border>

                            <!-- Safe Snapshot Notice -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_AutoBackupNote')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- About Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="24,20">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Border Width="56" Height="56" CornerRadius="14" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/brand/lexora-app-icon-1024.png" Width="56" Height="56" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Lexora" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CurrentAppVersion, Mode=OneWay}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind Loc.GetString('Settings_AboutSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Loc.GetString('Settings_AboutTech')}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</ScrollViewer>
</Page>
