<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.RoadmapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dto="using:Lexora.Application.DTOs"
    xmlns:enums="using:Lexora.Domain.Enums"
    Loaded="Page_Loaded"
    SizeChanged="Page_SizeChanged"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <ScrollViewer
            x:Name="PageScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="1240"
                Margin="32,24,32,48"
                HorizontalAlignment="Stretch"
                Spacing="24">

                <!-- 1. Header & Pathway Controls -->
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="{x:Bind Loc.GetString('Roadmap_Title')}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind Loc.GetString('Roadmap_Subtitle')}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

                        <!-- Roadmap Switcher Dropdown (when roadmaps exist) -->
                        <DropDownButton
                            x:Name="RoadmapSwitcherButton"
                            Style="{ThemeResource DefaultButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Roadmap_ManageRoadmaps')}"
                            Visibility="{x:Bind ViewModel.HasActiveRoadmap, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE81C;" />
                                <TextBlock
                                    MaxWidth="200"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{x:Bind ViewModel.ActiveRoadmap.Title, Mode=OneWay, FallbackValue=''}" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <Flyout x:Name="RoadmapsFlyout" Placement="BottomEdgeAlignedRight">
                                    <StackPanel MinWidth="280" MaxWidth="360" Spacing="10">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Loc.GetString('Roadmap_ManageRoadmaps')}" />

                                        <ListView
                                            ItemsSource="{x:Bind ViewModel.AllRoadmaps, Mode=OneWay}"
                                            SelectionMode="None"
                                            MaxHeight="260">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="dto:StudyRoadmapDto">
                                                    <Button
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="8,6"
                                                        Margin="0,2"
                                                        Click="SwitchRoadmapItem_Click"
                                                        Tag="{x:Bind}"
                                                        Style="{ThemeResource SubtleButtonStyle}">
                                                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="2">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Text="{x:Bind Title}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind TargetScoreDisplay}" />
                                                            </StackPanel>
                                                            <Border
                                                                Grid.Column="1"
                                                                Padding="6,2"
                                                                CornerRadius="4"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                    Text="✓" />
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <MenuFlyoutSeparator />

                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Click="OpenCreateRoadmapDialog_Click"
                                            Style="{ThemeResource DefaultButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE710;" />
                                                <TextBlock Text="{x:Bind Loc.GetString('Roadmap_CreateGoal')}" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Click="DeleteCurrentRoadmap_Click"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Style="{ThemeResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE74D;" />
                                                <TextBlock Text="{x:Bind Loc.GetString('Roadmap_DeleteRoadmap')}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <Button
                            Command="{x:Bind ViewModel.SyncProgressCommand}"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Roadmap_SyncProgress')}"
                            Style="{ThemeResource DefaultButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" />
                                <TextBlock Text="{x:Bind Loc.GetString('Roadmap_SyncProgress')}" />
                            </StackPanel>
                        </Button>

                        <Button
                            Click="OpenCreateRoadmapDialog_Click"
                            Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" />
                                <TextBlock Text="{x:Bind Loc.GetString('Roadmap_CreateGoal')}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Active Roadmap Overview Cards -->
                <Grid
                    x:Name="OverviewCardsGrid"
                    HorizontalAlignment="Stretch"
                    ColumnSpacing="16"
                    RowSpacing="16"
                    Visibility="{x:Bind ViewModel.HasActiveRoadmap, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Card 1: Overall Progress -->
                    <Border
                        x:Name="OverviewCard1"
                        Grid.Column="0"
                        Padding="18,16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Loc.GetString('Roadmap_OverallProgress')}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ActiveRoadmap.OverallProgressDisplay, Mode=OneWay, FallbackValue='0%'}" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE9D2;" />
                            </StackPanel>
                            <ProgressBar
                                Maximum="100"
                                Value="{x:Bind ViewModel.ActiveRoadmap.OverallProgress, Mode=OneWay, FallbackValue=0}" />
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Target & Scores -->
                    <Border
                        x:Name="OverviewCard2"
                        Grid.Column="1"
                        Padding="18,16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Loc.GetString('Roadmap_ExamTarget')}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ActiveRoadmap.Target, Mode=OneWay, FallbackValue=''}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ActiveRoadmap.TargetScoreDisplay, Mode=OneWay, FallbackValue=''}" />
                            </StackPanel>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ActiveRoadmap.StartingScoreDisplay, Mode=OneWay, FallbackValue=''}" />
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Days Remaining -->
                    <Border
                        x:Name="OverviewCard3"
                        Grid.Column="2"
                        Padding="18,16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Loc.GetString('Roadmap_DaysRemaining')}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ActiveRoadmap.DaysRemaining, Mode=OneWay, FallbackValue=0}" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Glyph="&#xEC92;" />
                            </StackPanel>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ActiveRoadmap.TargetDateDisplay, Mode=OneWay, FallbackValue=''}" />
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Mastered Nodes / SM-2 Engine -->
                    <Border
                        x:Name="OverviewCard4"
                        Grid.Column="3"
                        Padding="18,16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Loc.GetString('Roadmap_MasteredNodes')}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ActiveRoadmap.MasteredNodes, Mode=OneWay, FallbackValue=0}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.ActiveRoadmap.TotalNodesDisplay, Mode=OneWay, FallbackValue='/ 0'}" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Glyph="&#xE73E;" />
                            </StackPanel>
                            <TextBlock
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Loc.GetString('Roadmap_AdaptiveTip')}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2.5 Hero Banner: Up Next Lesson -->
                <Border
                    Padding="20,16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{x:Bind ViewModel.HasNextActiveNode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Glyph="&#xE768;" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="{x:Bind Loc.GetString('Roadmap_UpNextTitle')}" />
                            <TextBlock
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.NextActiveNode.Title, Mode=OneWay, FallbackValue=''}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.NextActiveNode.ReferenceDisplay, Mode=OneWay, FallbackValue=''}" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.StartLearningNodeCommand}"
                            CommandParameter="{x:Bind ViewModel.NextActiveNode, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" />
                                <TextBlock Text="{x:Bind Loc.GetString('Roadmap_ActionLearn')}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 3. View Mode Selector Bar (Path Map vs Timeline) -->
                <Grid
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.HasActiveRoadmap, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- Mode Toggle Segmented Pills -->
                    <Border
                        HorizontalAlignment="Left"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="3">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button
                                x:Name="MapViewTabButton"
                                Click="SwitchToMapView_Click"
                                Padding="12,6"
                                CornerRadius="6"
                                Style="{ThemeResource SubtleButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE81C;" FontSize="14" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Roadmap_ViewMap')}" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="TimelineViewTabButton"
                                Click="SwitchToTimelineView_Click"
                                Padding="12,6"
                                CornerRadius="6"
                                Style="{ThemeResource SubtleButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8D2;" FontSize="14" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Roadmap_ViewTimeline')}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 4. Empty State with Standard Goal Presets (When no roadmap created yet) -->
                <Border
                    Padding="32"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{x:Bind ViewModel.HasActiveRoadmap, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Center" Spacing="24">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontSize="44"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE81C;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{x:Bind Loc.GetString('Roadmap_EmptyState')}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind Loc.GetString('Roadmap_EmptyStateDesc')}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Standard Preset Cards Grid -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Preset 1: TOEIC 750+ -->
                            <Border
                                Grid.Column="0"
                                Padding="18"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border
                                            Width="32"
                                            Height="32"
                                            CornerRadius="16"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Glyph="&#xE9D2;" />
                                        </Border>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Loc.GetString('Roadmap_QuickStartToeicTitle')}" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Loc.GetString('Roadmap_QuickStartToeicDesc')}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.QuickCreateRoadmapCommand}"
                                        CommandParameter="TOEIC_750"
                                        Style="{ThemeResource AccentButtonStyle}">
                                        <TextBlock Text="{x:Bind Loc.GetString('Roadmap_ActionLearn')}" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Preset 2: IELTS 6.5+ -->
                            <Border
                                Grid.Column="1"
                                Padding="18"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border
                                            Width="32"
                                            Height="32"
                                            CornerRadius="16"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Glyph="&#xE768;" />
                                        </Border>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Loc.GetString('Roadmap_QuickStartIeltsTitle')}" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Loc.GetString('Roadmap_QuickStartIeltsDesc')}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.QuickCreateRoadmapCommand}"
                                        CommandParameter="IELTS_65"
                                        Style="{ThemeResource AccentButtonStyle}">
                                        <TextBlock Text="{x:Bind Loc.GetString('Roadmap_ActionLearn')}" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Preset 3: VSTEP B2 -->
                            <Border
                                Grid.Column="2"
                                Padding="18"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border
                                            Width="32"
                                            Height="32"
                                            CornerRadius="16"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Glyph="&#xE73E;" />
                                        </Border>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Loc.GetString('Roadmap_QuickStartVstepTitle')}" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Loc.GetString('Roadmap_QuickStartVstepDesc')}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.QuickCreateRoadmapCommand}"
                                        CommandParameter="VSTEP_B2"
                                        Style="{ThemeResource AccentButtonStyle}">
                                        <TextBlock Text="{x:Bind Loc.GetString('Roadmap_ActionLearn')}" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Button
                            HorizontalAlignment="Center"
                            Click="OpenCreateRoadmapDialog_Click"
                            Style="{ThemeResource DefaultButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" />
                                <TextBlock Text="{x:Bind Loc.GetString('Roadmap_CreateGoal')}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 5. Main Roadmap Workspace (Interactive Visual Canvas / Timeline + Inspector) -->
                <Grid
                    x:Name="RoadmapWorkspaceGrid"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.HasActiveRoadmap, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Workspace View Host (Contains Map Canvas or Timeline View) -->
                    <Grid Grid.Column="0" x:Name="CanvasHostBorder">
                        <!-- A. Map View Host -->
                        <Border
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{x:Bind ViewModel.IsMapView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <ScrollViewer
                                    x:Name="CanvasScrollViewer"
                                    Height="720"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Auto">
                                    <Canvas
                                        x:Name="RoadmapCanvas"
                                        MinWidth="760"
                                        Height="1600"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">
                                        <!-- Dynamic Bézier Curves generated in code-behind -->
                                        <Path
                                            x:Name="TrackSplinePath"
                                            Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                            StrokeDashArray="3,3"
                                            StrokeThickness="3" />
                                        <Path
                                            x:Name="ActiveSplinePath"
                                            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                            StrokeThickness="4" />
                                    </Canvas>
                                </ScrollViewer>

                                <!-- Floating Map Navigation & Zoom Toolbar -->
                                <Border
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,12,12,0"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button
                                            Click="CenterOnActiveNode_Click"
                                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Roadmap_CenterOnActive')}"
                                            Padding="8,6"
                                            Style="{ThemeResource SubtleButtonStyle}">
                                            <FontIcon Glyph="&#xE7C4;" FontSize="14" />
                                        </Button>
                                        <Button
                                            Command="{x:Bind ViewModel.ZoomInCommand}"
                                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Roadmap_ZoomIn')}"
                                            Padding="8,6"
                                            Style="{ThemeResource SubtleButtonStyle}">
                                            <FontIcon Glyph="&#xE71E;" FontSize="14" />
                                        </Button>
                                        <Button
                                            Command="{x:Bind ViewModel.ZoomOutCommand}"
                                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Roadmap_ZoomOut')}"
                                            Padding="8,6"
                                            Style="{ThemeResource SubtleButtonStyle}">
                                            <FontIcon Glyph="&#xE71F;" FontSize="14" />
                                        </Button>
                                        <Button
                                            Command="{x:Bind ViewModel.ResetZoomCommand}"
                                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Roadmap_ZoomReset')}"
                                            Padding="8,6"
                                            Style="{ThemeResource SubtleButtonStyle}">
                                            <FontIcon Glyph="&#xE81D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- B. Milestone Timeline View Host -->
                        <Border
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{x:Bind ViewModel.IsTimelineView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ScrollViewer Height="720" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Milestones, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="dto:MilestoneDto">
                                            <Border
                                                Margin="0,0,0,16"
                                                Padding="18"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                                <StackPanel Spacing="14">
                                                    <!-- Milestone Header -->
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border
                                                            Width="36"
                                                            Height="36"
                                                            CornerRadius="18"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                            <FontIcon
                                                                FontSize="15"
                                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                Glyph="&#xE8D2;" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                                Text="{x:Bind Title}" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind Description}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Text="{x:Bind CompletedNodesCount}" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="/" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind TotalNodesCount}" />
                                                            </StackPanel>
                                                            <ProgressBar
                                                                Width="80"
                                                                Maximum="100"
                                                                Value="{x:Bind ProgressPercentage}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Nodes List inside Milestone -->
                                                    <ItemsControl ItemsSource="{x:Bind Nodes}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="dto:RoadmapNodeDto">
                                                                <Border
                                                                    Margin="0,4"
                                                                    Padding="12,10"
                                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8">
                                                                    <Grid ColumnSpacing="12">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <Border
                                                                            Width="28"
                                                                            Height="28"
                                                                            CornerRadius="14"
                                                                            VerticalAlignment="Center"
                                                                            Background="{x:Bind Status, Converter={StaticResource StatusToBrushConverter}}">
                                                                            <FontIcon
                                                                                FontSize="12"
                                                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                                Glyph="&#xE768;" />
                                                                        </Border>

                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                            <TextBlock
                                                                                FontWeight="SemiBold"
                                                                                Text="{x:Bind Title}" />
                                                                            <TextBlock
                                                                                FontSize="11"
                                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                Text="{x:Bind ReferenceDisplay}" />
                                                                        </StackPanel>

                                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                                                            <TextBlock
                                                                                FontSize="11"
                                                                                HorizontalAlignment="Right"
                                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                Text="{x:Bind ProgressPercentageDisplay}" />
                                                                            <ProgressBar
                                                                                Width="60"
                                                                                Maximum="100"
                                                                                Value="{x:Bind ProgressPercentage}" />
                                                                        </StackPanel>

                                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                            <Button
                                                                                Click="TimelineNodeSelect_Click"
                                                                                Tag="{x:Bind}"
                                                                                Padding="8,5"
                                                                                Style="{ThemeResource SubtleButtonStyle}">
                                                                                <FontIcon Glyph="&#xE946;" FontSize="12" />
                                                                            </Button>
                                                                            <Button
                                                                                Click="TimelineNodeLearn_Click"
                                                                                Tag="{x:Bind}"
                                                                                IsEnabled="{x:Bind CanStartPractice}"
                                                                                Padding="10,5"
                                                                                Style="{ThemeResource AccentButtonStyle}">
                                                                                <FontIcon Glyph="&#xE768;" FontSize="12" />
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Node Detail & Action Inspector Panel -->
                    <Border
                        x:Name="InspectorHostBorder"
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        Padding="24"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid>
                            <!-- Empty State when no node is selected -->
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.IsNodeDetailOpen, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontSize="36"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE81C;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind Loc.GetString('Roadmap_SelectNodePlaceholder')}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind Loc.GetString('Roadmap_SelectNodeDesc')}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Selected Node Details -->
                            <StackPanel
                                Spacing="18"
                                Visibility="{x:Bind ViewModel.IsNodeDetailOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                                <!-- Selected Node Header with Close Button -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <Border
                                            HorizontalAlignment="Left"
                                            Padding="8,3"
                                            CornerRadius="4"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind ViewModel.SelectedNode.Type, Mode=OneWay, FallbackValue='Skill'}" />
                                        </Border>
                                        <TextBlock
                                            x:Name="InspectorTitle"
                                            Style="{ThemeResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind ViewModel.SelectedNode.Title, Mode=OneWay, FallbackValue=''}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Command="{x:Bind ViewModel.CloseNodeDetailCommand}"
                                        ToolTipService.ToolTip="{x:Bind Loc.GetString('Roadmap_CloseInspector')}"
                                        Style="{ThemeResource SubtleButtonStyle}">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>

                                <!-- Description -->
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedNode.Description, Mode=OneWay, FallbackValue=''}"
                                    TextWrapping="Wrap" />

                                <!-- Progress & Status Info -->
                                <StackPanel Spacing="12">
                                    <!-- Linked Topic / Rule Context -->
                                    <Grid Visibility="{x:Bind ViewModel.SelectedNode.HasLinkedContent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Loc.GetString('Roadmap_LinkedTopic')}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind ViewModel.SelectedNodeLinkedTopicDisplay, Mode=OneWay, FallbackValue=''}" />
                                    </Grid>

                                    <Grid>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Loc.GetString('Roadmap_TargetProgress')}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind ViewModel.SelectedNode.ProgressPercentageDisplay, Mode=OneWay, FallbackValue='0%'}" />
                                    </Grid>
                                    <ProgressBar
                                        Maximum="100"
                                        Value="{x:Bind ViewModel.SelectedNode.ProgressPercentage, Mode=OneWay, FallbackValue=0}" />

                                    <Grid Margin="0,4,0,0">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Loc.GetString('Roadmap_LessonsCount')}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedNode.CompletedItemCount, Mode=OneWay, FallbackValue=0}" />
                                            <TextBlock Text="/" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedNode.TargetItemCount, Mode=OneWay, FallbackValue=0}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Loc.GetString('Roadmap_RetentionIndicator')}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind ViewModel.SelectedNode.EaseFactorWeightDisplay, Mode=OneWay, FallbackValue='EF: 2.50'}" />
                                    </Grid>

                                    <!-- Action Buttons -->
                                    <Button
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.StartLearningNodeCommand}"
                                        CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanAdvanceProgress, Mode=OneWay}"
                                        Style="{ThemeResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;" />
                                            <TextBlock Text="{x:Bind Loc.GetString('Roadmap_ActionLearn')}" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.AdvanceNodeProgressCommand}"
                                        CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanAdvanceProgress, Mode=OneWay}"
                                        Style="{ThemeResource DefaultButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE777;" />
                                            <TextBlock Text="{x:Bind Loc.GetString('Roadmap_AdvanceProgress')}" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.MarkNodeCompletedCommand}"
                                        CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanAdvanceProgress, Mode=OneWay}"
                                        Style="{ThemeResource DefaultButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE73E;" />
                                            <TextBlock Text="{x:Bind Loc.GetString('Roadmap_MarkMastered')}" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.ViewInVocabularyCommand}"
                                        CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
                                        Style="{ThemeResource DefaultButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8A7;" />
                                            <TextBlock Text="{x:Bind Loc.GetString('Roadmap_ViewInVocab')}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Ring Overlay -->
        <ProgressRing
            Width="56"
            Height="56"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</Page>
