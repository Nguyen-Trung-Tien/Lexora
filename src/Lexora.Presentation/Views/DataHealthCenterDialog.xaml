<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.DataHealthCenterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dto="using:Lexora.Application.DTOs"
    mc:Ignorable="d"
    Title="{x:Bind Loc.GetString('DataHealth_Title')}"
    PrimaryButtonText="{x:Bind Loc.GetString('Action_Close')}"
    DefaultButton="Primary"
    CornerRadius="16"
    MaxWidth="760">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="500">
        <StackPanel Spacing="16" Margin="0,8,0,0">

            <!-- Subtitle Header -->
            <TextBlock Text="{x:Bind Loc.GetString('DataHealth_Subtitle')}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="13" TextWrapping="Wrap" />

            <!-- Diagnostic & Repair Results InfoBar -->
            <InfoBar x:Name="ResultInfoBar"
                     IsOpen="{x:Bind HasResultFeedback, Mode=OneWay}"
                     Severity="{x:Bind FeedbackSeverity, Mode=OneWay}"
                     Title="{x:Bind FeedbackTitle, Mode=OneWay}"
                     Message="{x:Bind FeedbackMessage, Mode=OneWay}"
                     CornerRadius="8"
                     IsClosable="True" />

            <!-- Progress Ring while diagnostics running -->
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center"
                        Visibility="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressRing IsActive="True" Width="24" Height="24" />
                <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
            </StackPanel>

            <!-- Health Score Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE958;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="{x:Bind Loc.GetString('DataHealth_HealthScore')}" FontSize="15" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind HealthRatingDescription, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="16,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind HealthScoreText, Mode=OneWay}" FontSize="28" FontWeight="Bold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="/100" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Diagnostic Telemetry Grid -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <!-- SQLite Integrity -->
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Loc.GetString('DataHealth_IntegrityStatus')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind Report.SqliteIntegrityStatus, Mode=OneWay}" FontSize="14" FontWeight="Bold"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Database Size & WAL -->
                <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Loc.GetString('DataHealth_DbSize')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Report.FormattedDatabaseSize, Mode=OneWay}" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind WalLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Page Count & Fragmentation -->
                <Border Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Loc.GetString('DataHealth_PageStats')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind FragmentationText, Mode=OneWay}" FontSize="14" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Reclaimable Space -->
                <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Loc.GetString('DataHealth_Reclaimable')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind Report.FormattedReclaimableSpace, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Orphan Records Status -->
                <Border Grid.Row="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Loc.GetString('DataHealth_Orphans')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind OrphansText, Mode=OneWay}" FontSize="14" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Audio Cache -->
                <Border Grid.Row="2" Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Loc.GetString('DataHealth_AudioCache')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind AudioCacheText, Mode=OneWay}" FontSize="14" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Actions Bar -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <Button Click="RunDiagnostics_Click"
                            IsEnabled="{x:Bind IsNotBusy, Mode=OneWay}"
                            Padding="14,8" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE777;" FontSize="13" />
                            <TextBlock Text="{x:Bind Loc.GetString('DataHealth_RunDiagnostics')}" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Click="ClearAudioCache_Click"
                            IsEnabled="{x:Bind IsNotBusy, Mode=OneWay}"
                            Padding="14,8" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                            <TextBlock Text="{x:Bind Loc.GetString('DataHealth_ClearAudioCache')}" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Click="RepairAndOptimize_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            IsEnabled="{x:Bind IsNotBusy, Mode=OneWay}"
                            Padding="16,8" CornerRadius="8" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE90F;" FontSize="13" />
                            <TextBlock Text="{x:Bind Loc.GetString('DataHealth_RepairAndOptimize')}" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
