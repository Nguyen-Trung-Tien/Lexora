<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.WordEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">840</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/brand/lexora-icon-only.png" Width="24" Height="24" VerticalAlignment="Center" />
                <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <ScrollViewer MaxHeight="580" HorizontalAlignment="Stretch" Padding="0,4,12,8">
        <StackPanel Spacing="16">
            <!-- Validation Error InfoBar -->
            <InfoBar x:Name="DialogInfoBar" IsOpen="False" Severity="Error" Margin="0,0,0,4" />

            <!-- Card 1: Term & Core Attributes -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE82D;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind Loc.GetString('Vocab_Title')}" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="12">
                        <TextBox x:Name="TermTextBox"
                                 Header="{x:Bind Loc.GetString('WordEditor_HeaderTerm')}"
                                 PlaceholderText="{x:Bind Loc.GetString('WordEditor_PlaceholderTerm')}"
                                 FontWeight="SemiBold" />
                        <ComboBox Grid.Column="1" x:Name="PosComboBox"
                                  Header="{x:Bind Loc.GetString('WordEditor_HeaderPos')}"
                                  HorizontalAlignment="Stretch" />
                        <ComboBox Grid.Column="2" x:Name="LevelComboBox"
                                  Header="{x:Bind Loc.GetString('WordEditor_HeaderLevel')}"
                                  HorizontalAlignment="Stretch" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <TextBox x:Name="IpaUkTextBox"
                                 Header="{x:Bind Loc.GetString('WordEditor_HeaderPhoneticUk')}"
                                 PlaceholderText="{x:Bind Loc.GetString('WordEditor_PlaceholderPhoneticUk')}" />
                        <TextBox Grid.Column="1" x:Name="IpaUsTextBox"
                                 Header="{x:Bind Loc.GetString('WordEditor_HeaderPhoneticUs')}"
                                 PlaceholderText="{x:Bind Loc.GetString('WordEditor_PlaceholderPhoneticUs')}" />
                        <TextBox Grid.Column="2" x:Name="NotesTextBox"
                                 Header="{x:Bind Loc.GetString('WordEditor_HeaderNotes')}"
                                 PlaceholderText="{x:Bind Loc.GetString('WordEditor_PlaceholderNotes')}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: Meanings Section -->
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE762;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind Loc.GetString('WordEditor_SectionMeanings')}" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Loc.GetString('WordEditor_SectionMeaningsDesc')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="AddMeaningButton_Click" Style="{ThemeResource AccentButtonStyle}" CornerRadius="6" VerticalAlignment="Center" Padding="14,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="{x:Bind Loc.GetString('WordEditor_BtnAddMeaning')}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Meanings Items -->
                <ItemsControl x:Name="MeaningsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <StackPanel Spacing="12">
                                    <!-- Meaning Header bar with Pill Badge, Inline POS selector, and Delete button -->
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MeaningBadge}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="12" FontWeight="Bold" />
                                        </Border>

                                        <Border Grid.Column="1" />

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HeaderMeaningPos}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <ComboBox ItemsSource="{Binding AvailablePartsOfSpeech}"
                                                      SelectedItem="{Binding PartOfSpeech, Mode=TwoWay}"
                                                      MinWidth="130" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <Button Grid.Column="3"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="{Binding TooltipDeleteMeaning}"
                                                Click="DeleteMeaningButton_Click"
                                                IsEnabled="{Binding CanDelete}"
                                                Padding="8,6" CornerRadius="6">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </Grid>

                                    <!-- Vietnamese Definition -->
                                    <TextBox Header="{Binding HeaderDefinitionVi}"
                                             Text="{Binding DefinitionVi, Mode=TwoWay}"
                                             PlaceholderText="{Binding PlaceholderDefinitionVi}"
                                             FontWeight="Medium" />

                                    <!-- English Definition & Context Nuance -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <TextBox Header="{Binding HeaderDefinitionEn}"
                                                 Text="{Binding DefinitionEn, Mode=TwoWay}"
                                                 PlaceholderText="{Binding PlaceholderDefinitionEn}" />
                                        <TextBox Grid.Column="1"
                                                 Header="{Binding HeaderExplanation}"
                                                 Text="{Binding Explanation, Mode=TwoWay}"
                                                 PlaceholderText="{Binding PlaceholderExplanation}" />
                                    </Grid>

                                    <!-- Examples list inside meaning -->
                                    <StackPanel Spacing="8" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding SectionExamples}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        
                                        <ItemsControl ItemsSource="{Binding Examples}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto,*,*,Auto" ColumnSpacing="8" Margin="0,2,0,6" VerticalAlignment="Center">
                                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ExampleBadge}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBox Grid.Column="1"
                                                                 PlaceholderText="{Binding PlaceholderExampleEn}"
                                                                 Text="{Binding SentenceEn, Mode=TwoWay}" />
                                                        <TextBox Grid.Column="2"
                                                                 PlaceholderText="{Binding PlaceholderExampleVi}"
                                                                 Text="{Binding SentenceVi, Mode=TwoWay}" />
                                                        <Button Grid.Column="3"
                                                                ToolTipService.ToolTip="{Binding TooltipDeleteExample}"
                                                                Click="DeleteExampleButton_Click"
                                                                Padding="8,6" CornerRadius="6">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button HorizontalAlignment="Left" Click="AddExampleButton_Click" Padding="12,6" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE710;" FontSize="11" />
                                                <TextBlock Text="{Binding BtnAddExample}" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Card 3: Topics & Exams -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE734;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind Loc.GetString('WordEditor_SectionTopicsExams')}" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Loc.GetString('WordEditor_SectionTopicsExamsDesc')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <!-- Topics list -->
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{x:Bind Loc.GetString('WordEditor_HeaderTopics')}" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{ThemeResource SubtleButtonStyle}" Padding="6,2" ToolTipService.ToolTip="{x:Bind Loc.GetString('WordEditor_AddTopic')}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE710;" FontSize="10" />
                                        <TextBlock Text="{x:Bind Loc.GetString('WordEditor_AddTopic')}" FontSize="11" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout x:Name="AddTopicFlyout">
                                            <StackPanel Spacing="10" Width="260">
                                                <TextBlock Text="{x:Bind Loc.GetString('WordEditor_AddTopicFlyoutTitle')}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBox x:Name="NewTopicNameTextBox"
                                                         PlaceholderText="{x:Bind Loc.GetString('TopicEditor_HeaderName')}"
                                                         KeyDown="NewTopicNameTextBox_KeyDown" />
                                                <TextBox x:Name="NewTopicDescTextBox"
                                                         PlaceholderText="{x:Bind Loc.GetString('TopicEditor_HeaderDesc')}"
                                                         Height="54" TextWrapping="Wrap" AcceptsReturn="True" />
                                                <Button Style="{ThemeResource AccentButtonStyle}"
                                                        HorizontalAlignment="Stretch"
                                                        Click="CreateTopicQuickButton_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                                                        <TextBlock Text="{x:Bind Loc.GetString('TopicEditor_Save')}" FontWeight="SemiBold" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6" MinHeight="100" MaxHeight="140" Background="{ThemeResource SubtleFillColorSecondaryBrush}">

                                <Grid>
                                    <ListView x:Name="TopicsListView" SelectionMode="Multiple">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock x:Name="EmptyTopicsTextBlock"
                                               Text="{x:Bind Loc.GetString('WordEditor_EmptyTopics')}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               FontSize="12" FontStyle="Italic"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Exam tags list -->
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{x:Bind Loc.GetString('WordEditor_HeaderExams')}" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6" MinHeight="100" MaxHeight="140" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid>
                                    <ListView x:Name="ExamTagsListView" SelectionMode="Multiple">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock x:Name="EmptyExamTagsTextBlock"
                                               Text="{x:Bind Loc.GetString('WordEditor_EmptyExams')}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               FontSize="12" FontStyle="Italic"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
