<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.WordEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Vocabulary Word Editor"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <ScrollViewer MaxHeight="600" Width="650" Padding="0,8,16,8">
        <StackPanel Spacing="16">
            <!-- Term & IPA -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <TextBox x:Name="TermTextBox" Header="Word / Term *" PlaceholderText="e.g. collaborate" />
                <TextBox Grid.Column="1" x:Name="IpaUkTextBox" Header="Phonetic (UK)" PlaceholderText="e.g. /kəˈlæb.ə.reɪt/" />
                <TextBox Grid.Column="2" x:Name="IpaUsTextBox" Header="Phonetic (US)" PlaceholderText="e.g. /kəˈlæb.ə.reɪt/" />
            </Grid>

            <!-- POS & Level -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <ComboBox x:Name="PosComboBox" Header="Primary Part of Speech" HorizontalAlignment="Stretch" />
                <ComboBox Grid.Column="1" x:Name="LevelComboBox" Header="CEFR Level" HorizontalAlignment="Stretch" />
                <TextBox Grid.Column="2" x:Name="NotesTextBox" Header="Personal Notes" PlaceholderText="Memory cues, collocations..." />
            </Grid>

            <MenuFlyoutSeparator />

            <!-- Meanings Section -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Definitions &amp; Meanings *" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="+ Add Meaning" Click="AddMeaningButton_Click" Style="{ThemeResource AccentButtonStyle}" />
            </Grid>

            <!-- Meanings Items -->
            <ItemsControl x:Name="MeaningsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Header="Vietnamese Meaning *" Text="{Binding DefinitionVi, Mode=TwoWay}" PlaceholderText="Định nghĩa tiếng Việt..." />
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="✕" ToolTipService.ToolTip="Delete Meaning" Click="DeleteMeaningButton_Click" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <TextBox Header="English Definition" Text="{Binding DefinitionEn, Mode=TwoWay}" PlaceholderText="English definition..." />
                                    <TextBox Header="Context / Nuance" Text="{Binding Explanation, Mode=TwoWay}" PlaceholderText="When to use, formality..." />
                                </Grid>

                                <!-- Examples list -->
                                <TextBlock Text="Examples" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <ItemsControl ItemsSource="{Binding Examples}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,2,0,4">
                                                <TextBox PlaceholderText="English sentence" Text="{Binding SentenceEn, Mode=TwoWay}" />
                                                <TextBox Grid.Column="1" PlaceholderText="Vietnamese translation" Text="{Binding SentenceVi, Mode=TwoWay}" />
                                                <Button Grid.Column="2" Content="✕" Click="DeleteExampleButton_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="+ Add Example" HorizontalAlignment="Left" Click="AddExampleButton_Click" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <MenuFlyoutSeparator />

            <!-- Topics & Exams -->
            <TextBlock Text="Topics &amp; Exam Certifications" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <!-- Topics list -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Topics" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="TopicsListView" SelectionMode="Multiple" MaxHeight="140" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Exam tags list -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Exam Targets (TOEIC / VSTEP / IELTS)" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="ExamTagsListView" SelectionMode="Multiple" MaxHeight="140" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>

            <!-- Error message if validation fails -->
            <TextBlock x:Name="ErrorMessageTextBlock" Foreground="#D83B01" FontWeight="SemiBold" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
