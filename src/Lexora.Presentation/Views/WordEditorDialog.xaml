<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.WordEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Vocabulary Word Editor"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/brand/lexora-icon-only.png" Width="22" Height="22" VerticalAlignment="Center" />
                <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <ScrollViewer MaxHeight="540" MaxWidth="720" HorizontalAlignment="Stretch" Padding="0,8,12,8">
        <StackPanel Spacing="16">
            <!-- Validation Error InfoBar -->
            <InfoBar x:Name="DialogInfoBar" IsOpen="False" Severity="Error" Title="Validation Error" Margin="0,0,0,4" />

            <!-- Card 1: Term & Core Attributes -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="12">
                        <TextBox x:Name="TermTextBox" Header="Word / Term *" PlaceholderText="e.g. collaborate" FontWeight="SemiBold" />
                        <ComboBox Grid.Column="1" x:Name="PosComboBox" Header="Part of Speech" HorizontalAlignment="Stretch" />
                        <ComboBox Grid.Column="2" x:Name="LevelComboBox" Header="CEFR Level" HorizontalAlignment="Stretch" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <TextBox x:Name="IpaUkTextBox" Header="Phonetic (UK)" PlaceholderText="e.g. /kəˈlæb.ə.reɪt/" />
                        <TextBox Grid.Column="1" x:Name="IpaUsTextBox" Header="Phonetic (US)" PlaceholderText="e.g. /kəˈlæb.ə.reɪt/" />
                        <TextBox Grid.Column="2" x:Name="NotesTextBox" Header="Personal Notes" PlaceholderText="Memory cues, collocations..." />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: Meanings Section -->
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Definitions &amp; Meanings *" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="Add contextual meanings, examples, and nuance notes" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="AddMeaningButton_Click" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Add Meaning" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Meanings Items -->
                <ItemsControl x:Name="MeaningsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Header="Vietnamese Meaning *" Text="{Binding DefinitionVi, Mode=TwoWay}" PlaceholderText="Định nghĩa tiếng Việt rõ ràng..." FontWeight="Medium" />
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" ToolTipService.ToolTip="Delete Meaning" Click="DeleteMeaningButton_Click" Padding="8,6">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <TextBox Header="English Definition" Text="{Binding DefinitionEn, Mode=TwoWay}" PlaceholderText="English definition..." />
                                        <TextBox Grid.Column="1" Header="Context / Nuance" Text="{Binding Explanation, Mode=TwoWay}" PlaceholderText="When to use, register, collocations..." />
                                    </Grid>

                                    <!-- Examples list -->
                                    <StackPanel Spacing="6" Margin="0,4,0,0">
                                        <TextBlock Text="Example Sentences" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ItemsControl ItemsSource="{Binding Examples}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,2,0,6">
                                                        <TextBox PlaceholderText="English example sentence..." Text="{Binding SentenceEn, Mode=TwoWay}" />
                                                        <TextBox Grid.Column="1" PlaceholderText="Vietnamese translation..." Text="{Binding SentenceVi, Mode=TwoWay}" />
                                                        <Button Grid.Column="2" ToolTipService.ToolTip="Delete Example" Click="DeleteExampleButton_Click" Padding="8,6">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button HorizontalAlignment="Left" Click="AddExampleButton_Click" Padding="10,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE710;" FontSize="11" />
                                                <TextBlock Text="Add Example" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Card 3: Topics & Exams -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Topics &amp; Exam Certifications" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <!-- Topics list -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Topics" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <ListView x:Name="TopicsListView" SelectionMode="Multiple" MaxHeight="140" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <!-- Exam tags list -->
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Exam Targets (TOEIC / VSTEP / IELTS)" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <ListView x:Name="ExamTagsListView" SelectionMode="Multiple" MaxHeight="140" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
