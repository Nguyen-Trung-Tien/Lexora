<?xml version="1.0" encoding="utf-8" ?>
<Page
    UseLayoutRounding="True"
    x:Class="Lexora.Presentation.Views.Help.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:common="using:Lexora.Presentation.Views.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Lexora.Presentation.ViewModels"
    Background="Transparent"
    KeyboardAcceleratorPlacementMode="Hidden"
    Loaded="HelpPage_Loaded"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="24" HorizontalAlignment="Stretch">
            <StackPanel Spacing="16" HorizontalAlignment="Stretch">

                <!-- 1. UNIFIED PAGE HEADER -->
                <common:PageHeaderControl Title="{x:Bind Loc.GetString('Help_Title')}"
                                          Subtitle="{x:Bind Loc.GetString('Help_Subtitle')}"
                                          IconGlyph="&#xE9CE;">
                    <common:PageHeaderControl.ActionsContent>
                        <Button Click="OpenReleaseNotesLog_Click"
                                Style="{StaticResource LexoraStandardButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind Loc.GetString('Help_ReleaseNotesLogTooltip')}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Loc.GetString('Help_ReleaseNotesLog')}" FontWeight="SemiBold" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                    </common:PageHeaderControl.ActionsContent>
                </common:PageHeaderControl>

                <!-- Search & Reset Bar -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="10,6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox x:Name="SearchBox"
                                 PlaceholderText="{x:Bind Loc.GetString('Help_SearchPlaceholder')}"
                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 CornerRadius="{ThemeResource ControlCornerRadius}" />
                        <Button Grid.Column="1" Click="ResetFilterButton_Click"
                                Style="{StaticResource LexoraStandardButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind Loc.GetString('Help_ResetFilterTooltip')}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock Text="{x:Bind Loc.GetString('Help_ResetFilter')}" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. CATEGORY FILTER PILLS (FLUENT 2 STRIP WITH CHEVRON SCROLLING) -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                    <!-- Scroll Left Chevron Button -->
                    <Button x:Name="ScrollPillsLeftBtn" Grid.Column="0"
                            Click="ScrollPillsLeft_Click"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Width="32" Height="36" Padding="0" CornerRadius="{ThemeResource ControlCornerRadius}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Help_ScrollLeft')}">
                        <FontIcon Glyph="&#xE76B;" FontSize="11" />
                    </Button>

                    <ScrollViewer x:Name="CategoryScrollViewer" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled"
                                  PointerWheelChanged="CategoryScrollViewer_PointerWheelChanged"
                                  ViewChanged="CategoryScrollViewer_ViewChanged"
                                  SizeChanged="CategoryScrollViewer_SizeChanged"
                                  Padding="0,2,0,4">
                        <StackPanel x:Name="CategoryPillsPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="FilterBtnAll" Click="FilterButton_Click" Tag="All" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,6">
                                <TextBlock Text="{x:Bind Loc.GetString('Help_Cat_All')}" FontWeight="SemiBold" />
                            </Button>
                            <Button x:Name="FilterBtnGettingStarted" Click="FilterButton_Click" Tag="GettingStarted" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE80F;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_Cat_GettingStarted')}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FilterBtnVocabulary" Click="FilterButton_Click" Tag="Vocabulary" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8D2;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_Cat_Vocabulary')}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FilterBtnSpacedRepetition" Click="FilterButton_Click" Tag="SpacedRepetition" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE81C;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_Cat_SpacedRepetition')}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FilterBtnRoadmap" Click="FilterButton_Click" Tag="Roadmap" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE81D;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_Cat_Roadmap')}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FilterBtnKnowledgeGraph" Click="FilterButton_Click" Tag="KnowledgeGraph" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE9CE;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_Cat_KnowledgeGraph')}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FilterBtnListeningLab" Click="FilterButton_Click" Tag="ListeningLab" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE767;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_Cat_ListeningLab')}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FilterBtnTestMode" Click="FilterButton_Click" Tag="TestMode" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7BE;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_Cat_TestMode')}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FilterBtnBackupSettings" Click="FilterButton_Click" Tag="BackupAndSettings" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE713;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_Cat_BackupSettings')}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Scroll Right Chevron Button -->
                    <Button x:Name="ScrollPillsRightBtn" Grid.Column="2"
                            Click="ScrollPillsRight_Click"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Width="32" Height="36" Padding="0" CornerRadius="{ThemeResource ControlCornerRadius}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Help_ScrollRight')}">
                        <FontIcon Glyph="&#xE76C;" FontSize="11" />
                    </Button>
                </Grid>

                <!-- 3. BALANCED 2-COLUMN GUIDE CARDS GRID -->
                <ItemsRepeater x:Name="GuidesRepeater" ItemsSource="{x:Bind ViewModel.FilteredGuides, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout x:Name="GuidesLayout" MinItemWidth="380" MaximumRowsOrColumns="2" MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:HelpGuideDisplayItem">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="18"
                                    VerticalAlignment="Stretch">
                                <StackPanel Spacing="14">
                                    <!-- Card Header -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <Border Width="44" Height="44" CornerRadius="{ThemeResource OverlayCornerRadius}"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                VerticalAlignment="Top">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="18"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
                                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="8,2"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{x:Bind Badge, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind Badge}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Direct Jump Button -->
                                        <Button Grid.Column="2" Style="{ThemeResource AccentButtonStyle}"
                                                Click="GuideActionButton_Click"
                                                Tag="{x:Bind ActionTargetTag}"
                                                CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12,6"
                                                VerticalAlignment="Top"
                                                Visibility="{x:Bind ActionTargetTag, Converter={StaticResource NullToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind ActionLabel}" FontWeight="SemiBold" FontSize="12" />
                                                <FontIcon Glyph="&#xE76C;" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Summary Quote / Lead -->
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="14,10">
                                        <TextBlock Text="{x:Bind Summary}" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" FontStyle="Italic" />
                                    </Border>

                                    <!-- Detailed Guide Body -->
                                    <TextBlock Text="{x:Bind Content}" FontSize="13" LineHeight="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />

                                    <!-- Mathematical Formula / Algorithm Card (if present) -->
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="14,10"
                                            Visibility="{x:Bind Formula, Converter={StaticResource NullToVisibilityConverter}}">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind FormulaHeader}" FontWeight="Bold" FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Formula}" FontFamily="Consolas, Cascadia Code, Segoe UI Variable"
                                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Key Tips / Bullet Points -->
                                    <StackPanel Spacing="6" Visibility="{x:Bind TipsList, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind KeyPointsHeader}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ItemsControl ItemsSource="{x:Bind TipsList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,3">
                                                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind ToString()}" FontSize="12" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Keyboard Shortcuts Reference (Horizontal Wrapping) -->
                                    <StackPanel Spacing="6" Visibility="{x:Bind ShortcutKeys, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind ShortcutsHeader}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ItemsRepeater ItemsSource="{x:Bind ShortcutKeys}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="155" MinColumnSpacing="6" MinRowSpacing="6" ItemsStretch="None" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,4">
                                                        <TextBlock Text="{x:Bind ToString()}" FontFamily="Consolas, Cascadia Code" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- 4. FOOTER NOTE -->
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="20,16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <FontIcon Glyph="&#xE946;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Loc.GetString('Help_FooterNoteTitle')}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{x:Bind Loc.GetString('Help_FooterNoteContent')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
