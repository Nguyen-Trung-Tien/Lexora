<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.GrammarEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">840</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/brand/lexora-icon-only.png" Width="24" Height="24" VerticalAlignment="Center" />
                <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <ScrollViewer MaxHeight="580" HorizontalAlignment="Stretch" Padding="0,4,12,8">
        <StackPanel Spacing="16">
            <!-- Validation Error InfoBar -->
            <InfoBar x:Name="DialogInfoBar" IsOpen="False" Severity="Error" Margin="0,0,0,4" />

            <!-- Card 1: Title & Structure -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE943;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind Loc.GetString('Grammar_Structures')}" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <TextBox x:Name="TitleTextBox"
                                 Header="{x:Bind Loc.GetString('GrammarEditor_HeaderTitle')}"
                                 PlaceholderText="{x:Bind Loc.GetString('GrammarEditor_PlaceholderTitle')}"
                                 FontWeight="SemiBold" />
                        
                        <TextBox Grid.Column="1" x:Name="StructureTextBox"
                                 PlaceholderText="{x:Bind Loc.GetString('GrammarEditor_PlaceholderStructure')}"
                                 FontFamily="Cascadia Code, Consolas">
                            <TextBox.Header>
                                <TextBlock Text="{x:Bind Loc.GetString('GrammarEditor_HeaderStructure')}"
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           FontWeight="SemiBold" />
                            </TextBox.Header>
                        </TextBox>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <ComboBox x:Name="LevelComboBox"
                                  Header="{x:Bind Loc.GetString('GrammarEditor_HeaderLevel')}"
                                  HorizontalAlignment="Stretch" />
                        <ComboBox Grid.Column="1" x:Name="ExamComboBox"
                                  Header="{x:Bind Loc.GetString('GrammarEditor_HeaderExam')}"
                                  HorizontalAlignment="Stretch" />
                        <TextBox Grid.Column="2" x:Name="TopicTextBox"
                                 Header="{x:Bind Loc.GetString('GrammarEditor_HeaderTopic')}"
                                 PlaceholderText="{x:Bind Loc.GetString('GrammarEditor_PlaceholderTopic')}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: Explanations -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE762;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind Loc.GetString('Grammar_Explanation')}" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <TextBox x:Name="ExplanationViTextBox"
                             Header="{x:Bind Loc.GetString('GrammarEditor_HeaderExplanationVi')}"
                             PlaceholderText="{x:Bind Loc.GetString('GrammarEditor_PlaceholderExplanationVi')}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75" />

                    <TextBox x:Name="ExplanationEnTextBox"
                             Header="{x:Bind Loc.GetString('GrammarEditor_HeaderExplanationEn')}"
                             PlaceholderText="{x:Bind Loc.GetString('GrammarEditor_PlaceholderExplanationEn')}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55" />
                </StackPanel>
            </Border>

            <!-- Card 3: Common Mistakes -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="{x:Bind Loc.GetString('GrammarEditor_SectionMistakes')}" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="13" />
                    </StackPanel>
                    <TextBox x:Name="CommonMistakesTextBox"
                             PlaceholderText="{x:Bind Loc.GetString('GrammarEditor_PlaceholderMistakes')}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                </StackPanel>
            </Border>

            <!-- Card 4: Examples Section -->
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE82D;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind Loc.GetString('GrammarEditor_SectionExamples')}" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Loc.GetString('GrammarEditor_SectionExamplesDesc')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="AddExampleButton_Click" Style="{ThemeResource AccentButtonStyle}" CornerRadius="6" VerticalAlignment="Center" Padding="14,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="{x:Bind Loc.GetString('GrammarEditor_BtnAddExample')}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ItemsControl x:Name="ExamplesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <StackPanel Spacing="10">
                                    <!-- Example Header Bar with Badge and Remove button -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ExampleBadge}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="11" FontWeight="Bold" />
                                        </Border>

                                        <Border Grid.Column="1" />

                                        <Button Grid.Column="2"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="{Binding TooltipRemoveExample}"
                                                Click="RemoveExampleButton_Click"
                                                IsEnabled="{Binding CanRemove}"
                                                Padding="8,6" CornerRadius="6">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </Grid>

                                    <!-- English Sentence -->
                                    <TextBox Header="{Binding HeaderSentenceEn}"
                                             Text="{Binding SentenceEn, Mode=TwoWay}"
                                             PlaceholderText="{Binding PlaceholderSentenceEn}" />

                                    <!-- Vietnamese Translation & Grammar Note -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <TextBox Header="{Binding HeaderSentenceVi}"
                                                 Text="{Binding SentenceVi, Mode=TwoWay}"
                                                 PlaceholderText="{Binding PlaceholderSentenceVi}" />
                                        <TextBox Grid.Column="1"
                                                 Header="{Binding HeaderNote}"
                                                 Text="{Binding Note, Mode=TwoWay}"
                                                 PlaceholderText="{Binding PlaceholderNote}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
