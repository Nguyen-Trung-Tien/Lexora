<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.GrammarEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Grammar Rule Editor"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/brand/lexora-icon-only.png" Width="22" Height="22" VerticalAlignment="Center" />
                <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <ScrollViewer MaxHeight="620" Width="680" Padding="0,8,16,8">
        <StackPanel Spacing="16">
            <!-- Title & Structure -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <TextBox x:Name="TitleTextBox" Header="Rule Title *" PlaceholderText="e.g. Present Perfect Continuous" />
                <TextBox Grid.Column="1" x:Name="StructureTextBox" Header="Structure Formula *" PlaceholderText="e.g. S + have/has + been + V-ing" FontFamily="Consolas, Segoe UI Variable" />
            </Grid>

            <!-- Level, Exam & Topic -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <ComboBox x:Name="LevelComboBox" Header="CEFR Level" HorizontalAlignment="Stretch" />
                <ComboBox Grid.Column="1" x:Name="ExamComboBox" Header="Target Exam" HorizontalAlignment="Stretch" />
                <TextBox Grid.Column="2" x:Name="TopicTextBox" Header="Topic / Category" PlaceholderText="e.g. Tenses, Passive Voice..." />
            </Grid>

            <MenuFlyoutSeparator />

            <!-- Explanation Vi & En -->
            <TextBox x:Name="ExplanationViTextBox" Header="Vietnamese Explanation *"
                     PlaceholderText="Giải thích cách dùng, trường hợp sử dụng bằng Tiếng Việt..."
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />

            <TextBox x:Name="ExplanationEnTextBox" Header="English Explanation (Optional)"
                     PlaceholderText="Explanation in English..."
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" />

            <!-- Common Mistakes -->
            <Border Background="#FFF4CE" BorderBrush="#FFB900" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="6">
                    <TextBlock Text="⚠️ Common Mistakes &amp; Pitfalls" FontWeight="Bold" Foreground="#323130" FontSize="13" />
                    <TextBox x:Name="CommonMistakesTextBox"
                             PlaceholderText="Các lỗi sai thí sinh hay mắc phải, lưu ý phân biệt..."
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" />
                </StackPanel>
            </Border>

            <MenuFlyoutSeparator />

            <!-- Examples Section -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Examples &amp; Sample Sentences" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="+ Add Example" Click="AddExampleButton_Click" Style="{ThemeResource AccentButtonStyle}" />
            </Grid>

            <ItemsControl x:Name="ExamplesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Header="English Sentence *" Text="{Binding SentenceEn, Mode=TwoWay}" PlaceholderText="e.g. I have been working for three hours." />
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="✕" ToolTipService.ToolTip="Remove Example" Click="RemoveExampleButton_Click" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <TextBox Header="Vietnamese Translation *" Text="{Binding SentenceVi, Mode=TwoWay}" PlaceholderText="Bản dịch tiếng Việt..." />
                                    <TextBox Header="Grammar Note" Text="{Binding Note, Mode=TwoWay}" PlaceholderText="Ghi chú ngữ pháp bổ sung..." />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
