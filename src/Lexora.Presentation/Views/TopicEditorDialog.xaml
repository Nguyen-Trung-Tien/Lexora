<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.TopicEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Lexora.Presentation.Views"
    DefaultButton="Primary"
    mc:Ignorable="d">


    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">540</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">440</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <FontIcon Glyph="&#xE8EC;" FontSize="16"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <ScrollViewer MaxHeight="520" HorizontalAlignment="Stretch" Padding="0,4,12,8">
        <StackPanel Spacing="16">
            <!-- Validation Error InfoBar -->
            <InfoBar x:Name="DialogInfoBar" IsOpen="False" Severity="Error" Margin="0,0,0,4" />

            <!-- Topic Details Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="14">
                    <!-- Topic Name -->
                    <TextBox x:Name="NameTextBox"
                             Header="{x:Bind Loc.GetString('TopicEditor_HeaderName')}"
                             PlaceholderText="{x:Bind Loc.GetString('TopicEditor_PlaceholderName')}"
                             FontWeight="SemiBold" />

                    <!-- Topic Description -->
                    <TextBox x:Name="DescriptionTextBox"
                             Header="{x:Bind Loc.GetString('TopicEditor_HeaderDesc')}"
                             PlaceholderText="{x:Bind Loc.GetString('TopicEditor_PlaceholderDesc')}"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="72" />

                    <!-- Icon Selector -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind Loc.GetString('TopicEditor_HeaderIcon')}"
                                   FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <GridView x:Name="IconGridView" SelectionMode="Single" SelectionChanged="IconGridView_SelectionChanged">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="3" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinWidth" Value="48" />
                                    <Setter Property="MinHeight" Value="48" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:TopicIconOption">
                                    <Grid Width="46" Height="46" ToolTipService.ToolTip="{x:Bind Name}">
                                        <Border CornerRadius="8"
                                                BorderThickness="{x:Bind BorderThickness, Mode=OneWay}"
                                                BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                                                Background="{x:Bind BackgroundBrush, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                                      Foreground="{x:Bind ForegroundBrush, Mode=OneWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- Selected Checkmark Badge -->
                                        <Border Visibility="{x:Bind BadgeVisibility, Mode=OneWay}"
                                                Width="16" Height="16" CornerRadius="8"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderThickness="1.5"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,-2,-2,0">
                                            <FontIcon Glyph="&#xE73E;" FontSize="9"
                                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
