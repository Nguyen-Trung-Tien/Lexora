<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.VocabularyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dto="using:Lexora.Application.DTOs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="AddWordAccelerator_Invoked" />
        <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="EditWordAccelerator_Invoked" />
        <KeyboardAccelerator Key="Delete" Invoked="DeleteWordAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid RowDefinitions="Auto,Auto,*" Padding="24" RowSpacing="12">
        <!-- Top Action Bar -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
            <!-- Segmented View Switcher -->
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="3">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="BtnViewList" Click="BtnViewList_Click" CornerRadius="6" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C0;" FontSize="13" />
                            <TextBlock Text="Danh sách từ" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnViewUnits" Click="BtnViewUnits_Click" CornerRadius="6" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F1;" FontSize="13" />
                            <TextBlock Text="Unit ngữ cảnh" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <TextBox Grid.Column="1" x:Name="SearchBox" PlaceholderText="Tìm kiếm từ vựng, ngữ nghĩa, phiên âm..."
                     Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay}"
                     TextChanged="SearchBox_TextChanged" CornerRadius="8" />

            <Button Grid.Column="2" Content="+ Add Word" ToolTipService.ToolTip="Thêm từ mới (Ctrl+N)" Style="{ThemeResource AccentButtonStyle}" CornerRadius="8" Padding="14,6" Click="AddWordButton_Click" />

            <DropDownButton Grid.Column="3" Content="Import / Export" CornerRadius="8" Padding="14,6">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Export to JSON" Click="ExportJson_Click" />
                        <MenuFlyoutItem Text="Export to CSV" Click="ExportCsv_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Import from JSON..." Click="ImportJson_Click" />
                        <MenuFlyoutItem Text="Import from CSV..." Click="ImportCsv_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- Filters & Sorting Bar (List Mode Only) -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                      Visibility="{x:Bind ViewModel.IsUnitViewMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,2,0,6">
                <ComboBox x:Name="TopicFilterCombo" PlaceholderText="Unit / Chủ đề" SelectionChanged="TopicFilterCombo_SelectionChanged" Width="160" CornerRadius="6" />
                <ComboBox x:Name="LevelFilterCombo" PlaceholderText="CEFR Level" SelectionChanged="LevelFilterCombo_SelectionChanged" Width="130" CornerRadius="6" />
                <ComboBox x:Name="PosFilterCombo" PlaceholderText="Part of Speech" SelectionChanged="PosFilterCombo_SelectionChanged" Width="140" CornerRadius="6" />
                <ComboBox x:Name="StatusFilterCombo" PlaceholderText="Status" SelectionChanged="StatusFilterCombo_SelectionChanged" Width="140" CornerRadius="6" />
                <ComboBox x:Name="SortCombo" PlaceholderText="Sort by" SelectionChanged="SortCombo_SelectionChanged" Width="150" CornerRadius="6" />
                <Button Content="Reset Filters" Click="ResetFiltersButton_Click" CornerRadius="6" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" Margin="8,0,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Master-Detail Content (List View) -->
        <Grid Grid.Row="2" ColumnDefinitions="380,*" ColumnSpacing="20"
              Visibility="{x:Bind ViewModel.IsUnitViewMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <!-- Left: Word List -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid RowDefinitions="Auto,*">
                    <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                        <TextBlock Text="Vocabulary" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Words.Count, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <!-- ProgressRing Loading State -->
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                      Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center" />

                        <!-- Empty State -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="24"
                                    Visibility="{x:Bind ViewModel.Words.Count, Mode=OneWay, Converter={StaticResource IntZeroToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE721;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="No words found" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Try adjusting your filters or search query." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <Button Content="Reset Filters" HorizontalAlignment="Center" Margin="0,6,0,0" Click="ResetFiltersButton_Click" />
                        </StackPanel>

                        <ListView ItemsSource="{x:Bind ViewModel.Words, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedWord, Mode=TwoWay}"
                                  Visibility="{x:Bind ViewModel.Words.Count, Mode=OneWay, Converter={StaticResource IntToVisibilityConverter}}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="dto:WordDto">
                                    <Grid Padding="8,10" ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Term}" FontWeight="Bold" FontSize="15" />
                                                <Border Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{x:Bind PrimaryPartOfSpeech}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Visibility="{x:Bind LearningStatus, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <TextBlock Text="{x:Bind LearningStatus}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind PhoneticUk}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="•" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind Confidence}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="% acc" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="-6,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Quick audio speaker -->
                                        <Button Grid.Column="1" VerticalAlignment="Center" Margin="4,0" Padding="6,4"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="Listen UK pronunciation"
                                                Click="QuickListenButton_Click">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        </Button>

                                        <!-- Level badge -->
                                        <Border Grid.Column="2" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{x:Bind Level}" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: Word Detail -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- Detail Empty State -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" Padding="40"
                                    Visibility="{x:Bind ViewModel.SelectedWord, Mode=OneWay, Converter={StaticResource InverseNullToVisibilityConverter}}">
                            <Border Width="64" Height="64" CornerRadius="16" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="8" HorizontalAlignment="Center" Opacity="0.85">
                                <Image Source="ms-appx:///Assets/brand/lexora-icon-only.png" Width="48" Height="48" />
                            </Border>
                            <TextBlock Text="Select a Word" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Select any vocabulary item on the left list to inspect full definitions, examples, CEFR level, and listen to pronunciation audio."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" MaxWidth="360" />
                        </StackPanel>

                        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.SelectedWord, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                        <!-- Term, Pronunciation & Actions -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.SelectedWord.Term, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" FontSize="32" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <!-- UK Audio Button -->
                                    <Button Padding="8,4" Click="PlayUkAudio_Click" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Text="UK" FontWeight="Bold" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedWord.PhoneticUk, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- US Audio Button -->
                                    <Button Padding="8,4" Click="PlayUsAudio_Click" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <TextBlock Text="US" FontWeight="Bold" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedWord.PhoneticUs, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Test, Edit & Delete Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedWord.Level, Mode=OneWay}" Foreground="White" FontWeight="Bold" />
                                </Border>
                                <Button Click="TestThisWordButton_Click" ToolTipService.ToolTip="Kiểm tra từ này trong bài test" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE765;" FontSize="13" />
                                        <TextBlock Text="Kiểm tra" />
                                    </StackPanel>
                                </Button>
                                <Button Click="EditWordButton_Click" ToolTipService.ToolTip="Chỉnh sửa từ vựng (Ctrl+E)" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                        <TextBlock Text="Sửa" />
                                    </StackPanel>
                                </Button>
                                <Button Foreground="{ThemeResource SystemFillColorCriticalBrush}" Click="DeleteWordButton_Click" ToolTipService.ToolTip="Xóa từ vựng (Delete)" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        <TextBlock Text="Xóa" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Topic & Exam Badges -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedWord.Topics, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="{Binding}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedWord.ExamTags, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="{Binding}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <MenuFlyoutSeparator />

                        <!-- Meanings List -->
                        <TextBlock Text="Definitions &amp; Explanations" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedWord.Meanings, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dto:WordMeaningDto">
                                    <Border Margin="0,0,0,16" Padding="16" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" CornerRadius="8">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{x:Bind PartOfSpeech}" FontSize="11" Foreground="White" FontWeight="Bold" />
                                                </Border>
                                                <TextBlock Text="{x:Bind DefinitionVi}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Text="{x:Bind DefinitionEn}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                                            <TextBlock Text="{x:Bind Explanation}" FontStyle="Italic" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                            <!-- Examples -->
                                            <TextBlock Text="Contextual Examples:" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                                            <ItemsControl ItemsSource="{x:Bind Examples}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="dto:ExampleSentenceDto">
                                                        <Border Margin="0,2,0,4" Padding="10,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{x:Bind SentenceEn}" FontWeight="SemiBold" FontSize="13" />
                                                                <TextBlock Text="{x:Bind SentenceVi}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Notes Section (if any) -->
                        <Border Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" CornerRadius="8" Padding="12"
                                Visibility="{x:Bind ViewModel.SelectedWord.Notes, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="📝 Notes &amp; Collocations" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedWord.Notes, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Quick Memory Rating -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                            <Button Style="{ThemeResource AccentButtonStyle}" Click="RememberedButton_Click" CornerRadius="6" Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE73E;" FontSize="13" />
                                    <TextBlock Text="Nhớ (Remembered)" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Click="NotRememberedButton_Click" CornerRadius="6" Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="Chưa nhớ (Not Remembered)" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Context Units View -->
        <Grid Grid.Row="2"
              Visibility="{x:Bind ViewModel.IsUnitViewMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Phân chia Từ vựng theo Unit Ngữ cảnh" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                            <TextBlock Text="Học từ theo ngữ cảnh thực tế (Chủ đề, Tình huống, Kỳ thi), theo dõi độ thành thạo và làm bài kiểm tra theo từng Unit."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8F1;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FilteredContextUnits.Count, Mode=OneWay}" FontWeight="Bold" />
                                <TextBlock Text="Units" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="40"
                                Visibility="{x:Bind ViewModel.FilteredContextUnits.Count, Mode=OneWay, Converter={StaticResource IntZeroToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE8F1;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Chưa có Unit ngữ cảnh nào phù hợp" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Hãy thêm từ vựng hoặc điều chỉnh từ khóa tìm kiếm để xem các Unit ngữ cảnh." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Cards Grid -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredContextUnits, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.FilteredContextUnits.Count, Mode=OneWay, Converter={StaticResource IntToVisibilityConverter}}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout Orientation="Horizontal" MinItemWidth="340" MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="dto:ContextUnitDto">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="18">
                                    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
                                        <!-- Header: Icon, Name, Word Count Badge -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border Width="40" Height="40" CornerRadius="8"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="18"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Description}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" MaxLines="2" />
                                            </StackPanel>

                                            <Border Grid.Column="2" VerticalAlignment="Top"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{x:Bind TotalWords}" FontWeight="Bold" FontSize="12" />
                                                    <TextBlock Text="từ" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Mastery Stats & Progress Bar -->
                                        <StackPanel Grid.Row="1" Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Độ thành thạo" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind MasteryPercentage}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Grid>
                                            <ProgressBar Value="{x:Bind MasteryPercentage}" Maximum="100" Height="6" CornerRadius="3" />
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                    <TextBlock Text="{x:Bind RememberedWords}" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                    <TextBlock Text="đã thuộc" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                    <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                    <TextBlock Text="{x:Bind NotRememberedWords}" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                    <TextBlock Text="cần ôn" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <MenuFlyoutSeparator Grid.Row="2" Margin="0,-4" />

                                        <!-- Actions: View Words & Test Unit -->
                                        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Button HorizontalAlignment="Stretch" Click="ViewUnitWords_Click" Tag="{x:Bind}" CornerRadius="6" Padding="8,7">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8C0;" FontSize="13" />
                                                    <TextBlock Text="Xem từ" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Style="{ThemeResource AccentButtonStyle}"
                                                    HorizontalAlignment="Stretch" Click="TestUnit_Click" Tag="{x:Bind}" CornerRadius="6" Padding="8,7">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE765;" FontSize="13" />
                                                    <TextBlock Text="Kiểm tra" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
