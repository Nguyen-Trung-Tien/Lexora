<?xml version="1.0" encoding="utf-8" ?>
<Page
    UseLayoutRounding="True"
    x:Class="Lexora.Presentation.Views.MemoryTips.MemoryTipsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dtos="using:Lexora.Application.DTOs.MemoryTips"
    xmlns:services="using:Lexora.Presentation.Services"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*" Padding="24" RowSpacing="16">
        <ProgressBar Grid.Row="0"
                     IsIndeterminate="True"
                     VerticalAlignment="Bottom"
                     Canvas.ZIndex="10"
                     Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        
        <!-- Row 0: Top Command Bar / Header Area -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                
                <!-- Left: Page Title & Subtitle -->
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <FontIcon Glyph="&#xE8D7;" FontSize="18"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText" Text="{x:Bind Loc.GetString('MemoryTips_Title')}" FontWeight="Bold" FontSize="18" />
                        <TextBlock x:Name="PageSubtitleText" Text="{x:Bind Loc.GetString('MemoryTips_Subtitle')}"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: View Mode Switcher & Primary Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- View Mode Switcher Segmented Control -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <Button x:Name="BtnViewSplit"
                                    Click="BtnViewSplit_Click"
                                    CornerRadius="{ThemeResource ControlCornerRadius}" Padding="10,5"
                                    ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_TooltipSplit')}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C0;" FontSize="12" />
                                    <TextBlock x:Name="TextViewSplit" Text="{x:Bind Loc.GetString('MemoryTips_ViewSplit')}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnViewGrid"
                                    Click="BtnViewGrid_Click"
                                    CornerRadius="{ThemeResource ControlCornerRadius}" Padding="10,5"
                                    ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_TooltipGrid')}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE80A;" FontSize="12" />
                                    <TextBlock x:Name="TextViewGrid" Text="{x:Bind Loc.GetString('MemoryTips_ViewGrid')}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Width="1" Height="22" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" />

                    <!-- Add Tip Button -->
                    <Button x:Name="BtnAddTip" Click="BtnAddTip_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12.5" />
                            <TextBlock x:Name="TextAddTip" Text="{x:Bind Loc.GetString('MemoryTips_AddButton')}" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <!-- Refresh Button -->
                    <Button x:Name="BtnRefresh" Click="BtnRefresh_Click"
                            Width="34" Height="34" Padding="0" CornerRadius="{ThemeResource ControlCornerRadius}"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Action_Refresh')}">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                    </Button>
                </StackPanel>
        </Grid>

        <!-- Row 1: Unified Search, Quick Filter Chips & Dropdowns Bar -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Padding="14,10">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                
                <!-- Search Box -->
                <TextBox x:Name="SearchBox" Grid.Column="0"
                         MinWidth="180" MaxWidth="280" HorizontalAlignment="Stretch"
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{x:Bind Loc.GetString('MemoryTips_SearchPlaceholder')}" />

                <Border Grid.Column="1" Width="1" Height="20" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" />

                <!-- Quick Filter Chips (Pill Buttons) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="ChipFilterAll"
                            Click="PillFilterAll_Click"
                            CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8D2;" FontSize="11" />
                            <TextBlock x:Name="TextFilterAll" Text="{x:Bind Loc.GetString('MemoryTips_FilterAll')}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ChipFilterPinned"
                            Click="PillFilterPinned_Click"
                            CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE840;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="TextFilterPinned" Text="{x:Bind Loc.GetString('MemoryTips_FilterPinned')}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ChipFilterTraps"
                            Click="PillFilterTraps_Click"
                            CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock x:Name="TextFilterTraps" Text="{x:Bind Loc.GetString('MemoryTips_FilterTraps')}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Dropdowns, Reset, and Total Count -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Category ComboBox -->
                    <ComboBox x:Name="CategoryFilterComboBox"
                              MinWidth="120"
                              SelectedIndex="{x:Bind ViewModel.SelectedCategoryIndex, Mode=TwoWay}">
                        <ComboBoxItem x:Name="ComboCatAll" Content="{x:Bind Loc.GetString('MemoryTips_CategoryAll')}" />
                        <ComboBoxItem x:Name="ComboCatVocab" Content="{x:Bind Loc.GetString('TipCategory_Vocabulary')}" />
                        <ComboBoxItem x:Name="ComboCatGrammar" Content="{x:Bind Loc.GetString('TipCategory_Grammar')}" />
                        <ComboBoxItem x:Name="ComboCatTense" Content="{x:Bind Loc.GetString('TipCategory_Tenses')}" />
                        <ComboBoxItem x:Name="ComboCatExpr" Content="{x:Bind Loc.GetString('TipCategory_Expressions')}" />
                        <ComboBoxItem x:Name="ComboCatExam" Content="{x:Bind Loc.GetString('TipCategory_ExamStrategy')}" />
                        <ComboBoxItem x:Name="ComboCatPronounce" Content="{x:Bind Loc.GetString('TipCategory_General')}" />
                    </ComboBox>

                    <!-- Technique ComboBox -->
                    <ComboBox x:Name="TechniqueFilterComboBox"
                              MinWidth="135"
                              SelectedIndex="{x:Bind ViewModel.SelectedTechniqueIndex, Mode=TwoWay}">
                        <ComboBoxItem x:Name="ComboTechAll" Content="{x:Bind Loc.GetString('MemoryTips_TechniqueAll')}" />
                        <ComboBoxItem x:Name="ComboTechAcrostic" Content="{x:Bind Loc.GetString('MnemonicTechnique_Acrostic')}" />
                        <ComboBoxItem x:Name="ComboTechRhyme" Content="{x:Bind Loc.GetString('MnemonicTechnique_RhymeAndRhythm')}" />
                        <ComboBoxItem x:Name="ComboTechVisual" Content="{x:Bind Loc.GetString('MnemonicTechnique_VisualImagery')}" />
                        <ComboBoxItem x:Name="ComboTechStory" Content="{x:Bind Loc.GetString('MnemonicTechnique_Storytelling')}" />
                        <ComboBoxItem x:Name="ComboTechKeyword" Content="{x:Bind Loc.GetString('MnemonicTechnique_SoundAlike')}" />
                        <ComboBoxItem x:Name="ComboTechContrast" Content="{x:Bind Loc.GetString('MnemonicTechnique_Etymology')}" />
                        <ComboBoxItem x:Name="ComboTechChunking" Content="{x:Bind Loc.GetString('MnemonicTechnique_EliminationRule')}" />
                        <ComboBoxItem x:Name="ComboTechOther" Content="{x:Bind Loc.GetString('MnemonicTechnique_Other')}" />
                    </ComboBox>

                    <!-- Exam Target ComboBox -->
                    <ComboBox x:Name="ExamFilterComboBox"
                              MinWidth="105"
                              SelectedIndex="{x:Bind ViewModel.SelectedExamTargetIndex, Mode=TwoWay}">
                        <ComboBoxItem x:Name="ComboExamAll" Content="{x:Bind Loc.GetString('MemoryTips_ExamAll')}" />
                        <ComboBoxItem Content="TOEIC" />
                        <ComboBoxItem Content="IELTS" />
                        <ComboBoxItem Content="VSTEP" />
                    </ComboBox>

                    <!-- Reset Filters Button -->
                    <Button x:Name="BtnResetFilters"
                            Command="{x:Bind ViewModel.ResetFiltersCommand}"
                            IsEnabled="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay}"
                            CornerRadius="{ThemeResource ControlCornerRadius}" Padding="10,6"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_ResetFilters')}">
                        <FontIcon Glyph="&#xE777;" FontSize="12" />
                    </Button>

                    <!-- Total Count Badge -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.FilteredTotalCount, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="TextTipsCountSuffix" Text="{x:Bind Loc.GetString('MemoryTips_TipsCount')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: Main Content Area -->
        <Grid Grid.Row="2">

            <!-- ======================================================== -->
            <!-- MODE 1: SPLIT VIEW (Master-Detail)                       -->
            <!-- ======================================================== -->
            <Grid Visibility="{x:Bind ViewModel.IsSplitViewMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                  ColumnDefinitions="360,*"
                  ColumnSpacing="16">
                
                <!-- Left Column: Searchable List & Pagination -->
                <Border Grid.Column="0"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid RowDefinitions="*,Auto">
                        
                        <!-- List of Memory Tips -->
                        <ListView x:Name="TipsListView"
                                  Grid.Row="0"
                                  Padding="12,10,12,12"
                                  ItemsSource="{x:Bind ViewModel.Tips, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedTip, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  SelectionChanged="TipsListView_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="dtos:MemoryTipDto">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                                            Padding="12,10"
                                            Margin="0,3,0,3">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                            <!-- Row 0: Badges & Single Pin Button (NO duplicate icon!) -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{x:Bind services:LocalizationHelper.FormatTipCategory(Category)}"
                                                                   FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    </Border>
                                                    <Border Visibility="{x:Bind HasExamTarget, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{x:Bind ExamTargetLabel}" FontSize="10.5" FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Single Pin Toggle Button -->
                                                <Button Grid.Column="1" Click="OnItemPinClick"
                                                        Tag="{x:Bind}"
                                                        Width="28" Height="28" Padding="0" CornerRadius="{ThemeResource ControlCornerRadius}"
                                                        Style="{ThemeResource SubtleButtonStyle}"
                                                        ToolTipService.ToolTip="{x:Bind services:LocalizationHelper.FormatPinTooltip(IsPinned), Mode=OneWay}">
                                                    <FontIcon Glyph="&#xE840;" FontSize="11"
                                                              Foreground="{x:Bind services:LocalizationHelper.FormatPinBrush(IsPinned), Mode=OneWay}" />
                                                </Button>
                                            </Grid>

                                            <!-- Row 1: Title -->
                                            <TextBlock Grid.Row="1"
                                                       Text="{x:Bind Title}"
                                                       FontWeight="Bold" FontSize="13.5"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="2" />

                                            <!-- Row 2: Mnemonic Hook Snippet -->
                                            <Border Grid.Row="2"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="6" Padding="8,5">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                    <FontIcon Glyph="&#xE8D7;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind MnemonicHook}"
                                                               FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Left Empty State -->
                        <StackPanel Grid.Row="0"
                                    Visibility="{x:Bind ViewModel.HasNoTips, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Padding="20">
                            <FontIcon Glyph="&#xE8D7;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind Loc.GetString('MemoryTips_EmptyTitle')}"
                                       FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>

                        <!-- Compact Pagination Bar in Left Column -->
                        <Border Grid.Row="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Padding="12,8">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.ItemRangeDisplayInfo, Mode=OneWay}"
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Button Command="{x:Bind ViewModel.FirstPageCommand}"
                                            IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                                            Padding="0" Height="28" Width="28" CornerRadius="{ThemeResource ControlCornerRadius}"
                                            ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_FirstPage')}">
                                        <FontIcon Glyph="&#xE892;" FontSize="11" />
                                    </Button>

                                    <Button Command="{x:Bind ViewModel.PreviousPageCommand}"
                                            IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                                            Padding="0" Height="28" Width="28" CornerRadius="{ThemeResource ControlCornerRadius}"
                                            ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_PrevPage')}">
                                        <FontIcon Glyph="&#xE76B;" FontSize="11" />
                                    </Button>

                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="6"
                                            Padding="8,0" Height="28">
                                        <TextBlock Text="{x:Bind ViewModel.PageDisplayInfo, Mode=OneWay}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>

                                    <Button Command="{x:Bind ViewModel.NextPageCommand}"
                                            IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                                            Padding="0" Height="28" Width="28" CornerRadius="{ThemeResource ControlCornerRadius}"
                                            ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_NextPage')}">
                                        <FontIcon Glyph="&#xE76C;" FontSize="11" />
                                    </Button>

                                    <Button Command="{x:Bind ViewModel.LastPageCommand}"
                                            IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                                            Padding="0" Height="28" Width="28" CornerRadius="{ThemeResource ControlCornerRadius}"
                                            ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_LastPage')}">
                                        <FontIcon Glyph="&#xE893;" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Column: Detail Inspector Workspace (Widescreen Optimized) -->
                <ScrollViewer Grid.Column="1" Padding="28,20,28,24"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <!-- Status InfoBar inside detail pane if active -->
                        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasSelectedTip, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            
                            <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                                     Severity="{x:Bind GetInfoBarSeverity(ViewModel.IsErrorStatus), Mode=OneWay}"
                                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                     IsClosable="True" />

                            <!-- Header Card: Title, Badges, Action Toolbar -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="22,18">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="14">
                                    <!-- Row 0: Badges & Action Buttons -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,4">
                                                <TextBlock Text="{x:Bind services:LocalizationHelper.FormatTipCategory(ViewModel.SelectedTip.Category), Mode=OneWay}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>

                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,4">
                                                <TextBlock Text="{x:Bind services:LocalizationHelper.FormatMnemonicTechnique(ViewModel.SelectedTip.Technique), Mode=OneWay}"
                                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>

                                            <Border Visibility="{x:Bind ViewModel.SelectedTip.HasExamTarget, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,4">
                                                <TextBlock Text="{x:Bind ViewModel.SelectedTip.ExamTargetLabel, Mode=OneWay}"
                                                           FontSize="12" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Action Buttons Toolbar -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <!-- Copy Hook Button -->
                                            <Button x:Name="BtnDetailCopyHook" Click="OnDetailCopyHookClick"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12,6"
                                                    ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_CopyHook')}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                                    <TextBlock Text="{x:Bind Loc.GetString('MemoryTips_CopyHook')}" FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Pin/Unpin Toggle Button -->
                                            <Button x:Name="BtnDetailPin" Click="OnDetailPinClick"
                                                    CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12,6"
                                                    ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_Pin')}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE840;" FontSize="13"
                                                              Foreground="{x:Bind services:LocalizationHelper.FormatPinBrush(ViewModel.SelectedTip.IsPinned), Mode=OneWay}" />
                                                    <TextBlock Text="{x:Bind services:LocalizationHelper.FormatPinText(ViewModel.SelectedTip.IsPinned), Mode=OneWay}"
                                                               FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Edit Button -->
                                            <Button x:Name="BtnDetailEdit" Click="OnDetailEditClick"
                                                    CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12,6"
                                                    ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_Edit')}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE70F;" FontSize="12.5" />
                                                    <TextBlock Text="{x:Bind Loc.GetString('MemoryTips_Edit')}" FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Delete Button -->
                                            <Button x:Name="BtnDetailDelete" Click="OnDetailDeleteClick"
                                                    CornerRadius="{ThemeResource ControlCornerRadius}" Padding="10,6"
                                                    ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_Delete')}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 1: Title -->
                                    <TextBlock Grid.Row="1"
                                               Text="{x:Bind ViewModel.SelectedTip.Title, Mode=OneWay}"
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <!-- Section 1: Mnemonic Hook (Hero Highlight Callout) -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    Padding="18,14">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border Width="40" Height="40" CornerRadius="10"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Top">
                                        <FontIcon Glyph="&#xE8D7;" FontSize="18"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="{x:Bind Loc.GetString('MemoryTips_HookLabel')}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedTip.MnemonicHook, Mode=OneWay}"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Section 2: Detailed Explanation -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    Padding="20,16">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8D2;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Loc.GetString('MemoryTips_ExplanationLabel')}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedTip.Explanation, Mode=OneWay}"
                                               FontSize="13.5" LineHeight="22"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Section 3: Application Example (If present) -->
                            <Border Visibility="{x:Bind ViewModel.SelectedTip.HasExample, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    Padding="16,14">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <FontIcon Glyph="&#xE8C4;" FontSize="15"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{x:Bind Loc.GetString('MemoryTips_ExampleLabel')}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedTip.Example, Mode=OneWay}"
                                                   FontSize="13" FontStyle="Italic"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap" LineHeight="20" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Section 4: Common Exam Trap / Watch Out (If present) -->
                            <Border Visibility="{x:Bind ViewModel.SelectedTip.HasCommonTrap, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                    BorderThickness="2,1,1,1"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    Padding="16,14">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Width="32" Height="32" CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            VerticalAlignment="Top">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="15"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{x:Bind Loc.GetString('MemoryTips_TrapLabel')}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedTip.CommonTrap, Mode=OneWay}"
                                                   FontSize="13" FontWeight="Medium"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap" LineHeight="20" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Section 5: Tags (If present) -->
                            <Border Visibility="{x:Bind ViewModel.SelectedTip.HasTags, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    Padding="16,12">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('MemoryTips_TagsLabel')}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedTip.Tags, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Placeholder when nothing is selected -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasSelectedTip, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Margin="0,100,0,0">
                            <Border Width="64" Height="64" CornerRadius="16"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8D7;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{x:Bind Loc.GetString('MemoryTips_NoSelectedTip')}"
                                       FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ======================================================== -->
            <!-- MODE 2: GRID VIEW (Adaptive Responsive Multi-Column)     -->
            <!-- ======================================================== -->
            <Grid Visibility="{x:Bind ViewModel.IsGridViewMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                  RowDefinitions="*,Auto">
                
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,16">
                    <StackPanel Spacing="16">
                        <!-- Status InfoBar -->
                        <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                                 Severity="{x:Bind GetInfoBarSeverity(ViewModel.IsErrorStatus), Mode=OneWay}"
                                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                 IsClosable="True" />

                        <!-- Grid Empty State -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasNoTips, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,64,0,0" Spacing="12">
                            <Border Width="64" Height="64" CornerRadius="16"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8D7;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{x:Bind Loc.GetString('MemoryTips_EmptyTitle')}"
                                       FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind Loc.GetString('MemoryTips_EmptySubtitle')}"
                                       FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- ItemsRepeater with UniformGridLayout (Adaptive 2-3 Columns) -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tips, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="340" MinColumnSpacing="16" MinRowSpacing="16"
                                                   Orientation="Horizontal" ItemsJustification="Start" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="dtos:MemoryTipDto">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="18,16"
                                            HorizontalAlignment="Stretch">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                                            <!-- Row 0: Badges & Single Pin Button (NO duplicate icon!) -->
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                                <Border Grid.Column="0"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                    <TextBlock Text="{x:Bind services:LocalizationHelper.FormatTipCategory(Category)}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Border>
                                                <Border Grid.Column="1"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                    <TextBlock Text="{x:Bind services:LocalizationHelper.FormatMnemonicTechnique(Technique)}" FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <Border Grid.Column="2"
                                                        Visibility="{x:Bind HasExamTarget, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                    <TextBlock Text="{x:Bind ExamTargetLabel}" FontSize="11" FontWeight="Bold" />
                                                </Border>

                                                <!-- Single Pin Toggle Button -->
                                                <Button Grid.Column="4" Click="OnItemPinClick"
                                                        Tag="{x:Bind}"
                                                        Width="30" Height="30" Padding="0" CornerRadius="{ThemeResource ControlCornerRadius}"
                                                        Style="{ThemeResource SubtleButtonStyle}"
                                                        ToolTipService.ToolTip="{x:Bind services:LocalizationHelper.FormatPinTooltip(IsPinned), Mode=OneWay}">
                                                    <FontIcon Glyph="&#xE840;" FontSize="12"
                                                              Foreground="{x:Bind services:LocalizationHelper.FormatPinBrush(IsPinned), Mode=OneWay}" />
                                                </Button>
                                            </Grid>

                                            <!-- Row 1: Title -->
                                            <TextBlock Grid.Row="1"
                                                       Text="{x:Bind Title}"
                                                       FontSize="15" FontWeight="Bold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       TextWrapping="Wrap" />

                                            <!-- Row 2: Mnemonic Hook (Hero Box) -->
                                            <Border Grid.Row="2"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="12,10">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <FontIcon Glyph="&#xE8D7;" FontSize="16"
                                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                              VerticalAlignment="Top" Margin="0,2,0,0" />
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Text="{x:Bind services:LocalizationHelper.GetString('MemoryTips_HookLabel')}"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind MnemonicHook}"
                                                                   FontSize="13.5" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Row 3: Explanation -->
                                            <TextBlock Grid.Row="3"
                                                       Text="{x:Bind Explanation}"
                                                       FontSize="12.5" LineHeight="18"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />

                                            <!-- Row 4: Common Trap (If present) -->
                                            <Border Grid.Row="4"
                                                    Visibility="{x:Bind HasCommonTrap, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Top" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{x:Bind services:LocalizationHelper.GetString('MemoryTips_TrapLabel')}"
                                                                   FontSize="10" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                        <TextBlock Text="{x:Bind CommonTrap}" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Row 5: Action Buttons (Copy Hook, Edit, Delete) -->
                                            <Border Grid.Row="5" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <Button Click="OnCardCopyHookClick" Tag="{x:Bind}"
                                                            Style="{ThemeResource SubtleButtonStyle}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                            <TextBlock Text="{x:Bind services:LocalizationHelper.GetString('MemoryTips_CopyHook')}" FontSize="11.5" />
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Grid.Column="1" Click="OnItemEditClick" Tag="{x:Bind}"
                                                            Width="30" Height="30" Padding="0" CornerRadius="{ThemeResource ControlCornerRadius}" Margin="4,0"
                                                            Style="{ThemeResource SubtleButtonStyle}"
                                                            ToolTipService.ToolTip="{x:Bind services:LocalizationHelper.GetString('MemoryTips_Edit')}">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                                    </Button>

                                                    <Button Grid.Column="2" Click="OnItemDeleteClick" Tag="{x:Bind}"
                                                            Width="30" Height="30" Padding="0" CornerRadius="{ThemeResource ControlCornerRadius}"
                                                            Style="{ThemeResource SubtleButtonStyle}"
                                                            ToolTipService.ToolTip="{x:Bind services:LocalizationHelper.GetString('MemoryTips_Delete')}">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>

                <!-- Grid Mode Bottom Pagination Bar -->
                <Border Grid.Row="1"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="24,10">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <!-- Left: Page Size Selector -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="TextPageSizeLabel" Text="{x:Bind Loc.GetString('MemoryTips_PageSize')}"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <ComboBox x:Name="PageSizeComboBox"
                                      SelectionChanged="PageSizeComboBox_SelectionChanged"
                                      MinWidth="72" Height="32" Padding="8,2" FontSize="12" CornerRadius="6">
                                <ComboBoxItem Content="6" />
                                <ComboBoxItem Content="10" IsSelected="True" />
                                <ComboBoxItem Content="18" />
                                <ComboBoxItem Content="24" />
                            </ComboBox>
                            <TextBlock x:Name="TextPageSizeSuffix" Text="{x:Bind Loc.GetString('MemoryTips_PageSizeSuffix')}"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Center: Item Range Indicator -->
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.ItemRangeDisplayInfo, Mode=OneWay}"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- Right: Navigation Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Command="{x:Bind ViewModel.FirstPageCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                                    Padding="0" Height="32" Width="32" CornerRadius="{ThemeResource ControlCornerRadius}"
                                    ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_FirstPage')}">
                                <FontIcon Glyph="&#xE892;" FontSize="12" />
                            </Button>

                            <Button Command="{x:Bind ViewModel.PreviousPageCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                                    Padding="0" Height="32" Width="32" CornerRadius="{ThemeResource ControlCornerRadius}"
                                    ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_PrevPage')}">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            </Button>

                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="12,0" Height="32" MinWidth="64">
                                <TextBlock Text="{x:Bind ViewModel.PageDisplayInfo, Mode=OneWay}"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>

                            <Button Command="{x:Bind ViewModel.NextPageCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                                    Padding="0" Height="32" Width="32" CornerRadius="{ThemeResource ControlCornerRadius}"
                                    ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_NextPage')}">
                                <FontIcon Glyph="&#xE76C;" FontSize="12" />
                            </Button>

                            <Button Command="{x:Bind ViewModel.LastPageCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                                    Padding="0" Height="32" Width="32" CornerRadius="{ThemeResource ControlCornerRadius}"
                                    ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_LastPage')}">
                                <FontIcon Glyph="&#xE893;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Page>