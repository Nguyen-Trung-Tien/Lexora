<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.MemoryTips.MemoryTipsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dtos="using:Lexora.Application.DTOs.MemoryTips"
    xmlns:views="using:Lexora.Presentation.Views.MemoryTips"
    xmlns:services="using:Lexora.Presentation.Services"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <!-- Top Command Bar / Header Area -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Page Title & Icon -->
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <FontIcon Glyph="&#xE8D7;" FontSize="18"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText" Text="{x:Bind Loc.GetString('MemoryTips_Title')}" FontWeight="Bold" FontSize="18" />
                        <TextBlock x:Name="PageSubtitleText" Text="{x:Bind Loc.GetString('MemoryTips_Subtitle')}"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="680" />
                    </StackPanel>
                </StackPanel>

                <!-- Statistics Badges (Center) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" VerticalAlignment="Center">
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="StatTotalLabel" Text="{x:Bind Loc.GetString('MemoryTips_StatTotal')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE840;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="StatPinnedLabel" Text="{x:Bind Loc.GetString('MemoryTips_StatPinned')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.PinnedCount, Mode=OneWay}" FontWeight="Bold" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock x:Name="StatTrapsLabel" Text="{x:Bind Loc.GetString('MemoryTips_StatTraps')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TrapCount, Mode=OneWay}" FontWeight="Bold" FontSize="13" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Top Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BtnAddTip" Click="BtnAddTip_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12.5" />
                            <TextBlock x:Name="TextAddTip" Text="{x:Bind Loc.GetString('MemoryTips_AddButton')}" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRefresh" Click="BtnRefresh_Click"
                            Width="34" Height="34" Padding="0" CornerRadius="8"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Action_Refresh')}">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter Bar -->
        <Border Grid.Row="1"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,10">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                <!-- Search Box -->
                <TextBox x:Name="SearchBox" Grid.Column="0"
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{x:Bind Loc.GetString('MemoryTips_SearchPlaceholder')}" />

                <!-- Category ComboBox -->
                <ComboBox x:Name="CategoryFilterComboBox" Grid.Column="1"
                          MinWidth="140"
                          SelectedIndex="{x:Bind ViewModel.SelectedCategoryIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Name="ComboCatAll" Content="{x:Bind Loc.GetString('MemoryTips_CategoryAll')}" />
                    <ComboBoxItem x:Name="ComboCatVocab" Content="{x:Bind Loc.GetString('TipCategory_Vocabulary')}" />
                    <ComboBoxItem x:Name="ComboCatGrammar" Content="{x:Bind Loc.GetString('TipCategory_Grammar')}" />
                    <ComboBoxItem x:Name="ComboCatTense" Content="{x:Bind Loc.GetString('TipCategory_Tenses')}" />
                    <ComboBoxItem x:Name="ComboCatExpr" Content="{x:Bind Loc.GetString('TipCategory_Expressions')}" />
                    <ComboBoxItem x:Name="ComboCatExam" Content="{x:Bind Loc.GetString('TipCategory_ExamStrategy')}" />
                    <ComboBoxItem x:Name="ComboCatPronounce" Content="{x:Bind Loc.GetString('TipCategory_General')}" />
                </ComboBox>

                <!-- Technique ComboBox -->
                <ComboBox x:Name="TechniqueFilterComboBox" Grid.Column="2"
                          MinWidth="160"
                          SelectedIndex="{x:Bind ViewModel.SelectedTechniqueIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Name="ComboTechAll" Content="{x:Bind Loc.GetString('MemoryTips_TechniqueAll')}" />
                    <ComboBoxItem x:Name="ComboTechAcrostic" Content="{x:Bind Loc.GetString('MnemonicTechnique_Acrostic')}" />
                    <ComboBoxItem x:Name="ComboTechRhyme" Content="{x:Bind Loc.GetString('MnemonicTechnique_RhymeAndRhythm')}" />
                    <ComboBoxItem x:Name="ComboTechVisual" Content="{x:Bind Loc.GetString('MnemonicTechnique_VisualImagery')}" />
                    <ComboBoxItem x:Name="ComboTechStory" Content="{x:Bind Loc.GetString('MnemonicTechnique_Storytelling')}" />
                    <ComboBoxItem x:Name="ComboTechKeyword" Content="{x:Bind Loc.GetString('MnemonicTechnique_SoundAlike')}" />
                    <ComboBoxItem x:Name="ComboTechContrast" Content="{x:Bind Loc.GetString('MnemonicTechnique_Etymology')}" />
                    <ComboBoxItem x:Name="ComboTechChunking" Content="{x:Bind Loc.GetString('MnemonicTechnique_EliminationRule')}" />
                    <ComboBoxItem x:Name="ComboTechOther" Content="{x:Bind Loc.GetString('MnemonicTechnique_Other')}" />
                </ComboBox>

                <!-- Exam Target ComboBox -->
                <ComboBox x:Name="ExamFilterComboBox" Grid.Column="3"
                          MinWidth="120"
                          SelectedIndex="{x:Bind ViewModel.SelectedExamTargetIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Name="ComboExamAll" Content="{x:Bind Loc.GetString('MemoryTips_ExamAll')}" />
                    <ComboBoxItem Content="TOEIC" />
                    <ComboBoxItem Content="IELTS" />
                    <ComboBoxItem Content="VSTEP" />
                </ComboBox>

                <!-- Only Pinned Toggle -->
                <ToggleButton x:Name="PinnedFilterToggle" Grid.Column="4"
                              IsChecked="{x:Bind ViewModel.OnlyPinnedFilter, Mode=TwoWay}"
                              CornerRadius="8" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE840;" FontSize="12" />
                        <TextBlock x:Name="TextOnlyPinned" Text="{x:Bind Loc.GetString('MemoryTips_OnlyPinned')}" FontSize="12" />
                    </StackPanel>
                </ToggleButton>

                <!-- Reset Button -->
                <Button x:Name="BtnResetFilters" Grid.Column="5"
                        Command="{x:Bind ViewModel.ResetFiltersCommand}"
                        CornerRadius="8" Padding="10,6">
                    <FontIcon Glyph="&#xE777;" FontSize="12" ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_ResetFilters')}" />
                </Button>
            </Grid>
        </Border>

        <!-- Main Workspace: Card Grid with ItemsRepeater + UniformGridLayout -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,20">
            <StackPanel Spacing="16">
                <!-- Status Message Banner if present -->
                <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                         Severity="{x:Bind GetInfoBarSeverity(ViewModel.IsErrorStatus), Mode=OneWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         IsClosable="True" />

                <!-- Empty State -->
                <StackPanel Visibility="{x:Bind ViewModel.HasNoTips, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,64,0,0" Spacing="12">
                    <Border Width="64" Height="64" CornerRadius="16"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8D7;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="EmptyTitleText" Text="{x:Bind Loc.GetString('MemoryTips_EmptyTitle')}"
                               FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptySubtitleText" Text="{x:Bind Loc.GetString('MemoryTips_EmptySubtitle')}"
                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" TextWrapping="Wrap" />
                </StackPanel>

                <!-- ItemsRepeater Stack Layout (Dynamic natural height per card, ZERO text clipping!) -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tips, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="16" />
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="dtos:MemoryTipDto">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20,18"
                                    Margin="0,0,0,4"
                                    MaxWidth="1040"
                                    HorizontalAlignment="Stretch">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">

                                    <!-- Row 0: Category / Technique Badges & Actions -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                                        <!-- Category Badge -->
                                        <Border Grid.Column="0"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="{x:Bind services:LocalizationHelper.FormatTipCategory(Category)}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>

                                        <!-- Technique Badge -->
                                        <Border Grid.Column="1"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="{x:Bind services:LocalizationHelper.FormatMnemonicTechnique(Technique)}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>

                                        <!-- Exam Target Badge (Optional) -->
                                        <Border Grid.Column="2"
                                                Visibility="{x:Bind HasExamTarget, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="{x:Bind ExamTargetLabel}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </Border>

                                        <!-- Pinned Visual Indicator -->
                                        <FontIcon Grid.Column="3"
                                                  Glyph="&#xE840;" FontSize="13"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  HorizontalAlignment="Right" Margin="0,0,8,0"
                                                  Visibility="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <!-- Pin/Unpin Action Button -->
                                        <Button Grid.Column="4" Click="OnItemPinClick"
                                                Tag="{x:Bind}"
                                                Width="30" Height="30" Padding="0" CornerRadius="6"
                                                Margin="0,0,4,0"
                                                Style="{ThemeResource SubtleButtonStyle}"
                                                ToolTipService.ToolTip="{x:Bind services:LocalizationHelper.GetString('MemoryTips_Pin')}">
                                            <FontIcon Glyph="&#xE840;" FontSize="12" />
                                        </Button>

                                        <!-- Context Menu Dropdown (Edit / Delete) -->
                                        <DropDownButton Grid.Column="5"
                                                        Width="30" Height="30" Padding="0" CornerRadius="6"
                                                        Style="{ThemeResource SubtleButtonStyle}">
                                            <FontIcon Glyph="&#xE712;" FontSize="12" />
                                            <DropDownButton.Flyout>
                                                <MenuFlyout Placement="Bottom">
                                                    <MenuFlyoutItem Text="{x:Bind services:LocalizationHelper.GetString('MemoryTips_Edit')}" Tag="{x:Bind}" Click="OnItemEditClick">
                                                        <MenuFlyoutItem.Icon>
                                                             <FontIcon Glyph="&#xE70F;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="{x:Bind services:LocalizationHelper.GetString('MemoryTips_Delete')}" Tag="{x:Bind}" Click="OnItemDeleteClick">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                    </Grid>

                                    <!-- Row 1: Title -->
                                    <TextBlock Grid.Row="1"
                                               Text="{x:Bind Title}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />

                                    <!-- Row 2: Mnemonic Hook / Recall Anchor (High-yield Callout) -->
                                    <Border Grid.Row="2"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,10">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <FontIcon Glyph="&#xE8D7;" FontSize="16"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{x:Bind services:LocalizationHelper.GetString('MemoryTips_HookLabel')}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind MnemonicHook}"
                                                           FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Row 3: Detailed Explanation -->
                                    <TextBlock Grid.Row="3"
                                               Text="{x:Bind Explanation}"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="20" />

                                    <!-- Row 4: Application Example (If present) -->
                                    <Border Grid.Row="4"
                                            Visibility="{x:Bind HasExample, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <FontIcon Glyph="&#xE8C4;" FontSize="12"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind services:LocalizationHelper.GetString('MemoryTips_ExampleLabel')}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind Example}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           TextWrapping="Wrap" FontStyle="Italic" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Row 5: Common Exam Trap / Watch Out (If present) -->
                                    <Border Grid.Row="5"
                                            Visibility="{x:Bind HasCommonTrap, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                            BorderThickness="1.5,1,1,1"
                                            CornerRadius="6"
                                            Padding="10,8">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="13"
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                      VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind services:LocalizationHelper.GetString('MemoryTips_TrapLabel')}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                <TextBlock Text="{x:Bind CommonTrap}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Row 6: Tags (If present) -->
                                    <Border Grid.Row="6"
                                            Visibility="{x:Bind HasTags, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Margin="0,2,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8EC;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind Tags}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- Pagination Bar (Row 3) -->
        <Border Grid.Row="3"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,10">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <!-- Left: Page Size Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="TextPageSizeLabel" Text="{x:Bind Loc.GetString('MemoryTips_PageSize')}"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <ComboBox x:Name="PageSizeComboBox"
                              SelectionChanged="PageSizeComboBox_SelectionChanged"
                              MinWidth="72" Height="32" Padding="8,2" FontSize="12" CornerRadius="6">
                        <ComboBoxItem Content="6" IsSelected="True" />
                        <ComboBoxItem Content="9" />
                        <ComboBoxItem Content="12" />
                        <ComboBoxItem Content="18" />
                        <ComboBoxItem Content="24" />
                    </ComboBox>
                    <TextBlock x:Name="TextPageSizeSuffix" Text="{x:Bind Loc.GetString('MemoryTips_PageSizeSuffix')}"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Item Range Indicator -->
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.ItemRangeDisplayInfo, Mode=OneWay}"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Right: Navigation Buttons & Page Info -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- First Page -->
                    <Button x:Name="BtnFirstPage"
                            Command="{x:Bind ViewModel.FirstPageCommand}"
                            IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                            Padding="0" Height="32" Width="32" CornerRadius="6"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_FirstPage')}">
                        <FontIcon Glyph="&#xE892;" FontSize="12" />
                    </Button>

                    <!-- Previous Page -->
                    <Button x:Name="BtnPrevPage"
                            Command="{x:Bind ViewModel.PreviousPageCommand}"
                            IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                            Padding="0" Height="32" Width="32" CornerRadius="6"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_PrevPage')}">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                    </Button>

                    <!-- Page Display Badge -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12,0" Height="32" MinWidth="64">
                        <TextBlock Text="{x:Bind ViewModel.PageDisplayInfo, Mode=OneWay}"
                                   FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>

                    <!-- Next Page -->
                    <Button x:Name="BtnNextPage"
                            Command="{x:Bind ViewModel.NextPageCommand}"
                            IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                            Padding="0" Height="32" Width="32" CornerRadius="6"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_NextPage')}">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                    </Button>

                    <!-- Last Page -->
                    <Button x:Name="BtnLastPage"
                            Command="{x:Bind ViewModel.LastPageCommand}"
                            IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                            Padding="0" Height="32" Width="32" CornerRadius="6"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('MemoryTips_LastPage')}">
                        <FontIcon Glyph="&#xE893;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
