<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.ReleaseNotesLogDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    DefaultButton="Primary"
    mc:Ignorable="d"
    CornerRadius="16">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">740</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">420</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <FontIcon Glyph="&#xE81C;" FontSize="16"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10" Margin="0,2,0,0" HorizontalAlignment="Stretch">
        <!-- Row 0: Subtitle Header -->
        <TextBlock Grid.Row="0" x:Name="DialogSubtitleText"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2" />

        <!-- Row 1: Version Selector Strip -->
        <Border Grid.Row="1"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="12,8"
                HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE71D;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="SelectVersionLabel" Text="Select version:" FontWeight="SemiBold" FontSize="12.5"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <ComboBox Grid.Column="1" x:Name="VersionComboBox"
                          HorizontalAlignment="Stretch"
                          CornerRadius="8"
                          SelectionChanged="VersionComboBox_SelectionChanged" />
            </Grid>
        </Border>

        <!-- Row 2: Selected Version Overview Header Card -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,10"
                HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="ReleaseTitleText"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Border x:Name="CurrentVersionBadge"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="6" Padding="6,2" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="CurrentVersionBadgeText" Text="Current"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                       FontSize="10.5" FontWeight="Bold" />
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="8,3"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE787;" FontSize="10.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="ReleaseDateText" FontSize="11" FontWeight="Medium"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="ReleaseSummaryText"
                           FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" LineHeight="17" LineStackingStrategy="MaxHeight" />
            </StackPanel>
        </Border>

        <!-- Row 3: Markdown Release Notes Container -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,12"
                HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE70F;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="NotesContentLabel" Text="Features &amp; Improvements" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NotesContainer" Spacing="3" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Row 4: Footer Note -->
        <Border Grid.Row="4"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10,6"
                HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE753;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="OfflineNoteText" Grid.Column="1"
                           Text="All release notes are stored offline directly within Lexora."
                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
