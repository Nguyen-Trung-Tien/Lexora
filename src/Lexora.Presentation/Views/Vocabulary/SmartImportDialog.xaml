<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.Vocabulary.SmartImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Lexora.Presentation.Converters"
    mc:Ignorable="d"
    UseLayoutRounding="True" CornerRadius="{ThemeResource OverlayCornerRadius}">

    <ContentDialog.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <x:Double x:Key="ContentDialogMaxWidth">880</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="{ThemeResource ControlCornerRadius}"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <FontIcon Glyph="&#xE8B5;" FontSize="16"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding}" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <Grid MaxWidth="840" HorizontalAlignment="Stretch" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10" Margin="0,2,0,0">
        <!-- Row 0: Global InfoBar at the top of the dialog -->
        <InfoBar x:Name="DialogInfoBar"
                 IsOpen="False"
                 IsClosable="True"
                 HorizontalAlignment="Stretch"
                 Margin="0,0,0,2" />

        <!-- Row 1: Step Breadcrumbs Header -->
        <Border Grid.Row="1"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto,*,Auto,*">
                <!-- Step 1 Indicator -->
                <StackPanel x:Name="Step1Badge" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Border x:Name="Step1NumberBorder" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Step1Text" Text="Nguồn dữ liệu" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>

                <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="4,0" />

                <!-- Step 2 Indicator -->
                <StackPanel x:Name="Step2Badge" Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Border x:Name="Step2NumberBorder" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="Step2NumberText" Text="2" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Step2Text" Text="Xem trước &amp; Kiểm tra" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="4,0" />

                <!-- Step 3 Indicator -->
                <StackPanel x:Name="Step3Badge" Grid.Column="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Border x:Name="Step3NumberBorder" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="Step3NumberText" Text="3" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Step3Text" Text="Kết quả" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: Dynamic Content Body -->
        <Grid Grid.Row="2">
            <!-- ================= STEP 1: SOURCE SELECTION ================= -->
            <StackPanel x:Name="PanelStep1" Spacing="12" Visibility="Visible">
                <!-- Subtitle / Info note -->
                <TextBlock x:Name="SubtitleText"
                           TextWrapping="Wrap"
                           FontSize="12.5"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Input Method Selector (Segmented look) -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button x:Name="BtnModeFile"
                            HorizontalAlignment="Stretch"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="12,8"
                            Click="BtnModeFile_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xED43;" FontSize="15" />
                            <TextBlock x:Name="TextModeFile" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnModePaste"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="12,8"
                            Click="BtnModePaste_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE77F;" FontSize="15" />
                            <TextBlock x:Name="TextModePaste" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Input Area Panel -->
                <Grid>
                    <!-- Mode 1: File Selection -->
                    <StackPanel x:Name="PanelFile" Spacing="10">
                        <Border x:Name="DropZoneBorder"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Padding="20,18"
                                AllowDrop="True"
                                DragOver="DropZone_DragOver"
                                DragLeave="DropZone_DragLeave"
                                Drop="DropZone_Drop">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8E5;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                <Button x:Name="BtnBrowseFile"
                                        HorizontalAlignment="Center"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Padding="16,8"
                                        Click="BtnBrowseFile_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                                        <TextBlock x:Name="TextBrowseFile" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="TextDropHint"
                                           TextAlignment="Center"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3">
                                        <TextBlock Text="JSON" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3">
                                        <TextBlock Text="CSV" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3">
                                        <TextBlock Text="TXT / TSV" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="≤ 20 MB" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TextSelectedFile"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Mode 2: Paste Text -->
                    <StackPanel x:Name="PanelPaste" Spacing="8" Visibility="Collapsed">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                            <TextBlock x:Name="TextModePasteHeader"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <DropDownButton x:Name="BtnInsertSampleQuick"
                                                Padding="8,4"
                                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                        <TextBlock x:Name="TextInsertSampleQuick" FontSize="11" />
                                    </StackPanel>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem x:Name="MenuSampleJsonQuick" Click="MenuItemSampleJson_Click" />
                                            <MenuFlyoutItem x:Name="MenuSampleCsvQuick" Click="MenuItemSampleCsv_Click" />
                                            <MenuFlyoutItem x:Name="MenuSampleTxtQuick" Click="MenuItemSampleTxt_Click" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <Button x:Name="BtnPasteClipboard"
                                        Padding="8,4"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Click="BtnPasteClipboard_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE77F;" FontSize="12" />
                                        <TextBlock x:Name="TextPasteClipboard" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnClearPaste"
                                        Padding="8,4"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Click="BtnClearPaste_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <TextBlock x:Name="TextClearPasteBtn" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="InputTextBox"
                                 MinHeight="180"
                                 Height="200"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 TextChanged="InputTextBox_TextChanged"
                                 CornerRadius="8"
                                 FontFamily="Consolas, Cascadia Code, Segoe UI"
                                 FontSize="12" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                            <TextBlock x:Name="TextPasteStats"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Detection Badge & Template Button -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                    <!-- Format Detection & Selector DropDownButton -->
                    <DropDownButton x:Name="BtnFormatSelector"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="10,6"
                                    HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon x:Name="IconFormatBadge" Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TextFormatBadge" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="MenuFormatAuto" Text="Tự động nhận diện (Auto-detect)" Click="MenuFormatAuto_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="MenuFormatJson" Text="JSON (.json / AI Prompts)" Click="MenuFormatJson_Click" />
                                <MenuFlyoutItem x:Name="MenuFormatCsv" Text="CSV (.csv / Bảng tính)" Click="MenuFormatCsv_Click" />
                                <MenuFlyoutItem x:Name="MenuFormatTxt" Text="TXT / TSV / Anki / Quizlet" Click="MenuFormatTxt_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Sample Template Button with Menu -->
                    <DropDownButton Grid.Column="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                            <TextBlock x:Name="TextViewSample" FontSize="12" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="MenuItemSampleJson" Text="Mẫu JSON" Click="MenuItemSampleJson_Click" />
                                <MenuFlyoutItem x:Name="MenuItemSampleCsv" Text="Mẫu CSV" Click="MenuItemSampleCsv_Click" />
                                <MenuFlyoutItem x:Name="MenuItemSampleTxt" Text="Mẫu TXT / Anki / Quizlet" Click="MenuItemSampleTxt_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
            </StackPanel>

            <!-- ================= STEP 2: PREVIEW & VALIDATION ================= -->
            <Grid x:Name="PanelStep2" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10" Visibility="Collapsed">
                <!-- Row 0: Metrics Summary Bar -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <!-- Total -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="10,6">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="TextMetricTotalLabel" Text="Tổng số" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TextMetricTotal" Text="0" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- Valid -->
                    <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="10,6">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="TextMetricValidLabel" Text="Hợp lệ" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TextMetricValid" Text="0" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- Duplicates -->
                    <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="10,6">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="TextMetricDuplicatesLabel" Text="Trùng lặp" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TextMetricDuplicates" Text="0" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- Errors -->
                    <Border Grid.Column="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="10,6">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="TextMetricErrorsLabel" Text="Lỗi/Thiếu" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TextMetricErrors" Text="0" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 1: Conflict Strategy Strip -->
                <Border Grid.Row="1"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Padding="12,6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TextConflictTitle"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <RadioButton x:Name="RadioConflictSkip"
                                         IsChecked="True"
                                         FontSize="12"
                                         GroupName="ConflictResolution"
                                         Checked="RadioConflict_Checked" />
                            <RadioButton x:Name="RadioConflictOverwrite"
                                         FontSize="12"
                                         GroupName="ConflictResolution"
                                         Checked="RadioConflict_Checked" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 2: Selection Controls Strip -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkSelectAll"
                              IsChecked="True"
                              Content="Chọn tất cả"
                              FontSize="12"
                              Click="ChkSelectAll_Click" />
                    <Border Grid.Column="2"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,3">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="TextSelectedCounter"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 3: Scrollable Item Cards Preview -->
                <Border Grid.Row="3"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <ListView x:Name="ItemsPreviewListView"
                              Height="285"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,8">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  MinWidth="24"
                                                  VerticalAlignment="Center" />
                                        <Border Grid.Column="1"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RowNumber}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Term}" FontWeight="SemiBold" FontSize="13" />
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="5,1"
                                                        Visibility="{Binding HasPartOfSpeech, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding PartOfSpeech}" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Border>
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="5,1"
                                                        Visibility="{Binding HasCefrLevel, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding CefrLevel}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Pronunciation}"
                                                           FontSize="11"
                                                           FontStyle="Italic"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasPronunciation, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Meaning}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2" />
                                            <TextBlock Text="{Binding ValidationMessage}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                       Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                        Visibility="{Binding HasMetadataRow, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Padding="5,1"
                                                        Visibility="{Binding HasExamType, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE734;" FontSize="9" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{Binding ExamType}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Padding="5,1"
                                                        Visibility="{Binding HasTopic, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE8EC;" FontSize="9" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{Binding TopicName}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding ExampleSentence}"
                                                           FontSize="11"
                                                           FontStyle="Italic"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1"
                                                           Visibility="{Binding HasExample, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Status Pill -->
                                        <Border Grid.Column="3"
                                                Background="{Binding StatusBackgroundBrush}"
                                                BorderBrush="{Binding StatusBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                ToolTipService.ToolTip="{Binding ValidationMessage}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding StatusForegroundBrush}" />
                                        </Border>
                                        <!-- Quick Delete Button -->
                                        <Button Grid.Column="4"
                                                Click="BtnDeletePreviewItem_Click"
                                                Style="{ThemeResource SubtleButtonStyle}"
                                                Padding="6,4"
                                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <!-- ================= STEP 3: SUMMARY & REPORT ================= -->
            <StackPanel x:Name="PanelStep3" Spacing="16" Visibility="Collapsed">
                <!-- Loading State -->
                <StackPanel x:Name="PanelImportProgress" Spacing="14" HorizontalAlignment="Center" Margin="0,30" MaxWidth="440">
                    <ProgressRing Width="48" Height="48" IsActive="True" HorizontalAlignment="Center" />
                    <ProgressBar x:Name="BarImportProgress" HorizontalAlignment="Stretch" Margin="0,4" />
                    <TextBlock x:Name="TextImportProgressMessage"
                               Text="Đang xử lý và lưu vào cơ sở dữ liệu..."
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="BtnCancelImport"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="16,6"
                            Click="BtnCancelImport_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock x:Name="TextCancelImport" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Final Report Card -->
                <StackPanel x:Name="PanelImportReport" Spacing="16" Visibility="Collapsed" Margin="0,10,0,0">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon x:Name="IconReportStatus" Glyph="&#xE73E;" FontSize="42" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TextReportTitle"
                                   Text="Nhập dữ liệu thành công!"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="540"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Result Grid -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Padding="16">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE710;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock x:Name="TextReportAdded" Text="Thêm mới: 0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE777;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock x:Name="TextReportUpdated" Text="Cập nhật: 0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE711;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock x:Name="TextReportSkipped" Text="Bỏ qua: 0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xEA39;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock x:Name="TextReportErrors" Text="Lỗi: 0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================= UNIFIED DIALOG FOOTER BAR ================= -->
        <Border Grid.Row="3"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,2"
                Margin="0,4,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <!-- Left: Contextual Indicators & Pagination -->
                <Grid VerticalAlignment="Center">
                    <!-- Step 1 Left: Data Format Detection Badge -->
                    <StackPanel x:Name="FooterStep1Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon x:Name="FooterFormatIcon" Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="FooterFormatText" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Step 2 Left: Pagination Navigation Strip -->
                    <StackPanel x:Name="FooterStep2Left" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed">
                        <Button x:Name="BtnPreviewFirstPage" Padding="6,5" CornerRadius="{ThemeResource ControlCornerRadius}" Click="BtnPreviewFirstPage_Click">
                            <FontIcon Glyph="&#xE892;" FontSize="11" />
                        </Button>
                        <Button x:Name="BtnPreviewPrevPage" Padding="6,5" CornerRadius="{ThemeResource ControlCornerRadius}" Click="BtnPreviewPrevPage_Click">
                            <FontIcon Glyph="&#xE76B;" FontSize="11" />
                        </Button>
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,4"
                                Margin="4,0">
                            <TextBlock x:Name="TextPreviewPagingInfo" Text="1 - 10 / 10 mục (Trang 1/1)" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Border>
                        <Button x:Name="BtnPreviewNextPage" Padding="6,5" CornerRadius="{ThemeResource ControlCornerRadius}" Click="BtnPreviewNextPage_Click">
                            <FontIcon Glyph="&#xE76C;" FontSize="11" />
                        </Button>
                        <Button x:Name="BtnPreviewLastPage" Padding="6,5" CornerRadius="{ThemeResource ControlCornerRadius}" Click="BtnPreviewLastPage_Click">
                            <FontIcon Glyph="&#xE893;" FontSize="11" />
                        </Button>
                    </StackPanel>

                    <!-- Step 3 Left: Status Summary -->
                    <StackPanel x:Name="FooterStep3Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="FooterStep3StatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Right: Unified Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Back Button: Used in Step 2 to return to Step 1, or in Step 3 to review errors -->
                    <Button x:Name="BtnFooterBack"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="14,8"
                            Visibility="Collapsed"
                            Click="BtnFooterBack_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72B;" FontSize="12" />
                            <TextBlock x:Name="TextFooterBack" Text="Quay lại" />
                        </StackPanel>
                    </Button>

                    <!-- Cancel Button: Always accessible across steps -->
                    <Button x:Name="BtnFooterCancel"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="14,8"
                            Click="BtnFooterCancel_Click">
                        <TextBlock x:Name="TextFooterCancel" Text="Hủy" />
                    </Button>

                    <!-- Step 1 Primary Action: Phân tích & Xem trước -->
                    <Button x:Name="BtnAnalyzeNext"
                            Style="{ThemeResource AccentButtonStyle}"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="18,8"
                            Click="BtnAnalyzeNext_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE721;" FontSize="13" />
                            <TextBlock x:Name="TextAnalyzeNext" Text="Phân tích &amp; Xem trước" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Step 2 Primary Action: Tiến hành nhập / Import Selected (HERO ACTION) -->
                    <Button x:Name="BtnCommitImport"
                            Style="{ThemeResource AccentButtonStyle}"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="18,8"
                            Visibility="Collapsed"
                            Click="BtnCommitImport_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="CommitButtonProgressRing"
                                          Width="14" Height="14"
                                          IsActive="False"
                                          Visibility="Collapsed" />
                            <FontIcon x:Name="IconCommitImport" Glyph="&#xE896;" FontSize="14" />
                            <TextBlock x:Name="TextCommitImport" Text="Tiến hành nhập (0 mục)" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Step 3 Primary Action: Hoàn tất -->
                    <Button x:Name="BtnDone"
                            Style="{ThemeResource AccentButtonStyle}"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="20,8"
                            Visibility="Collapsed"
                            Click="BtnDone_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="13" />
                            <TextBlock x:Name="TextDone" Text="Hoàn tất" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
