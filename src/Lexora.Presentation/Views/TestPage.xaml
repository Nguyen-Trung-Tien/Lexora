<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.TestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dto="using:Lexora.Application.DTOs"
    xmlns:vm="using:Lexora.Presentation.ViewModels"
    xmlns:services="using:Lexora.Presentation.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="32,20" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Loading Ring Overlay -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                          Width="44" Height="44"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Grid.RowSpan="2" Canvas.ZIndex="10" />

            <!-- ========================================== -->
            <!-- 1. SETUP VIEW                              -->
            <!-- ========================================== -->
            <StackPanel Grid.Row="1" Spacing="20"
                        Visibility="{x:Bind ViewModel.IsSetupMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="20" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                
                <!-- Page Title Banner -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="24,18">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                        <Border Width="48" Height="48" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="8" VerticalAlignment="Center">
                            <Image Source="ms-appx:///Assets/brand/lexora-icon-only.png" Width="32" Height="32" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Test_Title')}" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" FontSize="24" />
                            <TextBlock Text="{x:Bind Loc.GetString('Test_Subtitle')}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status InfoBar -->
                <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                         Severity="Informational"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" CornerRadius="8" />

                <!-- 2-Column Responsive Workspace for Test Setup -->
                <Grid ColumnDefinitions="1.15*,1*" ColumnSpacing="18">
                    
                    <!-- Left Column: Choose Test Format -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="22"
                            VerticalAlignment="Stretch">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Loc.GetString('Test_ChooseFormat')}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="{x:Bind Loc.GetString('Test_ChooseFormatDesc')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                            
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                <!-- Mixed Test -->
                                <Button x:Name="BtnTypeMixed" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,12" CornerRadius="10"
                                        Click="TestTypeButton_Click" Tag="Mixed">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                            <FontIcon x:Name="IconTypeMixed" Glyph="&#xE765;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="TitleTypeMixed" Text="{x:Bind Loc.GetString('Test_FormatMixed')}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{x:Bind Loc.GetString('Test_FormatMixedDesc')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border x:Name="CheckBadgeTypeMixed" Grid.Column="2" Width="22" Height="22" CornerRadius="11"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- Word -> Meaning -->
                                <Button x:Name="BtnTypeWordToMeaning" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,12" CornerRadius="10"
                                        Click="TestTypeButton_Click" Tag="WordToMeaning">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                            <FontIcon x:Name="IconTypeWordToMeaning" Glyph="&#xE82D;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="TitleTypeWordToMeaning" Text="{x:Bind Loc.GetString('Test_FormatWordToMeaning')}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{x:Bind Loc.GetString('Test_FormatWordToMeaningDesc')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border x:Name="CheckBadgeTypeWordToMeaning" Grid.Column="2" Width="22" Height="22" CornerRadius="11"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- Meaning -> Word -->
                                <Button x:Name="BtnTypeMeaningToWord" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,12" CornerRadius="10"
                                        Click="TestTypeButton_Click" Tag="MeaningToWord">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                            <FontIcon x:Name="IconTypeMeaningToWord" Glyph="&#xE895;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="TitleTypeMeaningToWord" Text="{x:Bind Loc.GetString('Test_FormatMeaningToWord')}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{x:Bind Loc.GetString('Test_FormatMeaningToWordDesc')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border x:Name="CheckBadgeTypeMeaningToWord" Grid.Column="2" Width="22" Height="22" CornerRadius="11"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- Fill in the blank -->
                                <Button x:Name="BtnTypeFillInTheBlank" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,12" CornerRadius="10"
                                        Click="TestTypeButton_Click" Tag="FillInTheBlank">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                            <FontIcon x:Name="IconTypeFillInTheBlank" Glyph="&#xE70F;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="TitleTypeFillInTheBlank" Text="{x:Bind Loc.GetString('Test_FormatFillBlank')}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{x:Bind Loc.GetString('Test_FormatFillBlankDesc')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border x:Name="CheckBadgeTypeFillInTheBlank" Grid.Column="2" Width="22" Height="22" CornerRadius="11"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- Part of Speech -->
                                <Button x:Name="BtnTypePartOfSpeech" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,12" CornerRadius="10"
                                        Click="TestTypeButton_Click" Tag="PartOfSpeech">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                            <FontIcon x:Name="IconTypePartOfSpeech" Glyph="&#xE8D2;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="TitleTypePartOfSpeech" Text="{x:Bind Loc.GetString('Test_FormatPartOfSpeech')}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{x:Bind Loc.GetString('Test_FormatPartOfSpeechDesc')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border x:Name="CheckBadgeTypePartOfSpeech" Grid.Column="2" Width="22" Height="22" CornerRadius="11"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- Listening / Audio Quiz -->
                                <Button x:Name="BtnTypeListeningQuiz" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,12" CornerRadius="10"
                                        Click="TestTypeButton_Click" Tag="ListeningQuiz">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                            <FontIcon x:Name="IconTypeListeningQuiz" Glyph="&#xE767;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="TitleTypeListeningQuiz" Text="{x:Bind Loc.GetString('Test_FormatAudioQuiz')}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{x:Bind Loc.GetString('Test_FormatAudioQuizDesc')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border x:Name="CheckBadgeTypeListeningQuiz" Grid.Column="2" Width="22" Height="22" CornerRadius="11"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Right Column: Settings, Question Count & Filters -->
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="22"
                            VerticalAlignment="Stretch">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Loc.GetString('Test_Configuration')}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="{x:Bind Loc.GetString('Test_ConfigDesc')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>

                            <!-- Question Count Pills -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Loc.GetString('Test_QuestionCount')}" FontWeight="SemiBold" FontSize="13" />
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="4">
                                    <Grid ColumnDefinitions="*,*,*,*">
                                        <Button x:Name="BtnCount5" Grid.Column="0" Content="5" HorizontalAlignment="Stretch" CornerRadius="8" Padding="6,8"
                                                Click="QuestionCountButton_Click" Tag="5" />
                                        <Button x:Name="BtnCount10" Grid.Column="1" Content="10" HorizontalAlignment="Stretch" CornerRadius="8" Padding="6,8"
                                                Click="QuestionCountButton_Click" Tag="10" />
                                        <Button x:Name="BtnCount20" Grid.Column="2" Content="20" HorizontalAlignment="Stretch" CornerRadius="8" Padding="6,8"
                                                Click="QuestionCountButton_Click" Tag="20" />
                                        <Button x:Name="BtnCount30" Grid.Column="3" Content="30" HorizontalAlignment="Stretch" CornerRadius="8" Padding="6,8"
                                                Click="QuestionCountButton_Click" Tag="30" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Mode Selector: Filters vs Custom List -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Loc.GetString('Test_QuestionSource')}" FontWeight="SemiBold" FontSize="13" />
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="4">
                                    <Grid ColumnDefinitions="*,*">
                                        <Button x:Name="BtnModeFilters" Grid.Column="0" Content="{x:Bind Loc.GetString('Test_FiltersAndTopics')}" HorizontalAlignment="Stretch" CornerRadius="8" Padding="6,8"
                                                Click="ModeFiltersButton_Click" />
                                        <Button x:Name="BtnModeCustomList" Grid.Column="1" Content="{x:Bind Loc.GetString('Test_CustomSelection')}" HorizontalAlignment="Stretch" CornerRadius="8" Padding="6,8"
                                                Click="ModeCustomListButton_Click" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Option Area A: Regular Filters -->
                            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsCustomListMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="8">
                                    <ComboBox PlaceholderText="{x:Bind Loc.GetString('Test_AllExams')}" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.ExamTypes}"
                                              SelectedItem="{x:Bind ViewModel.SelectedExamType, Mode=TwoWay}" CornerRadius="8" />
                                    <ComboBox Grid.Column="1" PlaceholderText="{x:Bind Loc.GetString('Test_AllTopics')}" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.Topics}"
                                              SelectedItem="{x:Bind ViewModel.SelectedTopic, Mode=TwoWay}" CornerRadius="8">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="dto:TopicDto">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8EC;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="2" PlaceholderText="{x:Bind Loc.GetString('Test_AllLevels')}" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.CefrLevels}"
                                              SelectedItem="{x:Bind ViewModel.SelectedLevel, Mode=TwoWay}" CornerRadius="8" />
                                    <Button Grid.Column="3" Command="{x:Bind ViewModel.ResetFiltersCommand}" CornerRadius="8" Padding="10,6"
                                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Test_ResetFilters')}">
                                        <FontIcon Glyph="&#xE777;" FontSize="12" />
                                    </Button>
                                </Grid>

                                <!-- Weak Words Focus Toggle -->
                                <ToggleSwitch Header="{x:Bind Loc.GetString('Test_TargetWeakOnly')}"
                                              IsOn="{x:Bind ViewModel.WeakWordsOnly, Mode=TwoWay}"
                                              OffContent="{x:Bind Loc.GetString('Test_TargetWeakOff')}"
                                              OnContent="{x:Bind Loc.GetString('Test_TargetWeakOn')}" />
                            </StackPanel>

                            <!-- Option Area B: Custom Word List Mode -->
                            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsCustomListMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                    <TextBox x:Name="CustomWordSearchBox"
                                             PlaceholderText="{x:Bind Loc.GetString('Test_SearchCustomPool')}"
                                             Text="{x:Bind ViewModel.CustomListSearchTerm, Mode=TwoWay}"
                                             TextChanged="CustomWordSearchBox_TextChanged"
                                             CornerRadius="8" />
                                    <Button Grid.Column="1" Content="{x:Bind Loc.GetString('Test_SelectAll')}" Click="SelectAllCustomWords_Click" CornerRadius="8" />
                                    <Button Grid.Column="2" Content="{x:Bind Loc.GetString('Test_ClearSelection')}" Click="DeselectAllCustomWords_Click" CornerRadius="8" />
                                    <Button Grid.Column="3" Content="{x:Bind Loc.GetString('Test_WeakWordsFilter')}" Click="SelectWeakCustomWords_Click" CornerRadius="8" />
                                </Grid>

                                <!-- Optional: Paste Terms Expander -->
                                <Expander Header="{x:Bind Loc.GetString('Test_PasteWordList')}" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="8" Padding="6">
                                        <TextBlock Text="{x:Bind Loc.GetString('Test_PastePrompt')}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBox AcceptsReturn="True" Height="75" TextWrapping="Wrap"
                                                 Text="{x:Bind ViewModel.CustomListPastedTerms, Mode=TwoWay}" CornerRadius="6" />
                                        <Button Content="{x:Bind Loc.GetString('Test_ApplyPasted')}" Style="{ThemeResource AccentButtonStyle}"
                                                HorizontalAlignment="Right" Click="ApplyPastedTermsButton_Click" CornerRadius="6" Padding="16,6" />
                                    </StackPanel>
                                </Expander>

                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Loc.GetString('Test_SelectedCount')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedCustomWordsCount, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Loc.GetString('Test_WordsForTest')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Custom Word Candidates Scrollable List -->
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" MaxHeight="250">
                                    <ListView ItemsSource="{x:Bind ViewModel.FilteredCustomWordCandidates, Mode=OneWay}"
                                              SelectionMode="None" Padding="4">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,6" ColumnSpacing="10" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" MinWidth="32" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Word.Term}" FontWeight="SemiBold" FontSize="14" />
                                                            <TextBlock Text="{Binding Word.PhoneticUs}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Word.PrimaryPartOfSpeech}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Word.PrimaryDefinition}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="{Binding Word.Level, Converter={StaticResource CefrToBrushConverter}}"
                                                            CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Word.Level}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Full-Width Master Start Action Footer -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="24,18">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="12"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Test_ReadyToBegin')}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="{x:Bind Loc.GetString('Test_ReadyDesc')}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                        </StackPanel>
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.StartTestCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                Padding="28,12" CornerRadius="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="15" />
                                <TextBlock Text="{x:Bind Loc.GetString('Test_StartTest')}" FontWeight="Bold" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ========================================== -->
            <!-- 2. TESTING ACTIVE VIEW                     -->
            <!-- ========================================== -->
            <StackPanel Grid.Row="1" Spacing="18"
                        Visibility="{x:Bind ViewModel.IsTestingMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        MaxWidth="1360" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="20" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                
                <!-- Progress Header -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                    <StackPanel Spacing="6">
                        <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" Height="6" CornerRadius="3" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Loc.GetString('Test_ShortcutsHint')}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- Question Main Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="32">
                    <StackPanel Spacing="22">
                        
                        <!-- Question Type Badge & Audio Button -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="10,4" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.CurrentQuestion.QuestionType, Mode=OneWay}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                            </Border>

                            <Button Grid.Column="1" Command="{x:Bind ViewModel.PlayAudioCommand}"
                                    Visibility="{x:Bind ViewModel.HasAudio, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTipService.ToolTip="{x:Bind Loc.GetString('Test_ListenAudio')}"
                                    CornerRadius="8" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Test_ListenAudio')}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Main Question Prompt -->
                        <TextBlock Text="{x:Bind ViewModel.CurrentQuestion.Prompt, Mode=OneWay}"
                                   Style="{ThemeResource TitleTextBlockStyle}" FontSize="26" FontWeight="Bold"
                                   TextWrapping="Wrap" />

                        <!-- Sub-prompt / Translation clue -->
                        <TextBlock Text="{x:Bind ViewModel.CurrentQuestion.SubPrompt, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.CurrentQuestion.SubPrompt, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontStyle="Italic" FontSize="15" TextWrapping="Wrap" />

                        <!-- 4 Interactive Choice Cards -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TestOptionItem">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Margin="0,0,0,10" Padding="16,14" CornerRadius="10"
                                            BorderBrush="{x:Bind State, Mode=OneWay, Converter={StaticResource OptionStateToBrushConverter}, ConverterParameter=CardBorder}"
                                            BorderThickness="{x:Bind State, Mode=OneWay, Converter={StaticResource OptionStateToThicknessConverter}}"
                                            Background="{x:Bind State, Mode=OneWay, Converter={StaticResource OptionStateToBrushConverter}, ConverterParameter=CardBackground}"
                                            Click="OptionButton_Click" Tag="{x:Bind Text}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Background="{x:Bind State, Mode=OneWay, Converter={StaticResource OptionStateToBrushConverter}, ConverterParameter=Background}"
                                                    CornerRadius="6" Width="28" Height="28" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="12"
                                                          Foreground="{x:Bind State, Mode=OneWay, Converter={StaticResource OptionStateToBrushConverter}, ConverterParameter=Foreground}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Answer Feedback InfoBar (After selection) -->
                        <InfoBar IsOpen="{x:Bind ViewModel.IsAnswerSubmitted, Mode=OneWay}"
                                 Severity="{x:Bind GetFeedbackSeverity(ViewModel.IsAnswerCorrect), Mode=OneWay}"
                                 Title="{x:Bind GetFeedbackTitle(ViewModel.IsAnswerCorrect), Mode=OneWay}"
                                 Message="{x:Bind ViewModel.ExplanationText, Mode=OneWay}" CornerRadius="8" />

                        <!-- Bottom Controls -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <Button Content="{x:Bind Loc.GetString('Test_ExitTest')}" Click="ExitTestButton_Click" CornerRadius="8" Padding="16,8" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.NextQuestionCommand}"
                                    Style="{ThemeResource AccentButtonStyle}" Padding="26,10" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Loc.GetString('Test_NextQuestion')}" FontWeight="Bold" />
                                    <FontIcon Glyph="&#xE76C;" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>

                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ========================================== -->
            <!-- 3. RESULT VIEW                             -->
            <!-- ========================================== -->
            <StackPanel Grid.Row="1" Spacing="22"
                        Visibility="{x:Bind ViewModel.IsResultMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        MaxWidth="1360" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="20" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                
                <!-- Score Summary Banner -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="32">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="28">
                        <!-- Score Circle -->
                        <Border Width="110" Height="110" CornerRadius="55"
                                Background="{x:Bind ViewModel.ResultScoreTier, Mode=OneWay, Converter={StaticResource ScoreTierToBrushConverter}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.ScorePercentage, Mode=OneWay}"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="%" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="14" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Feedback Message -->
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Test_ResultTitle')}" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" FontSize="26" />
                            <TextBlock Text="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Loc.GetString('Test_ResultSubtitle')}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Statistics Metrics Grid -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14" MinWidth="560">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind Loc.GetString('Test_Correct')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.CorrectCount, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind Loc.GetString('Test_Incorrect')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.IncorrectCount, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind Loc.GetString('Test_Accuracy')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.ScorePercentage, Mode=OneWay}" FontSize="26" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind Loc.GetString('Test_TimeTaken')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.TimeTakenText, Mode=OneWay}" FontSize="26" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

                <!-- Action Bar -->
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <Button Content="{x:Bind Loc.GetString('Test_RetakeTest')}" Command="{x:Bind ViewModel.RestartSetupCommand}" Padding="18,10" CornerRadius="8" />
                    <Button Content="{x:Bind Loc.GetString('Test_ReviewWeakWords')}" Command="{x:Bind ViewModel.RetestWeakWordsCommand}"
                            Visibility="{x:Bind ViewModel.WeakWordsList.Count, Mode=OneWay, Converter={StaticResource IntToVisibilityConverter}}"
                            Padding="18,10" CornerRadius="8" />
                    <Button Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.ReviewWeakWordsInSpacedRepetitionCommand}" Padding="22,10" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE895;" FontSize="15" />
                            <TextBlock Text="{x:Bind Loc.GetString('Test_ReviewInSm2')}" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Weak Words Identified Section -->
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.WeakWordsList.Count, Mode=OneWay, Converter={StaticResource IntToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="18" />
                        <TextBlock Text="{x:Bind Loc.GetString('Test_WeakWordsSection')}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                    </StackPanel>

                    <ListView ItemsSource="{x:Bind ViewModel.WeakWordsList}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dto:WordDto">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Button Click="WeakWordAudio_Click" Tag="{x:Bind}"
                                                Padding="8,6" Margin="0,0,12,0" VerticalAlignment="Center" CornerRadius="6">
                                            <FontIcon Glyph="&#xE767;" FontSize="14" />
                                        </Button>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Term}" FontWeight="Bold" FontSize="15" />
                                                <TextBlock Text="{x:Bind PhoneticUs}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,1">
                                                    <TextBlock Text="{x:Bind PrimaryPartOfSpeech}" FontSize="10" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind PrimaryDefinition}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind services:LocalizationHelper.GetString('Test_NeedsReview')}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Detailed Questions Review -->
                <Expander Header="{x:Bind Loc.GetString('Test_DetailedReview')}" HorizontalAlignment="Stretch">
                    <ListView ItemsSource="{x:Bind ViewModel.QuestionResultsList}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dto:TestQuestionDto">
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,12">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{x:Bind Prompt}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                            <Border Grid.Column="1" CornerRadius="4" Padding="8,3"
                                                    Background="{x:Bind IsCorrect, Converter={StaticResource CorrectnessToBrushConverter}}">
                                                <TextBlock Text="{x:Bind services:LocalizationHelper.FormatCorrectness(IsCorrect)}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{x:Bind Explanation}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind services:LocalizationHelper.GetString('Test_YourAnswer')}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                                            <TextBlock Text="{x:Bind UserAnswer}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{x:Bind services:LocalizationHelper.GetString('Test_CorrectAnswerPrefix')}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                                            <TextBlock Text="{x:Bind CorrectAnswer}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
