<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.OperationProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DefaultButton="None"
    CornerRadius="16">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">520</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">420</x:Double>

        <Storyboard x:Name="DialogEntranceStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="DialogRoot"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="1.0"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="DialogScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.94" To="1.0"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="DialogScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.94" To="1.0"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </ContentDialog.Resources>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,4">
                <Border Width="36" Height="36" CornerRadius="10"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon x:Name="DialogIcon" Glyph="&#xE896;" FontSize="16"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="DialogTitleText" Text="{Binding}"
                               FontWeight="SemiBold" FontSize="17"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Lexora Background Task Engine"
                               FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <Grid x:Name="DialogRoot" Width="420" Padding="4,16,4,8">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="DialogScale" CenterX="210" CenterY="100" />
        </Grid.RenderTransform>

        <StackPanel Spacing="20" HorizontalAlignment="Stretch">

            <!-- Progress Visual Area (Active State) -->
            <StackPanel x:Name="ActiveProgressPanel" Spacing="18" HorizontalAlignment="Stretch">

                <!-- Radial / Ring Progress with Centered Percentage -->
                <Grid HorizontalAlignment="Center" Width="96" Height="96">
                    <!-- Background Track Ring -->
                    <ProgressRing IsIndeterminate="False" Value="100"
                                  Width="96" Height="96"
                                  Opacity="0.15"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Active Progress Ring -->
                    <ProgressRing x:Name="MainProgressRing"
                                  IsIndeterminate="False"
                                  Value="0"
                                  Width="96" Height="96"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <!-- Large Central Percentage Text -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="-2">
                        <TextBlock x:Name="PercentTextBlock"
                                   Text="0%"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="PROGRESS"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Status Step Description -->
                <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="StepMessageText"
                               Text="Đang chuẩn bị dữ liệu..."
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <!-- Granular Detail Pill -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,6"
                            HorizontalAlignment="Center"
                            MaxWidth="380">
                        <TextBlock x:Name="StepDetailText"
                                   Text="Vui lòng đợi trong giây lát..."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Linear Fluid Progress Bar -->
                <ProgressBar x:Name="LinearProgressBar"
                             IsIndeterminate="False"
                             Value="0"
                             Maximum="100"
                             Height="6"
                             CornerRadius="3"
                             HorizontalAlignment="Stretch"
                             Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
            </StackPanel>

            <!-- Success / Completed State View -->
            <StackPanel x:Name="CompletedPanel" Spacing="16" Visibility="Collapsed" HorizontalAlignment="Stretch">
                <!-- Checkmark Icon Area -->
                <Border Width="64" Height="64" CornerRadius="32"
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                        BorderThickness="1.5"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE73E;" FontSize="28"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock x:Name="CompletedTitleText"
                               Text="Hoàn tất thành công!"
                               FontSize="18"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="CompletedSummaryText"
                               Text="Toàn bộ dữ liệu đã được xử lý an toàn."
                               FontSize="13"
                               TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Metrics Summary Cards Grid -->
                <Grid x:Name="MetricsGrid" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,4,0,0">
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10,8">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="StatImportedCount" Text="0"
                                       FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="Đã nhập" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10,8">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="StatSkippedCount" Text="0"
                                       FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Bỏ qua" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10,8">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="StatErrorCount" Text="0"
                                       FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="Lỗi" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

        </StackPanel>
    </Grid>
</ContentDialog>
