<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.UpdateDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dto="using:Lexora.Application.DTOs"
    DefaultButton="Primary"
    mc:Ignorable="d"
    CornerRadius="16">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">440</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <FontIcon Glyph="&#xE896;" FontSize="16"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding}" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" Margin="0,2,0,0" HorizontalAlignment="Stretch">
        <!-- Row 0: Subtitle Header -->
        <TextBlock Grid.Row="0" x:Name="DialogSubtitleText"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,2" />

        <!-- Row 1: Overview Banner -->
        <Border Grid.Row="1"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,12"
                HorizontalAlignment="Stretch">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Top">
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Top" Margin="0,2,0,0">
                        <TextBlock x:Name="VersionBadgeText"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   FontWeight="Bold" FontSize="12.5" />
                    </Border>
                    <TextBlock Grid.Column="1" x:Name="ReleaseTitleText"
                               FontWeight="Bold" FontSize="14.5"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>

                <!-- Metadata badges: Symmetrical 3-column responsive grid -->
                <Grid x:Name="BadgesGrid" ColumnDefinitions="*,*,*" ColumnSpacing="8" HorizontalAlignment="Stretch">
                    <!-- Version transition -->
                    <Border Grid.Column="0" x:Name="VersionTransitionBorder"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE895;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="VersionTransitionText" FontSize="11.5" FontWeight="Medium"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- Download Size -->
                    <Border Grid.Column="1" x:Name="DownloadSizeBorder"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B9;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="DownloadSizeText" FontSize="11.5" FontWeight="Medium"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- Publish Date -->
                    <Border Grid.Column="2" x:Name="PublishDateBorder"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE787;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="PublishDateText" FontSize="11.5" FontWeight="Medium"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 2: Release Notes -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,12"
                HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE70F;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="ReleaseNotesLabel" FontWeight="SemiBold" FontSize="12.5"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NotesContainer" Spacing="4" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Row 3: Safety Snapshot Guarantee -->
        <Border Grid.Row="3"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8"
                HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="AutoBackupNoteText"
                           FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
