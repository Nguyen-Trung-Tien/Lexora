<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Lexora.Presentation.Views.ToastOverlayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Fluid Entrance Storyboard -->
        <Storyboard x:Name="EntranceStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="ToastRoot"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="1.0"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="ToastTranslate"
                Storyboard.TargetProperty="Y"
                From="-20" To="0"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Subtle Update Pulse Storyboard -->
        <Storyboard x:Name="UpdatePulseStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="ToastScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.97" To="1.0"
                Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="ToastScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.97" To="1.0"
                Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Fluid Exit Storyboard -->
        <Storyboard x:Name="ExitStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="ToastRoot"
                Storyboard.TargetProperty="Opacity"
                From="1.0" To="0.0"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="ToastTranslate"
                Storyboard.TargetProperty="Y"
                From="0" To="-16"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="ToastRoot"
            CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Padding="14,12"
            MinWidth="320"
            MaxWidth="420"
            Opacity="0"
            Visibility="Collapsed"
            PointerEntered="ToastRoot_PointerEntered"
            PointerExited="ToastRoot_PointerExited"
            RenderTransformOrigin="0.5,0.5">

        <Border.RenderTransform>
            <TransformGroup>
                <TranslateTransform x:Name="ToastTranslate" Y="0" />
                <ScaleTransform x:Name="ToastScale" ScaleX="1.0" ScaleY="1.0" />
            </TransformGroup>
        </Border.RenderTransform>

        <Grid RowDefinitions="Auto,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <!-- Icon Badge -->
                <Border x:Name="IconBadgeBorder"
                        Width="34" Height="34"
                        CornerRadius="8"
                        VerticalAlignment="Top"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <FontIcon x:Name="TypeIcon"
                              FontSize="14"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>

                <!-- Content Area -->
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleTextBlock"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MessageTextBlock"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxLines="3"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2"
                        x:Name="CloseButton"
                        Click="CloseButton_Click"
                        Width="26" Height="26"
                        Padding="0"
                        CornerRadius="6"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="{x:Bind Loc.GetString('Toast_Close')}">
                    <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Button>
            </Grid>

            <!-- Remaining Time Indicator Bar -->
            <ProgressBar Grid.Row="1"
                         x:Name="TimeProgressBar"
                         Height="2"
                         Margin="0,8,0,0"
                         Minimum="0"
                         Maximum="100"
                         Value="100"
                         HorizontalAlignment="Stretch"
                         Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
        </Grid>
    </Border>
</UserControl>
