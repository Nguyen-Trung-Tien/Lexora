<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Lexora.Presentation.Views.ToastOverlayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Fluid Entrance Storyboard (Slides down gently from top into view) -->
        <Storyboard x:Name="EntranceStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="ToastRoot"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="1.0"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="ToastTranslate"
                Storyboard.TargetProperty="Y"
                From="-24" To="0"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Subtle Update Pulse Storyboard -->
        <Storyboard x:Name="UpdatePulseStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="ToastScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.97" To="1.0"
                Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="ToastScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.97" To="1.0"
                Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Fluid Exit Storyboard (Slides up gently back into top) -->
        <Storyboard x:Name="ExitStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="ToastRoot"
                Storyboard.TargetProperty="Opacity"
                From="1.0" To="0.0"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="ToastTranslate"
                Storyboard.TargetProperty="Y"
                From="0" To="-24"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <!-- Hardware-accelerated Smooth Countdown Progress Storyboard -->
        <Storyboard x:Name="ProgressStoryboard">
            <DoubleAnimation
                x:Name="ProgressAnimation"
                Storyboard.TargetName="ProgressBarScale"
                Storyboard.TargetProperty="ScaleX"
                From="1.0" To="0.0" />
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="ToastRoot"
            CornerRadius="12"
            Background="{ThemeResource LexoraToastBackgroundBrush}"
            BorderBrush="{ThemeResource LexoraToastBorderBrush}"
            BorderThickness="1"
            Padding="14,10"
            MinWidth="280"
            MaxWidth="460"
            Opacity="0"
            Visibility="Collapsed"
            Translation="0,0,32"
            PointerEntered="ToastRoot_PointerEntered"
            PointerExited="ToastRoot_PointerExited"
            RenderTransformOrigin="0.5,0.5">

        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>

        <Border.RenderTransform>
            <TransformGroup>
                <TranslateTransform x:Name="ToastTranslate" Y="0" />
                <ScaleTransform x:Name="ToastScale" ScaleX="1.0" ScaleY="1.0" />
            </TransformGroup>
        </Border.RenderTransform>

        <Grid RowDefinitions="Auto,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <!-- Icon Badge -->
                <Border x:Name="IconBadgeBorder"
                        Width="32" Height="32"
                        CornerRadius="8"
                        VerticalAlignment="Top"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <FontIcon x:Name="TypeIcon"
                              FontSize="14"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>

                <!-- Content Area -->
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleTextBlock"
                               FontWeight="SemiBold"
                               FontSize="13"
                               MaxLines="1"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MessageTextBlock"
                               FontSize="12"
                               LineHeight="16"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxLines="3"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="ActionButton"
                            Margin="0,4,0,0"
                            Padding="12,5"
                            CornerRadius="6"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            Click="ActionButton_Click" />
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2"
                        x:Name="CloseButton"
                        Click="CloseButton_Click"
                        Width="24" Height="24"
                        Padding="0"
                        CornerRadius="4"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="{x:Bind Loc.GetString('Toast_Close')}">
                    <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Button>
            </Grid>

            <!-- Remaining Time Indicator Bar Track -->
            <Border Grid.Row="1"
                    Height="2.5"
                    CornerRadius="1.25"
                    Margin="0,8,0,0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    HorizontalAlignment="Stretch">
                <Border x:Name="TimeProgressBar"
                        Height="2.5"
                        CornerRadius="1.25"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        HorizontalAlignment="Stretch"
                        RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ProgressBarScale" ScaleX="1.0" />
                    </Border.RenderTransform>
                </Border>
            </Border>
        </Grid>
    </Border>
</UserControl>
