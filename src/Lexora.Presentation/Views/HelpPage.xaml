<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Lexora.Presentation.ViewModels"
    KeyboardAcceleratorPlacementMode="Hidden"
    Loaded="HelpPage_Loaded"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="28,20" HorizontalAlignment="Stretch">
            <StackPanel Spacing="22" MaxWidth="1100" HorizontalAlignment="Stretch">

                <!-- 1. HERO BANNER: Elegant Fluent Card with Hub Overview -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource LexoraHeroCardBorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="28,24">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="18">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,3">
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_HeroBadge')}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="11" FontWeight="Bold" />
                                </Border>
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,3">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE9CE;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Loc.GetString('Help_OnboardingSystem')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,3">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE753;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        <TextBlock Text="{x:Bind Loc.GetString('Help_OfflineBadge')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{x:Bind Loc.GetString('Help_Title')}" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" FontSize="26" />
                            <TextBlock Text="{x:Bind Loc.GetString('Help_Subtitle')}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Search Box for Help Center -->
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBox x:Name="SearchBox"
                                     PlaceholderText="{x:Bind Loc.GetString('Help_SearchPlaceholder')}"
                                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     CornerRadius="8" Padding="12,8">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                </TextBox.Resources>
                            </TextBox>
                            <Button Grid.Column="1" Click="ResetFilterButton_Click" CornerRadius="8" Padding="14,8"
                                    ToolTipService.ToolTip="{x:Bind Loc.GetString('Help_ResetFilterTooltip')}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_ResetFilter')}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. CATEGORY FILTER PILLS (FLUENT 2 STRIP WITH CHEVRON SCROLLING) -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                    <!-- Scroll Left Chevron Button -->
                    <Button x:Name="ScrollPillsLeftBtn" Grid.Column="0"
                            Click="ScrollPillsLeft_Click"
                            Width="32" Height="36" Padding="0" CornerRadius="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Help_ScrollLeft')}">
                        <FontIcon Glyph="&#xE76B;" FontSize="11" />
                    </Button>

                    <ScrollViewer x:Name="CategoryScrollViewer" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled"
                                  PointerWheelChanged="CategoryScrollViewer_PointerWheelChanged"
                                  ViewChanged="CategoryScrollViewer_ViewChanged"
                                  SizeChanged="CategoryScrollViewer_SizeChanged"
                                  Padding="0,2,0,4">
                        <StackPanel x:Name="CategoryPillsPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="FilterBtnAll" Click="FilterButton_Click" Tag="All" CornerRadius="8" Padding="14,6">
                                <TextBlock Text="{x:Bind Loc.GetString('Help_Cat_All')}" FontWeight="SemiBold" />
                            </Button>
                            <Button x:Name="FilterBtnGettingStarted" Click="FilterButton_Click" Tag="GettingStarted" CornerRadius="8" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE80F;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_Cat_GettingStarted')}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FilterBtnVocabulary" Click="FilterButton_Click" Tag="Vocabulary" CornerRadius="8" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8D2;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_Cat_Vocabulary')}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FilterBtnSpacedRepetition" Click="FilterButton_Click" Tag="SpacedRepetition" CornerRadius="8" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE81C;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_Cat_SpacedRepetition')}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FilterBtnListeningLab" Click="FilterButton_Click" Tag="ListeningLab" CornerRadius="8" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE767;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_Cat_ListeningLab')}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FilterBtnTestMode" Click="FilterButton_Click" Tag="TestMode" CornerRadius="8" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7BE;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_Cat_TestMode')}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FilterBtnBackupSettings" Click="FilterButton_Click" Tag="BackupAndSettings" CornerRadius="8" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE713;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_Cat_BackupSettings')}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Scroll Right Chevron Button -->
                    <Button x:Name="ScrollPillsRightBtn" Grid.Column="2"
                            Click="ScrollPillsRight_Click"
                            Width="32" Height="36" Padding="0" CornerRadius="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Help_ScrollRight')}">
                        <FontIcon Glyph="&#xE76C;" FontSize="11" />
                    </Button>
                </Grid>

                <!-- 3. LIST OF GUIDE CARDS -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredGuides, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HelpGuideDisplayItem">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="20,18" Margin="0,0,0,14">
                                <StackPanel Spacing="14">
                                    <!-- Card Header -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                        <Border Width="44" Height="44" CornerRadius="10"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="18"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="16" />
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,2"
                                                        Visibility="{x:Bind Badge, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <TextBlock Text="{x:Bind Badge}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Direct Jump Button -->
                                        <Button Grid.Column="2" Style="{ThemeResource AccentButtonStyle}"
                                                Click="GuideActionButton_Click"
                                                Tag="{x:Bind ActionTargetTag}"
                                                CornerRadius="8" Padding="12,6"
                                                Visibility="{x:Bind ActionTargetTag, Converter={StaticResource NullToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind ActionLabel}" FontWeight="SemiBold" FontSize="12" />
                                                <FontIcon Glyph="&#xE76C;" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Summary Quote / Lead -->
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10">
                                        <TextBlock Text="{x:Bind Summary}" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" FontStyle="Italic" />
                                    </Border>

                                    <!-- Detailed Guide Body -->
                                    <TextBlock Text="{x:Bind Content}" FontSize="13" LineHeight="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />

                                    <!-- Mathematical Formula / Algorithm Card (if present) -->
                                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="14,10"
                                            Visibility="{x:Bind Formula, Converter={StaticResource NullToVisibilityConverter}}">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind FormulaHeader}" FontWeight="Bold" FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Formula}" FontFamily="Consolas, Cascadia Code, Segoe UI Variable"
                                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Key Tips / Bullet Points -->
                                    <StackPanel Spacing="6" Visibility="{x:Bind TipsList, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind KeyPointsHeader}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ItemsControl ItemsSource="{x:Bind TipsList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
                                                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                        <TextBlock Text="{x:Bind ToString()}" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Keyboard Shortcuts Reference -->
                                    <StackPanel Spacing="6" Visibility="{x:Bind ShortcutKeys, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind ShortcutsHeader}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ItemsControl ItemsSource="{x:Bind ShortcutKeys}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,2" HorizontalAlignment="Left">
                                                        <TextBlock Text="{x:Bind ToString()}" FontFamily="Consolas, Cascadia Code" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 4. FOOTER NOTE -->
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="20,16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <FontIcon Glyph="&#xE946;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Loc.GetString('Help_FooterNoteTitle')}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{x:Bind Loc.GetString('Help_FooterNoteContent')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
