<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Lexora.Presentation.Views.Common.SplashScreenOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- ======================================================= -->
        <!-- MODERN FLUENT 2 ENTRANCE STORYBOARD (380ms)             -->
        <!-- ======================================================= -->
        <Storyboard x:Name="EntranceStoryboard" Duration="0:0:0.38">
            <!-- Glass Card Scale & Fade In -->
            <DoubleAnimation
                Storyboard.TargetName="SplashCard"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="1.0"
                Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="SplashCardScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.95" To="1.0"
                Duration="0:0:0.34">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="SplashCardScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.95" To="1.0"
                Duration="0:0:0.34">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Logo Pop -->
            <DoubleAnimation
                Storyboard.TargetName="LogoScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.88" To="1.0"
                Duration="0:0:0.34"
                BeginTime="0:0:0.04">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="LogoScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.88" To="1.0"
                Duration="0:0:0.34"
                BeginTime="0:0:0.04">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Specular Sheen Sweep Across Logo Tile -->
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="SpecularSheen"
                Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="0.0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.24" Value="0.45" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.38" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation
                Storyboard.TargetName="SheenTransform"
                Storyboard.TargetProperty="TranslateX"
                From="-120" To="120"
                Duration="0:0:0.28"
                BeginTime="0:0:0.10">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Ambient Orbs Subtle Bloom -->
            <DoubleAnimation
                Storyboard.TargetName="TopLeftOrb"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="0.18"
                Duration="0:0:0.38">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="BottomRightOrb"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="0.14"
                Duration="0:0:0.38">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Reduced Motion Instant Reveal -->
        <Storyboard x:Name="ReducedMotionEntrance" Duration="0:0:0.01">
            <DoubleAnimation Storyboard.TargetName="SplashCard" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.01" />
        </Storyboard>

        <!-- Seamless Cross-Fade Exit (250ms) -->
        <Storyboard x:Name="ExitStoryboard" Duration="0:0:0.25">
            <DoubleAnimation
                Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="Opacity"
                From="1.0" To="0.0"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="SplashCardScale"
                Storyboard.TargetProperty="ScaleX"
                From="1.0" To="1.03"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="SplashCardScale"
                Storyboard.TargetProperty="ScaleY"
                From="1.0" To="1.03"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <!-- Subtle Ambient Accent Orbs -->
        <Ellipse x:Name="TopLeftOrb"
                 Width="420" Height="420"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-140,-140,0,0"
                 Opacity="0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0.0" />
                    <GradientStop Color="Transparent" Offset="1.0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse x:Name="BottomRightOrb"
                 Width="380" Height="380"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-120,-120"
                 Opacity="0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="0.0" />
                    <GradientStop Color="Transparent" Offset="1.0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Centered Modern Fluent 2 Floating Glass Card -->
        <Border x:Name="SplashCard"
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24"
                Padding="32,28"
                CornerRadius="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource LexoraHeroCardBorderBrush}"
                BorderThickness="1"
                Opacity="0"
                Translation="0,0,32"
                RenderTransformOrigin="0.5,0.5">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Border.RenderTransform>
                <ScaleTransform x:Name="SplashCardScale" ScaleX="0.95" ScaleY="0.95" />
            </Border.RenderTransform>

            <StackPanel Spacing="22">
                <!-- Brand Header: Logo Tile + Wordmark + Version Badge -->
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <Border x:Name="LogoTileCard"
                            Width="84" Height="84"
                            CornerRadius="20"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource LexoraHeroCardBorderBrush}"
                            BorderThickness="1.5"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="LogoScale" ScaleX="0.88" ScaleY="0.88" />
                        </Border.RenderTransform>
                        <Grid Clip="{x:Null}">
                            <Image x:Name="LogoTile"
                                   Width="68" Height="68"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                            <!-- Specular Sheen Sweep -->
                            <Rectangle x:Name="SpecularSheen"
                                       Width="36" Height="140"
                                       Opacity="0"
                                       IsHitTestVisible="False"
                                       RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <CompositeTransform x:Name="SheenTransform" Rotation="-26" TranslateX="-120" />
                                </Rectangle.RenderTransform>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0" />
                                        <GradientStop Color="{ThemeResource SystemAccentColorLight3}" Offset="0.5" />
                                        <GradientStop Color="Transparent" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <TextBlock Text="Lexora"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       CharacterSpacing="25"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border CornerRadius="{StaticResource RadiusPill}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Padding="9,3"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock x:Name="VersionBadgeTextBlock"
                                               Text="v1.8.0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               FontFamily="Consolas, Cascadia Code"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="TaglineTextBlock"
                                   Text="INTELLIGENT VOCABULARY &amp; SPACED REPETITION"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="90"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock x:Name="EditionBadgeTextBlock"
                                   Text="DESKTOP • OFFLINE FIRST"
                                   FontSize="10.5"
                                   CharacterSpacing="40"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Sleek Divider -->
                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <!-- Deterministic Modern Loading System -->
                <StackPanel x:Name="LoadingContainer" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="Đang khởi tạo hệ thống..."
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="ProgressPercentageTextBlock"
                                   Grid.Column="1"
                                   Text="12%"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   FontFamily="Consolas, Cascadia Code"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <ProgressBar x:Name="StartupProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="12"
                                 IsIndeterminate="False"
                                 Height="5"
                                 CornerRadius="2.5"
                                 Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <!-- 4 Modern Milestone Step Pills -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,2,0,0">
                        <Border x:Name="Step1Pill" Grid.Column="0" CornerRadius="{StaticResource RadiusSmall}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="6,5">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <Ellipse x:Name="Step1Dot" Width="6" Height="6" Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="Step1TextBlock" Text="Core" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="Step2Pill" Grid.Column="1" CornerRadius="{StaticResource RadiusSmall}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="6,5">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <Ellipse x:Name="Step2Dot" Width="6" Height="6" Fill="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="Step2TextBlock" Text="Database" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="Step3Pill" Grid.Column="2" CornerRadius="{StaticResource RadiusSmall}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="6,5">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <Ellipse x:Name="Step3Dot" Width="6" Height="6" Fill="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="Step3TextBlock" Text="Data" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="Step4Pill" Grid.Column="3" CornerRadius="{StaticResource RadiusSmall}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="6,5">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <Ellipse x:Name="Step4Dot" Width="6" Height="6" Fill="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="Step4TextBlock" Text="Ready" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Error State Panel (Initially Collapsed) -->
                <StackPanel x:Name="ErrorCard" Visibility="Collapsed" Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18"
                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE783;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="ErrorTitleTextBlock"
                                   Text="Không thể khởi tạo Lexora"
                                   FontWeight="Bold"
                                   FontSize="15.5"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Padding="12,10">
                        <ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="ErrorDetailsTextBlock"
                                       Text="Đã có lỗi xảy ra khi tải cơ sở dữ liệu."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ScrollViewer>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <Button x:Name="RetryButton"
                                Content="Thử lại"
                                Style="{StaticResource AccentButtonStyle}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="18,8"
                                Click="RetryButton_Click" />
                        <Button x:Name="ExitButton"
                                Content="Đóng ứng dụng"
                                Style="{StaticResource LexoraStandardButtonStyle}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="18,8"
                                Click="ExitButton_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
