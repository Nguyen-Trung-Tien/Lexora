<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Lexora.Presentation.Views.Common.ToastOverlayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lexora.Presentation.Views.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <ItemsControl x:Name="ToastItemsControl">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="10">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="40" FromVerticalOffset="0" IsStaggeringEnabled="False" />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>
                </StackPanel>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:ToastCardItem">
                <Border CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Background="{ThemeResource LexoraToastBackgroundBrush}"
                        BorderBrush="{ThemeResource LexoraToastBorderBrush}"
                        BorderThickness="1"
                        Padding="14,10"
                        MinWidth="300"
                        MaxWidth="420"
                        Translation="0,0,32"
                        PointerEntered="ToastCard_PointerEntered"
                        PointerExited="ToastCard_PointerExited">

                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>

                    <Grid RowDefinitions="Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <!-- Icon Badge -->
                            <Border Width="32" Height="32"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    VerticalAlignment="Top"
                                    Background="{x:Bind BadgeBackground, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                                          FontSize="14"
                                          Foreground="{x:Bind AccentBrush, Mode=OneWay}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>

                            <!-- Content Area -->
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                           Visibility="{x:Bind TitleVisibility, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           MaxLines="1"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Message, Mode=OneWay}"
                                           ToolTipService.ToolTip="{x:Bind Message, Mode=OneWay}"
                                           FontSize="12"
                                           LineHeight="16"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           MaxLines="4"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Content="{x:Bind ActionText, Mode=OneWay}"
                                        Visibility="{x:Bind ActionVisibility, Mode=OneWay}"
                                        Tag="{x:Bind Id, Mode=OneWay}"
                                        Margin="0,4,0,0"
                                        Padding="12,5"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Click="ActionButton_Click" />
                            </StackPanel>

                            <!-- Close Button -->
                            <Button Grid.Column="2"
                                    Tag="{x:Bind Id, Mode=OneWay}"
                                    Click="CloseButton_Click"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Width="24" Height="24"
                                    Padding="0"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    VerticalAlignment="Top"
                                    ToolTipService.ToolTip="{x:Bind CloseTooltip, Mode=OneWay}">
                                <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Button>
                        </Grid>

                        <!-- Smooth GPU-composited Remaining Time Bar -->
                        <Border Grid.Row="1"
                                Margin="0,8,0,0"
                                Height="2.5"
                                CornerRadius="1.25"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Border Background="{x:Bind AccentBrush, Mode=OneWay}"
                                    CornerRadius="1.25"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{x:Bind RemainingFraction, Mode=OneWay}" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
