<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Lexora.Presentation.Views.Common.CommandPaletteOverlayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:common="using:Lexora.Presentation.Views.Common"
    mc:Ignorable="d">

    <Grid x:Name="RootOverlay"
          Background="{ThemeResource SmokeFillColorDefaultBrush}"
          Tapped="RootOverlay_Tapped"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <!-- Centered Floating Palette Card -->
        <Border x:Name="PaletteCard"
                Width="640"
                MaxHeight="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,80,0,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Tapped="PaletteCard_Tapped">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <!-- Row 0: Search Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE721;" FontSize="16"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              VerticalAlignment="Center" Margin="4,0,0,0" />

                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="15"
                             VerticalAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown" />

                    <Border Grid.Column="2"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="ESC" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </Grid>

                <!-- Row 1: Divider -->
                <Border Grid.Row="1" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <!-- Row 2: Results List / No Results -->
                <Grid Grid.Row="2" MinHeight="180" MaxHeight="380">
                    <ListView x:Name="ItemsListView"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="ItemsListView_ItemClick"
                              KeyDown="ItemsListView_KeyDown"
                              Padding="6,6">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="common:CommandPaletteDisplayItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="8,6" HorizontalAlignment="Stretch">
                                    <Border Width="32" Height="32" CornerRadius="8"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="14"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="11.5"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Visibility="{x:Bind HasBadge, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="7,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Badge}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty State -->
                    <StackPanel x:Name="NoResultsPanel"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Padding="20">
                        <FontIcon Glyph="&#xE721;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="NoResultsText"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Row 3: Footer Hints -->
                <Border Grid.Row="3"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12"
                        Padding="16,8">
                    <TextBlock x:Name="FooterHintText"
                               FontSize="11.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Right" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
