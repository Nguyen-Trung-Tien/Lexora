<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Lexora.Presentation.Views.Common.PaginationBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}"
            Padding="14,8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <!-- Left: Page & Total Summary -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource RadiusPill}"
                        Padding="10,3">
                    <TextBlock Text="{x:Bind ComputedPageSummary, Mode=OneWay}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Text="{x:Bind ComputedTotalSummary, Mode=OneWay}"
                           Visibility="{x:Bind TotalItemsVisibility, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Right: Navigation Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="BtnFirst"
                        Click="BtnFirst_Click"
                        IsEnabled="{x:Bind CanGoPrevious, Mode=OneWay}"
                        Style="{StaticResource LexoraCompactButtonStyle}"
                        Padding="8,5"
                        ToolTipService.ToolTip="{x:Bind FirstTooltip, Mode=OneWay}">
                    <FontIcon Glyph="&#xE892;" FontSize="11" />
                </Button>
                <Button x:Name="BtnPrev"
                        Click="BtnPrev_Click"
                        IsEnabled="{x:Bind CanGoPrevious, Mode=OneWay}"
                        Style="{StaticResource LexoraCompactButtonStyle}"
                        Padding="10,5"
                        ToolTipService.ToolTip="{x:Bind PreviousTooltip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE76B;" FontSize="11" />
                        <TextBlock Text="{x:Bind PreviousLabel, Mode=OneWay}" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnNext"
                        Click="BtnNext_Click"
                        IsEnabled="{x:Bind CanGoNext, Mode=OneWay}"
                        Style="{StaticResource LexoraCompactButtonStyle}"
                        Padding="10,5"
                        ToolTipService.ToolTip="{x:Bind NextTooltip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{x:Bind NextLabel, Mode=OneWay}" FontSize="12" />
                        <FontIcon Glyph="&#xE76C;" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnLast"
                        Click="BtnLast_Click"
                        IsEnabled="{x:Bind CanGoNext, Mode=OneWay}"
                        Style="{StaticResource LexoraCompactButtonStyle}"
                        Padding="8,5"
                        ToolTipService.ToolTip="{x:Bind LastTooltip, Mode=OneWay}">
                    <FontIcon Glyph="&#xE893;" FontSize="11" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
