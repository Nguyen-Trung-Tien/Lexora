<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Lexora.Presentation.Views.Common.PageHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon x:Name="HeaderIcon"
                          Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                          Visibility="{x:Bind IconVisibility, Mode=OneWay}"
                          FontSize="20"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                           Style="{StaticResource LexoraDisplayTitleStyle}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                       Visibility="{x:Bind SubtitleVisibility, Mode=OneWay}"
                       Style="{StaticResource LexoraBodyStyle}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ContentPresenter Grid.Column="1"
                          Content="{x:Bind ActionsContent, Mode=OneWay}"
                          VerticalAlignment="Center" />
    </Grid>
</UserControl>
