<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.Common.ExceptionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    DefaultButton="Close"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">420</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">620</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                <Border Width="28" Height="28"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
                    <FontIcon Glyph="&#xE783;"
                              FontSize="14"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding}"
                           FontWeight="SemiBold"
                           FontSize="17"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <ScrollViewer MaxHeight="440"
                  HorizontalAlignment="Stretch"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Padding="0,4,4,4">
            <InfoBar x:Name="FriendlyMessageBar"
                     IsOpen="True"
                     IsClosable="False"
                     Severity="Error"
                     CornerRadius="{ThemeResource OverlayCornerRadius}" />

            <TextBlock Text="{x:Bind Loc.GetString('ExceptionDialog_Subtitle')}"
                       Style="{StaticResource LexoraBodyStyle}"
                       TextWrapping="Wrap" />

            <Expander HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      IsExpanded="False"
                      CornerRadius="{ThemeResource ControlCornerRadius}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE943;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind Loc.GetString('ExceptionDialog_DetailsHeader')}"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                    </StackPanel>
                </Expander.Header>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Padding="12">
                    <TextBox x:Name="TechnicalDetailsBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="11.5"
                             MaxHeight="200"
                             BorderThickness="0"
                             Background="Transparent" />
                </Border>
            </Expander>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CopyDetailsButton"
                        Click="CopyDetailsButton_Click"
                        Style="{StaticResource LexoraSubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                        <TextBlock x:Name="CopyButtonText" Text="{x:Bind Loc.GetString('ExceptionDialog_CopyDetails')}" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenLogsButton"
                        Click="OpenLogsButton_Click"
                        Style="{StaticResource LexoraSubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                        <TextBlock Text="{x:Bind Loc.GetString('ExceptionDialog_OpenLogs')}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
