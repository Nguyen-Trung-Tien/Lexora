<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Lexora.Presentation.Views.Common.EmptyStateControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <Border Style="{StaticResource EmptyStateCard}" HorizontalAlignment="Stretch">
        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="12" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <Border Width="56" Height="56"
                    CornerRadius="28"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    HorizontalAlignment="Center">
                <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                          FontSize="22"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                       Style="{StaticResource LexoraSectionHeaderStyle}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                       Visibility="{x:Bind SubtitleVisibility, Mode=OneWay}"
                       Style="{StaticResource LexoraBodyStyle}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <ContentPresenter Content="{x:Bind ActionContent, Mode=OneWay}"
                              HorizontalAlignment="Center"
                              Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</UserControl>
