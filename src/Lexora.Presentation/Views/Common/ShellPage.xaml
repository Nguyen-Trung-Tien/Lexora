<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.Common.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:common="using:Lexora.Presentation.Views.Common"
    xmlns:services="using:Lexora.Presentation.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    KeyboardAcceleratorPlacementMode="Hidden"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Auto"
            AlwaysShowHeader="False"
            PaneDisplayMode="Auto"
            OpenPaneLength="260"
            CompactPaneLength="48"
            IsSettingsVisible="False"
            KeyboardAcceleratorPlacementMode="Hidden"
            ItemInvoked="NavView_ItemInvoked"
            Loaded="NavView_Loaded">
            <NavigationView.MenuItems>
                <!-- 1. Today & Path -->
                <NavigationViewItemHeader x:Name="NavHeaderOverview" Content="TỔNG QUAN" />
                <NavigationViewItem x:Name="NavItemDashboard" Content="Dashboard" Tag="Dashboard" ToolTipService.ToolTip="Dashboard (Ctrl+1)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemRoadmap" Content="Roadmap" Tag="Roadmap" ToolTipService.ToolTip="Roadmap (Ctrl+9)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 2. Core Learning & Practice Workspaces -->
                <NavigationViewItemHeader x:Name="NavHeaderLearning" Content="WORKSPACES" />
                <NavigationViewItem x:Name="NavItemKnowledgeStudio" Content="Knowledge Studio" Tag="KnowledgeStudio" ToolTipService.ToolTip="Knowledge Studio (Ctrl+2)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE82D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemPracticeArena" Content="Practice Arena" Tag="PracticeArena" ToolTipService.ToolTip="Practice Arena (Ctrl+6)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="ReviewInfoBadge"
                                   Value="{x:Bind ViewModel.DueCardsCount, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasDueReviews, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>

                <!-- 3. Vault & Data -->
                <NavigationViewItemHeader x:Name="NavHeaderArchive" Content="KHO LƯU TRỮ &amp; DỮ LIỆU" />
                <NavigationViewItem x:Name="NavItemLearningStorage" Content="Learning Storage" Tag="LearningStorage" ToolTipService.ToolTip="Learning Storage (Ctrl+8)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavItemSettings" Content="Settings" Tag="Settings" ToolTipService.ToolTip="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="SettingsInfoBadge"
                                   Style="{ThemeResource AttentionDotInfoBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="GlobalSearchBox"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                PlaceholderText="{x:Bind services:LocalizationHelper.GetString('Search_Placeholder')}"
                                ToolTipService.ToolTip="{x:Bind services:LocalizationHelper.GetString('Shell_SearchTooltip')}"
                                QueryIcon="Find"
                                TextChanged="GlobalSearchBox_TextChanged"
                                SuggestionChosen="GlobalSearchBox_SuggestionChosen"
                                QuerySubmitted="GlobalSearchBox_QuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="4,4">
                                <Border Width="26" Height="26" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>

            <!-- Page Content Frame (Rock-solid baseline, zero vertical layout shift) -->
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Modern Floating Toast Notification Overlay (Top-Right Stack, Non-blocking, Zero Layout Shift) -->
        <common:ToastOverlayControl x:Name="ToastOverlay"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Margin="0,16,20,0"
                                   IsHitTestVisible="False"
                                   Canvas.ZIndex="1000" />

        <!-- Modern Command Palette Modal Overlay (Ctrl + K) -->
        <common:CommandPaletteOverlayControl x:Name="CommandPaletteOverlay"
                                             Canvas.ZIndex="2000"
                                             Visibility="Collapsed" />
    </Grid>
</Page>
