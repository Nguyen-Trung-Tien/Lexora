<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.KnowledgeGraphDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dto="using:Lexora.Application.DTOs"
    mc:Ignorable="d"
    Title="{x:Bind Loc.GetString('KnowledgeGraph_Title')}"
    PrimaryButtonText="{x:Bind Loc.GetString('Action_Close')}"
    DefaultButton="Primary"
    CornerRadius="16"
    MaxWidth="820">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="620">
        <StackPanel Spacing="16" Margin="0,8,0,0">

            <!-- Search AutoSuggestBox -->
            <AutoSuggestBox x:Name="GraphSearchBox"
                            PlaceholderText="{x:Bind Loc.GetString('KnowledgeGraph_SearchPlaceholder')}"
                            QueryIcon="Find"
                            TextChanged="GraphSearchBox_TextChanged"
                            SuggestionChosen="GraphSearchBox_SuggestionChosen"
                            QuerySubmitted="GraphSearchBox_QuerySubmitted"
                            CornerRadius="8" Padding="12,8" />

            <!-- Loading Indicator -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                        Visibility="{x:Bind IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressRing IsActive="True" Width="20" Height="20" />
                <TextBlock Text="Generating semantic graph..." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Center Word Hero Card -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="8,2">
                                <TextBlock Text="Core Concept" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,2">
                                <TextBlock Text="{x:Bind Graph.CenterNode.PartOfSpeech, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,2">
                                <TextBlock Text="{x:Bind Graph.CenterNode.Level, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{x:Bind Graph.CenterNode.Term, Mode=OneWay}" FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="{x:Bind Graph.CenterNode.Ipa, Mode=OneWay}" FontFamily="Consolas, Segoe UI" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="13" />
                        <TextBlock Text="{x:Bind Graph.CenterNode.MeaningVi, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1" Click="PlayCenterAudio_Click" CornerRadius="20" Width="40" Height="40" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Relationship Filter Tabs -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="TabAllBtn" Content="{x:Bind AllTabText, Mode=OneWay}" Click="FilterTab_Click" Tag="All"
                        Style="{ThemeResource AccentButtonStyle}" CornerRadius="6" Padding="12,5" FontSize="12" />
                <Button x:Name="TabSynBtn" Content="{x:Bind Loc.GetString('KnowledgeGraph_SynonymsTab')}" Click="FilterTab_Click" Tag="Synonym"
                        CornerRadius="6" Padding="12,5" FontSize="12" />
                <Button x:Name="TabAntBtn" Content="{x:Bind Loc.GetString('KnowledgeGraph_AntonymsTab')}" Click="FilterTab_Click" Tag="Antonym"
                        CornerRadius="6" Padding="12,5" FontSize="12" />
                <Button x:Name="TabFamBtn" Content="{x:Bind Loc.GetString('KnowledgeGraph_FamilyTab')}" Click="FilterTab_Click" Tag="WordFamily"
                        CornerRadius="6" Padding="12,5" FontSize="12" />
                <Button x:Name="TabColBtn" Content="{x:Bind Loc.GetString('KnowledgeGraph_CollocationsTab')}" Click="FilterTab_Click" Tag="Collocation"
                        CornerRadius="6" Padding="12,5" FontSize="12" />
            </StackPanel>

            <!-- Connected Nodes List -->
            <ItemsControl ItemsSource="{x:Bind FilteredNodes, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dto:GraphNodeDto">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                <!-- Relationship Tag -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind RelationshipLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Term}" FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="{x:Bind Ipa}" FontFamily="Consolas, Segoe UI" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind MeaningVi}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Level}" FontSize="11" FontWeight="Bold" />
                                </Border>

                                <Button Grid.Column="3" Click="PivotToNode_Click" Tag="{x:Bind Id}"
                                        ToolTipService.ToolTip="{x:Bind RelationshipLabel}" CornerRadius="6" Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE895;" FontSize="12" />
                                        <TextBlock Text="Pivot" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
