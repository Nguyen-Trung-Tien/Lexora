<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.SmartImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DefaultButton="Primary"
    CornerRadius="16">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">580</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">460</x:Double>
    </ContentDialog.Resources>

    <Grid Width="500" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
        <!-- Subtitle / Info note -->
        <TextBlock x:Name="SubtitleText"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Input Method Selector (Segmented look) -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button x:Name="BtnModeFile"
                    HorizontalAlignment="Stretch"
                    CornerRadius="8"
                    Padding="12,8"
                    Click="BtnModeFile_Click">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xED43;" FontSize="15" />
                    <TextBlock x:Name="TextModeFile" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnModePaste"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    CornerRadius="8"
                    Padding="12,8"
                    Click="BtnModePaste_Click">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE77F;" FontSize="15" />
                    <TextBlock x:Name="TextModePaste" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Input Area Panel -->
        <Grid Grid.Row="2">
            <!-- Mode 1: File Selection -->
            <StackPanel x:Name="PanelFile" Spacing="10">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8E5;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                        <Button x:Name="BtnBrowseFile"
                                HorizontalAlignment="Center"
                                Style="{ThemeResource AccentButtonStyle}"
                                CornerRadius="8"
                                Padding="16,8"
                                Click="BtnBrowseFile_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                                <TextBlock x:Name="TextBrowseFile" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="TextSelectedFile"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Mode 2: Paste Text -->
            <StackPanel x:Name="PanelPaste" Spacing="8" Visibility="Collapsed">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                    <TextBlock Text="Nội dung dữ liệu:"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            x:Name="BtnPasteClipboard"
                            Padding="8,4"
                            CornerRadius="6"
                            Click="BtnPasteClipboard_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE77F;" FontSize="12" />
                            <TextBlock x:Name="TextPasteClipboard" FontSize="11" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBox x:Name="InputTextBox"
                         Height="150"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         TextChanged="InputTextBox_TextChanged"
                         CornerRadius="8"
                         FontFamily="Consolas, Cascadia Code, Segoe UI"
                         FontSize="12" />
            </StackPanel>
        </Grid>

        <!-- Detection Badge & Template Button -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <!-- Format Detection Badge -->
            <Border x:Name="BorderFormatBadge"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon x:Name="IconFormatBadge" Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TextFormatBadge" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Sample Template Button with Menu -->
            <DropDownButton Grid.Column="1" CornerRadius="8" Padding="10,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                    <TextBlock x:Name="TextViewSample" FontSize="12" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="MenuItemSampleJson" Text="Mẫu JSON" Click="MenuItemSampleJson_Click" />
                        <MenuFlyoutItem x:Name="MenuItemSampleCsv" Text="Mẫu CSV" Click="MenuItemSampleCsv_Click" />
                        <MenuFlyoutItem x:Name="MenuItemSampleTxt" Text="Mẫu TXT / Anki / Quizlet" Click="MenuItemSampleTxt_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- Conflict Resolution Options -->
        <Border Grid.Row="4"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,10">
            <StackPanel Spacing="6">
                <TextBlock x:Name="TextConflictTitle"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <RadioButton x:Name="RadioConflictSkip"
                             IsChecked="True"
                             FontSize="12"
                             GroupName="ConflictResolution" />
                <RadioButton x:Name="RadioConflictOverwrite"
                             FontSize="12"
                             GroupName="ConflictResolution" />
            </StackPanel>
        </Border>
    </Grid>
</ContentDialog>
