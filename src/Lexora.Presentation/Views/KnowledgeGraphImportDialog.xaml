<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.KnowledgeGraphImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dto="using:Lexora.Application.DTOs"
    mc:Ignorable="d"
    CornerRadius="16">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
    </ContentDialog.Resources>

    <Grid MaxWidth="620" HorizontalAlignment="Stretch" RowDefinitions="Auto,*" RowSpacing="14">
        <!-- Step Breadcrumbs Header -->
        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto,*,Auto,*">
                <StackPanel x:Name="Step1Badge" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Border x:Name="Step1NumberBorder" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Step1Text" Text="Nguồn dữ liệu" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>

                <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="4,0" />

                <StackPanel x:Name="Step2Badge" Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Border x:Name="Step2NumberBorder" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="Step2NumberText" Text="2" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Step2Text" Text="Xem trước &amp; Kiểm tra" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="4,0" />

                <StackPanel x:Name="Step3Badge" Grid.Column="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Border x:Name="Step3NumberBorder" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="Step3NumberText" Text="3" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Step3Text" Text="Kết quả" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dynamic Content Body -->
        <Grid Grid.Row="1">
            <!-- ================= STEP 1: SOURCE SELECTION ================= -->
            <StackPanel x:Name="PanelStep1" Spacing="12" Visibility="Visible">
                <TextBlock Text="Nhập các liên kết ngữ nghĩa (đồng nghĩa, trái nghĩa, họ từ, collocation) từ tệp JSON hoặc bảng CSV để mở rộng mạng lưới tri thức Lexora."
                           TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button x:Name="BtnModeFile" HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,8" Click="BtnModeFile_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xED43;" FontSize="15" />
                            <TextBlock Text="Chọn tệp (.json, .csv)" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnModePaste" Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,8" Click="BtnModePaste_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE77F;" FontSize="15" />
                            <TextBlock Text="Dán trực tiếp văn bản" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- File Mode Panel -->
                <StackPanel x:Name="PanelFileMode" Spacing="10" Visibility="Collapsed">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8E5;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="SelectedFileNameText" Text="Chưa chọn tệp dữ liệu" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <Button Content="Duyệt tệp tin trên máy..." Click="BrowseFile_Click" HorizontalAlignment="Center" CornerRadius="8" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Paste Mode Panel -->
                <StackPanel x:Name="PanelPasteMode" Spacing="8" Visibility="Visible">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="Định dạng dữ liệu:" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                            <RadioButton x:Name="RadioFormatJson" Content="JSON (.json)" IsChecked="True" Checked="FormatRadio_Checked" />
                            <RadioButton x:Name="RadioFormatCsv" Content="CSV (.csv)" Checked="FormatRadio_Checked" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Dán dữ liệu mẫu" Click="PasteSample_Click" CornerRadius="6" Padding="8,4" FontSize="11" />
                    </Grid>

                    <TextBox x:Name="InputTextBox" AcceptsReturn="True" TextWrapping="NoWrap"
                             PlaceholderText="Dán nội dung JSON hoặc CSV vào đây..."
                             Height="170" FontFamily="Consolas, Cascadia Code, monospace" FontSize="12" CornerRadius="8" />
                </StackPanel>

                <!-- Options -->
                <CheckBox x:Name="CheckAutoCreateMissing" IsChecked="True" Margin="0,4,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Tự động tạo từ vựng mới nếu chưa có trong từ điển" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Tạo các thẻ từ vựng với định nghĩa liên kết để hiển thị ngay trên đồ thị"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </CheckBox>

                <InfoBar x:Name="Step1InfoBar" IsOpen="False" Severity="Error" Margin="0,4,0,0" />
            </StackPanel>

            <!-- ================= STEP 2: PREVIEW & VALIDATION ================= -->
            <StackPanel x:Name="PanelStep2" Spacing="12" Visibility="Collapsed">
                <!-- Summary Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <Grid ColumnDefinitions="*,*,*">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Tổng số liên kết" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TextSummaryTotal" Text="0" FontSize="18" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Hợp lệ" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock x:Name="TextSummaryValid" Text="0" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="Từ mới cần tạo" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="TextSummaryMissing" Text="0" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Preview List -->
                <TextBlock Text="Danh sách liên kết được phát hiện:" FontWeight="SemiBold" FontSize="12" />
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" MaxHeight="220">
                    <ListView x:Name="PreviewListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dto:KnowledgeGraphImportItemDto">
                                <Grid Padding="8,6" ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{x:Bind RowNumber}" Width="24" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind SourceTerm}" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind RelationshipType}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{x:Bind TargetTerm}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind StatusMessage}" FontSize="10" MaxWidth="160" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <InfoBar x:Name="Step2InfoBar" IsOpen="False" Severity="Informational" />
            </StackPanel>

            <!-- ================= STEP 3: RESULTS ================= -->
            <StackPanel x:Name="PanelStep3" Spacing="14" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE73E;" FontSize="44" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Nhập dữ liệu đồ thị thành công!" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Width="400">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Số quan hệ ngữ nghĩa đã liên kết:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ResultImportedCount" Grid.Column="1" FontWeight="Bold" Text="0" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Số từ vựng đã cập nhật ghi chú:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ResultUpdatedWordsCount" Grid.Column="1" FontWeight="Bold" Text="0" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Số từ vựng mới đã tạo:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ResultCreatedWordsCount" Grid.Column="1" FontWeight="Bold" Text="0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
