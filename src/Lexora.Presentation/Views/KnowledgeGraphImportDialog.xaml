<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.KnowledgeGraphImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dto="using:Lexora.Application.DTOs"
    mc:Ignorable="d"
    CornerRadius="16">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">880</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <FontIcon Glyph="&#xE8B5;" FontSize="16"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding}" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <ScrollViewer MaxHeight="500" HorizontalAlignment="Stretch"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,4,12,8">
        <Grid MaxWidth="840" HorizontalAlignment="Stretch" RowDefinitions="Auto,*" RowSpacing="14">
        <!-- Step Breadcrumbs Header -->
        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto,*,Auto,*">
                <StackPanel x:Name="Step1Badge" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Border x:Name="Step1NumberBorder" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Step1Text" Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_Step1')}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>

                <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="4,0" />

                <StackPanel x:Name="Step2Badge" Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Border x:Name="Step2NumberBorder" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="Step2NumberText" Text="2" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Step2Text" Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_Step2')}" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="4,0" />

                <StackPanel x:Name="Step3Badge" Grid.Column="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Border x:Name="Step3NumberBorder" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="Step3NumberText" Text="3" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Step3Text" Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_Step3')}" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dynamic Content Body -->
        <Grid Grid.Row="1">
            <!-- ================= STEP 1: SOURCE SELECTION ================= -->
            <StackPanel x:Name="PanelStep1" Spacing="12" Visibility="Visible">
                <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_Description')}"
                           TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button x:Name="BtnModeFile" HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,8" Style="{ThemeResource DefaultButtonStyle}" Click="BtnModeFile_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xED43;" FontSize="15" />
                            <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_ModeFile')}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnModePaste" Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,8" Style="{ThemeResource AccentButtonStyle}" Click="BtnModePaste_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE77F;" FontSize="15" />
                            <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_ModePaste')}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- File Mode Panel -->
                <StackPanel x:Name="PanelFileMode" Spacing="10" Visibility="Collapsed">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8E5;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="SelectedFileNameText" Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_NoFileSelected')}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <Button Content="{x:Bind Loc.GetString('KnowledgeGraph_Import_Browse')}" Click="BrowseFile_Click" HorizontalAlignment="Center" CornerRadius="8" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Paste Mode Panel -->
                <StackPanel x:Name="PanelPasteMode" Spacing="8" Visibility="Visible">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_DataFormat')}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                            <RadioButton x:Name="RadioFormatJson" GroupName="KnowledgeImportFormat" Content="JSON (.json)" IsChecked="True" Checked="FormatRadio_Checked" />
                            <RadioButton x:Name="RadioFormatCsv" GroupName="KnowledgeImportFormat" Content="CSV (.csv)" Checked="FormatRadio_Checked" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{x:Bind Loc.GetString('KnowledgeGraph_Import_PasteSample')}" Click="PasteSample_Click" CornerRadius="6" Padding="8,4" FontSize="11" />
                    </Grid>

                    <TextBox x:Name="InputTextBox" AcceptsReturn="True" TextWrapping="NoWrap"
                             PlaceholderText="{x:Bind Loc.GetString('KnowledgeGraph_Import_Placeholder')}"
                             MinHeight="220" Height="240" FontFamily="Consolas, Cascadia Code, monospace" FontSize="12" CornerRadius="8" />
                </StackPanel>

                <!-- Options -->
                <CheckBox x:Name="CheckAutoCreateMissing" IsChecked="True" Margin="0,4,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_AutoCreateTitle')}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_AutoCreateDesc')}"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </CheckBox>

                <InfoBar x:Name="Step1InfoBar" IsOpen="False" Severity="Error" Margin="0,4,0,0" />
            </StackPanel>

            <!-- ================= STEP 2: PREVIEW & VALIDATION ================= -->
            <StackPanel x:Name="PanelStep2" Spacing="12" Visibility="Collapsed">
                <!-- Summary Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <Grid ColumnDefinitions="*,*,*">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_SummaryTotal')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TextSummaryTotal" Text="0" FontSize="18" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_SummaryValid')}" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock x:Name="TextSummaryValid" Text="0" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_SummaryMissing')}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="TextSummaryMissing" Text="0" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Preview List -->
                <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_PreviewHeader')}" FontWeight="SemiBold" FontSize="12" />
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" MaxHeight="220">
                    <ListView x:Name="PreviewListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dto:KnowledgeGraphImportItemDto">
                                <Grid Padding="8,6" ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{x:Bind RowNumber}" Width="24" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind SourceTerm}" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind RelationshipType}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{x:Bind TargetTerm}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind StatusMessage}" FontSize="10" MaxWidth="160" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <InfoBar x:Name="Step2InfoBar" IsOpen="False" Severity="Informational" />
            </StackPanel>

            <!-- ================= STEP 3: RESULTS ================= -->
            <StackPanel x:Name="PanelStep3" Spacing="14" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE73E;" FontSize="44" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_SuccessTitle')}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Width="400">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_ResRelations')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ResultImportedCount" Grid.Column="1" FontWeight="Bold" Text="0" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_ResUpdated')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ResultUpdatedWordsCount" Grid.Column="1" FontWeight="Bold" Text="0" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_Import_ResCreated')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ResultCreatedWordsCount" Grid.Column="1" FontWeight="Bold" Text="0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</ContentDialog>
