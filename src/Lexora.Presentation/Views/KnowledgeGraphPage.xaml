<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.KnowledgeGraphPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dto="using:Lexora.Application.DTOs"
    xmlns:views="using:Lexora.Presentation.Views"
    xmlns:services="using:Lexora.Presentation.Services"
    SizeChanged="Page_SizeChanged"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <!-- Top Command Bar / Header Area -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12,20,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Page Title with Compact Navigation Back Button -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="BtnHistoryBack"
                            Click="BtnHistoryBack_Click"
                            IsEnabled="{x:Bind ViewModel.HasHistory, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('KnowledgeGraph_HistoryBack')}"
                            CornerRadius="8" Width="36" Height="36" Padding="0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72B;" FontSize="13" />
                    </Button>

                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <FontIcon Glyph="&#xE81E;" FontSize="18"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" MaxWidth="300">
                        <TextBlock x:Name="PageTitleText" Text="{x:Bind Loc.GetString('KnowledgeGraph_Title')}" FontWeight="Bold" FontSize="17" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PageSubtitleText" Text="{x:Bind Loc.GetString('KnowledgeGraph_Subtitle')}"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <!-- Search Box in Header -->
                <AutoSuggestBox x:Name="HeaderSearchBox"
                                Grid.Column="1"
                                Margin="16,0,16,0"
                                MinWidth="180"
                                MaxWidth="320"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                PlaceholderText="{x:Bind Loc.GetString('KnowledgeGraph_SearchPlaceholder')}"
                                QueryIcon="Find"
                                TextChanged="HeaderSearchBox_TextChanged"
                                SuggestionChosen="HeaderSearchBox_SuggestionChosen"
                                QuerySubmitted="HeaderSearchBox_QuerySubmitted"
                                CornerRadius="8" Padding="10,6">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:WordDto">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,4">
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Level}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Term}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{x:Bind PrimaryDefinition}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind PrimaryPartOfSpeech}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>

                <!-- Action Controls Row -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- Recommendations Flyout Button -->
                    <DropDownButton x:Name="BtnRecommendations" ToolTipService.ToolTip="{x:Bind Loc.GetString('KnowledgeGraph_RecommendButton')}" CornerRadius="8" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B5;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="BtnRecommendationsText" Text="{x:Bind Loc.GetString('KnowledgeGraph_RecommendButton')}" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout Placement="Bottom">
                                <Border Width="340" MaxHeight="420" Padding="8">
                                    <StackPanel Spacing="10">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_RecommendTitle')}" FontWeight="Bold" FontSize="13" />
                                            <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_RecommendSubtitle')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <MenuFlyoutSeparator Margin="0,2,0,2" />
                                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.Recommendations, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="dto:KnowledgeGraphRecommendationDto">
                                                        <Button Click="RecommendItem_Click" Tag="{x:Bind Id}"
                                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="8,6" Margin="0,2">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Level}" FontSize="10" FontWeight="Bold" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                    <TextBlock Text="{x:Bind Term}" FontWeight="SemiBold" FontSize="13" />
                                                                    <TextBlock Text="{x:Bind Reason}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <Border Grid.Column="2" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Width="20" Height="20" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind EstimatedConnections}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Smart Import Button -->
                    <Button x:Name="BtnSmartImport" Click="BtnSmartImport_Click" ToolTipService.ToolTip="{x:Bind Loc.GetString('KnowledgeGraph_SmartImport')}" CornerRadius="8" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xED43;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="BtnSmartImportText" Text="{x:Bind Loc.GetString('KnowledgeGraph_SmartImport')}" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <!-- Export Dropdown -->
                    <DropDownButton x:Name="BtnExport" ToolTipService.ToolTip="{x:Bind Loc.GetString('KnowledgeGraph_Export')}" CornerRadius="8" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEDE1;" FontSize="13" />
                            <TextBlock x:Name="BtnExportText" Text="{x:Bind Loc.GetString('KnowledgeGraph_Export')}" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="{x:Bind Loc.GetString('KnowledgeGraph_ExportJson')}" Click="ExportJson_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE943;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="{x:Bind Loc.GetString('KnowledgeGraph_ExportCsv')}" Click="ExportCsv_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xED43;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="{x:Bind Loc.GetString('KnowledgeGraph_ExportMarkdown')}" Click="ExportMarkdown_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C4;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- View Mode Toggle -->
                    <Button x:Name="BtnViewMode" Click="BtnViewMode_Click" ToolTipService.ToolTip="{x:Bind ViewModel.ViewModeButtonText, Mode=OneWay}" CornerRadius="8" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="{x:Bind ViewModel.ViewModeIconGlyph, Mode=OneWay}" FontSize="13" />
                            <TextBlock x:Name="BtnViewModeText" Text="{x:Bind ViewModel.ViewModeButtonText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Two-Pane Master Detail / Catalog & Graph -->
        <Grid Grid.Row="1" ColumnDefinitions="340,*">

            <!-- LEFT PANE: Concept Catalog with Pagination & Filters -->
            <Border Grid.Column="0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="16,14,16,14">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">

                    <!-- Catalog Header & Search -->
                    <StackPanel Grid.Row="0" Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_CatalogHeader')}" FontWeight="Bold" FontSize="14" />
                                <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_CatalogSubtitle')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ProgressRing Grid.Column="1" Width="16" Height="16" IsActive="{x:Bind ViewModel.IsCatalogLoading, Mode=OneWay}" />
                        </Grid>

                        <TextBox x:Name="CatalogSearchTextBox"
                                 PlaceholderText="{x:Bind Loc.GetString('KnowledgeGraph_SearchInCatalog')}"
                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                                 KeyDown="CatalogSearchTextBox_KeyDown"
                                 CornerRadius="6" Padding="10,6" FontSize="12">
                        </TextBox>
                    </StackPanel>

                    <!-- CEFR Level Filter Pills -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="{x:Bind Loc.GetString('KnowledgeGraph_FilterAll')}" Click="LevelFilter_Click" Tag="All"
                                    Style="{ThemeResource AccentButtonStyle}" x:Name="LevelFilterAllBtn" CornerRadius="6" Padding="10,4" FontSize="11" />
                            <Button Content="A1" Click="LevelFilter_Click" Tag="A1" x:Name="LevelFilterA1Btn" CornerRadius="6" Padding="10,4" FontSize="11" />
                            <Button Content="A2" Click="LevelFilter_Click" Tag="A2" x:Name="LevelFilterA2Btn" CornerRadius="6" Padding="10,4" FontSize="11" />
                            <Button Content="B1" Click="LevelFilter_Click" Tag="B1" x:Name="LevelFilterB1Btn" CornerRadius="6" Padding="10,4" FontSize="11" />
                            <Button Content="B2" Click="LevelFilter_Click" Tag="B2" x:Name="LevelFilterB2Btn" CornerRadius="6" Padding="10,4" FontSize="11" />
                            <Button Content="C1" Click="LevelFilter_Click" Tag="C1" x:Name="LevelFilterC1Btn" CornerRadius="6" Padding="10,4" FontSize="11" />
                            <Button Content="C2" Click="LevelFilter_Click" Tag="C2" x:Name="LevelFilterC2Btn" CornerRadius="6" Padding="10,4" FontSize="11" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Paged Concepts List -->
                    <ListView Grid.Row="2"
                              ItemsSource="{x:Bind ViewModel.PagedConcepts, Mode=OneWay}"
                              SelectionMode="None"
                              Padding="0,4,0,4">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,2,0,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dto:KnowledgeGraphConceptSummaryDto">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                        <!-- CEFR Badge -->
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Level}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>

                                        <!-- Term & Definition -->
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Term}" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="{x:Bind Ipa}" FontFamily="Consolas, Segoe UI" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind MeaningVi}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                        </StackPanel>

                                        <!-- Connections count badge & Open Button -->
                                        <Button Grid.Column="2" Click="ConceptItem_Click" Tag="{x:Bind Id}"
                                                ToolTipService.ToolTip="{x:Bind services:LocalizationHelper.GetString('KnowledgeGraph_CoreConcept')}"
                                                CornerRadius="6" Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE81E;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind TotalConnections}" FontSize="11" FontWeight="Bold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Pagination Controls -->
                    <Border Grid.Row="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="8,6">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <Button Click="PrevPage_Click" IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                                    CornerRadius="6" Padding="8,4" ToolTipService.ToolTip="{x:Bind Loc.GetString('Vocab_PrevPage')}">
                                <FontIcon Glyph="&#xE76B;" FontSize="11" />
                            </Button>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind ViewModel.PageDisplayInfo, Mode=OneWay}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.ItemsRangeDisplay, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="2" Click="NextPage_Click" IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                                    CornerRadius="6" Padding="8,4" ToolTipService.ToolTip="{x:Bind Loc.GetString('Vocab_NextPage')}">
                                <FontIcon Glyph="&#xE76C;" FontSize="11" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANE: Graph Canvas & Semantic Relations Hub -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" Padding="24,18,24,24">

                    <!-- Loading Indicator -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                Visibility="{x:Bind ViewModel.IsGraphLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ProgressRing IsActive="True" Width="20" Height="20" />
                        <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_Generating')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Center Word Hero Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="22,18">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <!-- Top row: Status, POS, Level & Actions -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_CoreConcept')}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,3">
                                        <TextBlock Text="{x:Bind ViewModel.ActiveGraph.CenterNode.PartOfSpeech, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,3">
                                        <TextBlock Text="{x:Bind ViewModel.ActiveGraph.CenterNode.Level, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <!-- Play US Audio Button -->
                                    <Button Click="PlayAudioUs_Click" ToolTipService.ToolTip="{x:Bind Loc.GetString('Vocab_PlayUsPronunciation')}" CornerRadius="20" Width="36" Height="36" Padding="0">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Button>
                                    <!-- Play UK Audio Button -->
                                    <Button Click="PlayAudioUk_Click" ToolTipService.ToolTip="{x:Bind Loc.GetString('Vocab_PlayUkPronunciation')}" CornerRadius="20" Width="36" Height="36" Padding="0">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    </Button>
                                    <!-- View in Vocabulary Button -->
                                    <Button Click="ViewInVocab_Click" ToolTipService.ToolTip="{x:Bind Loc.GetString('KnowledgeGraph_ViewInVocab')}" CornerRadius="8" Padding="10,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE82D;" FontSize="12" />
                                            <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_ViewInVocab')}" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Middle row: Term, IPA, Meaning -->
                            <StackPanel Grid.Row="1" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.ActiveGraph.CenterNode.Term, Mode=OneWay}" FontSize="28" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.ActiveGraph.CenterNode.Ipa, Mode=OneWay}" FontFamily="Consolas, Segoe UI" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.ActiveGraph.CenterNode.MeaningVi, Mode=OneWay}" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.ActiveGraph.CenterNode.MeaningEn, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontStyle="Italic"
                                           Visibility="{x:Bind ViewModel.ActiveGraph.CenterNode.MeaningEn, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- Bottom row: Semantic Connectivity Counters -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="8" Margin="0,4,0,0">
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="10,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_SynonymsTab')}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ActiveGraph.SynonymsCount, Mode=OneWay}" FontWeight="Bold" FontSize="14" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="10,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_AntonymsTab')}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ActiveGraph.AntonymsCount, Mode=OneWay}" FontWeight="Bold" FontSize="14" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="10,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_FamilyTab')}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ActiveGraph.WordFamilyCount, Mode=OneWay}" FontWeight="Bold" FontSize="14" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="10,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_CollocationsTab')}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ActiveGraph.CollocationsCount, Mode=OneWay}" FontWeight="Bold" FontSize="14" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="10,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_TopicTab')}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ActiveGraph.TopicWordsCount, Mode=OneWay}" FontWeight="Bold" FontSize="14" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="5" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="10,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_Connections')}" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ViewModel.ActiveGraph.TotalConnections, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Filter Tabs Row -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="TabAllBtn" Content="{x:Bind ViewModel.AllTabText, Mode=OneWay}" Click="FilterTab_Click" Tag="All"
                                    Style="{ThemeResource AccentButtonStyle}" CornerRadius="6" Padding="14,6" FontSize="12" />
                            <Button x:Name="TabSynBtn" Content="{x:Bind ViewModel.SynonymsTabText, Mode=OneWay}" Click="FilterTab_Click" Tag="Synonym"
                                    CornerRadius="6" Padding="14,6" FontSize="12" />
                            <Button x:Name="TabAntBtn" Content="{x:Bind ViewModel.AntonymsTabText, Mode=OneWay}" Click="FilterTab_Click" Tag="Antonym"
                                    CornerRadius="6" Padding="14,6" FontSize="12" />
                            <Button x:Name="TabFamBtn" Content="{x:Bind ViewModel.FamilyTabText, Mode=OneWay}" Click="FilterTab_Click" Tag="WordFamily"
                                    CornerRadius="6" Padding="14,6" FontSize="12" />
                            <Button x:Name="TabColBtn" Content="{x:Bind ViewModel.CollocationsTabText, Mode=OneWay}" Click="FilterTab_Click" Tag="Collocation"
                                    CornerRadius="6" Padding="14,6" FontSize="12" />
                            <Button x:Name="TabTopBtn" Content="{x:Bind ViewModel.TopicTabText, Mode=OneWay}" Click="FilterTab_Click" Tag="TopicCluster"
                                    CornerRadius="6" Padding="14,6" FontSize="12" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- VISUAL GRAPH CANVAS (Radial Orbit Layout with Zoom Controls) -->
                    <Border x:Name="VisualGraphContainer"
                            Visibility="{x:Bind ViewModel.IsVisualMapMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="14" Height="520" Padding="12">
                        <Grid>
                            <Canvas x:Name="GraphCanvas" SizeChanged="GraphCanvas_SizeChanged" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <!-- Visual orbit nodes & connecting lines dynamically injected in code-behind -->
                            </Canvas>

                            <!-- Floating Canvas Zoom Controls -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Click="ZoomIn_Click" Padding="6" CornerRadius="4" ToolTipService.ToolTip="{x:Bind Loc.GetString('KnowledgeGraph_ZoomIn')}">
                                        <FontIcon Glyph="&#xE71E;" FontSize="11" />
                                    </Button>
                                    <Button Click="ZoomOut_Click" Padding="6" CornerRadius="4" ToolTipService.ToolTip="{x:Bind Loc.GetString('KnowledgeGraph_ZoomOut')}">
                                        <FontIcon Glyph="&#xE71F;" FontSize="11" />
                                    </Button>
                                    <Button Click="ResetZoom_Click" Padding="6" CornerRadius="4" ToolTipService.ToolTip="{x:Bind Loc.GetString('KnowledgeGraph_ResetZoom')}">
                                        <FontIcon Glyph="&#xE777;" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- CARDS LIST MODE -->
                    <StackPanel x:Name="CardsListContainer"
                                Visibility="{x:Bind ViewModel.IsVisualMapMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                Spacing="8">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredConnectedNodes, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dto:GraphNodeDto">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="16,12"
                                            Tapped="CardItem_Tapped" Tag="{x:Bind}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <!-- Relationship Tag -->
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind RelationshipLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>

                                            <!-- Term, IPA, Meanings, and Rationale -->
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Term}" FontWeight="Bold" FontSize="14" />
                                                    <TextBlock Text="{x:Bind Ipa}" FontFamily="Consolas, Segoe UI" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Level}" FontSize="10" FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind MeaningVi}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Explanation}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" TextWrapping="Wrap"
                                                           Visibility="{x:Bind Explanation, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </StackPanel>

                                            <!-- Weight indicator badge -->
                                            <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ConnectionWeight}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>

                                            <!-- Action Buttons: Audio, Select & Pivot -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Click="PlayNodeItemAudio_Click" Tag="{x:Bind Term}" ToolTipService.ToolTip="{x:Bind services:LocalizationHelper.GetString('Vocab_PlayUsPronunciation')}" CornerRadius="16" Width="32" Height="32" Padding="0">
                                                    <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                </Button>
                                                <Button Click="InspectNode_Click" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind services:LocalizationHelper.GetString('KnowledgeGraph_InspectDetails')}" CornerRadius="6" Padding="8,6">
                                                    <FontIcon Glyph="&#xE7B3;" FontSize="12" />
                                                </Button>
                                                <Button Click="PivotToNode_Click" Tag="{x:Bind Id}" ToolTipService.ToolTip="{x:Bind services:LocalizationHelper.GetString('KnowledgeGraph_PivotToNode')}" CornerRadius="6" Padding="10,6" Style="{ThemeResource AccentButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE895;" FontSize="12" />
                                                        <TextBlock Text="{x:Bind services:LocalizationHelper.GetString('KnowledgeGraph_Pivot')}" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- SELECTED NODE INSPECTOR DRAWER -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="18,14"
                            Visibility="{x:Bind ViewModel.HasSelectedNode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <!-- Top row: Node Term, POS, Level, Actions -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedNode.RelationshipLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedNode.Term, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedNode.Ipa, Mode=OneWay}" FontFamily="Consolas, Segoe UI" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedNode.Level, Mode=OneWay}" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Click="CopySelectedTerm_Click" CornerRadius="6" Padding="8,6" ToolTipService.ToolTip="{x:Bind Loc.GetString('KnowledgeGraph_CopyTerm')}">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                    </Button>
                                    <Button Click="ViewSelectedInVocab_Click" CornerRadius="6" Padding="8,6" ToolTipService.ToolTip="{x:Bind Loc.GetString('KnowledgeGraph_ViewInVocab')}">
                                        <FontIcon Glyph="&#xE82D;" FontSize="12" />
                                    </Button>
                                    <Button Click="PlaySelectedAudio_Click" CornerRadius="16" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="{x:Bind Loc.GetString('Vocab_PlayUsPronunciation')}">
                                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                                    </Button>
                                    <Button Click="PivotSelectedNode_Click" CornerRadius="6" Padding="10,6" Style="{ThemeResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE895;" FontSize="12" />
                                            <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_Pivot')}" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Meaning & Explanation -->
                            <StackPanel Grid.Row="1" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.SelectedNode.MeaningVi, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedNode.Explanation, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                           Visibility="{x:Bind ViewModel.SelectedNode.Explanation, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- Example Sentences -->
                            <Border Grid.Row="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12,8"
                                    Visibility="{x:Bind ViewModel.SelectedNode.ExampleSentenceEn, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{x:Bind Loc.GetString('KnowledgeGraph_ExampleSentence')}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedNode.ExampleSentenceEn, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedNode.ExampleSentenceVi, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Page>
