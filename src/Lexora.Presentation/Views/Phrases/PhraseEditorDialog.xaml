<ContentDialog
    x:Class="Lexora.Presentation.Views.Phrases.PhraseEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    UseLayoutRounding="True"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <Grid MaxWidth="720" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="ValidationInfoBar"
            Grid.Row="0"
            IsClosable="True"
            IsOpen="False"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Severity="Error" />

        <ScrollViewer
            Grid.Row="1"
            MaxHeight="540"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,8,0" Spacing="12">
                <!-- Quick Templates Section -->
                <Border
                    Padding="12"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="{x:Bind Loc.GetString('Phrases_QuickTemplates')}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <ComboBox
                                x:Name="TemplateComboBox"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                DisplayMemberPath="Title"
                                PlaceholderText="{x:Bind Loc.GetString('Phrases_SelectTemplateHint')}" />
                            <Button
                                Grid.Column="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Click="OnApplyTemplateClick"
                                Content="{x:Bind Loc.GetString('Phrases_ApplyTemplate')}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Scenario, Context, Level, Register, Exam -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <ComboBox
                        x:Name="CategoryComboBox"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Header="{x:Bind Loc.GetString('Phrases_CategoryLabel')}"
                        IsEditable="True" />
                    <TextBox
                        x:Name="ContextTagBox"
                        Grid.Column="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Header="{x:Bind Loc.GetString('Phrases_ContextTagLabel')}"
                        PlaceholderText="{x:Bind Loc.GetString('Phrases_ContextTagPlaceholder')}" />
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <ComboBox
                        x:Name="CefrComboBox"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Header="{x:Bind Loc.GetString('Phrases_CefrLabel')}"
                        SelectedIndex="2">
                        <ComboBoxItem Content="A1" />
                        <ComboBoxItem Content="A2" />
                        <ComboBoxItem Content="B1" />
                        <ComboBoxItem Content="B2" />
                        <ComboBoxItem Content="C1" />
                        <ComboBoxItem Content="C2" />
                    </ComboBox>

                    <ComboBox
                        x:Name="RegisterComboBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Header="{x:Bind Loc.GetString('Phrases_RegisterLabel')}"
                        SelectedIndex="0">
                        <ComboBoxItem Content="{x:Bind Loc.GetString('Phrases_RegisterNeutral')}" />
                        <ComboBoxItem Content="{x:Bind Loc.GetString('Phrases_RegisterFormal')}" />
                        <ComboBoxItem Content="{x:Bind Loc.GetString('Phrases_RegisterCasual')}" />
                        <ComboBoxItem Content="{x:Bind Loc.GetString('Phrases_RegisterIdiomatic')}" />
                    </ComboBox>

                    <ComboBox
                        x:Name="ExamTargetComboBox"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Header="{x:Bind Loc.GetString('Phrases_ExamTargetLabel')}"
                        SelectedIndex="0">
                        <ComboBoxItem Content="{x:Bind Loc.GetString('Phrases_ExamAll')}" />
                        <ComboBoxItem Content="TOEIC" />
                        <ComboBoxItem Content="IELTS" />
                        <ComboBoxItem Content="VSTEP" />
                    </ComboBox>
                </Grid>

                <!-- Speaker A Prompt -->
                <TextBox
                    x:Name="PromptSentenceBox"
                    AcceptsReturn="True"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Header="{x:Bind Loc.GetString('Phrases_PromptSentenceLabel')}"
                    PlaceholderText="{x:Bind Loc.GetString('Phrases_PromptSentencePlaceholder')}"
                    TextWrapping="Wrap" />

                <TextBox
                    x:Name="PromptTranslationBox"
                    AcceptsReturn="True"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Header="{x:Bind Loc.GetString('Phrases_PromptTranslationLabel')}"
                    PlaceholderText="{x:Bind Loc.GetString('Phrases_PromptTranslationPlaceholder')}"
                    TextWrapping="Wrap" />

                <!-- Speaker B Response -->
                <TextBox
                    x:Name="SampleResponseBox"
                    AcceptsReturn="True"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Header="{x:Bind Loc.GetString('Phrases_SampleResponseLabel')}"
                    PlaceholderText="{x:Bind Loc.GetString('Phrases_SampleResponsePlaceholder')}"
                    TextWrapping="Wrap" />

                <TextBox
                    x:Name="ResponseTranslationBox"
                    AcceptsReturn="True"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Header="{x:Bind Loc.GetString('Phrases_ResponseTranslationLabel')}"
                    PlaceholderText="{x:Bind Loc.GetString('Phrases_ResponseTranslationPlaceholder')}"
                    TextWrapping="Wrap" />

                <!-- Key Phrases, Formal & Casual Variations -->
                <TextBox
                    x:Name="KeyPhrasesBox"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Header="{x:Bind Loc.GetString('Phrases_KeyPhrasesLabel')}"
                    PlaceholderText="{x:Bind Loc.GetString('Phrases_KeyPhrasesPlaceholder')}"
                    TextWrapping="Wrap" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <TextBox
                        x:Name="FormalVariationBox"
                        Grid.Column="0"
                        AcceptsReturn="True"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Header="{x:Bind Loc.GetString('Phrases_FormalVariationLabel')}"
                        PlaceholderText="{x:Bind Loc.GetString('Phrases_VariationPlaceholder')}"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="CasualVariationBox"
                        Grid.Column="1"
                        AcceptsReturn="True"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Header="{x:Bind Loc.GetString('Phrases_CasualVariationLabel')}"
                        PlaceholderText="{x:Bind Loc.GetString('Phrases_VariationPlaceholder')}"
                        TextWrapping="Wrap" />
                </Grid>

                <!-- Vietnamese Common Mistakes & Notes -->
                <TextBox
                    x:Name="CommonMistakesBox"
                    AcceptsReturn="True"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Header="{x:Bind Loc.GetString('Phrases_CommonMistakesLabel')}"
                    PlaceholderText="{x:Bind Loc.GetString('Phrases_CommonMistakesPlaceholder')}"
                    TextWrapping="Wrap" />

                <TextBox
                    x:Name="AdditionalSuggestionsBox"
                    AcceptsReturn="True"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Header="{x:Bind Loc.GetString('Phrases_AdditionalNotesLabel')}"
                    PlaceholderText="{x:Bind Loc.GetString('Phrases_AdditionalNotesPlaceholder')}"
                    TextWrapping="Wrap" />

                <CheckBox
                    x:Name="IsFavoriteCheckBox"
                    Content="{x:Bind Loc.GetString('Phrases_MarkFavorite')}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
