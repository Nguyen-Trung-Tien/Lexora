<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.Phrases.PhraseEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    DefaultButton="Primary"
    CornerRadius="8"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">880</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">500</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/brand/lexora-icon-only.png" Width="24" Height="24" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding}" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <ScrollViewer MaxHeight="540" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,12,8">
        <StackPanel Spacing="16">
            <!-- Validation Error InfoBar at Top -->
            <InfoBar x:Name="DialogInfoBar" IsOpen="False" Severity="Error" Margin="0,0,0,4" />

            <!-- Card 1: Context & CEFR Level -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8EC;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Loc.GetString('Phrases_EditorCategoryHeader')}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid ColumnDefinitions="1.2*,1*,0.8*" ColumnSpacing="12">
                        <ComboBox x:Name="CategoryComboBox"
                                  Header="{x:Bind Loc.GetString('Phrases_EditorCategoryHeader')}"
                                  PlaceholderText="{x:Bind Loc.GetString('Phrases_EditorCategoryPlaceholder')}"
                                  IsEditable="True"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Greetings &amp; Introductions" IsSelected="True" />
                            <ComboBoxItem Content="Workplace &amp; Office" />
                            <ComboBoxItem Content="Job Interviews" />
                            <ComboBoxItem Content="Travel &amp; Directions" />
                            <ComboBoxItem Content="Dining &amp; Shopping" />
                            <ComboBoxItem Content="TOEIC &amp; VSTEP Speaking" />
                            <ComboBoxItem Content="Daily Conversation &amp; Socializing" />
                        </ComboBox>

                        <TextBox x:Name="TagTextBox" Grid.Column="1"
                                 Header="{x:Bind Loc.GetString('Phrases_EditorTagHeader')}"
                                 PlaceholderText="{x:Bind Loc.GetString('Phrases_EditorTagPlaceholder')}" />

                        <ComboBox x:Name="LevelComboBox" Grid.Column="2"
                                  Header="{x:Bind Loc.GetString('Phrases_EditorLevelHeader')}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="A1" Tag="A1" />
                            <ComboBoxItem Content="A2" Tag="A2" />
                            <ComboBoxItem Content="B1" Tag="B1" IsSelected="True" />
                            <ComboBoxItem Content="B2" Tag="B2" />
                            <ComboBoxItem Content="C1" Tag="C1" />
                            <ComboBoxItem Content="C2" Tag="C2" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: Prompt / Greeting Sentence -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8BD;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Loc.GetString('Phrases_PromptSectionTitle')}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBox x:Name="PromptTextBox"
                             Header="{x:Bind Loc.GetString('Phrases_EditorPromptHeader')}"
                             PlaceholderText="{x:Bind Loc.GetString('Phrases_EditorPromptPlaceholder')}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" MaxHeight="100" />

                    <TextBox x:Name="PromptTransTextBox"
                             Header="{x:Bind Loc.GetString('Phrases_EditorPromptTransHeader')}"
                             PlaceholderText="{x:Bind Loc.GetString('Phrases_EditorPromptTransPlaceholder')}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" MaxHeight="100" />
                </StackPanel>
            </Border>

            <!-- Card 3: Sample Response -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F2;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Loc.GetString('Phrases_ResponseSectionTitle')}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBox x:Name="ResponseTextBox"
                             Header="{x:Bind Loc.GetString('Phrases_EditorResponseHeader')}"
                             PlaceholderText="{x:Bind Loc.GetString('Phrases_EditorResponsePlaceholder')}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" MaxHeight="120" />

                    <TextBox x:Name="ResponseTransTextBox"
                             Header="{x:Bind Loc.GetString('Phrases_EditorResponseTransHeader')}"
                             PlaceholderText="{x:Bind Loc.GetString('Phrases_EditorResponseTransPlaceholder')}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" MaxHeight="120" />
                </StackPanel>
            </Border>

            <!-- Card 4: Additional Suggestions & Quick Templates -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEA80;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Loc.GetString('Phrases_EditorSuggestionsHeader')}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Quick Suggestions Buttons Row -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind Loc.GetString('Phrases_QuickSuggestionsTitle')}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnInsertFormal" Content="{x:Bind Loc.GetString('Phrases_InsertFormal')}"
                                    Style="{ThemeResource DefaultButtonStyle}" FontSize="12" Click="BtnInsertFormal_Click" />
                            <Button x:Name="BtnInsertCasual" Content="{x:Bind Loc.GetString('Phrases_InsertCasual')}"
                                    Style="{ThemeResource DefaultButtonStyle}" FontSize="12" Click="BtnInsertCasual_Click" />
                            <Button x:Name="BtnInsertSynonyms" Content="{x:Bind Loc.GetString('Phrases_InsertSynonyms')}"
                                    Style="{ThemeResource DefaultButtonStyle}" FontSize="12" Click="BtnInsertSynonyms_Click" />
                            <Button x:Name="BtnInsertFollowUp" Content="{x:Bind Loc.GetString('Phrases_InsertFollowUp')}"
                                    Style="{ThemeResource DefaultButtonStyle}" FontSize="12" Click="BtnInsertFollowUp_Click" />
                        </StackPanel>
                    </StackPanel>

                    <TextBox x:Name="SuggestionsTextBox"
                             PlaceholderText="{x:Bind Loc.GetString('Phrases_EditorSuggestionsPlaceholder')}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="96" MaxHeight="180" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
