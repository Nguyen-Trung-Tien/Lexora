<Page
    x:Class="Lexora.Presentation.Views.Phrases.PhrasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dtos="using:Lexora.Application.DTOs"
    Background="Transparent"
    NavigationCacheMode="Required" UseLayoutRounding="True">

    <Grid
        Padding="24,16,24,20"
        HorizontalAlignment="Stretch"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MasterColumn.Width" Value="330" />
                        <Setter Target="DetailColumn.Width" Value="*" />
                        <Setter Target="MasterRow.Height" Value="*" />
                        <Setter Target="DetailRow.Height" Value="0" />
                        <Setter Target="DetailPaneContainer.(Grid.Column)" Value="1" />
                        <Setter Target="DetailPaneContainer.(Grid.Row)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MasterColumn.Width" Value="*" />
                        <Setter Target="DetailColumn.Width" Value="0" />
                        <Setter Target="MasterRow.Height" Value="280" />
                        <Setter Target="DetailRow.Height" Value="*" />
                        <Setter Target="DetailPaneContainer.(Grid.Column)" Value="0" />
                        <Setter Target="DetailPaneContainer.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- ========================================================================= -->
        <!-- Row 0: Top Header & Primary Command Actions (Hidden in Roleplay Mode)     -->
        <!-- ========================================================================= -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="16"
            Visibility="{x:Bind ViewModel.IsRoleplayMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon
                        FontSize="22"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE8BD;" />
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind Loc.GetString('Phrases_HeaderTitle')}" />
                </StackPanel>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Loc.GetString('Phrases_HeaderSubtitle')}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Top Action Controls: Roleplay, Add, Import/Export, Audio Settings -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <!-- Roleplay Practice Button -->
                <Button
                    Click="OnStartRoleplayClick"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Padding="12,6"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE8FA;" />
                        <TextBlock Text="{x:Bind Loc.GetString('Phrases_StartRoleplay')}" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Add Phrase Button -->
                <Button Click="OnAddPhraseClick" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="{x:Bind Loc.GetString('Phrases_AddButton')}" />
                    </StackPanel>
                </Button>

                <!-- Import / Export DropDown -->
                <DropDownButton Content="{x:Bind Loc.GetString('Phrases_ImportExportButton')}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="10,6">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Click="OnImportFileClick" Text="{x:Bind Loc.GetString('Phrases_ImportAction')}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnCopyTemplateClick" Text="{x:Bind Loc.GetString('Phrases_CopyTemplateAction')}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnExportJsonClick" Text="{x:Bind Loc.GetString('Phrases_ExportJsonAction')}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE943;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnExportCsvClick" Text="{x:Bind Loc.GetString('Phrases_ExportCsvAction')}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xED43;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnExportTxtClick" Text="{x:Bind Loc.GetString('Phrases_ExportTxtAction')}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C4;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Audio Accent & Speed Settings Flyout -->
                <DropDownButton
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Padding="10,6"
                    ToolTipService.ToolTip="{x:Bind Loc.GetString('Phrases_AudioSettings')}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE767;" />
                        <TextBlock Text="{x:Bind Loc.GetString('Phrases_AudioSettings')}" FontSize="12" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="230" Spacing="10" Padding="4">
                                <TextBlock Text="{x:Bind Loc.GetString('Phrases_AudioSettings')}" FontWeight="Bold" FontSize="13" />

                                <TextBlock Text="{x:Bind Loc.GetString('Phrases_VoiceAccent')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="6"
                                    SelectedIndex="{x:Bind ViewModel.SelectedAccentIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="US — English (Mỹ)" />
                                    <ComboBoxItem Content="UK — English (Anh)" />
                                </ComboBox>

                                <TextBlock Text="{x:Bind Loc.GetString('Phrases_PlaybackSpeed')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="6"
                                    SelectedIndex="{x:Bind ViewModel.SelectedRateIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="0.75x (Chậm)" />
                                    <ComboBoxItem Content="1.0x (Chuẩn)" />
                                    <ComboBoxItem Content="1.25x (Nhanh vừa)" />
                                    <ComboBoxItem Content="1.5x (Nhanh)" />
                                </ComboBox>

                                <Button
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.StopAudioCommand}"
                                    CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE71A;" />
                                        <TextBlock Text="{x:Bind Loc.GetString('Phrases_StopAudio')}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- ========================================================================= -->
        <!-- Row 1: Unified Filter Bar with Interactive Pills (Hidden in Roleplay)    -->
        <!-- ========================================================================= -->
        <Border
            Grid.Row="1"
            Padding="14,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Visibility="{x:Bind ViewModel.IsRoleplayMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StackPanel Spacing="10">
                <!-- Top Filter Line: Interactive Filter Pills + Search Box -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <!-- Segmented Interactive Filter Chips (Horizontal Scroll Safety) -->
                    <ScrollViewer
                        Grid.Column="0"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- All Pill -->
                            <Button
                                x:Name="BtnFilterAll"
                                Click="OnFilterAllClick"
                                CornerRadius="14"
                                Padding="12,5"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE8D2;" />
                                    <TextBlock FontWeight="SemiBold" FontSize="12">
                                        <Run Text="{x:Bind Loc.GetString('Phrases_FilterAll')}" />
                                        <Run Text=" (" />
                                        <Run Text="{x:Bind ViewModel.TotalPhraseCount, Mode=OneWay}" />
                                        <Run Text=")" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <!-- Favorites Pill -->
                            <Button
                                x:Name="BtnFilterFavorites"
                                Click="OnFilterFavoritesClick"
                                CornerRadius="14"
                                Padding="12,5">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE734;" />
                                    <TextBlock FontWeight="SemiBold" FontSize="12">
                                        <Run Text="{x:Bind Loc.GetString('Phrases_FilterFavorites')}" />
                                        <Run Text=" (" />
                                        <Run Text="{x:Bind ViewModel.FavoritePhraseCount, Mode=OneWay}" />
                                        <Run Text=")" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <!-- Due for Review Pill -->
                            <Button
                                x:Name="BtnFilterDue"
                                Click="OnFilterDueClick"
                                CornerRadius="14"
                                Padding="12,5">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE823;" />
                                    <TextBlock FontWeight="SemiBold" FontSize="12">
                                        <Run Text="{x:Bind Loc.GetString('Phrases_FilterDue')}" />
                                        <Run Text=" (" />
                                        <Run Text="{x:Bind ViewModel.DuePhraseCount, Mode=OneWay}" />
                                        <Run Text=")" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Search Box with Clear Button -->
                    <TextBox
                        Grid.Column="1"
                        CornerRadius="8"
                        PlaceholderText="{x:Bind Loc.GetString('Phrases_SearchPlaceholder')}"
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- Bottom Filter Line: Scenario, CEFR, Formality & Exam, Reset Button -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
                    <!-- Scenario / Category ComboBox -->
                    <ComboBox
                        Grid.Column="0"
                        MinWidth="170"
                        CornerRadius="8"
                        Header="{x:Bind Loc.GetString('Phrases_CategoryLabel')}"
                        ItemsSource="{x:Bind ViewModel.FilterCategories}"
                        SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />

                    <!-- CEFR Level ComboBox -->
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="90"
                        CornerRadius="8"
                        Header="{x:Bind Loc.GetString('Phrases_CefrLabel')}"
                        SelectedIndex="{x:Bind ViewModel.SelectedCefrIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="CEFR" />
                        <ComboBoxItem Content="A1" />
                        <ComboBoxItem Content="A2" />
                        <ComboBoxItem Content="B1" />
                        <ComboBoxItem Content="B2" />
                        <ComboBoxItem Content="C1" />
                        <ComboBoxItem Content="C2" />
                    </ComboBox>

                    <!-- Formality Register & Exam Focus (Compact Dropdown Flyout) -->
                    <DropDownButton
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE71C;" />
                            <TextBlock Text="{x:Bind Loc.GetString('Phrases_MoreFilters')}" FontSize="12" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="230" Spacing="10" Padding="4">
                                    <TextBlock Text="{x:Bind Loc.GetString('Phrases_RegisterLabel')}" FontWeight="SemiBold" FontSize="12" />
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="6"
                                        SelectedIndex="{x:Bind ViewModel.SelectedRegisterIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="{x:Bind Loc.GetString('Phrases_RegisterAll')}" />
                                        <ComboBoxItem Content="{x:Bind Loc.GetString('Phrases_RegisterNeutral')}" />
                                        <ComboBoxItem Content="{x:Bind Loc.GetString('Phrases_RegisterFormal')}" />
                                        <ComboBoxItem Content="{x:Bind Loc.GetString('Phrases_RegisterCasual')}" />
                                        <ComboBoxItem Content="{x:Bind Loc.GetString('Phrases_RegisterIdiomatic')}" />
                                    </ComboBox>

                                    <TextBlock Text="{x:Bind Loc.GetString('Phrases_ExamTargetLabel')}" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" />
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="6"
                                        SelectedIndex="{x:Bind ViewModel.SelectedExamTargetIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="{x:Bind Loc.GetString('Phrases_ExamAll')}" />
                                        <ComboBoxItem Content="TOEIC" />
                                        <ComboBoxItem Content="IELTS" />
                                        <ComboBoxItem Content="VSTEP" />
                                    </ComboBox>
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Reset Filters Button -->
                    <Button
                        Grid.Column="4"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.ResetFiltersCommand}"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                            <TextBlock Text="{x:Bind Loc.GetString('Phrases_ResetFilters')}" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- Row 2: Status & Feedback InfoBar                                         -->
        <!-- ========================================================================= -->
        <InfoBar
            Grid.Row="2"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

        <!-- ========================================================================= -->
        <!-- Row 3A: Responsive Master-Detail Browsing Workspace                      -->
        <!-- ========================================================================= -->
        <Grid
            x:Name="MasterDetailWorkspace"
            Grid.Row="3"
            ColumnSpacing="16"
            RowSpacing="12"
            Visibility="{x:Bind ViewModel.IsRoleplayMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MasterColumn" Width="330" />
                <ColumnDefinition x:Name="DetailColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="MasterRow" Height="*" />
                <RowDefinition x:Name="DetailRow" Height="0" />
            </Grid.RowDefinitions>

            <!-- Master Pane (Left list) -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <Grid RowDefinitions="Auto,*">
                    <ProgressBar
                        Grid.Row="0"
                        IsIndeterminate="True"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Empty List Hint -->
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="24"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.HasNoPhrases, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="32"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8BD;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind Loc.GetString('Phrases_EmptyTitle')}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Loc.GetString('Phrases_EmptySubtitle')}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Phrases Master ListView -->
                    <ListView
                        x:Name="MasterListView"
                        Grid.Row="1"
                        Padding="6"
                        ItemsSource="{x:Bind ViewModel.Phrases}"
                        SelectedItem="{x:Bind ViewModel.SelectedPhrase, Mode=TwoWay}"
                        SelectionChanged="OnPhraseListSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,3" />
                                <Setter Property="Padding" Value="2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:ConversationPhraseDto">
                                <Border
                                    Padding="12,10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                                    <StackPanel Spacing="5">
                                        <!-- Card Top: CEFR + Category + Due Badge + Favorite Star -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                <Border
                                                    Padding="6,2"
                                                    Background="{x:Bind CefrLevel, Mode=OneWay, Converter={StaticResource CefrToBrushConverter}}"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        FontSize="10.5"
                                                        FontWeight="Bold"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        Text="{x:Bind CefrLevel, Mode=OneWay}" />
                                                </Border>
                                                <Border
                                                    Padding="5,2"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        FontSize="10.5"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Category, Mode=OneWay}"
                                                        MaxWidth="130"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <Border
                                                    Padding="5,2"
                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    CornerRadius="4"
                                                    Visibility="{x:Bind IsDueForReview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock
                                                        FontSize="10.5"
                                                        FontWeight="Bold"
                                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                        Text="Due" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Favorite Star Button -->
                                            <Button
                                                Grid.Column="1"
                                                Padding="4,2"
                                                Click="OnCardToggleFavoriteClick"
                                                Background="Transparent"
                                                BorderBrush="Transparent">
                                                <FontIcon
                                                    FontSize="12"
                                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                    Glyph="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToStarGlyphConverter}}" />
                                            </Button>
                                        </Grid>

                                        <!-- Speaker A Prompt Sentence -->
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            MaxLines="2"
                                            Text="{x:Bind PromptSentence, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />

                                        <!-- Speaker B Response Sneak-Peek -->
                                        <TextBlock
                                            FontSize="11.5"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis">
                                            <Run Text="↳ " Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                            <Run Text="{x:Bind SampleResponse, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Detail Pane (Right workspace) -->
            <Border
                x:Name="DetailPaneContainer"
                Grid.Row="0"
                Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <Grid>
                    <!-- Empty Selection Hint -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="24"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.HasSelectedPhrase, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="36"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8BD;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Loc.GetString('Phrases_SelectPromptHint')}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Selected Phrase Detail View -->
                    <ScrollViewer
                        x:Name="DetailScrollViewer"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        SizeChanged="DetailScrollViewer_SizeChanged"
                        Visibility="{x:Bind ViewModel.HasSelectedPhrase, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel
                            x:Name="DetailCardRoot"
                            Padding="20"
                            Spacing="14">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition />
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>

                            <!-- Detail Header & Action Toolbar (Adaptive Non-Clipping Layout) -->
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Row: Metadata Badges (Left) & Action Toolbar (Right) with Horizontal Scroll Safety -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ScrollViewer
                                        Grid.Column="0"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Disabled"
                                        HorizontalScrollMode="Enabled"
                                        VerticalScrollMode="Disabled">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border
                                                Padding="8,3"
                                                Background="{x:Bind ViewModel.SelectedPhrase.CefrLevel, Mode=OneWay, Converter={StaticResource CefrToBrushConverter}}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Text="{x:Bind ViewModel.SelectedPhrase.CefrLevel, Mode=OneWay, FallbackValue=''}" />
                                            </Border>
                                            <Border
                                                Padding="8,3"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ViewModel.SelectedPhrase.RegisterLabel, Mode=OneWay, FallbackValue=''}" />
                                            </Border>
                                            <Border
                                                Padding="8,3"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Visibility="{x:Bind ViewModel.SelectedPhrase.HasExamTarget, Mode=OneWay, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Text="{x:Bind ViewModel.SelectedPhrase.ExamTargetLabel, Mode=OneWay, FallbackValue=''}" />
                                            </Border>
                                            <Border
                                                Padding="8,3"
                                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                    Text="{x:Bind ViewModel.SelectedPhrase.StatusLabel, Mode=OneWay, FallbackValue=''}" />
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Right: Action Toolbar -->
                                    <ScrollViewer
                                        Grid.Column="1"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Disabled"
                                        HorizontalScrollMode="Enabled"
                                        VerticalScrollMode="Disabled">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <!-- Play Full Conversation -->
                                            <Button
                                                Click="OnDetailPlayFullConversationClick"
                                                Style="{StaticResource AccentButtonStyle}"
                                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                                Padding="10,6"
                                                ToolTipService.ToolTip="{x:Bind Loc.GetString('Phrases_PlayFullDialogue')}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontSize="13" Glyph="&#xE768;" />
                                                    <TextBlock Text="{x:Bind Loc.GetString('Phrases_PlayFullDialogue')}" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Favorite Toggle Button -->
                                            <Button
                                                Click="OnDetailToggleFavoriteClick"
                                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                                Padding="8,6"
                                                ToolTipService.ToolTip="{x:Bind Loc.GetString('Phrases_StatFavorites')}">
                                                <FontIcon
                                                    FontSize="14"
                                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                    Glyph="{x:Bind ViewModel.SelectedPhrase.IsFavorite, Mode=OneWay, Converter={StaticResource BoolToStarGlyphConverter}}" />
                                            </Button>

                                            <!-- Add to Review Queue -->
                                            <Button
                                                Click="OnEnqueueSelectedReviewClick"
                                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                                Padding="8,6"
                                                ToolTipService.ToolTip="{x:Bind Loc.GetString('Phrases_AddToReviewQueue')}">
                                                <FontIcon FontSize="14" Glyph="&#xE823;" />
                                            </Button>

                                            <!-- Edit -->
                                            <Button
                                                Click="OnEditSelectedClick"
                                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                                Padding="8,6"
                                                ToolTipService.ToolTip="{x:Bind Loc.GetString('Action_Edit')}">
                                                <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                            </Button>

                                            <!-- Delete -->
                                            <Button
                                                Click="OnDeleteSelectedClick"
                                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                                Padding="8,6"
                                                ToolTipService.ToolTip="{x:Bind Loc.GetString('Action_Delete')}">
                                                <FontIcon
                                                    FontSize="14"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    Glyph="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>

                                <!-- Bottom Row: Category & Context Tag Breadcrumb -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.SelectedPhrase.Category, Mode=OneWay, FallbackValue=''}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="•"
                                        Visibility="{x:Bind ViewModel.SelectedPhrase.HasContextTag, Mode=OneWay, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.SelectedPhrase.ContextTag, Mode=OneWay, FallbackValue=''}"
                                        Visibility="{x:Bind ViewModel.SelectedPhrase.HasContextTag, Mode=OneWay, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>

                            <!-- Connected Dialogue Flow Container (Speaker A & Speaker B) -->
                            <Border
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="14">
                                    <!-- Dialogue Container Header -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8BD;" />
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Text="{x:Bind Loc.GetString('Phrases_DialogueExchangeHeader')}" />
                                        </StackPanel>

                                        <!-- Stop Audio button visible when audio is playing -->
                                        <Button
                                            Grid.Column="1"
                                            Click="OnStopAudioClick"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Padding="6,2"
                                            Visibility="{x:Bind ViewModel.SelectedPhrase.IsAnyAudioPlaying, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon FontSize="11" Glyph="&#xE71A;" />
                                                <TextBlock FontSize="11" Text="{x:Bind Loc.GetString('Phrases_StopAudio')}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Speaker A: Turn Card -->
                                    <Border
                                        Padding="14"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                                    <Border
                                                        Grid.Column="0"
                                                        Width="22"
                                                        Height="22"
                                                        CornerRadius="11"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            FontWeight="Bold"
                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                            Text="A" />
                                                    </Border>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        Text="{x:Bind Loc.GetString('Phrases_SpeakerAPrompt')}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button Click="OnDetailPlayPromptClick" Padding="8,4" CornerRadius="{ThemeResource ControlCornerRadius}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon FontSize="12" Glyph="{x:Bind ViewModel.SelectedPhrase.PromptAudioGlyph, Mode=OneWay}" />
                                                            <ProgressRing
                                                                Width="12"
                                                                Height="12"
                                                                IsActive="{x:Bind ViewModel.SelectedPhrase.IsPlayingPrompt, Mode=OneWay, FallbackValue=False}"
                                                                Visibility="{x:Bind ViewModel.SelectedPhrase.IsPlayingPrompt, Mode=OneWay, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            <TextBlock FontSize="12" Text="{x:Bind Loc.GetString('Phrases_Listen')}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="OnCopyPromptClick" Padding="8,4" CornerRadius="{ThemeResource ControlCornerRadius}" ToolTipService.ToolTip="{x:Bind Loc.GetString('Phrases_CopyPrompt')}">
                                                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind ViewModel.SelectedPhrase.PromptSentence, Mode=OneWay, FallbackValue=''}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.SelectedPhrase.PromptTranslation, Mode=OneWay, FallbackValue=''}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Turn Connector Glyph -->
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE74B;" />

                                    <!-- Speaker B: Turn Card -->
                                    <Border
                                        Padding="14"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                                    <Border
                                                        Grid.Column="0"
                                                        Width="22"
                                                        Height="22"
                                                        CornerRadius="11"
                                                        Background="{ThemeResource SystemFillColorSuccessBrush}">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            FontWeight="Bold"
                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                            Text="B" />
                                                    </Border>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                        Text="{x:Bind Loc.GetString('Phrases_SpeakerBResponse')}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button Click="OnDetailPlayResponseClick" Padding="8,4" CornerRadius="{ThemeResource ControlCornerRadius}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon FontSize="12" Glyph="{x:Bind ViewModel.SelectedPhrase.ResponseAudioGlyph, Mode=OneWay}" />
                                                            <ProgressRing
                                                                Width="12"
                                                                Height="12"
                                                                IsActive="{x:Bind ViewModel.SelectedPhrase.IsPlayingResponse, Mode=OneWay, FallbackValue=False}"
                                                                Visibility="{x:Bind ViewModel.SelectedPhrase.IsPlayingResponse, Mode=OneWay, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            <TextBlock FontSize="12" Text="{x:Bind Loc.GetString('Phrases_Listen')}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="OnCopyResponseClick" Padding="8,4" CornerRadius="{ThemeResource ControlCornerRadius}" ToolTipService.ToolTip="{x:Bind Loc.GetString('Phrases_CopyResponse')}">
                                                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Text="{x:Bind ViewModel.SelectedPhrase.SampleResponse, Mode=OneWay, FallbackValue=''}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.SelectedPhrase.ResponseTranslation, Mode=OneWay, FallbackValue=''}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Key Phrases & Core Expressions -->
                            <Border
                                Padding="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Visibility="{x:Bind ViewModel.SelectedPhrase.HasKeyPhrases, Mode=OneWay, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8D2;" />
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind Loc.GetString('Phrases_KeyPhrasesHeader')}" />
                                    </StackPanel>

                                    <!-- Key phrase token chips with safe horizontal scroll -->
                                    <ScrollViewer
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Disabled"
                                        HorizontalScrollMode="Enabled"
                                        VerticalScrollMode="Disabled">
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedPhrase.KeyPhraseTokens, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border
                                                        Padding="8,3"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- Formality & Tone Comparison -->
                            <Border
                                Padding="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Visibility="{x:Bind ViewModel.SelectedPhrase.HasVariations, Mode=OneWay, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE777;" />
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Loc.GetString('Phrases_VariationsHeader')}" />
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <!-- Formal Alternative -->
                                        <Border
                                            Grid.Column="0"
                                            Padding="12"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6"
                                            Visibility="{x:Bind ViewModel.SelectedPhrase.HasFormalVariation, Mode=OneWay, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Text="{x:Bind Loc.GetString('Phrases_FormalVariationLabel')}" />
                                                <TextBlock
                                                    FontSize="13"
                                                    Text="{x:Bind ViewModel.SelectedPhrase.FormalVariation, Mode=OneWay, FallbackValue=''}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Casual Alternative -->
                                        <Border
                                            Grid.Column="1"
                                            Padding="12"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6"
                                            Visibility="{x:Bind ViewModel.SelectedPhrase.HasCasualVariation, Mode=OneWay, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                    Text="{x:Bind Loc.GetString('Phrases_CasualVariationLabel')}" />
                                                <TextBlock
                                                    FontSize="13"
                                                    Text="{x:Bind ViewModel.SelectedPhrase.CasualVariation, Mode=OneWay, FallbackValue=''}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Vietnamese Common Mistakes Callout -->
                            <Border
                                Padding="14"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{x:Bind ViewModel.SelectedPhrase.HasCommonMistakesVi, Mode=OneWay, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE7BA;" />
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Text="{x:Bind Loc.GetString('Phrases_CommonMistakesLabel')}" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        Text="{x:Bind ViewModel.SelectedPhrase.CommonMistakesVi, Mode=OneWay, FallbackValue=''}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Additional Notes & Suggestions -->
                            <Border
                                Padding="14"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Visibility="{x:Bind ViewModel.SelectedPhrase.HasAdditionalSuggestions, Mode=OneWay, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE946;" />
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Loc.GetString('Phrases_AdditionalNotesLabel')}" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.SelectedPhrase.AdditionalSuggestions, Mode=OneWay, FallbackValue=''}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- Row 3B: Interactive Roleplay & Shadowing Mode (Distraction-Free)          -->
        <!-- ========================================================================= -->
        <ScrollViewer
            x:Name="RoleplayWorkspace"
            Grid.Row="3"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.IsRoleplayMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="16">
                    <!-- Roleplay Top Bar: Exit button, Progress, Audio, SM-2/FSRS Switch -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                        <!-- Exit Button -->
                        <Button
                            Grid.Column="0"
                            Command="{x:Bind ViewModel.ExitRoleplayCommand}"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="10,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Glyph="&#xE72B;" />
                                <TextBlock Text="{x:Bind Loc.GetString('Phrases_ExitRoleplay')}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Progress Bar & Count -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8FA;" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Loc.GetString('Phrases_RoleplayTitle')}" />
                                <Border
                                    Padding="8,2"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.RoleplayProgressText, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                            <ProgressBar
                                Maximum="{x:Bind ViewModel.RoleplayTotalCount, Mode=OneWay}"
                                Minimum="0"
                                Value="{x:Bind ViewModel.RoleplayCompletedCount, Mode=OneWay}" />
                        </StackPanel>

                        <!-- Audio Accent / Speed Dropdown in Roleplay -->
                        <DropDownButton
                            Grid.Column="2"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="10,6"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Phrases_AudioSettings')}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE767;" />
                                <TextBlock Text="{x:Bind Loc.GetString('Phrases_AudioSettings')}" FontSize="12" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Width="220" Spacing="10" Padding="4">
                                        <TextBlock Text="{x:Bind Loc.GetString('Phrases_VoiceAccent')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="6"
                                            SelectedIndex="{x:Bind ViewModel.SelectedAccentIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="US — English (Mỹ)" />
                                            <ComboBoxItem Content="UK — English (Anh)" />
                                        </ComboBox>

                                        <TextBlock Text="{x:Bind Loc.GetString('Phrases_PlaybackSpeed')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="6"
                                            SelectedIndex="{x:Bind ViewModel.SelectedRateIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="0.75x" />
                                            <ComboBoxItem Content="1.0x" />
                                            <ComboBoxItem Content="1.25x" />
                                            <ComboBoxItem Content="1.5x" />
                                        </ComboBox>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <!-- Scheduler Toggle -->
                        <ToggleSwitch
                            Grid.Column="3"
                            OffContent="SM-2"
                            OnContent="FSRS"
                            IsOn="{x:Bind ViewModel.UseFsrsScheduler, Mode=TwoWay}" />
                    </Grid>

                    <!-- Active Roleplay Flashcard Content -->
                    <StackPanel
                        Spacing="14"
                        Visibility="{x:Bind ViewModel.HasRoleplayCard, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Speaker A Prompt Box -->
                        <Border
                            Padding="18"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="{x:Bind Loc.GetString('Phrases_RoleplayPromptHeader')}" />
                                    <Button
                                        Grid.Column="1"
                                        Command="{x:Bind ViewModel.PlayRoleplayPromptCommand}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Padding="10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="13" Glyph="{x:Bind ViewModel.CurrentRoleplayCard.Phrase.PromptAudioGlyph, Mode=OneWay}" />
                                            <ProgressRing
                                                Width="12"
                                                Height="12"
                                                IsActive="{x:Bind ViewModel.CurrentRoleplayCard.Phrase.IsPlayingPrompt, Mode=OneWay, FallbackValue=False}"
                                                Visibility="{x:Bind ViewModel.CurrentRoleplayCard.Phrase.IsPlayingPrompt, Mode=OneWay, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Text="{x:Bind Loc.GetString('Phrases_Listen')}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.CurrentRoleplayCard.Phrase.PromptSentence, Mode=OneWay, FallbackValue=''}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.CurrentRoleplayCard.Phrase.PromptTranslation, Mode=OneWay, FallbackValue=''}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- User Draft Input Box -->
                        <TextBox
                            AcceptsReturn="True"
                            CornerRadius="8"
                            Header="{x:Bind Loc.GetString('Phrases_RoleplayYourTurn')}"
                            MinHeight="80"
                            PlaceholderText="{x:Bind Loc.GetString('Phrases_RoleplayYourTurnPlaceholder')}"
                            Text="{x:Bind ViewModel.UserPracticeDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />

                        <!-- Reveal Answer Button -->
                        <Button
                            Command="{x:Bind ViewModel.RevealRoleplayAnswerCommand}"
                            Content="{x:Bind Loc.GetString('Phrases_RoleplayReveal')}"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="16,8"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsRoleplayAnswerRevealed, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                        <!-- Revealed Sample Response + Key Phrases + SM-2 Ratings -->
                        <StackPanel
                            Spacing="14"
                            Visibility="{x:Bind ViewModel.IsRoleplayAnswerRevealed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border
                                Padding="18"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            Grid.Column="0"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Text="{x:Bind Loc.GetString('Phrases_RoleplayModelResponse')}" />
                                        <Button
                                            Grid.Column="1"
                                            Command="{x:Bind ViewModel.PlayRoleplayResponseCommand}"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Padding="10,4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="13" Glyph="{x:Bind ViewModel.CurrentRoleplayCard.Phrase.ResponseAudioGlyph, Mode=OneWay}" />
                                                <ProgressRing
                                                    Width="12"
                                                    Height="12"
                                                    IsActive="{x:Bind ViewModel.CurrentRoleplayCard.Phrase.IsPlayingResponse, Mode=OneWay, FallbackValue=False}"
                                                    Visibility="{x:Bind ViewModel.CurrentRoleplayCard.Phrase.IsPlayingResponse, Mode=OneWay, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Text="{x:Bind Loc.GetString('Phrases_ShadowAudio')}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.CurrentRoleplayCard.Phrase.SampleResponse, Mode=OneWay, FallbackValue=''}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.CurrentRoleplayCard.Phrase.ResponseTranslation, Mode=OneWay, FallbackValue=''}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="{x:Bind ViewModel.CurrentRoleplayCard.Phrase.KeyPhrases, Mode=OneWay, FallbackValue=''}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- SM-2 / FSRS Rating Buttons -->
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                                <Button
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="0,8"
                                    Command="{x:Bind ViewModel.RateRoleplayAgainCommand}">
                                    <StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind Loc.GetString('Review_RatingAgain')}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.CurrentRoleplayCard.IntervalAgainPreview, Mode=OneWay, FallbackValue=''}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="0,8"
                                    Command="{x:Bind ViewModel.RateRoleplayHardCommand}">
                                    <StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Text="{x:Bind Loc.GetString('Review_RatingHard')}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.CurrentRoleplayCard.IntervalHardPreview, Mode=OneWay, FallbackValue=''}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="0,8"
                                    Command="{x:Bind ViewModel.RateRoleplayGoodCommand}">
                                    <StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Text="{x:Bind Loc.GetString('Review_RatingGood')}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.CurrentRoleplayCard.IntervalGoodPreview, Mode=OneWay, FallbackValue=''}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="3"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="0,8"
                                    Command="{x:Bind ViewModel.RateRoleplayEasyCommand}">
                                    <StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind Loc.GetString('Review_RatingEasy')}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.CurrentRoleplayCard.IntervalEasyPreview, Mode=OneWay, FallbackValue=''}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- Roleplay Completed Banner -->
                    <StackPanel
                        Padding="24"
                        HorizontalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.RoleplayCompletedVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="40"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Glyph="&#xE73E;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind Loc.GetString('Phrases_RoleplayCompletedTitle')}" />
                        <Button
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.ExitRoleplayCommand}"
                            Content="{x:Bind Loc.GetString('Phrases_ExitRoleplay')}"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="16,8"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ========================================================================= -->
        <!-- Row 4: Pagination Bar (Hidden in Roleplay Mode)                          -->
        <!-- ========================================================================= -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsRoleplayMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Button
                Command="{x:Bind ViewModel.PreviousPageCommand}"
                Content="{x:Bind Loc.GetString('Phrases_PrevPage')}"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.PageSummaryText, Mode=OneWay}" />
            <Button
                Command="{x:Bind ViewModel.NextPageCommand}"
                Content="{x:Bind Loc.GetString('Phrases_NextPage')}"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>