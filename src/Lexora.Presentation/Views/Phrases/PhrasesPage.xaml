<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.Phrases.PhrasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dtos="using:Lexora.Application.DTOs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Page Header & Primary Action -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Loc.GetString('Phrases_Title')}"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{x:Bind Loc.GetString('Phrases_Subtitle')}"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{ThemeResource AccentButtonStyle}"
                    Padding="16,8"
                    VerticalAlignment="Center"
                    Click="BtnAddPhrase_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="{x:Bind Loc.GetString('Phrases_AddNew')}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ROW 1: Search & Filter Bar -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid ColumnDefinitions="1.5*,1.2*,Auto,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <!-- Search Box -->
                <AutoSuggestBox x:Name="SearchBox"
                                QueryIcon="Find"
                                PlaceholderText="{x:Bind Loc.GetString('Phrases_SearchPlaceholder')}"
                                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                                QuerySubmitted="SearchBox_QuerySubmitted"
                                TextChanged="SearchBox_TextChanged"
                                VerticalAlignment="Center" />

                <!-- Category Filter -->
                <ComboBox x:Name="CategoryFilterBox" Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                          SelectionChanged="CategoryFilterBox_SelectionChanged"
                          PlaceholderText="{x:Bind Loc.GetString('Phrases_FilterCategory')}" />

                <!-- CEFR Level Filter -->
                <ComboBox x:Name="LevelFilterBox" Grid.Column="2"
                          VerticalAlignment="Center"
                          MinWidth="120"
                          SelectionChanged="LevelFilterBox_SelectionChanged">
                    <ComboBoxItem Content="{x:Bind Loc.GetString('Phrases_FilterAllLevels')}" Tag="All" IsSelected="True" />
                    <ComboBoxItem Content="A1" Tag="A1" />
                    <ComboBoxItem Content="A2" Tag="A2" />
                    <ComboBoxItem Content="B1" Tag="B1" />
                    <ComboBoxItem Content="B2" Tag="B2" />
                    <ComboBoxItem Content="C1" Tag="C1" />
                    <ComboBoxItem Content="C2" Tag="C2" />
                </ComboBox>

                <!-- Favorites Toggle -->
                <ToggleButton x:Name="FavoritesToggle" Grid.Column="3"
                              VerticalAlignment="Center"
                              IsChecked="{x:Bind ViewModel.OnlyFavorites, Mode=TwoWay}"
                              Checked="FavoritesToggle_Checked"
                              Unchecked="FavoritesToggle_Unchecked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE735;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind Loc.GetString('Phrases_OnlyFavorites')}" />
                    </StackPanel>
                </ToggleButton>

                <!-- Reset Filters Button -->
                <Button Grid.Column="4"
                        ToolTipService.ToolTip="Đặt lại bộ lọc"
                        Click="BtnClearFilters_Click"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>
            </Grid>
        </Border>

        <!-- ROW 2: Results Count & Subtitle -->
        <Grid Grid.Row="2" Margin="4,0,4,8">
            <TextBlock Text="{x:Bind ViewModel.CountDisplayInfo, Mode=OneWay}"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- ROW 3: Main Content (List / Cards & Empty / Loading States) -->
        <Grid Grid.Row="3">
            <!-- Loading Indicator -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="44" Height="44"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!-- Empty State -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.IsEmptyState, Mode=OneWay}">
                <FontIcon Glyph="&#xE8BD;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind Loc.GetString('Phrases_EmptyTitle')}"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind Loc.GetString('Phrases_EmptySubtitle')}"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="450" TextAlignment="Center" />
                <Button Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Click="BtnAddPhrase_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock Text="{x:Bind Loc.GetString('Phrases_AddNew')}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Phrases Cards List -->
            <ListView x:Name="PhrasesListView"
                      ItemsSource="{x:Bind ViewModel.Phrases, Mode=OneWay}"
                      SelectionMode="None"
                      Padding="0,0,0,16"
                      HorizontalAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,0,0,12" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ConversationPhraseDto">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                HorizontalAlignment="Stretch">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                                <!-- Card Header: Badges & Action Buttons -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                    <!-- Category Pill -->
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Category}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>

                                    <!-- Subtag Pill (if any) -->
                                    <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4" Padding="8,4" VerticalAlignment="Center"
                                            Visibility="{x:Bind ContextTag, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind ContextTag}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>

                                    <!-- CEFR Pill -->
                                    <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind CefrLevel}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Border>

                                    <!-- Action: Favorite Toggle -->
                                    <Button Grid.Column="4" Style="{ThemeResource SubtleButtonStyle}"
                                            Padding="6" VerticalAlignment="Center"
                                            Click="CardFavorite_Click"
                                            ToolTipService.ToolTip="Yêu thích">
                                        <FontIcon Glyph="{x:Bind IsFavorite, Converter={StaticResource BoolToStarGlyphConverter}}"
                                                  FontSize="14"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Button>

                                    <!-- Action: Edit -->
                                    <Button Grid.Column="5" Style="{ThemeResource SubtleButtonStyle}"
                                            Padding="6" VerticalAlignment="Center"
                                            Click="CardEdit_Click"
                                            ToolTipService.ToolTip="Chỉnh sửa">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>

                                    <!-- Action: Delete -->
                                    <Button Grid.Column="6" Style="{ThemeResource SubtleButtonStyle}"
                                            Padding="6" VerticalAlignment="Center"
                                            Click="CardDelete_Click"
                                            ToolTipService.ToolTip="Xóa">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </Button>
                                </Grid>

                                <!-- Section 1: Prompt Sentence -->
                                <Border Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="14,10">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <!-- Header Label -->
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="CÂU MỞ ĐẦU / TÌNH HUỐNG"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   Margin="0,0,0,4" />

                                        <!-- English Prompt -->
                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{x:Bind PromptSentence}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap" />

                                        <!-- Actions: Speak & Copy -->
                                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                    Orientation="Horizontal" Spacing="4"
                                                    VerticalAlignment="Center">
                                            <Button Style="{ThemeResource SubtleButtonStyle}" Padding="6"
                                                    Click="CardPlayPrompt_Click" ToolTipService.ToolTip="Nghe phát âm">
                                                <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Button>
                                            <Button Style="{ThemeResource SubtleButtonStyle}" Padding="6"
                                                    Click="CardCopyPrompt_Click" ToolTipService.ToolTip="Sao chép">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Vietnamese Translation -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{x:Bind PromptTranslation}"
                                                   FontSize="13" FontStyle="Italic"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </Grid>
                                </Border>

                                <!-- Section 2: Sample Response -->
                                <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6" Padding="14,10">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                        <!-- Header Label -->
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="CÂU TRẢ LỜI MẪU TỰ NHIÊN"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                   Margin="0,0,0,4" />

                                        <!-- English Sample Response -->
                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{x:Bind SampleResponse}"
                                                   FontSize="14.5"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap" />

                                        <!-- Actions: Speak & Copy -->
                                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                    Orientation="Horizontal" Spacing="4"
                                                    VerticalAlignment="Center">
                                            <Button Style="{ThemeResource SubtleButtonStyle}" Padding="6"
                                                    Click="CardPlayResponse_Click" ToolTipService.ToolTip="Nghe câu trả lời">
                                                <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            </Button>
                                            <Button Style="{ThemeResource SubtleButtonStyle}" Padding="6"
                                                    Click="CardCopyResponse_Click" ToolTipService.ToolTip="Sao chép">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Vietnamese Translation -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{x:Bind ResponseTranslation}"
                                                   FontSize="13" FontStyle="Italic"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </Grid>
                                </Border>

                                <!-- Section 3: Additional Suggestions & Cultural Notes -->
                                <Border Grid.Row="3"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="12,10"
                                        Visibility="{x:Bind AdditionalSuggestions, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xEA80;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="GỢI Ý MỞ RỘNG &amp; LƯU Ý NGỮ CẢNH"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind AdditionalSuggestions}"
                                                   FontSize="12.5"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
