<?xml version="1.0" encoding="utf-8" ?>
<Page
    UseLayoutRounding="True"
    x:Class="Lexora.Presentation.Views.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:common="using:Lexora.Presentation.Views.Common"
    xmlns:helpers="using:Lexora.Presentation.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    KeyboardAcceleratorPlacementMode="Hidden"
    Loaded="SettingsPage_Loaded"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="24" HorizontalAlignment="Stretch">
            <StackPanel Spacing="18" HorizontalAlignment="Stretch">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="SettingsCardsLayoutStates">
                        <VisualState x:Name="CardsWideState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="740" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="CardsNarrowState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <!-- Theme 3 cards -> 3 rows -->
                                <Setter Target="ThemeSystemButton.(Grid.Row)" Value="0" />
                                <Setter Target="ThemeSystemButton.(Grid.Column)" Value="0" />
                                <Setter Target="ThemeSystemButton.(Grid.ColumnSpan)" Value="3" />
                                <Setter Target="ThemeLightButton.(Grid.Row)" Value="1" />
                                <Setter Target="ThemeLightButton.(Grid.Column)" Value="0" />
                                <Setter Target="ThemeLightButton.(Grid.ColumnSpan)" Value="3" />
                                <Setter Target="ThemeDarkButton.(Grid.Row)" Value="2" />
                                <Setter Target="ThemeDarkButton.(Grid.Column)" Value="0" />
                                <Setter Target="ThemeDarkButton.(Grid.ColumnSpan)" Value="3" />
                                <!-- Voice UK/US 2 cards -> 2 rows -->
                                <Setter Target="VoiceUkCard.(Grid.Row)" Value="0" />
                                <Setter Target="VoiceUkCard.(Grid.Column)" Value="0" />
                                <Setter Target="VoiceUkCard.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="VoiceUsCard.(Grid.Row)" Value="1" />
                                <Setter Target="VoiceUsCard.(Grid.Column)" Value="0" />
                                <Setter Target="VoiceUsCard.(Grid.ColumnSpan)" Value="2" />
                                <!-- Algorithm 2 cards -> 2 rows -->
                                <Setter Target="AlgorithmSm2Button.(Grid.Row)" Value="0" />
                                <Setter Target="AlgorithmSm2Button.(Grid.Column)" Value="0" />
                                <Setter Target="AlgorithmSm2Button.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="AlgorithmFsrsButton.(Grid.Row)" Value="1" />
                                <Setter Target="AlgorithmFsrsButton.(Grid.Column)" Value="0" />
                                <Setter Target="AlgorithmFsrsButton.(Grid.ColumnSpan)" Value="2" />
                                <!-- Backup action buttons -> stacked compact rows -->
                                <Setter Target="BtnCreateBackup.(Grid.Row)" Value="0" />
                                <Setter Target="BtnCreateBackup.(Grid.Column)" Value="0" />
                                <Setter Target="BtnCreateBackup.HorizontalAlignment" Value="Stretch" />
                                <Setter Target="BtnRestoreBackup.(Grid.Row)" Value="1" />
                                <Setter Target="BtnRestoreBackup.(Grid.Column)" Value="0" />
                                <Setter Target="BtnRestoreBackup.HorizontalAlignment" Value="Stretch" />
                                <Setter Target="BtnDataHealth.(Grid.Row)" Value="2" />
                                <Setter Target="BtnDataHealth.(Grid.Column)" Value="0" />
                                <Setter Target="BtnDataHealth.HorizontalAlignment" Value="Stretch" />
                                <!-- Help Quick Topics -> 4 rows -->
                                <Setter Target="BtnHelpTopic1.(Grid.Row)" Value="0" />
                                <Setter Target="BtnHelpTopic1.(Grid.Column)" Value="0" />
                                <Setter Target="BtnHelpTopic1.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="BtnHelpTopic2.(Grid.Row)" Value="1" />
                                <Setter Target="BtnHelpTopic2.(Grid.Column)" Value="0" />
                                <Setter Target="BtnHelpTopic2.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="BtnHelpTopic3.(Grid.Row)" Value="2" />
                                <Setter Target="BtnHelpTopic3.(Grid.Column)" Value="0" />
                                <Setter Target="BtnHelpTopic3.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="BtnHelpTopic4.(Grid.Row)" Value="3" />
                                <Setter Target="BtnHelpTopic4.(Grid.Column)" Value="0" />
                                <Setter Target="BtnHelpTopic4.(Grid.ColumnSpan)" Value="2" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <!-- Unified Page Header -->
                <common:PageHeaderControl Title="{x:Bind Loc.GetString('Settings_Title')}"
                                          Subtitle="{x:Bind Loc.GetString('Settings_Subtitle')}"
                                          IconGlyph="&#xE713;">
                    <common:PageHeaderControl.ActionsContent>
                        <Button x:Name="SettingsHelpButton" Click="SettingsHelpButton_Click"
                                Style="{ThemeResource SubtleButtonStyle}"
                                CornerRadius="{ThemeResource ControlCornerRadius}" Padding="7"
                                ToolTipService.ToolTip="{x:Bind Loc.GetString('Settings_Help_Title')}">
                            <FontIcon Glyph="&#xE9CE;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </common:PageHeaderControl.ActionsContent>
                </common:PageHeaderControl>

                <TeachingTip x:Name="SettingsHelpTeachingTip"
                             helpers:ThemeSyncHelper.SyncTheme="True"
                             Target="{x:Bind SettingsHelpButton}"
                             Title="{x:Bind Loc.GetString('Settings_Help_Title')}"
                             Subtitle="{x:Bind Loc.GetString('Settings_Help_Subtitle')}"
                             IsOpen="False"
                             IsLightDismissEnabled="True"
                             PreferredPlacement="BottomRight">
                    <TeachingTip.Content>
                        <StackPanel Spacing="10" MaxWidth="320">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_Help_Content')}" TextWrapping="Wrap" FontSize="13" />
                            <Button Style="{ThemeResource AccentButtonStyle}"
                                    Click="OpenFullGuide_Click"
                                    Tag="BackupAndSettings"
                                    CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind Loc.GetString('Help_OpenFullGuide')}" FontWeight="SemiBold" FontSize="12" />
                                    <FontIcon Glyph="&#xE76C;" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </TeachingTip.Content>
                </TeachingTip>

                <!-- CATEGORY SELECTOR BAR -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Padding="8,4">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled">
                        <SelectorBar x:Name="SettingsSelectorBar" SelectionChanged="SettingsSelectorBar_SelectionChanged">
                            <SelectorBarItem x:Name="TabAppearance" Tag="Appearance" Text="{x:Bind Loc.GetString('Settings_Tab_Appearance')}" IsSelected="True">
                                <SelectorBarItem.Icon>
                                    <FontIcon Glyph="&#xE790;" />
                                </SelectorBarItem.Icon>
                            </SelectorBarItem>
                            <SelectorBarItem x:Name="TabStudy" Tag="Study" Text="{x:Bind Loc.GetString('Settings_Tab_Study')}">
                                <SelectorBarItem.Icon>
                                    <FontIcon Glyph="&#xE895;" />
                                </SelectorBarItem.Icon>
                            </SelectorBarItem>
                            <SelectorBarItem x:Name="TabDataUpdates" Tag="DataUpdates" Text="{x:Bind Loc.GetString('Settings_Tab_DataUpdates')}">
                                <SelectorBarItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </SelectorBarItem.Icon>
                            </SelectorBarItem>
                            <SelectorBarItem x:Name="TabHelpAbout" Tag="HelpAbout" Text="{x:Bind Loc.GetString('Settings_Tab_HelpAbout')}">
                                <SelectorBarItem.Icon>
                                    <FontIcon Glyph="&#xE897;" />
                                </SelectorBarItem.Icon>
                            </SelectorBarItem>
                        </SelectorBar>
                    </ScrollViewer>
                </Border>

                <!-- TAB 1: APPEARANCE & LANGUAGE -->
                <StackPanel x:Name="PanelAppearance" Spacing="16" Visibility="Visible">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="0" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                <!-- Appearance Theme Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="20,16">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="34" Height="34" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE790;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_Theme')}" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_ThemeSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!-- Visual Theme Selector Cards -->
                        <Grid x:Name="ThemeCardsGrid" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12" Margin="0,4,0,0">
                            <!-- 1. System Theme Card -->
                            <Button x:Name="ThemeSystemButton"
                                    helpers:AnimationHelper.EnableHoverScale="True"
                                    Click="ThemeSystemButton_Click"
                                    Style="{ThemeResource DefaultButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                                <Grid Padding="14">
                                    <StackPanel Spacing="10">
                                        <!-- Mini Window Mockup System (Dual split Light/Dark) -->
                                        <Border Height="95" CornerRadius="{ThemeResource OverlayCornerRadius}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Grid ColumnDefinitions="*,*">
                                                <!-- Left half: Light -->
                                                <Grid Background="{StaticResource LexoraMockupLightWindowBrush}">
                                                    <Grid ColumnDefinitions="24,*">
                                                        <Border Background="{StaticResource LexoraMockupLightSidebarBrush}">
                                                            <StackPanel Spacing="4" Margin="4,8,4,4">
                                                                <Border Height="3" CornerRadius="2" Background="{StaticResource LexoraMockupLightAccentBrush}" />
                                                                <Border Height="3" CornerRadius="2" Background="{StaticResource LexoraMockupLightBarBrush}" Opacity="0.6" />
                                                                <Border Height="3" CornerRadius="2" Background="{StaticResource LexoraMockupLightBarBrush}" Opacity="0.4" />
                                                            </StackPanel>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="6,8,4,4" Spacing="5">
                                                            <Border Height="4" Width="28" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource LexoraMockupLightBarBrush}" />
                                                            <Border Background="{StaticResource LexoraMockupLightCardBrush}" BorderThickness="1" BorderBrush="{StaticResource LexoraMockupLightStrokeBrush}" CornerRadius="4" Padding="4">
                                                                <StackPanel Spacing="3">
                                                                    <Border Height="3" Width="36" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource LexoraMockupLightAccentBrush}" />
                                                                    <Border Height="2" Width="24" HorizontalAlignment="Left" CornerRadius="1" Background="{StaticResource LexoraMockupLightBarBrush}" Opacity="0.5" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                                <!-- Right half: Dark -->
                                                <Grid Grid.Column="1" Background="{StaticResource LexoraMockupDarkWindowBrush}">
                                                    <Grid ColumnDefinitions="24,*">
                                                        <Border Background="{StaticResource LexoraMockupDarkSidebarBrush}">
                                                            <StackPanel Spacing="4" Margin="4,8,4,4">
                                                                <Border Height="3" CornerRadius="2" Background="{StaticResource LexoraMockupDarkAccentBrush}" />
                                                                <Border Height="3" CornerRadius="2" Background="{StaticResource LexoraMockupDarkBarBrush}" Opacity="0.6" />
                                                                <Border Height="3" CornerRadius="2" Background="{StaticResource LexoraMockupDarkBarBrush}" Opacity="0.4" />
                                                            </StackPanel>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="6,8,4,4" Spacing="5">
                                                            <Border Height="4" Width="28" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource LexoraMockupDarkBarBrush}" />
                                                            <Border Background="{StaticResource LexoraMockupDarkCardBrush}" BorderThickness="1" BorderBrush="{StaticResource LexoraMockupDarkStrokeBrush}" CornerRadius="4" Padding="4">
                                                                <StackPanel Spacing="3">
                                                                    <Border Height="3" Width="36" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource LexoraMockupDarkAccentBrush}" />
                                                                    <Border Height="2" Width="24" HorizontalAlignment="Left" CornerRadius="1" Background="{StaticResource LexoraMockupDarkBarBrush}" Opacity="0.5" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Label & Selection Badge -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_Theme_System')}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_Theme_SystemDesc')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border x:Name="ThemeSystemCheck" Grid.Column="1" Width="22" Height="22" CornerRadius="11" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Visibility="Collapsed">
                                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 2. Light Theme Card -->
                            <Button x:Name="ThemeLightButton"
                                    helpers:AnimationHelper.EnableHoverScale="True"
                                    Grid.Column="1"
                                    Click="ThemeLightButton_Click"
                                    Style="{ThemeResource DefaultButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                                <Grid Padding="14">
                                    <StackPanel Spacing="10">
                                        <!-- Mini Window Mockup Light -->
                                        <Border Height="95" CornerRadius="{ThemeResource OverlayCornerRadius}" BorderThickness="1" BorderBrush="{StaticResource LexoraMockupLightStrokeBrush}" Background="{StaticResource LexoraMockupLightWindowBrush}">
                                            <Grid ColumnDefinitions="32,*">
                                                <Border Background="{StaticResource LexoraMockupLightSidebarBrush}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource LexoraMockupLightStrokeBrush}">
                                                    <StackPanel Spacing="5" Margin="6,10,6,6">
                                                        <Border Height="4" CornerRadius="2" Background="{StaticResource LexoraMockupLightAccentBrush}" />
                                                        <Border Height="4" CornerRadius="2" Background="{StaticResource LexoraMockupLightBarBrush}" Opacity="0.6" />
                                                        <Border Height="4" CornerRadius="2" Background="{StaticResource LexoraMockupLightBarBrush}" Opacity="0.4" />
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,8,8,6" Spacing="6">
                                                    <Border Height="5" Width="55" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource LexoraMockupLightBarBrush}" />
                                                    <Border Background="{StaticResource LexoraMockupLightCardBrush}" BorderThickness="1" BorderBrush="{StaticResource LexoraMockupLightStrokeBrush}" CornerRadius="4" Padding="6">
                                                        <StackPanel Spacing="4">
                                                            <Border Height="4" Width="70" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource LexoraMockupLightAccentBrush}" />
                                                            <Border Height="3" Width="48" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource LexoraMockupLightBarBrush}" Opacity="0.5" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Label & Selection Badge -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_Theme_Light')}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_Theme_LightDesc')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border x:Name="ThemeLightCheck" Grid.Column="1" Width="22" Height="22" CornerRadius="11" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Visibility="Collapsed">
                                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 3. Dark Theme Card -->
                            <Button x:Name="ThemeDarkButton"
                                    helpers:AnimationHelper.EnableHoverScale="True"
                                    Grid.Column="2"
                                    Click="ThemeDarkButton_Click"
                                    Style="{ThemeResource DefaultButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                                <Grid Padding="14">
                                    <StackPanel Spacing="10">
                                        <!-- Mini Window Mockup Dark -->
                                        <Border Height="95" CornerRadius="{ThemeResource OverlayCornerRadius}" BorderThickness="1" BorderBrush="{StaticResource LexoraMockupDarkStrokeBrush}" Background="{StaticResource LexoraMockupDarkWindowBrush}">
                                            <Grid ColumnDefinitions="32,*">
                                                <Border Background="{StaticResource LexoraMockupDarkSidebarBrush}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource LexoraMockupDarkStrokeBrush}">
                                                    <StackPanel Spacing="5" Margin="6,10,6,6">
                                                        <Border Height="4" CornerRadius="2" Background="{StaticResource LexoraMockupDarkAccentBrush}" />
                                                        <Border Height="4" CornerRadius="2" Background="{StaticResource LexoraMockupDarkBarBrush}" Opacity="0.6" />
                                                        <Border Height="4" CornerRadius="2" Background="{StaticResource LexoraMockupDarkBarBrush}" Opacity="0.4" />
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,8,8,6" Spacing="6">
                                                    <Border Height="5" Width="55" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource LexoraMockupDarkBarBrush}" />
                                                    <Border Background="{StaticResource LexoraMockupDarkCardBrush}" BorderThickness="1" BorderBrush="{StaticResource LexoraMockupDarkStrokeBrush}" CornerRadius="4" Padding="6">
                                                        <StackPanel Spacing="4">
                                                            <Border Height="4" Width="70" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource LexoraMockupDarkAccentBrush}" />
                                                            <Border Height="3" Width="48" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource LexoraMockupDarkBarBrush}" Opacity="0.5" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Label & Selection Badge -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_Theme_Dark')}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_Theme_DarkDesc')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border x:Name="ThemeDarkCheck" Grid.Column="1" Width="22" Height="22" CornerRadius="11" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Visibility="Collapsed">
                                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>
                </StackPanel>
            </Border>

            <!-- Language Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="20,16">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Width="34" Height="34" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF2B7;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_Language')}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_LanguageSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="LangViButton" Click="LangViButton_Click" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="TextLangVi" Text="Tiếng Việt (VI)" VerticalAlignment="Center" />
                                    <FontIcon x:Name="CheckLangVi" Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LangEnButton" Click="LangEnButton_Click" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="TextLangEn" Text="English (EN)" VerticalAlignment="Center" />
                                    <FontIcon x:Name="CheckLangEn" Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
                </StackPanel>

                <!-- TAB 2: STUDY EXPERIENCE & ALGORITHM -->
                <StackPanel x:Name="PanelStudy" Spacing="16" Visibility="Collapsed">
                    <!-- Study Experience & Notifications Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="20,16">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Width="34" Height="34" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE767;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_StudyExperience')}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_StudyExperienceSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- Setting Row 1: Auto Play Audio -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_AutoPlayAudio')}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_AutoPlayAudioSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      IsOn="{x:Bind ViewModel.AutoPlayAudio, Mode=OneWay}"
                                      Toggled="AutoPlayToggle_Toggled"
                                      OffContent="{x:Bind Loc.GetString('Settings_Toggle_Off')}"
                                      OnContent="{x:Bind Loc.GetString('Settings_Toggle_On')}"
                                      MinWidth="76"
                                      HorizontalAlignment="Right" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <!-- Setting Row 2: Due Reminder -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_DueReminder')}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_DueReminderSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      IsOn="{x:Bind ViewModel.EnableReviewReminder, Mode=OneWay}"
                                      Toggled="ReminderToggle_Toggled"
                                      OffContent="{x:Bind Loc.GetString('Settings_Toggle_Off')}"
                                      OnContent="{x:Bind Loc.GetString('Settings_Toggle_On')}"
                                      MinWidth="76"
                                      HorizontalAlignment="Right" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <!-- Setting Row 3: Pronunciation Preference (UK vs US) -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_PronunciationPreference')}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_PronunciationSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button x:Name="AccentUkButton" Click="AccentUkButton_Click" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="TextAccentUk" Text="{x:Bind Loc.GetString('Settings_Accent_UK')}" VerticalAlignment="Center" FontSize="13" />
                                        <FontIcon x:Name="CheckAccentUk" Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AccentUsButton" Click="AccentUsButton_Click" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="TextAccentUs" Text="{x:Bind Loc.GetString('Settings_Accent_US')}" VerticalAlignment="Center" FontSize="13" />
                                        <FontIcon x:Name="CheckAccentUs" Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Voice Engine Diagnostic & Test Panel -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="14,12" Margin="0,2">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Settings_VoiceDiagnostic_Title')}" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="OpenSpeechSettings_Click" Style="{ThemeResource SubtleButtonStyle}" Padding="10,4" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Loc.GetString('Settings_Voice_InstallHelp')}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                                <!-- UK Voice Info -->
                                <Border x:Name="VoiceUkCard" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="12,10">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                        <TextBlock Text="{x:Bind Loc.GetString('Settings_Pronunciation_UK')}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.UkVoiceStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <Button Grid.Row="2" Click="TestVoiceUk_Click" Style="{ThemeResource SubtleButtonStyle}" HorizontalAlignment="Left" Padding="10,4" CornerRadius="{ThemeResource ControlCornerRadius}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_TestVoice_UK')}" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- US Voice Info -->
                                <Border x:Name="VoiceUsCard" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="12,10">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                        <TextBlock Text="{x:Bind Loc.GetString('Settings_Pronunciation_US')}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.UsVoiceStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <Button Grid.Row="2" Click="TestVoiceUs_Click" Style="{ThemeResource SubtleButtonStyle}" HorizontalAlignment="Left" Padding="10,4" CornerRadius="{ThemeResource ControlCornerRadius}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_TestVoice_US')}" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <!-- Setting Row 4: Speech Playback Speed -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_SpeechRate')}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_SpeechRateSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="SpeechRateCombo" Width="160" VerticalAlignment="Center" HorizontalAlignment="Right" SelectionChanged="SpeechRateCombo_SelectionChanged" CornerRadius="{ThemeResource ControlCornerRadius}">
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Settings_Speed_Slow')}" Tag="0.75" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Settings_Speed_Normal')}" Tag="1.0" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Settings_Speed_Fast')}" Tag="1.25" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Settings_Speed_VeryFast')}" Tag="1.5" />
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <!-- Setting Row 4: Typing Practice Drill -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_TypingPractice')}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_TypingPracticeSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      IsOn="{x:Bind ViewModel.EnableTypingPractice, Mode=OneWay}"
                                      Toggled="TypingPracticeToggle_Toggled"
                                      OffContent="{x:Bind Loc.GetString('Settings_Toggle_Off')}"
                                      OnContent="{x:Bind Loc.GetString('Settings_Toggle_On')}"
                                      MinWidth="76"
                                      HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Spaced Repetition Algorithm & Target Retention Card (Balanced in Left Column) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="20,16">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Width="34" Height="34" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_Algorithm')}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_AlgorithmSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- Algorithm Selection Grid (SM-2 vs FSRS v5) -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="12">
                        <!-- Card 1: SM-2 -->
                        <Button x:Name="AlgorithmSm2Button"
                                helpers:AnimationHelper.EnableHoverScale="True"
                                Click="AlgorithmSm2Button_Click"
                                Style="{ThemeResource DefaultButtonStyle}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="16,14"
                                CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Settings_Algorithm_SM2')}" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <Border x:Name="AlgorithmSm2Check" Grid.Column="1" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Visibility="Visible">
                                    <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                           Text="{x:Bind Loc.GetString('Settings_Algorithm_SM2Desc')}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <!-- Card 2: FSRS v5 -->
                        <Button x:Name="AlgorithmFsrsButton"
                                helpers:AnimationHelper.EnableHoverScale="True"
                                Grid.Column="1"
                                Click="AlgorithmFsrsButton_Click"
                                Style="{ThemeResource DefaultButtonStyle}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="16,14"
                                CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE958;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Settings_Algorithm_FSRS')}" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <Border x:Name="AlgorithmFsrsCheck" Grid.Column="1" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Visibility="Collapsed">
                                    <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                           Text="{x:Bind Loc.GetString('Settings_Algorithm_FSRSDesc')}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                        </Button>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2" />

                    <!-- Target Retention Selector Row -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_TargetRetention')}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_TargetRetentionSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="TargetRetentionCombo" Grid.Column="1"
                                  SelectionChanged="TargetRetentionCombo_SelectionChanged"
                                  MinWidth="200" CornerRadius="{ThemeResource ControlCornerRadius}">
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Settings_Retention_85')}" Tag="0.85" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Settings_Retention_90')}" Tag="0.90" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Settings_Retention_95')}" Tag="0.95" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>
                </StackPanel>

                <!-- TAB 3: DATABASE & SOFTWARE UPDATES -->
                <StackPanel x:Name="PanelDataUpdates" Spacing="16" Visibility="Collapsed">

            <!-- Database & Backup Management Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="20,16">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Width="34" Height="34" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_DatabaseManagement')}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_DatabaseManagementSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{x:Bind Loc.GetString('Settings_RefreshStats')}" Click="RefreshStatsButton_Click" CornerRadius="{ThemeResource ControlCornerRadius}" />
                    </Grid>

                    <!-- Database Stats Grid -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BackgroundSizing="InnerBorderEdge" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="10" ColumnSpacing="14">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_DbLocation')}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DatabasePath, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center" />
                            <Button x:Name="BtnCopyDbPath" Grid.Column="2" Click="CopyDbPath_Click" ToolTipService.ToolTip="{x:Bind Loc.GetString('Action_Copy')}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon x:Name="IconCopyDbPath" Glyph="&#xE8C8;" FontSize="12" />
                                    <TextBlock x:Name="TextCopyDbPath" Text="{x:Bind Loc.GetString('Action_Copy')}" FontSize="11" />
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Row="1" Text="{x:Bind Loc.GetString('Settings_DbSize')}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.DatabaseSizeFormatted, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Text="{x:Bind Loc.GetString('Settings_DbTotalData')}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" BackgroundSizing="InnerBorderEdge" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.TotalWordsCount, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Loc.GetString('Settings_DbWordsUnit')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" BackgroundSizing="InnerBorderEdge" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.TotalGrammarCount, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        <TextBlock Text="{x:Bind Loc.GetString('Settings_DbGrammarUnit')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Backup Actions (Compact, well-proportioned action buttons; stacks cleanly on narrow screens) -->
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10" HorizontalAlignment="Left">
                        <Button x:Name="BtnCreateBackup" Grid.Row="0" Grid.Column="0" Style="{ThemeResource AccentButtonStyle}" Click="BackupButton_Click" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16,8" ToolTipService.ToolTip="{x:Bind Loc.GetString('Settings_CreateBackupBtn')}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEA35;" FontSize="12" />
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_CreateBackupBtn')}" FontWeight="SemiBold" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnRestoreBackup" Grid.Row="0" Grid.Column="1" Style="{StaticResource LexoraStandardButtonStyle}" Click="RestoreButton_Click" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16,8" ToolTipService.ToolTip="{x:Bind Loc.GetString('Settings_RestoreBackupBtn')}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE777;" FontSize="12" />
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_RestoreBackupBtn')}" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnDataHealth" Grid.Row="0" Grid.Column="2" Style="{StaticResource LexoraStandardButtonStyle}" Click="OpenDataHealthCenter_Click" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16,8" ToolTipService.ToolTip="{x:Bind Loc.GetString('DataHealth_Title')}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE958;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Loc.GetString('DataHealth_Title')}" FontWeight="SemiBold" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.BackupStatusMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Software Updates Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="20,16">
                <StackPanel Spacing="16">
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Width="34" Height="34" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_UpdateTitle')}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_UpdateSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <!-- Check for Updates Button -->
                        <Button Grid.Column="2"
                                Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingUpdate, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsCheckingUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                              Width="16" Height="16" />
                                <FontIcon Glyph="&#xE777;" FontSize="12"
                                          Visibility="{x:Bind ViewModel.IsCheckingUpdate, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_CheckForUpdates')}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Auto-check for updates Toggle Row -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="4,0">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_AutoCheckUpdates')}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_AutoCheckUpdatesDesc')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.AutoCheckUpdates, Mode=TwoWay}"
                                      OffContent="{x:Bind Loc.GetString('Settings_Toggle_Off')}"
                                      OnContent="{x:Bind Loc.GetString('Settings_Toggle_On')}"
                                      VerticalAlignment="Center" Margin="0" />
                    </Grid>

                    <!-- Version Status Bar -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_CurrentVersion')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Padding="8,3">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentAppVersion, Mode=OneWay}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="Bold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.UpdateStatusMessage, Mode=OneWay}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis" Margin="8,0" />

                            <Button Grid.Column="2" Click="OpenReleaseNotesLog_Click"
                                    Style="{ThemeResource DefaultButtonStyle}"
                                    Padding="10,4" CornerRadius="{ThemeResource ControlCornerRadius}" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="{x:Bind Loc.GetString('Settings_ViewReleaseNotesLogTooltip')}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE81C;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Settings_BtnViewReleaseNotesLog')}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Update Available Details Section -->
                    <Border Visibility="{x:Bind ViewModel.UpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16,14">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3">
                                            <TextBlock Text="{x:Bind ViewModel.AvailableUpdate.NewVersion, Mode=OneWay, FallbackValue=''}"
                                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                       FontWeight="Bold" FontSize="12" />
                                        </Border>
                                        <TextBlock Text="{x:Bind ViewModel.AvailableUpdate.ReleaseTitle, Mode=OneWay, FallbackValue=''}"
                                                   FontWeight="Bold" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind ViewModel.AvailableUpdatePublishDateText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.AvailableUpdateFileSizeText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- View Details in Popup Button -->
                                    <Button Click="OpenUpdateDetailsPopup_Click"
                                            Style="{ThemeResource DefaultButtonStyle}"
                                            CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE78B;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Loc.GetString('Settings_ViewUpdateDetails')}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Download Button (Visible when not downloaded and not ready to install) -->
                                    <Button Command="{x:Bind ViewModel.DownloadUpdateCommand}"
                                            Visibility="{x:Bind ViewModel.UpdateReadyToInstall, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE896;" FontSize="12" />
                                            <TextBlock Text="{x:Bind Loc.GetString('Settings_DownloadUpdate')}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Install & Restart Button (Visible when download completed) -->
                                    <Button Command="{x:Bind ViewModel.InstallUpdateCommand}"
                                            Visibility="{x:Bind ViewModel.UpdateReadyToInstall, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                                            <TextBlock Text="{x:Bind Loc.GetString('Settings_InstallUpdate')}" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Download Progress Bar (Visible while downloading) -->
                            <StackPanel Visibility="{x:Bind ViewModel.IsDownloadingUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{x:Bind Loc.GetString('Settings_DownloadingUpdate')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DownloadProgressText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Grid>
                                <ProgressBar Value="{x:Bind ViewModel.DownloadProgressPercentage, Mode=OneWay}" Maximum="100" Height="6" CornerRadius="3" />
                            </StackPanel>

                            <!-- Release Notes Preview -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="12,10">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{x:Bind Loc.GetString('Settings_ReleaseNotes')}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <Button Command="{x:Bind ViewModel.ToggleExpandUpdateNotesCommand}"
                                                    Style="{ThemeResource SubtleButtonStyle}" Padding="6,2" CornerRadius="{ThemeResource ControlCornerRadius}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="{x:Bind ViewModel.ExpandUpdateNotesGlyph, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.ExpandUpdateNotesText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OpenUpdateDetailsPopup_Click"
                                                    Style="{ThemeResource SubtleButtonStyle}" Padding="6,2" CornerRadius="{ThemeResource ControlCornerRadius}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE78B;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind Loc.GetString('Settings_ViewUpdateDetails')}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <ScrollViewer MaxHeight="{x:Bind ViewModel.ReleaseNotesMaxHeight, Mode=OneWay}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="InlineReleaseNotesPanel" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.AvailableUpdate.ReleaseNotes, Mode=OneWay, FallbackValue=''}" FontSize="12.5" LineHeight="22" LineStackingStrategy="MaxHeight" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- Safe Snapshot Notice -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_AutoBackupNote')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
                </StackPanel>

                <!-- TAB 4: HELP & GUIDE, SHORTCUTS, ABOUT -->
                <StackPanel x:Name="PanelHelpAbout" Spacing="16" Visibility="Collapsed">
                    <!-- Dedicated Help & User Guide Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="20,16">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Width="34" Height="34" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE897;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Loc.GetString('Settings_HelpCard_Title')}" FontWeight="Bold" FontSize="16" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Settings_HelpCard_Subtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Click="OpenFullGuide_Click"
                                        Tag="GettingStarted"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Padding="14,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                        <TextBlock Text="{x:Bind Loc.GetString('Settings_HelpCard_OpenBtn')}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="14,12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{x:Bind Loc.GetString('Settings_HelpCard_QuickTopics')}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8" HorizontalAlignment="Left">
                                        <Button x:Name="BtnHelpTopic1" Grid.Row="0" Grid.Column="0" Click="OpenFullGuide_Click" Tag="GettingStarted" Style="{StaticResource LexoraStandardButtonStyle}" MinWidth="220" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE80F;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_HelpCard_TopicGettingStarted')}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnHelpTopic2" Grid.Row="0" Grid.Column="1" Click="OpenFullGuide_Click" Tag="Vocabulary" Style="{StaticResource LexoraStandardButtonStyle}" MinWidth="220" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE82D;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_HelpCard_TopicVocabulary')}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnHelpTopic3" Grid.Row="1" Grid.Column="0" Click="OpenFullGuide_Click" Tag="Review" Style="{StaticResource LexoraStandardButtonStyle}" MinWidth="220" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE895;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_HelpCard_TopicReview')}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnHelpTopic4" Grid.Row="1" Grid.Column="1" Click="OpenFullGuide_Click" Tag="Roadmap" Style="{StaticResource LexoraStandardButtonStyle}" MinWidth="220" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Loc.GetString('Settings_HelpCard_TopicRoadmap')}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Keyboard Shortcuts Reference Guide -->
                    <Expander IsExpanded="True"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE765;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_ShortcutsTitle')}" FontWeight="Bold" FontSize="15" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="12">
                            <TextBlock Text="{x:Bind Loc.GetString('Settings_ShortcutsSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />

                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="16" RowSpacing="10">
                                <!-- Ctrl + 1-9 -->
                                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="Ctrl + 1 .. 9" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_Nav')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <!-- Ctrl + T -->
                                <Border Grid.Row="1" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="Ctrl + T" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                                </Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_Theme')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <!-- F1 / Ctrl + H -->
                                <Border Grid.Row="2" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="F1 / Ctrl + H" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                                </Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_Help')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <!-- Ctrl + K / F -->
                                <Border Grid.Row="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="Ctrl + K / F" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                                </Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_Search')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <!-- Ctrl + N -->
                                <Border Grid.Row="4" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="Ctrl + N" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                                </Border>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_AddWord')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <!-- Ctrl + E -->
                                <Border Grid.Row="5" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="Ctrl + E" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                                </Border>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_EditWord')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <!-- Delete -->
                                <Border Grid.Row="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="Delete" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                                </Border>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_DeleteWord')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <!-- Space -->
                                <Border Grid.Row="7" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="Space" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                                </Border>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_Flip')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <!-- 1, 2, 3, 4 -->
                                <Border Grid.Row="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="1, 2, 3, 4" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                                </Border>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_Rate')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <!-- R / U / S -->
                                <Border Grid.Row="9" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="R / U / S" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                                </Border>
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_Audio')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <!-- Enter -->
                                <Border Grid.Row="10" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="Enter" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                                </Border>
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="{x:Bind Loc.GetString('Settings_Shortcut_Enter')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- About Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="20,16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Border Width="56" Height="56" CornerRadius="{ThemeResource OverlayCornerRadius}" VerticalAlignment="Center">
                                <Image Source="ms-appx:///Assets/brand/lexora-app-icon-1024.png" Width="56" Height="56" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Lexora" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentAppVersion, Mode=OneWay}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_AboutSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Loc.GetString('Settings_AboutTech')}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
        </StackPanel>
    </Grid>
</ScrollViewer>
</Page>
