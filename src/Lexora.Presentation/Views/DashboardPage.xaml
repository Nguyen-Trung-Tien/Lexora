<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dto="using:Lexora.Application.DTOs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20">
        <StackPanel Spacing="24" MaxWidth="1180" HorizontalAlignment="Center">
            
            <!-- Loading Ring Overlay -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                          Width="36" Height="36" HorizontalAlignment="Center" />

            <!-- HERO BANNER: Elegant Fluent Surface Card with 1-Click Quick Actions -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="28,24">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,3">
                                <TextBlock Text="SPACED REPETITION (SM-2)" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,3">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xEC08;" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="Daily Consistency" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Welcome back to Lexora" Style="{ThemeResource TitleTextBlockStyle}" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Master English vocabulary scientifically with active recall drills, spaced repetition, and exam readiness tracking."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" MaxWidth="620" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Quick Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Click="StartReviewButton_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                FontWeight="Bold" Padding="20,12" CornerRadius="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE895;" FontSize="16" />
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_StartReview')}" FontSize="14" />
                                <Border Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" CornerRadius="10" Padding="6,1" Margin="4,0,0,0"
                                        Visibility="{x:Bind ViewModel.DueToday, Mode=OneWay, Converter={StaticResource IntToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind ViewModel.DueToday, Mode=OneWay}" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Click="StartPracticeButton_Click"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                FontWeight="SemiBold" Padding="18,12" CornerRadius="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE765;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_QuickPractice')}" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4 HERO METRIC CARDS -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                <!-- Total Vocabulary -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="20,18">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Width="38" Height="38" CornerRadius="19" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE82D;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,2">
                                <TextBlock Text="Active" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.TotalWords, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontSize="30" FontWeight="Bold" />
                        <TextBlock Text="{x:Bind Loc.GetString('Dashboard_TotalWords')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                    </StackPanel>
                </Border>

                <!-- Due Today -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="20,18">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Width="38" Height="38" CornerRadius="19" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE823;" FontSize="18" Foreground="{ThemeResource SystemFillColorCriticalBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" CornerRadius="6" Padding="6,2">
                                <TextBlock Text="Urgent" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.DueToday, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="{x:Bind Loc.GetString('Dashboard_DueToday')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                    </StackPanel>
                </Border>

                <!-- Mastered Words -->
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="20,18">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Width="38" Height="38" CornerRadius="19" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="6" Padding="6,2">
                                <TextBlock Text="Retention" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.Mastered, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="{x:Bind Loc.GetString('Dashboard_Mastered')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                    </StackPanel>
                </Border>

                <!-- Day Streak -->
                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="20,18">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Width="38" Height="38" CornerRadius="19" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xEC08;" FontSize="18" Foreground="{ThemeResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="6" Padding="6,2">
                                <TextBlock Text="Habit" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.StreakDays, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontSize="30" FontWeight="Bold" />
                            <TextBlock Text="days" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Loc.GetString('Dashboard_Streak')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SECTION 1: Memory Status Breakdown & Retention -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="24">
                <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_RetentionDistribution')}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_RetentionSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="8" Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_OverallAccuracy')}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.AccuracyRate, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="%" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Status Items list -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.StatusBreakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:LearningStatusDistributionDto">
                                <Grid ColumnDefinitions="140,*,70,60" Margin="0,6" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Value="{x:Bind Percentage}" Maximum="100" Height="8" CornerRadius="4" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Count}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Percentage}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="%" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- SECTION 2: Exam Target Progress -->
            <StackPanel Spacing="14">
                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_ExamTargetProgress')}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ExamProgressList}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal" MinItemWidth="300" MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="dto:ExamProgressDto">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind ExamName}" FontWeight="Bold" FontSize="16" />
                                            <TextBlock Text="{x:Bind TargetDescription}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{x:Bind ProgressPercentage}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="Bold" FontSize="12" />
                                                <TextBlock Text="%" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="Bold" FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <ProgressBar Value="{x:Bind ProgressPercentage}" Maximum="100" Height="8" CornerRadius="4" />

                                    <Grid ColumnDefinitions="*,*,*">
                                        <StackPanel>
                                            <TextBlock Text="Total" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                                            <TextBlock Text="{x:Bind TotalWords}" FontWeight="Bold" FontSize="15" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Learning" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                                            <TextBlock Text="{x:Bind LearningWords}" FontWeight="Bold" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Mastered" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                                            <TextBlock Text="{x:Bind MasteredWords}" FontWeight="Bold" FontSize="15" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- SECTION 3: Study Activity Heatmap (Last 30 Days) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="24">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEC08;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_HeatmapTitle')}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_HeatmapSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_HeatmapLess')}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <Border Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource HeatmapLevel0Brush}" />
                            <Border Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource HeatmapLevel1Brush}" />
                            <Border Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource HeatmapLevel2Brush}" />
                            <Border Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource HeatmapLevel3Brush}" />
                            <Border Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource HeatmapLevel4Brush}" />
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_HeatmapMore')}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Heatmap Grid -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.StudyHeatmapList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="15" ItemWidth="36" ItemHeight="36" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dto:StudyHistoryDayDto">
                                    <Border Width="28" Height="28" CornerRadius="5" Margin="4"
                                            BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            Background="{x:Bind HeatmapLevel, Converter={StaticResource HeatmapLevelToBrushConverter}}"
                                            ToolTipService.ToolTip="{x:Bind TooltipText}">
                                        <TextBlock Text="{x:Bind Date.Day}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{x:Bind HeatmapLevel, Converter={StaticResource HeatmapLevelToForegroundConverter}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_ReviewedToday')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.StudiedTodayCount, Mode=OneWay}" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="3,0,3,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEC08;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_CurrentStreak')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.StreakDays, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_DaysUnit')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_BestStreak')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.LongestStreakDays, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_DaysUnit')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECTION 4: CEFR & POS Breakdown -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <!-- CEFR Breakdown -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Loc.GetString('Dashboard_CefrBreakdown')}" FontWeight="Bold" FontSize="15" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.CefrDistributionList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dto:CefrLevelDistributionDto">
                                    <Grid ColumnDefinitions="50,*,40" Margin="0,4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Level}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Value="{x:Bind Percentage}" Maximum="100" Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Count}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- POS Breakdown -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Loc.GetString('Dashboard_PosBreakdown')}" FontWeight="Bold" FontSize="15" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PosDistributionList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dto:PosDistributionDto">
                                    <Grid ColumnDefinitions="110,*,40" Margin="0,4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind PartOfSpeech}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Value="{x:Bind Percentage}" Maximum="100" Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Count}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SECTION 5: Recent Sessions -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_RecentSessions')}" FontWeight="Bold" FontSize="15" />
                    <ListView ItemsSource="{x:Bind ViewModel.RecentSessionsList}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dto:StudySessionDto">
                                <Grid ColumnDefinitions="160,*,Auto,Auto" Padding="8,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind SessionType}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{x:Bind StartedAtText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <TextBlock Text="Cards:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{x:Bind TotalCards}" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Text="Correct:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{x:Bind CorrectCards}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" CornerRadius="4" Padding="8,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <TextBlock Text="{x:Bind AccuracyRate}" FontWeight="Bold" FontSize="12" />
                                            <TextBlock Text="%" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{x:Bind DurationText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
