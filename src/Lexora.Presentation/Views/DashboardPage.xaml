<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="24" MaxWidth="1200" HorizontalAlignment="Stretch">
            <!-- Header section -->
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="Welcome back to Lexora" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                    <TextBlock Text="Track your active vocabulary, review progress, and build your daily learning habit."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource BodyTextBlockStyle}" />
                </StackPanel>
            </Grid>

            <!-- Quick Action Banner -->
            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Today's Spaced Repetition Queue" Foreground="White" FontWeight="Bold" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Consistent daily review trains long-term retention via the SM-2 spaced repetition algorithm."
                                   Foreground="White" Opacity="0.9" Style="{ThemeResource BodyTextBlockStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Content="Start Review Session"
                            Background="White" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold"
                            Padding="16,8" CornerRadius="8" Click="StartReviewButton_Click" />
                </Grid>
            </Border>

            <!-- Metrics Grid -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                <!-- Card 1: Total Words -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE82D;" FontSize="24" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" />
                        <TextBlock Text="Total Words" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalWords, Mode=OneWay}" Style="{ThemeResource HeaderTextBlockStyle}" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Due Today -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE823;" FontSize="24" Foreground="#D83B01" HorizontalAlignment="Left" />
                        <TextBlock Text="Due For Review" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DueToday, Mode=OneWay}" Style="{ThemeResource HeaderTextBlockStyle}" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Mastered Words -->
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="24" Foreground="#107C41" HorizontalAlignment="Left" />
                        <TextBlock Text="Mastered Words" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Mastered, Mode=OneWay}" Style="{ThemeResource HeaderTextBlockStyle}" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Card 4: Day Streak -->
                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xEC58;" FontSize="24" Foreground="#FFB900" HorizontalAlignment="Left" />
                        <TextBlock Text="Daily Streak" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.StreakDays, Mode=OneWay}" Style="{ThemeResource HeaderTextBlockStyle}" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" HorizontalAlignment="Stretch" />
        </StackPanel>
    </ScrollViewer>
</Page>
