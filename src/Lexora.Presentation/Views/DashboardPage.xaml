<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dto="using:Lexora.Application.DTOs"
    xmlns:services="using:Lexora.Presentation.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20">
        <StackPanel Spacing="20" MaxWidth="1560" HorizontalAlignment="Stretch">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="0" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <!-- Loading Ring Overlay -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                          Width="36" Height="36" HorizontalAlignment="Center" />

            <!-- Due Review Reminder Banner -->
            <InfoBar x:Name="DueReviewInfoBar"
                     IsOpen="{x:Bind ViewModel.HasDueReviews, Mode=OneWay}"
                     Severity="Informational"
                     Title="{x:Bind Loc.GetString('Review_Reminder_Title')}"
                     Message="{x:Bind ViewModel.DueReviewMessage, Mode=OneWay}"
                     CornerRadius="12"
                     IsClosable="True">
                <InfoBar.ActionButton>
                    <Button Content="{x:Bind Loc.GetString('Review_Now')}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="StartReviewButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- HERO BANNER: Elegant Fluent Surface Card with 1-Click Quick Actions -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource LexoraHeroCardBorderBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="28,24">
                <Grid x:Name="HeroGrid" RowDefinitions="Auto,Auto" RowSpacing="18">
                    <!-- Top Section: Badges, Greeting, Subtitle and Help Button -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,3">
                                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_HeroBadge')}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="11" FontWeight="Bold" />
                                </Border>
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,3">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xEC08;" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        <TextBlock Text="{x:Bind Loc.GetString('Dashboard_DailyConsistency')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.GreetingText, Mode=OneWay}" Style="{StaticResource LexoraHeroHeaderStyle}" />
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_Subtitle')}"
                                       Style="{StaticResource LexoraBodyStyle}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Contextual Quick Help Button -->
                        <Button Grid.Column="1" x:Name="DashboardHelpButton" Click="DashboardHelpButton_Click"
                                Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="8"
                                VerticalAlignment="Top"
                                ToolTipService.ToolTip="{x:Bind Loc.GetString('Dashboard_Help_Title')}">
                            <FontIcon Glyph="&#xE9CE;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </Grid>

                    <TeachingTip x:Name="DashboardHelpTeachingTip"
                                 Target="{x:Bind DashboardHelpButton}"
                                 Title="{x:Bind Loc.GetString('Dashboard_Help_Title')}"
                                 Subtitle="{x:Bind Loc.GetString('Dashboard_Help_Subtitle')}"
                                 IsOpen="False"
                                 IsLightDismissEnabled="True"
                                 PreferredPlacement="BottomRight">
                        <TeachingTip.Content>
                            <StackPanel Spacing="10" MaxWidth="320">
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_Help_Content')}" TextWrapping="Wrap" FontSize="13" />
                                <Button Style="{ThemeResource AccentButtonStyle}"
                                        Click="OpenFullGuide_Click"
                                        Tag="GettingStarted"
                                        CornerRadius="8" Padding="12,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Loc.GetString('Help_OpenFullGuide')}" FontWeight="SemiBold" FontSize="12" />
                                        <FontIcon Glyph="&#xE76C;" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </TeachingTip.Content>
                    </TeachingTip>

                    <!-- Primary actions remain visible without requiring horizontal scrolling. -->
                    <Grid Grid.Row="1" x:Name="HeroActionsPanel" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                            <Button Click="StartReviewButton_Click"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    FontWeight="Bold" Padding="20,12" CornerRadius="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE895;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_StartReview')}" FontSize="14" />
                                    <Border Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" CornerRadius="10" Padding="6,1" Margin="4,0,0,0"
                                            Visibility="{x:Bind ViewModel.DueToday, Mode=OneWay, Converter={StaticResource IntToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind ViewModel.DueToday, Mode=OneWay}" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Click="StartPracticeButton_Click"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    FontWeight="SemiBold" Padding="18,12" CornerRadius="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE765;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_QuickPractice')}" FontSize="14" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Click="OpenStudyPlanner_Click"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    FontWeight="SemiBold" Padding="18,12" CornerRadius="10"
                                    ToolTipService.ToolTip="{x:Bind Loc.GetString('StudyPlanner_Title')}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE787;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_StudyPlannerAction')}" FontSize="14" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Grid.Column="1" Click="OpenListeningLab_Click"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    FontWeight="SemiBold" Padding="18,12" CornerRadius="10"
                                    ToolTipService.ToolTip="{x:Bind Loc.GetString('ListeningLab_Title')}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE767;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_ListeningLabAction')}" FontSize="14" />
                                </StackPanel>
                            </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Priority metrics adapt to narrow windows without horizontal scrolling. -->
            <Grid x:Name="MetricsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                    <!-- Total Vocabulary -->
                    <Border x:Name="CardTotalWords" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="20,18"
                            Tapped="TotalWordsCard_Tapped"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Dashboard_TooltipTotalWords')}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Border Width="38" Height="38" CornerRadius="19" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE82D;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,2">
                                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_StatActive')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.TotalWords, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontSize="30" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_TotalWords')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <!-- Due Today -->
                    <Border x:Name="CardDueToday" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="20,18"
                            Tapped="DueTodayCard_Tapped"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Dashboard_TooltipDueToday')}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Border Width="38" Height="38" CornerRadius="19" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE823;" FontSize="18" Foreground="{ThemeResource SystemFillColorCriticalBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" CornerRadius="6" Padding="6,2">
                                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_StatUrgent')}" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.DueToday, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_DueToday')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <!-- Mastered Words -->
                    <Border x:Name="CardMastered" Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="20,18"
                            Tapped="TotalWordsCard_Tapped"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Dashboard_TooltipMastered')}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Border Width="38" Height="38" CornerRadius="19" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="6" Padding="6,2">
                                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_StatRetention')}" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.Mastered, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_Mastered')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <!-- Day Streak -->
                    <Border x:Name="CardStreak" Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="20,18"
                            Tapped="StreakCard_Tapped"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('Dashboard_TooltipStreak')}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Border Width="38" Height="38" CornerRadius="19" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xEC08;" FontSize="18" Foreground="{ThemeResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="6" Padding="6,2">
                                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_StatHabit')}" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.StreakDays, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontSize="30" FontWeight="Bold" />
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_StatDays')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_Streak')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                        </StackPanel>
                    </Border>
            </Grid>

            <!-- SMART STUDY ADVISOR: Adaptive Recommendation Hero Card -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource LexoraAdvisorBorderBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="22,18">
                <Grid ColumnDefinitions="*,Auto" RowSpacing="12">
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8" Padding="7,3">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_AdvisorBadge')}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="11" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_AdvisorTitle')}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.AdviceTitle, Mode=OneWay}" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{x:Bind ViewModel.AdviceDescription, Mode=OneWay}" Style="{StaticResource LexoraBodyStyle}" MaxWidth="680" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{x:Bind ViewModel.ExecuteAdviceActionCommand}"
                            Style="{ThemeResource AccentButtonStyle}"
                            CornerRadius="10" Padding="18,10" VerticalAlignment="Center"
                            FontWeight="Bold">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="{x:Bind ViewModel.AdviceButtonText, Mode=OneWay}" FontSize="13" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 7-DAY WORKLOAD FORECAST: Spaced Repetition Schedule Projection -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="22,18">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_ForecastTitle')}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_ForecastSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_ForecastTotal')}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.TotalForecastNext7Days, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 7 Forecast Day Pills -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ForecastDaysList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Stretch" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dto:DailyForecastItemDto">
                                    <Border MinWidth="110" Padding="12,10" CornerRadius="10"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Bind DayLabel}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                            <Border Width="34" Height="34" CornerRadius="17"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{x:Bind DueCount}" FontSize="14" FontWeight="Bold"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{x:Bind DisplayDate}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Detailed analytics stay available without competing with today's work. -->
            <Expander Header="{x:Bind Loc.GetString('LearningIntel_Title')}"
                      IsExpanded="False"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="14"
                      Padding="16">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="22,18">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="8,2">
                                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_AiIntelligenceBadge')}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="11" FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="{x:Bind Loc.GetString('LearningIntel_Title')}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Loc.GetString('LearningIntel_Desc')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <!-- 3 Cognitive Insight Pills -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <!-- Peak Efficiency Slot -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEC08;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('LearningIntel_PeakTime')}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.PeakEfficiencyDisplay, Mode=OneWay}" FontSize="14" FontWeight="Bold" />
                            </StackPanel>
                        </Border>

                        <!-- Velocity -->
                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE890;" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('LearningIntel_MasteryVelocity')}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.VelocitySummaryDisplay, Mode=OneWay}" FontSize="14" FontWeight="Bold" />
                            </StackPanel>
                        </Border>

                        <!-- Exam Readiness -->
                        <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE734;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('LearningIntel_ExamReadiness')}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.ExamReadinessDisplay, Mode=OneWay}" FontSize="14" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Memory Health Segments -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind Loc.GetString('LearningIntel_MemoryHealth')}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.MemoryHealthList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="dto:MemoryHealthSegmentDto">
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="12,8" MinWidth="130">
                                            <StackPanel Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind StatusName}" FontSize="12" FontWeight="Bold" />
                                                    <TextBlock Text="{x:Bind WordCount}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Recommendation}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="150" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- HIGH-IMPACT LEARNING RECOMMENDATION BANNER -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="1.5" CornerRadius="12" Padding="18,14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Width="38" Height="38" CornerRadius="19" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE735;" FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="6,2">
                                        <TextBlock Text="{x:Bind Loc.GetString('Dashboard_AiHighImpactBadge')}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_HighImpactTitle')}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.HighImpactRecommendation, Mode=OneWay}"
                                           Style="{StaticResource LexoraBodyStyle}" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            </Expander>

            <!-- FORGETTING CURVE & RETENTION COMPARISON CARD -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="22,18">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_ForgettingCurveTitle')}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_ForgettingCurveSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="36,0,0,0" />
                        </StackPanel>

                        <!-- Legend -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="5" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_RetentionEmpirical')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="5" Background="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_RetentionTheoretical')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ItemsControl of Retention Curve Comparison Points -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.RetentionCurveList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:RetentionCurvePointDto">
                                <Grid ColumnDefinitions="90,*,160,90" Margin="0,6" VerticalAlignment="Center" ColumnSpacing="12">
                                    <!-- Interval Label & Word Count -->
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Label}" FontWeight="Bold" FontSize="13" />
                                        <TextBlock Text="{x:Bind WordCountDisplay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Dual Comparison ProgressBars -->
                                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="4" VerticalAlignment="Center">
                                        <!-- Empirical / Actual Rate -->
                                        <ProgressBar Value="{x:Bind RetentionRate}" Maximum="100" Height="7" CornerRadius="3.5"
                                                     Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <!-- Theoretical / Ebbinghaus Rate -->
                                        <ProgressBar Grid.Row="1" Value="{x:Bind TheoreticalRate}" Maximum="100" Height="4" CornerRadius="2"
                                                     Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Numerical Values -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ActualRateDisplay}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text=" vs " FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind TheoreticalRateDisplay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Retention Advantage Badge -->
                                    <Border Grid.Column="3" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                            BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="0.5"
                                            CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind RetentionAdvantageDisplay}" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- SECTION 1: Memory Status Breakdown & Retention -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="24">
                <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_RetentionDistribution')}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_RetentionSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="8" Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_OverallAccuracy')}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.AccuracyRate, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="%" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Status Items list -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.StatusBreakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:LearningStatusDistributionDto">
                                <Grid ColumnDefinitions="140,*,70,60" Margin="0,6" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Grid.Column="1" Value="{x:Bind Percentage}" Maximum="100" Height="8" CornerRadius="4" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Count}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Percentage}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="%" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- SECTION 2: Exam Target Progress -->
            <StackPanel Spacing="14">
                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_ExamTargetProgress')}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ExamProgressList}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal" MinItemWidth="300" MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="dto:ExamProgressDto">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2" Margin="0,0,12,0">
                                            <TextBlock Text="{x:Bind ExamName}" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind TargetDescription}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{x:Bind ProgressPercentage}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="Bold" FontSize="12" />
                                                <TextBlock Text="%" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="Bold" FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <ProgressBar Value="{x:Bind ProgressPercentage}" Maximum="100" Height="8" CornerRadius="4" />

                                    <Grid ColumnDefinitions="*,*,*">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind services:LocalizationHelper.GetString('Dashboard_ExamTotal')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                                            <TextBlock Text="{x:Bind TotalWords}" FontWeight="Bold" FontSize="15" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind services:LocalizationHelper.GetString('Dashboard_ExamLearning')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                                            <TextBlock Text="{x:Bind LearningWords}" FontWeight="Bold" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{x:Bind services:LocalizationHelper.GetString('Dashboard_ExamMastered')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                                            <TextBlock Text="{x:Bind MasteredWords}" FontWeight="Bold" FontSize="15" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- SECTION 3: Study Activity Heatmap (Last 30 Days) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="24">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEC08;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_HeatmapTitle')}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_HeatmapSubtitle')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_HeatmapLess')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Border Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource HeatmapLevel0Brush}" />
                            <Border Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource HeatmapLevel1Brush}" />
                            <Border Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource HeatmapLevel2Brush}" />
                            <Border Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource HeatmapLevel3Brush}" />
                            <Border Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource HeatmapLevel4Brush}" />
                            <TextBlock Text="{x:Bind Loc.GetString('Dashboard_HeatmapMore')}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Heatmap Grid -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.StudyHeatmapList, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="15" ItemWidth="36" ItemHeight="36" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dto:StudyHistoryDayDto">
                                    <Border Width="28" Height="28" CornerRadius="5" Margin="4"
                                            BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            Background="{x:Bind HeatmapLevel, Converter={StaticResource HeatmapLevelToBrushConverter}}"
                                            ToolTipService.ToolTip="{x:Bind TooltipText}">
                                        <TextBlock Text="{x:Bind Date.Day}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{x:Bind HeatmapLevel, Converter={StaticResource HeatmapLevelToForegroundConverter}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,4,0,0">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12,10">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.StudiedTodayCount, Mode=OneWay}" FontWeight="Bold" FontSize="15" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_ReviewedToday')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12,10">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xEC08;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.StreakDays, Mode=OneWay}" FontWeight="Bold" FontSize="15" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_DaysUnit')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_CurrentStreak')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12,10">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.LongestStreakDays, Mode=OneWay}" FontWeight="Bold" FontSize="15" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_DaysUnit')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Loc.GetString('Dashboard_BestStreak')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECTION 4: CEFR & POS Breakdown -->
            <Grid x:Name="BreakdownGrid" ColumnDefinitions="*,*" ColumnSpacing="16">
                <!-- CEFR Breakdown -->
                <Border x:Name="CefrBreakdownBorder" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Loc.GetString('Dashboard_CefrBreakdown')}" FontWeight="Bold" FontSize="15" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.CefrDistributionList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dto:CefrLevelDistributionDto">
                                    <Grid ColumnDefinitions="50,*,40" Margin="0,4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Level}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Value="{x:Bind Percentage}" Maximum="100" Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Count}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- POS Breakdown -->
                <Border x:Name="PosBreakdownBorder" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Loc.GetString('Dashboard_PosBreakdown')}" FontWeight="Bold" FontSize="15" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PosDistributionList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dto:PosDistributionDto">
                                    <Grid ColumnDefinitions="110,*,40" Margin="0,4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind services:LocalizationHelper.FormatPartOfSpeech(PartOfSpeech)}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Value="{x:Bind Percentage}" Maximum="100" Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Count}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SECTION 5: Recent Sessions -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="{x:Bind Loc.GetString('Dashboard_RecentSessions')}" FontWeight="Bold" FontSize="15" />
                    <!-- Empty State for Recent Sessions -->
                    <StackPanel Spacing="10" Padding="24" HorizontalAlignment="Center"
                                Visibility="{x:Bind ViewModel.HasRecentSessions, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Border Width="48" Height="48" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE81C;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{x:Bind Loc.GetString('Dashboard_NoRecentSessions')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" TextWrapping="Wrap" />
                    </StackPanel>

                    <ListView ItemsSource="{x:Bind ViewModel.RecentSessionsList}" SelectionMode="None"
                              Visibility="{x:Bind ViewModel.HasRecentSessions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dto:StudySessionDto">
                                <Grid ColumnDefinitions="160,*,Auto,Auto" Padding="8,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind services:LocalizationHelper.FormatSessionType(SessionType)}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{x:Bind StartedAtText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind services:LocalizationHelper.GetString('Dashboard_Cards')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{x:Bind TotalCards}" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Text="{x:Bind services:LocalizationHelper.GetString('Dashboard_Correct')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{x:Bind CorrectCards}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" CornerRadius="4" Padding="8,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <TextBlock Text="{x:Bind AccuracyRate}" FontWeight="Bold" FontSize="12" />
                                            <TextBlock Text="%" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{x:Bind DurationText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
