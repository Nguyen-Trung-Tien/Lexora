<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.HomophonesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dtos="using:Lexora.Application.DTOs"
    xmlns:views="using:Lexora.Presentation.Views"
    Background="{ThemeResource LayerFillColorDefaultBrush}"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <!-- Top Command Bar / Header Area -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14,24,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Page Title -->
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <FontIcon Glyph="&#xE768;" FontSize="18"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText" Text="Từ đồng âm &amp; Cặp âm dễ nhầm" FontWeight="Bold" FontSize="18" />
                        <TextBlock x:Name="PageSubtitleText" Text="Phân biệt từ phát âm tương đồng, tránh bẫy nghe và viết trong TOEIC, IELTS, VSTEP"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Action Controls Row with Horizontal Scroll for Compact/1366x768 screens -->
                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="BtnAddGroup" Click="BtnAddGroup_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                CornerRadius="10" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock x:Name="TextAddGroup" Text="Thêm nhóm từ" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSmartImport" Click="BtnSmartImport_Click"
                                CornerRadius="10" Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B5;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="TextSmartImport" Text="Nhập thông minh" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <DropDownButton x:Name="BtnExport" CornerRadius="10" Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEDE1;" FontSize="13" />
                                <TextBlock x:Name="TextExport" Text="Xuất dữ liệu" FontWeight="SemiBold" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="Xuất file JSON (.json)" Click="ExportJson_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE943;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Xuất bảng tính CSV (.csv)" Click="ExportCsv_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xED43;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Xuất Flashcard TXT (.txt)" Click="ExportTxt_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C4;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <Button x:Name="BtnRefresh" Click="BtnRefresh_Click"
                                Width="36" Height="36" Padding="0" CornerRadius="10"
                                ToolTipService.ToolTip="Làm mới danh sách">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Main Workspace (Master-Detail) -->
        <Grid Grid.Row="1" ColumnDefinitions="360,*">
            <!-- Left Pane: Search, Filters, Group List & Pagination -->
            <Border Grid.Column="0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Search Input with AutoSuggestBox -->
                    <Grid Grid.Row="0" Padding="16,14,16,8">
                        <AutoSuggestBox x:Name="SearchBox"
                                        PlaceholderText="Tìm từ, phát âm /IPA/, ý nghĩa..."
                                        TextChanged="SearchBox_TextChanged"
                                        SuggestionChosen="SearchBox_SuggestionChosen"
                                        QuerySubmitted="SearchBox_QuerySubmitted"
                                        QueryIcon="Find"
                                        CornerRadius="10" Padding="12,6">
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="4,4">
                                        <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                            <FontIcon Glyph="{Binding Glyph}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>
                    </Grid>

                    <!-- Filter Dropdowns -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,*" Padding="16,0,16,12">
                        <ComboBox x:Name="TypeFilterBox"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="8"
                                  Margin="0,0,4,0"
                                  SelectionChanged="TypeFilterBox_SelectionChanged">
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Homophones_FilterAllTypes')}" Tag="All" IsSelected="True" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Homophones_TypeExact')}" Tag="ExactHomophone" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Homophones_TypeNear')}" Tag="NearHomophone" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Homophones_TypePair')}" Tag="MinimalPair" />
                        </ComboBox>

                        <ComboBox x:Name="LevelFilterBox"
                                  Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="8"
                                  Margin="4,0,0,0"
                                  SelectionChanged="LevelFilterBox_SelectionChanged">
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Homophones_FilterAllLevels')}" Tag="All" IsSelected="True" />
                            <ComboBoxItem Content="A1 - A2" Tag="A1" />
                            <ComboBoxItem Content="B1 - B2" Tag="B1" />
                            <ComboBoxItem Content="C1 - C2" Tag="C1" />
                        </ComboBox>
                    </Grid>

                    <!-- List of Groups -->
                    <ListView x:Name="GroupsListView"
                              Grid.Row="2"
                              Padding="12,4,12,12"
                              ItemsSource="{x:Bind ViewModel.Groups}"
                              SelectionMode="Single"
                              SelectionChanged="GroupsListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:HomophoneGroupDto">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,3,0,3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="14" />
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                        Visibility="{x:Bind PhoneticIpa, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <TextBlock Text="{x:Bind PhoneticIpa}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontFamily="Consolas, Segoe UI" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{x:Bind TermsSummary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ItemCount}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Pagination Controls Bar -->
                    <Border Grid.Row="3"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{x:Bind ViewModel.ItemsRangeDisplay, Mode=OneWay}"
                                       VerticalAlignment="Center" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <Button Command="{x:Bind ViewModel.FirstPageCommand}"
                                        IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                                        Padding="0" Height="28" Width="28" CornerRadius="6"
                                        ToolTipService.ToolTip="Trang đầu">
                                    <FontIcon Glyph="&#xE892;" FontSize="11" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.PreviousPageCommand}"
                                        IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                                        Padding="0" Height="28" Width="28" CornerRadius="6"
                                        ToolTipService.ToolTip="Trang trước">
                                    <FontIcon Glyph="&#xE76B;" FontSize="11" />
                                </Button>

                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="8,0" Height="28">
                                    <TextBlock Text="{x:Bind ViewModel.PageDisplayInfo, Mode=OneWay}"
                                               FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>

                                <Button Command="{x:Bind ViewModel.NextPageCommand}"
                                        IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                                        Padding="0" Height="28" Width="28" CornerRadius="6"
                                        ToolTipService.ToolTip="Trang sau">
                                    <FontIcon Glyph="&#xE76C;" FontSize="11" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.LastPageCommand}"
                                        IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                                        Padding="0" Height="28" Width="28" CornerRadius="6"
                                        ToolTipService.ToolTip="Trang cuối">
                                    <FontIcon Glyph="&#xE893;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyListPanel"
                                Grid.Row="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10"
                                Visibility="Collapsed"
                                Padding="24">
                        <FontIcon Glyph="&#xE774;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind Loc.GetString('Homophones_EmptyList')}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Pane: Detail & Side-by-Side Comparison Workspace -->
            <ScrollViewer Grid.Column="1" Padding="28,20,28,24">
                <StackPanel x:Name="DetailContentPanel" Spacing="20">
                    <!-- Selected Group Header Bar -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20,16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailGroupTitle" Text="bare / bear" FontWeight="Bold" FontSize="22" />
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,3"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="DetailGroupIpa" Text="/beə(r)/" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   FontFamily="Consolas, Segoe UI" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border x:Name="BadgeType" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock x:Name="TextBadgeType" Text="Exact Homophone" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Border x:Name="BadgeLevel" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock x:Name="TextBadgeLevel" Text="Level B1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Border x:Name="BadgeExam" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock x:Name="TextBadgeExam" Text="TOEIC" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Group Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="BtnEditGroup" Click="BtnEditGroup_Click"
                                        CornerRadius="8" Padding="12,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                        <TextBlock Text="{x:Bind Loc.GetString('Action_Edit')}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnDeleteGroup" Click="BtnDeleteGroup_Click"
                                        CornerRadius="8" Padding="12,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <TextBlock Text="{x:Bind Loc.GetString('Action_Delete')}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Differentiation Tip Banner -->
                    <Border x:Name="TipBanner"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="30" Height="30" CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    VerticalAlignment="Top" Margin="0,0,12,0">
                                <FontIcon Glyph="&#xEA80;" FontSize="15"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Loc.GetString('Homophones_TipTitle')}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock x:Name="TextDifferentiationTip"
                                           Text="'Bare' là tính từ nghĩa là trần trụi..."
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Side-by-Side Comparison Workspace -->
                    <TextBlock Text="{x:Bind Loc.GetString('Homophones_ComparisonTitle')}" FontWeight="Bold" FontSize="16" />

                    <!-- Grid of 2 comparison cards -->
                    <Grid x:Name="ComparisonCardsGrid" ColumnDefinitions="*,*" ColumnSpacing="16">
                        <!-- Card 1 (Word A) -->
                        <Border Grid.Column="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="Word1Term" Text="bare" FontWeight="Bold" FontSize="24" />
                                        <TextBlock x:Name="Word1Pos" Text="Adjective" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>

                                    <!-- Action Buttons: Listen, View in Vocab, Save to Storage -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button x:Name="BtnListenWord1" Click="BtnListenWord1_Click"
                                                Width="36" Height="36" Padding="0" CornerRadius="18"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                ToolTipService.ToolTip="{x:Bind Loc.GetString('Vocab_PlayUsPronunciation')}">
                                            <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Button>
                                        <Button x:Name="BtnViewWord1" Click="ViewInVocab_Click"
                                                Width="36" Height="36" Padding="0" CornerRadius="18"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                ToolTipService.ToolTip="{x:Bind Loc.GetString('Homophones_ViewInVocabulary')}">
                                            <FontIcon Glyph="&#xE82D;" FontSize="13" />
                                        </Button>
                                        <Button x:Name="BtnSaveWord1" Click="SaveToStorage_Click"
                                                Width="36" Height="36" Padding="0" CornerRadius="18"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                ToolTipService.ToolTip="{x:Bind Loc.GetString('Homophones_SaveToStorage')}">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Loc.GetString('Homophones_VietnameseMeaning')}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="Word1MeaningVi" Text="trần trụi, trống không" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Loc.GetString('Homophones_ContextualExample')}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontWeight="SemiBold" />
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="Word1Example" Text="He walked on the floor with bare feet." FontStyle="Italic" TextWrapping="Wrap" FontSize="13" />
                                            <TextBlock x:Name="Word1Translation" Text="Anh ấy đi chân trần trên sàn nhà." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2 (Word B) -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="Word2Term" Text="bear" FontWeight="Bold" FontSize="24" />
                                        <TextBlock x:Name="Word2Pos" Text="Verb" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>

                                    <!-- Action Buttons: Listen, View in Vocab, Save to Storage -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button x:Name="BtnListenWord2" Click="BtnListenWord2_Click"
                                                Width="36" Height="36" Padding="0" CornerRadius="18"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                ToolTipService.ToolTip="{x:Bind Loc.GetString('Vocab_PlayUsPronunciation')}">
                                            <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Button>
                                        <Button x:Name="BtnViewWord2" Click="ViewInVocab_Click"
                                                Width="36" Height="36" Padding="0" CornerRadius="18"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                ToolTipService.ToolTip="{x:Bind Loc.GetString('Homophones_ViewInVocabulary')}">
                                            <FontIcon Glyph="&#xE82D;" FontSize="13" />
                                        </Button>
                                        <Button x:Name="BtnSaveWord2" Click="SaveToStorage_Click"
                                                Width="36" Height="36" Padding="0" CornerRadius="18"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                ToolTipService.ToolTip="{x:Bind Loc.GetString('Homophones_SaveToStorage')}">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Loc.GetString('Homophones_VietnameseMeaning')}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="Word2MeaningVi" Text="chịu đựng" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Loc.GetString('Homophones_ContextualExample')}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontWeight="SemiBold" />
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="Word2Example" Text="I can hardly bear the continuous noise." FontStyle="Italic" TextWrapping="Wrap" FontSize="13" />
                                            <TextBlock x:Name="Word2Translation" Text="Tôi khó lòng chịu đựng nổi tiếng ồn." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
