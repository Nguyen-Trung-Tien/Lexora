<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Lexora.Presentation.Views.SplashScreenOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- ======================================================= -->
        <!-- CINEMATIC ENTRANCE STORYBOARD                           -->
        <!-- Multi-layered camera push-in, aurora glow, specular     -->
        <!-- light sweep, and staggered title reveal                 -->
        <!-- ======================================================= -->
        <Storyboard x:Name="EntranceStoryboard">
            <!-- 1. Ambient Aurora Glow Expand & Breathe -->
            <DoubleAnimation
                Storyboard.TargetName="AuraScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.6" To="1.25"
                Duration="0:0:0.9"
                BeginTime="0:0:0.0">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="AuraScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.6" To="1.25"
                Duration="0:0:0.9"
                BeginTime="0:0:0.0">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="AuroraGlow"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="0.55"
                Duration="0:0:0.6"
                BeginTime="0:0:0.0">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 2. Energy Pulse Ripple Ring (Expands & Fades Out) -->
            <DoubleAnimation
                Storyboard.TargetName="RippleScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.75" To="1.65"
                Duration="0:0:0.85"
                BeginTime="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="RippleScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.75" To="1.65"
                Duration="0:0:0.85"
                BeginTime="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="RippleRing"
                Storyboard.TargetProperty="Opacity"
                BeginTime="0:0:0.15">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="0.8" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>

            <!-- 3. Logo Camera Push-In (Scale from 0.82 to 1.0 with subtle elastic settle) -->
            <DoubleAnimation
                Storyboard.TargetName="LogoScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.82" To="1.0"
                Duration="0:0:0.75"
                BeginTime="0:0:0.05">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="LogoScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.82" To="1.0"
                Duration="0:0:0.75"
                BeginTime="0:0:0.05">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="LogoTile"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="1.0"
                Duration="0:0:0.5"
                BeginTime="0:0:0.05">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 5. Horizontal Energy Divider Line Expand (ScaleX 0 -> 1) -->
            <DoubleAnimation
                Storyboard.TargetName="DividerScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.0" To="1.0"
                Duration="0:0:0.5"
                BeginTime="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="GlowingDivider"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="1.0"
                Duration="0:0:0.4"
                BeginTime="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 6. Wordmark "Lexora" Slide Up & Fade In -->
            <DoubleAnimation
                Storyboard.TargetName="TypographyContainer"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="1.0"
                Duration="0:0:0.5"
                BeginTime="0:0:0.40">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="TypographyTranslate"
                Storyboard.TargetProperty="Y"
                From="16" To="0"
                Duration="0:0:0.5"
                BeginTime="0:0:0.40">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 7. Loading Status Fade In -->
            <DoubleAnimation
                Storyboard.TargetName="LoadingContainer"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="1.0"
                Duration="0:0:0.4"
                BeginTime="0:0:0.55">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ======================================================= -->
        <!-- CINEMATIC EXIT STORYBOARD (Camera Push-through & Dissolve)-->
        <!-- ======================================================= -->
        <Storyboard x:Name="ExitStoryboard">
            <!-- Loading indicator quick fade -->
            <DoubleAnimation
                Storyboard.TargetName="LoadingContainer"
                Storyboard.TargetProperty="Opacity"
                To="0.0"
                Duration="0:0:0.12" />

            <!-- Cinematic Push-through zoom on exit (1.0 -> 1.08) -->
            <DoubleAnimation
                Storyboard.TargetName="MainStackScale"
                Storyboard.TargetProperty="ScaleX"
                To="1.06"
                Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MainStackScale"
                Storyboard.TargetProperty="ScaleY"
                To="1.06"
                Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Overall Splash Dissolve -->
            <DoubleAnimation
                Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="Opacity"
                To="0.0"
                Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Reduced Motion Entrance -->
        <Storyboard x:Name="ReducedMotionEntrance">
            <DoubleAnimation
                Storyboard.TargetName="LogoTile"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="1.0"
                Duration="0:0:0.2" />
            <DoubleAnimation
                Storyboard.TargetName="TypographyContainer"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="1.0"
                Duration="0:0:0.2" />
            <DoubleAnimation
                Storyboard.TargetName="LoadingContainer"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="1.0"
                Duration="0:0:0.2" />
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        
        <!-- Ambient Backdrop Aurora Radial Glow (Center behind logo) -->
        <Border x:Name="AuroraGlow" Width="360" Height="360"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <ScaleTransform x:Name="AuraScale" CenterX="180" CenterY="180" ScaleX="0.6" ScaleY="0.6" />
            </Border.RenderTransform>
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="0" />
                    <GradientStop Color="{ThemeResource SystemAccentColorLight1}" Offset="0.45" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Energy Ripple Wave Ring -->
        <Border x:Name="RippleRing" Width="180" Height="180" CornerRadius="90"
                BorderThickness="1.5" BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <ScaleTransform x:Name="RippleScale" CenterX="90" CenterY="90" ScaleX="0.75" ScaleY="0.75" />
            </Border.RenderTransform>
        </Border>

        <!-- Main Visual Center Stack (Supports Push-in Zoom on Exit) -->
        <StackPanel
            x:Name="MainVisualStack"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="24">
            <StackPanel.RenderTransform>
                <ScaleTransform x:Name="MainStackScale" CenterX="200" CenterY="160" ScaleX="1" ScaleY="1" />
            </StackPanel.RenderTransform>

            <!-- 1. Logo Vector Squircle Container -->
            <Grid
                x:Name="LogoContainer"
                Width="160"
                Height="160"
                HorizontalAlignment="Center">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" CenterX="80" CenterY="80" ScaleX="0.82" ScaleY="0.82" />
                </Grid.RenderTransform>

                <!-- Subtle Logo Glow Shadow Behind Tile -->
                <Border Width="144" Height="144" CornerRadius="32"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Master Authentic Logo Tile -->
                <Image
                    x:Name="LogoTile"
                    Source="ms-appx:///Assets/brand/lexora-app-icon-1024.png"
                    Width="144"
                    Height="144"
                    Opacity="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Image.Shadow>
                        <ThemeShadow />
                    </Image.Shadow>
                </Image>
            </Grid>

            <!-- 2. Wordmark & Tagline -->
            <StackPanel
                x:Name="TypographyContainer"
                HorizontalAlignment="Center"
                Spacing="8"
                Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="TypographyTranslate" Y="16" />
                </StackPanel.RenderTransform>

                <TextBlock
                    Text="Lexora"
                    FontSize="44"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    CharacterSpacing="30"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <!-- Glowing Divider Beam -->
                <Border x:Name="GlowingDivider" Width="180" Height="1.5"
                        HorizontalAlignment="Center" Opacity="0">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="DividerScale" CenterX="90" CenterY="0.75" ScaleX="0" ScaleY="1" />
                    </Border.RenderTransform>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="0.5" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <TextBlock
                    x:Name="TaglineTextBlock"
                    Text="INTELLIGENT VOCABULARY &amp; SPACED REPETITION"
                    FontSize="11"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    CharacterSpacing="150"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 3. Minimalist Loading State -->
            <StackPanel
                x:Name="LoadingContainer"
                HorizontalAlignment="Center"
                Spacing="14"
                Opacity="0">

                <!-- Fluent Modern Capsule Progress Track -->
                <Border Width="220" Height="4" CornerRadius="2"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0.5">
                    <ProgressBar
                        x:Name="StartupProgressBar"
                        IsIndeterminate="True"
                        Height="4"
                        CornerRadius="2"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                </Border>

                <!-- Status Feedback Label -->
                <TextBlock
                    x:Name="StatusTextBlock"
                    Text="Đang khởi tạo hệ thống..."
                    FontSize="12"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <!-- 4. Error State Panel (Initially Collapsed) -->
            <Border
                x:Name="ErrorCard"
                Visibility="Collapsed"
                MaxWidth="400"
                Padding="20"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                BorderThickness="1.5">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE783;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="18" />
                        <TextBlock x:Name="ErrorTitleTextBlock" Text="Không thể khởi tạo Lexora" FontWeight="Bold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="ErrorDetailsTextBlock"
                        Text="Đã có lỗi xảy ra khi tải cơ sở dữ liệu."
                        TextWrapping="Wrap"
                        FontSize="12"
                        TextAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,4,0,0">
                        <Button
                            x:Name="RetryButton"
                            Content="Thử lại"
                            Style="{StaticResource AccentButtonStyle}"
                            CornerRadius="8"
                            Padding="16,8"
                            Click="RetryButton_Click" />
                        <Button
                            x:Name="ExitButton"
                            Content="Đóng ứng dụng"
                            CornerRadius="8"
                            Padding="16,8"
                            Click="ExitButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
