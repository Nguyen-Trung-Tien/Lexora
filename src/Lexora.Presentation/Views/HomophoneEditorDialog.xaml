<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Lexora.Presentation.Views.HomophoneEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    DefaultButton="Primary"
    CornerRadius="16"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">880</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/brand/lexora-icon-only.png" Width="24" Height="24" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding}" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <ScrollViewer MaxHeight="500" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,12,8">
        <StackPanel Spacing="16">
            <!-- Validation Feedback InfoBar at Top -->
            <InfoBar x:Name="DialogInfoBar" IsOpen="False" Severity="Error" Margin="0,0,0,4" />

            <!-- Card 1: Group Metadata Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Loc.GetString('Homophones_EditorSectionInfo')}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Title & IPA -->
                    <Grid ColumnDefinitions="1.2*,1*" ColumnSpacing="12">
                        <TextBox x:Name="TitleTextBox"
                                 Header="{x:Bind Loc.GetString('Homophones_EditorTitleHeader')}"
                                 PlaceholderText="{x:Bind Loc.GetString('Homophones_EditorTitlePlaceholder')}"
                                 FontWeight="SemiBold"
                                 TextWrapping="Wrap" />
                        <TextBox x:Name="IpaTextBox" Grid.Column="1"
                                 Header="{x:Bind Loc.GetString('Homophones_EditorIpaHeader')}"
                                 PlaceholderText="{x:Bind Loc.GetString('Homophones_EditorIpaPlaceholder')}"
                                 FontFamily="Consolas, Cascadia Code, Segoe UI" />
                    </Grid>

                    <!-- Type, Level, Exam Tag -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <ComboBox x:Name="TypeComboBox" Header="{x:Bind Loc.GetString('Homophones_EditorTypeHeader')}" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Homophones_TypeExact')}" Tag="ExactHomophone" IsSelected="True" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Homophones_TypeNear')}" Tag="NearHomophone" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Homophones_TypePair')}" Tag="MinimalPair" />
                        </ComboBox>

                        <ComboBox x:Name="LevelComboBox" Grid.Column="1" Header="{x:Bind Loc.GetString('Homophones_EditorLevelHeader')}" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Cefr_None')}" Tag="None" IsSelected="True" />
                            <ComboBoxItem Content="A1" Tag="A1" />
                            <ComboBoxItem Content="A2" Tag="A2" />
                            <ComboBoxItem Content="B1" Tag="B1" />
                            <ComboBoxItem Content="B2" Tag="B2" />
                            <ComboBoxItem Content="C1" Tag="C1" />
                            <ComboBoxItem Content="C2" Tag="C2" />
                        </ComboBox>

                        <ComboBox x:Name="ExamComboBox" Grid.Column="2" Header="{x:Bind Loc.GetString('Homophones_EditorExamHeader')}" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Exam_Name_General')}" Tag="General" IsSelected="True" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Exam_Name_Toeic')}" Tag="Toeic" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Exam_Name_Ielts')}" Tag="Ielts" />
                            <ComboBoxItem Content="{x:Bind Loc.GetString('Exam_Name_Vstep')}" Tag="Vstep" />
                        </ComboBox>
                    </Grid>

                    <!-- Differentiation Tip -->
                    <TextBox x:Name="TipTextBox"
                             Header="{x:Bind Loc.GetString('Homophones_EditorTipHeader')}"
                             PlaceholderText="{x:Bind Loc.GetString('Homophones_EditorTipPlaceholder')}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="68" MaxHeight="140" />
                </StackPanel>
            </Border>

            <!-- Card 2: Side-by-Side Comparison Words (Word A & Word B) -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <!-- Word 1 Card -->
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind Loc.GetString('Homophones_EditorWord1Badge')}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>

                        <Grid ColumnDefinitions="*,135" ColumnSpacing="10">
                            <TextBox x:Name="Word1TermBox" Header="{x:Bind Loc.GetString('Homophones_EditorTermHeader')}" PlaceholderText="{x:Bind Loc.GetString('Homophones_EditorTerm1Placeholder')}" FontWeight="SemiBold" />
                            <ComboBox x:Name="Word1PosBox" Grid.Column="1" Header="{x:Bind Loc.GetString('Homophones_EditorPosHeader')}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="{x:Bind Loc.GetString('WordEditor_PosNoun')}" Tag="Noun" IsSelected="True" />
                                <ComboBoxItem Content="{x:Bind Loc.GetString('WordEditor_PosVerb')}" Tag="Verb" />
                                <ComboBoxItem Content="{x:Bind Loc.GetString('WordEditor_PosAdj')}" Tag="Adjective" />
                                <ComboBoxItem Content="{x:Bind Loc.GetString('WordEditor_PosAdv')}" Tag="Adverb" />
                                <ComboBoxItem Content="{x:Bind Loc.GetString('WordEditor_PosConjunction')}" Tag="Conjunction" />
                                <ComboBoxItem Content="{x:Bind Loc.GetString('WordEditor_PosPreposition')}" Tag="Preposition" />
                            </ComboBox>
                        </Grid>

                        <TextBox x:Name="Word1MeaningBox"
                                 Header="{x:Bind Loc.GetString('Homophones_EditorMeaningHeader')}"
                                 PlaceholderText="{x:Bind Loc.GetString('Homophones_EditorMeaning1Placeholder')}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" />
                        <TextBox x:Name="Word1ExampleBox"
                                 Header="{x:Bind Loc.GetString('Homophones_EditorExampleHeader')}"
                                 PlaceholderText="{x:Bind Loc.GetString('Homophones_EditorExamplePlaceholder')}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" />
                        <TextBox x:Name="Word1ExampleTransBox"
                                 Header="{x:Bind Loc.GetString('Homophones_EditorExampleTransHeader')}"
                                 PlaceholderText="{x:Bind Loc.GetString('Homophones_EditorExampleTransPlaceholder')}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" />
                    </StackPanel>
                </Border>

                <!-- Word 2 Card -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind Loc.GetString('Homophones_EditorWord2Badge')}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>

                        <Grid ColumnDefinitions="*,135" ColumnSpacing="10">
                            <TextBox x:Name="Word2TermBox" Header="{x:Bind Loc.GetString('Homophones_EditorTermHeader')}" PlaceholderText="{x:Bind Loc.GetString('Homophones_EditorTerm2Placeholder')}" FontWeight="SemiBold" />
                            <ComboBox x:Name="Word2PosBox" Grid.Column="1" Header="{x:Bind Loc.GetString('Homophones_EditorPosHeader')}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="{x:Bind Loc.GetString('WordEditor_PosNoun')}" Tag="Noun" />
                                <ComboBoxItem Content="{x:Bind Loc.GetString('WordEditor_PosVerb')}" Tag="Verb" IsSelected="True" />
                                <ComboBoxItem Content="{x:Bind Loc.GetString('WordEditor_PosAdj')}" Tag="Adjective" />
                                <ComboBoxItem Content="{x:Bind Loc.GetString('WordEditor_PosAdv')}" Tag="Adverb" />
                                <ComboBoxItem Content="{x:Bind Loc.GetString('WordEditor_PosConjunction')}" Tag="Conjunction" />
                                <ComboBoxItem Content="{x:Bind Loc.GetString('WordEditor_PosPreposition')}" Tag="Preposition" />
                            </ComboBox>
                        </Grid>

                        <TextBox x:Name="Word2MeaningBox"
                                 Header="{x:Bind Loc.GetString('Homophones_EditorMeaningHeader')}"
                                 PlaceholderText="{x:Bind Loc.GetString('Homophones_EditorMeaning2Placeholder')}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" />
                        <TextBox x:Name="Word2ExampleBox"
                                 Header="{x:Bind Loc.GetString('Homophones_EditorExampleHeader')}"
                                 PlaceholderText="{x:Bind Loc.GetString('Homophones_EditorExamplePlaceholder')}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" />
                        <TextBox x:Name="Word2ExampleTransBox"
                                 Header="{x:Bind Loc.GetString('Homophones_EditorExampleTransHeader')}"
                                 PlaceholderText="{x:Bind Loc.GetString('Homophones_EditorExampleTransPlaceholder')}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
