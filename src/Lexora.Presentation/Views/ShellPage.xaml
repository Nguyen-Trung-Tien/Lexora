<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="NavigateAccelerator_Invoked" />
        <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="NavigateAccelerator_Invoked" />
        <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="NavigateAccelerator_Invoked" />
        <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="NavigateAccelerator_Invoked" />
        <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="NavigateAccelerator_Invoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            IsSettingsVisible="True"
            ItemInvoked="NavView_ItemInvoked"
            Loaded="NavView_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavItemDashboard" Content="Dashboard" Tag="Dashboard" ToolTipService.ToolTip="Dashboard (Ctrl+1)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemVocabulary" Content="Vocabulary" Tag="Vocabulary" ToolTipService.ToolTip="Vocabulary (Ctrl+2)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE82D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemReview" Content="Spaced Review" Tag="Review" ToolTipService.ToolTip="Spaced Review (Ctrl+3)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemTest" Content="Practice &amp; Test" Tag="Test" ToolTipService.ToolTip="Practice &amp; Test (Ctrl+4)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemGrammar" Content="Grammar" Tag="Grammar" ToolTipService.ToolTip="Grammar (Ctrl+5)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="GlobalSearchBox" PlaceholderText="Search Lexora..." ToolTipService.ToolTip="Search Lexora (Ctrl+F)" QuerySubmitted="GlobalSearchBox_QuerySubmitted" />
            </NavigationView.AutoSuggestBox>

            <Grid RowDefinitions="Auto,*">
                <!-- Due Review Reminder InfoBar (Top, above content) -->
                <InfoBar x:Name="DueReviewInfoBar"
                         Grid.Row="0"
                         IsOpen="{x:Bind ViewModel.IsReminderVisible, Mode=OneWay}"
                         Severity="Informational"
                         Title="Review Reminder"
                         Message="{x:Bind ViewModel.DueReviewMessage, Mode=OneWay}"
                         Margin="16,8,16,0"
                         CornerRadius="8">
                    <InfoBar.ActionButton>
                        <Button Content="Review Now" Style="{ThemeResource AccentButtonStyle}" Click="ReviewNowButton_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Page Content Frame -->
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Page>
