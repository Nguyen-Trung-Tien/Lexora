<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:views="using:Lexora.Presentation.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Auto"
            AlwaysShowHeader="False"
            PaneDisplayMode="Auto"
            OpenPaneLength="260"
            CompactPaneLength="48"
            IsSettingsVisible="False"
            KeyboardAcceleratorPlacementMode="Hidden"
            ItemInvoked="NavView_ItemInvoked"
            Loaded="NavView_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavItemDashboard" Content="Dashboard" Tag="Dashboard" ToolTipService.ToolTip="Dashboard (Ctrl+1)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemVocabulary" Content="Vocabulary" Tag="Vocabulary" ToolTipService.ToolTip="Vocabulary (Ctrl+2)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE82D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemReview" Content="Spaced Review" Tag="Review" ToolTipService.ToolTip="Spaced Review (Ctrl+3)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="ReviewInfoBadge"
                                   Value="{x:Bind ViewModel.DueCardsCount, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasDueReviews, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemTest" Content="Practice &amp; Test" Tag="Test" ToolTipService.ToolTip="Practice &amp; Test (Ctrl+4)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemGrammar" Content="Grammar" Tag="Grammar" ToolTipService.ToolTip="Grammar (Ctrl+5)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavItemSettings" Content="Settings" Tag="Settings" ToolTipService.ToolTip="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="GlobalSearchBox"
                                PlaceholderText="Search Lexora... (Ctrl+K)"
                                ToolTipService.ToolTip="Smart Search (Ctrl+K, Ctrl+F)"
                                QueryIcon="Find"
                                TextChanged="GlobalSearchBox_TextChanged"
                                SuggestionChosen="GlobalSearchBox_SuggestionChosen"
                                QuerySubmitted="GlobalSearchBox_QuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="4,4">
                                <Border Width="26" Height="26" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>

            <!-- Page Content Frame (Rock-solid baseline, zero vertical layout shift) -->
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Modern Floating Toast Notification Overlay (Top-Right, Non-blocking, Zero Layout Shift) -->
        <views:ToastOverlayControl x:Name="ToastOverlay"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Margin="0,52,24,0"
                                   Canvas.ZIndex="1000" />
    </Grid>
</Page>
