<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:views="using:Lexora.Presentation.Views"
    xmlns:services="using:Lexora.Presentation.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Auto"
            AlwaysShowHeader="False"
            PaneDisplayMode="Auto"
            OpenPaneLength="260"
            CompactPaneLength="48"
            IsSettingsVisible="False"
            KeyboardAcceleratorPlacementMode="Hidden"
            ItemInvoked="NavView_ItemInvoked"
            Loaded="NavView_Loaded">
            <NavigationView.MenuItems>
                <!-- 1. Overview Group -->
                <NavigationViewItemHeader x:Name="NavHeaderOverview" Content="TỔNG QUAN" />
                <NavigationViewItem x:Name="NavItemDashboard" Content="Dashboard" Tag="Dashboard" ToolTipService.ToolTip="Dashboard (Ctrl+1)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 2. Knowledge & Vocabulary Group -->
                <NavigationViewItemHeader x:Name="NavHeaderLearning" Content="HỌC TẬP &amp; KHO TỪ" />
                <NavigationViewItem x:Name="NavItemVocabulary" Content="Vocabulary" Tag="Vocabulary" ToolTipService.ToolTip="Vocabulary (Ctrl+2)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE82D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemHomophones" Content="Homophones" Tag="Homophones" ToolTipService.ToolTip="Homophones (Ctrl+3)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemKnowledgeGraph" Content="Knowledge Graph" Tag="KnowledgeGraph" ToolTipService.ToolTip="Knowledge Graph (Ctrl+4)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemGrammar" Content="Grammar" Tag="Grammar" ToolTipService.ToolTip="Grammar (Ctrl+5)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 3. Practice & Assessment Group -->
                <NavigationViewItemHeader x:Name="NavHeaderPractice" Content="LUYỆN TẬP &amp; ĐÁNH GIÁ" />
                <NavigationViewItem x:Name="NavItemReview" Content="Spaced Review" Tag="Review" ToolTipService.ToolTip="Spaced Review (Ctrl+6)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="ReviewInfoBadge"
                                   Value="{x:Bind ViewModel.DueCardsCount, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasDueReviews, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemTest" Content="Practice &amp; Test" Tag="Test" ToolTipService.ToolTip="Practice &amp; Test (Ctrl+7)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 4. Storage & Archive Group -->
                <NavigationViewItemHeader x:Name="NavHeaderArchive" Content="KHO LƯU TRỮ &amp; DỮ LIỆU" />
                <NavigationViewItem x:Name="NavItemLearningStorage" Content="Learning Storage" Tag="LearningStorage" ToolTipService.ToolTip="Learning Storage (Ctrl+8)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavItemThemeToggle" Content="Theme" Tag="ThemeToggle" SelectsOnInvoked="False" ToolTipService.ToolTip="Toggle Theme (Ctrl+T)">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="ThemeToggleIcon" Glyph="&#xE708;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemSettings" Content="Settings" Tag="Settings" ToolTipService.ToolTip="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="SettingsInfoBadge"
                                   Style="{ThemeResource AttentionDotInfoBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="GlobalSearchBox"
                                PlaceholderText="{x:Bind services:LocalizationHelper.GetString('Search_Placeholder')}"
                                ToolTipService.ToolTip="{x:Bind services:LocalizationHelper.GetString('Shell_SearchTooltip')}"
                                QueryIcon="Find"
                                TextChanged="GlobalSearchBox_TextChanged"
                                SuggestionChosen="GlobalSearchBox_SuggestionChosen"
                                QuerySubmitted="GlobalSearchBox_QuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="4,4">
                                <Border Width="26" Height="26" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>

            <!-- Page Content Frame (Rock-solid baseline, zero vertical layout shift) -->
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Modern Floating Toast Notification Overlay (Bottom-Right, Non-blocking, Zero Layout Shift) -->
        <views:ToastOverlayControl x:Name="ToastOverlay"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,24,24"
                                   IsHitTestVisible="False"
                                   Canvas.ZIndex="1000" />
    </Grid>
</Page>
