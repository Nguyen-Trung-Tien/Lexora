<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.DownloadCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Lexora.Presentation.ViewModels"
    xmlns:dtos="using:Lexora.Application.DTOs"
    mc:Ignorable="d"
    Background="{ThemeResource LayerFillColorDefaultBrush}">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="32,24,32,40" MaxWidth="1360" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- InfoBars / Offline / Error -->
                <RowDefinition Height="Auto" /> <!-- Navigation Segmented Tabs -->
                <RowDefinition Height="Auto" /> <!-- Search & Filter Bar -->
                <RowDefinition Height="*" />    <!-- Main Content Area -->
            </Grid.RowDefinitions>

            <!-- 1. Header Area -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock
                            Text="{x:Bind Loc.GetString('DownloadCenter_Title')}"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind Loc.GetString('DownloadCenter_Subtitle')}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        FontSize="13"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Header Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        Click="RefreshButton_Click"
                        ToolTipService.ToolTip="{x:Bind Loc.GetString('DownloadCenter_RefreshCatalog')}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.GetString('Action_Refresh')}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Status / Offline InfoBar -->
            <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,16">
                <!-- Offline Notice -->
                <InfoBar
                    IsOpen="{x:Bind ViewModel.IsOfflineMode}"
                    Severity="Informational"
                    IsClosable="False"
                    Title="{x:Bind Loc.GetString('DownloadCenter_OfflineNotice')}" />

                <!-- Error Notice -->
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasError}"
                    Severity="Error"
                    Title="{x:Bind Loc.GetString('DownloadCenter_ErrorTitle')}"
                    Message="{x:Bind ViewModel.ErrorMessage}">
                    <InfoBar.ActionButton>
                        <Button Content="{x:Bind Loc.GetString('DownloadCenter_Retry')}" Click="RefreshButton_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <!-- 3. Navigation Tabs (Vocabulary, Grammar, My Downloads, Import & Share) -->
            <Border Grid.Row="2" Margin="0,0,0,20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                <Grid ColumnDefinitions="*,*,*,*">
                    <ToggleButton
                        x:Name="TabVocabBtn"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        IsChecked="{x:Bind ViewModel.IsVocabTab}"
                        Click="TabVocab_Click"
                        Margin="2">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE82D;" FontSize="15" />
                            <TextBlock Text="{x:Bind Loc.GetString('DownloadCenter_TabVocabulary')}" FontWeight="SemiBold" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton
                        x:Name="TabGrammarBtn"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        IsChecked="{x:Bind ViewModel.IsGrammarTab}"
                        Click="TabGrammar_Click"
                        Margin="2">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8D2;" FontSize="15" />
                            <TextBlock Text="{x:Bind Loc.GetString('DownloadCenter_TabGrammar')}" FontWeight="SemiBold" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton
                        x:Name="TabDownloadsBtn"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        IsChecked="{x:Bind ViewModel.IsMyDownloadsTab}"
                        Click="TabDownloads_Click"
                        Margin="2">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE896;" FontSize="15" />
                            <TextBlock Text="{x:Bind Loc.GetString('DownloadCenter_TabMyDownloads')}" FontWeight="SemiBold" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton
                        x:Name="TabShareBtn"
                        Grid.Column="3"
                        HorizontalAlignment="Stretch"
                        IsChecked="{x:Bind ViewModel.IsImportShareTab}"
                        Click="TabShare_Click"
                        Margin="2">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE72D;" FontSize="15" />
                            <TextBlock Text="{x:Bind Loc.GetString('DownloadCenter_TabImportShare')}" FontWeight="SemiBold" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>
            </Border>

            <!-- 4. Search & Filter Bar (Only visible for Vocab & Grammar tabs) -->
            <Grid Grid.Row="3" Margin="0,0,0,24" Visibility="{x:Bind ViewModel.IsImportShareTab, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox
                    Grid.Column="0"
                    PlaceholderText="{x:Bind Loc.GetString('DownloadCenter_SearchPlaceholder')}"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="SearchBox_TextChanged"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,12,0" />

                <!-- Level Filter -->
                <ComboBox
                    Grid.Column="1"
                    Header="{x:Bind Loc.GetString('DownloadCenter_FilterLevel')}"
                    SelectedItem="{x:Bind ViewModel.SelectedLevelFilter, Mode=TwoWay}"
                    SelectionChanged="Filter_SelectionChanged"
                    Width="140"
                    Margin="0,0,12,0">
                    <x:String>All</x:String>
                    <x:String>A1</x:String>
                    <x:String>A2</x:String>
                    <x:String>B1</x:String>
                    <x:String>B2</x:String>
                    <x:String>C1</x:String>
                    <x:String>C2</x:String>
                </ComboBox>

                <!-- Exam Target Filter -->
                <ComboBox
                    Grid.Column="2"
                    Header="{x:Bind Loc.GetString('DownloadCenter_FilterExam')}"
                    SelectedItem="{x:Bind ViewModel.SelectedExamFilter, Mode=TwoWay}"
                    SelectionChanged="Filter_SelectionChanged"
                    Width="140">
                    <x:String>All</x:String>
                    <x:String>TOEIC</x:String>
                    <x:String>IELTS</x:String>
                    <x:String>VSTEP</x:String>
                    <x:String>General</x:String>
                </ComboBox>
            </Grid>

            <!-- 5. Main Content Area -->
            <Grid Grid.Row="4">
                <!-- Loading State -->
                <StackPanel
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Margin="0,60,0,60">
                    <ProgressRing IsActive="True" Width="48" Height="48" />
                    <TextBlock
                        Text="{x:Bind Loc.GetString('DownloadCenter_LoadingPackages')}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        FontSize="14" />
                </StackPanel>

                <!-- Empty State (When no packages found) -->
                <Border
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="40"
                    Margin="0,20,0,40"
                    HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="{x:Bind Loc.GetString('DownloadCenter_EmptyTitle')}"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="{x:Bind Loc.GetString('DownloadCenter_EmptySubtitle')}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            MaxWidth="400"
                            TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Packages Grid View (Vocabulary & Grammar Tabs) -->
                <ItemsControl
                    x:Name="PackagesItemsControl"
                    ItemsSource="{x:Bind ViewModel.Packages}"
                    Visibility="{x:Bind ViewModel.IsImportShareTab, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:CommunityPackageItemViewModel">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /> <!-- Badges & Meta -->
                                        <RowDefinition Height="Auto" /> <!-- Title -->
                                        <RowDefinition Height="Auto" /> <!-- Description -->
                                        <RowDefinition Height="Auto" /> <!-- Tags -->
                                        <RowDefinition Height="Auto" /> <!-- Actions & Progress -->
                                    </Grid.RowDefinitions>

                                    <!-- Top Badges -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <!-- Level Badge -->
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{x:Bind Level}" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>
                                            <!-- Exam Badge -->
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{x:Bind TargetExam}" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <!-- Version Badge -->
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{x:Bind Version}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Items count & Size -->
                                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12">
                                                <Run Text="{x:Bind ItemCount}" FontWeight="SemiBold" />
                                                <Run Text="items" />
                                            </TextBlock>
                                            <TextBlock Text="{x:Bind FormattedSize}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Package Name -->
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{x:Bind Name}"
                                        Style="{ThemeResource SubtitleTextBlockStyle}"
                                        Margin="0,0,0,6"
                                        TextTrimming="CharacterEllipsis" />

                                    <!-- Description -->
                                    <TextBlock
                                        Grid.Row="2"
                                        Text="{x:Bind Description}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="13"
                                        TextWrapping="Wrap"
                                        MaxLines="3"
                                        Margin="0,0,0,12" />

                                    <!-- Tags & Author -->
                                    <Grid Grid.Row="3" Margin="0,0,0,16">
                                        <TextBlock Text="{x:Bind TagsDisplay}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                            <FontIcon Glyph="&#xE77B;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind Author}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Action Bar / Progress Bar -->
                                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                                        <!-- Working / Progress State -->
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center" Visibility="{x:Bind IsWorking, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ProgressBar Value="{x:Bind DownloadProgress}" Maximum="100" />
                                            <TextBlock Text="{x:Bind StatusMessage}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <!-- Details Button -->
                                            <Button Click="PackageDetails_Click" Tag="{x:Bind Dto}" Style="{ThemeResource DefaultButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE946;" FontSize="13" />
                                                    <TextBlock Text="Chi tiết" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Install / Update / Installed Button -->
                                            <Button
                                                Click="DownloadPackage_Click"
                                                Tag="{x:Bind}"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                IsEnabled="{x:Bind IsWorking, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                Visibility="{x:Bind CanInstall, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE896;" FontSize="13" />
                                                    <TextBlock Text="Tải về" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Update Button -->
                                            <Button
                                                Click="DownloadPackage_Click"
                                                Tag="{x:Bind}"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                Visibility="{x:Bind HasUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE777;" FontSize="13" />
                                                    <TextBlock Text="Cập nhật" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Installed Indicator -->
                                            <Border
                                                Visibility="{x:Bind IsInstalled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Padding="12,6"
                                                VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                    <TextBlock Text="Đã cài đặt" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- My Downloads List (Visible only when My Downloads Tab selected) -->
                <StackPanel Visibility="{x:Bind ViewModel.IsMyDownloadsTab, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="12">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.InstalledPackages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dtos:InstalledPackageRecord">
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                        <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                                    <TextBlock Text="{x:Bind Category}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                                    <TextBlock Text="{x:Bind Version}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12">
                                                <Run Text="{x:Bind ItemCount}" FontWeight="SemiBold" />
                                                <Run Text="mục | Cài đặt lúc:" />
                                                <Run Text="{x:Bind InstalledAtFormatted}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="2" Click="RemoveInstalled_Click" Tag="{x:Bind PackageId}" ToolTipService.ToolTip="Xóa bản ghi theo dõi">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 4. Import & Share Tab Content -->
                <StackPanel
                    Visibility="{x:Bind ViewModel.IsImportShareTab, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Spacing="24">

                    <!-- Import from File or URL Section -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                        <!-- Import From File Card -->
                        <Border
                            Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="24">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Loc.GetString('DownloadCenter_ImportFileTitle')}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{x:Bind Loc.GetString('DownloadCenter_ImportFileDesc')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <ComboBox
                                    Header="{x:Bind Loc.GetString('DownloadCenter_ConflictResolution')}"
                                    SelectedIndex="{x:Bind ViewModel.SelectedConflictResolutionIndex, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="{x:Bind Loc.GetString('DownloadCenter_ConflictSkip')}" />
                                    <ComboBoxItem Content="{x:Bind Loc.GetString('DownloadCenter_ConflictOverwrite')}" />
                                </ComboBox>

                                <Button
                                    Click="PickImportFile_Click"
                                    HorizontalAlignment="Stretch"
                                    Style="{ThemeResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Loc.GetString('DownloadCenter_BrowseFiles')}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Import From URL Card -->
                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="24">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE71B;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Loc.GetString('DownloadCenter_ImportUrlTitle')}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{x:Bind Loc.GetString('DownloadCenter_ImportUrlDesc')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBox
                                    PlaceholderText="{x:Bind Loc.GetString('DownloadCenter_EnterUrlPlaceholder')}"
                                    Text="{x:Bind ViewModel.DirectUrl, Mode=TwoWay}" />

                                <ProgressBar
                                    Visibility="{x:Bind ViewModel.IsImportingUrl, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Value="{x:Bind ViewModel.ImportUrlProgress}"
                                    Maximum="100" />

                                <Button
                                    Click="ImportUrl_Click"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.IsImportingUrl, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                    Style="{ThemeResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Loc.GetString('DownloadCenter_DownloadAndImport')}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Export Package Card -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEDE1;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Loc.GetString('DownloadCenter_ExportTitle')}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{x:Bind Loc.GetString('DownloadCenter_ExportDesc')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                <!-- Package Name -->
                                <TextBox
                                    Grid.Row="0" Grid.Column="0"
                                    Header="{x:Bind Loc.GetString('DownloadCenter_PackageName')}"
                                    Text="{x:Bind ViewModel.ExportName, Mode=TwoWay}" />

                                <!-- Author -->
                                <TextBox
                                    Grid.Row="0" Grid.Column="1"
                                    Header="{x:Bind Loc.GetString('DownloadCenter_PackageAuthor')}"
                                    Text="{x:Bind ViewModel.ExportAuthor, Mode=TwoWay}" />

                                <!-- Category (Vocabulary or Grammar) -->
                                <ComboBox
                                    Grid.Row="1" Grid.Column="0"
                                    Header="{x:Bind Loc.GetString('DownloadCenter_PackageCategory')}"
                                    SelectedItem="{x:Bind ViewModel.ExportCategory, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch">
                                    <x:String>Vocabulary</x:String>
                                    <x:String>Grammar</x:String>
                                </ComboBox>

                                <!-- Level -->
                                <ComboBox
                                    Grid.Row="1" Grid.Column="1"
                                    Header="{x:Bind Loc.GetString('DownloadCenter_FilterLevel')}"
                                    SelectedItem="{x:Bind ViewModel.ExportLevel, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch">
                                    <x:String>A1</x:String>
                                    <x:String>A2</x:String>
                                    <x:String>B1</x:String>
                                    <x:String>B2</x:String>
                                    <x:String>C1</x:String>
                                    <x:String>C2</x:String>
                                    <x:String>All</x:String>
                                </ComboBox>

                                <!-- Description -->
                                <TextBox
                                    Grid.Row="2" Grid.Column="0"
                                    Header="{x:Bind Loc.GetString('DownloadCenter_PackageDescription')}"
                                    Text="{x:Bind ViewModel.ExportDescription, Mode=TwoWay}" />

                                <!-- Tags -->
                                <TextBox
                                    Grid.Row="2" Grid.Column="1"
                                    Header="{x:Bind Loc.GetString('DownloadCenter_PackageTags')}"
                                    Text="{x:Bind ViewModel.ExportTags, Mode=TwoWay}" />
                            </Grid>

                            <Button
                                Click="ExportPackage_Click"
                                HorizontalAlignment="Right"
                                Style="{ThemeResource AccentButtonStyle}"
                                Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                                    <TextBlock Text="{x:Bind Loc.GetString('DownloadCenter_ExportButton')}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
