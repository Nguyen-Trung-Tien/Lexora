<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Lexora.Presentation.Views.LearningStoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dto="using:Lexora.Application.DTOs"
    xmlns:enums="using:Lexora.Domain.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    KeyboardAcceleratorPlacementMode="Hidden"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        
        <!-- Loading overlay -->
        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                      Width="44" Height="44"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Canvas.ZIndex="20" />

        <!-- Main Content Area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="28,20">
            <StackPanel Spacing="18" MaxWidth="1200" HorizontalAlignment="Stretch">

                <!-- 1. Top Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Loc.GetString('Storage_Title')}"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind Loc.GetString('Storage_Subtitle')}"
                                   FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Top Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Style="{ThemeResource AccentButtonStyle}"
                                CornerRadius="8" Padding="14,8"
                                Click="PracticeBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="{x:Bind Loc.GetString('Storage_BtnPractice')}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button CornerRadius="8" Padding="14,8"
                                Click="TestBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE765;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Loc.GetString('Storage_BtnTest')}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button CornerRadius="8" Padding="12,8"
                                Click="RefreshBtn_Click">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Overview Metrics Cards -->
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
                    
                    <!-- Weak (Needs Focus) Card -->
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{x:Bind Loc.GetString('Storage_StatWeak')}"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <FontIcon Grid.Column="1" Glyph="&#xE7BA;" FontSize="14"
                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.WeakCount, Mode=OneWay}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- In Progress (Learning) Card -->
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{x:Bind Loc.GetString('Storage_StatLearning')}"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <FontIcon Grid.Column="1" Glyph="&#xE82D;" FontSize="14"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.LearningCount, Mode=OneWay}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Mastered Card -->
                    <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{x:Bind Loc.GetString('Storage_StatMastered')}"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="14"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.MasteredCount, Mode=OneWay}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Due for Review Card -->
                    <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{x:Bind Loc.GetString('Storage_StatDueToday')}"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <FontIcon Grid.Column="1" Glyph="&#xE823;" FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.DueTodayCount, Mode=OneWay}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Average Retention Card -->
                    <Border Grid.Column="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{x:Bind Loc.GetString('Storage_StatAvgRetention')}"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <FontIcon Grid.Column="1" Glyph="&#xE9D9;" FontSize="14"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.AverageRetention, Mode=OneWay, Converter={StaticResource RetentionToBrushConverter}}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                                <Run Text="{x:Bind ViewModel.AverageRetention, Mode=OneWay}" /><Run Text="%" FontSize="16" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. Section Tabs (Vocabulary / Grammar) -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <!-- Vocabulary Tab Button -->
                        <ToggleButton x:Name="TabVocabBtn"
                                      IsChecked="{x:Bind ViewModel.IsVocabTabSelected, Mode=OneWay}"
                                      Click="TabVocab_Click"
                                      CornerRadius="8" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE82D;" FontSize="14" />
                                <TextBlock Text="{x:Bind Loc.GetString('Vocab_NavTab')}" FontWeight="SemiBold" />
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10" Padding="8,1">
                                    <TextBlock Text="{x:Bind ViewModel.VocabCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </ToggleButton>

                        <!-- Grammar Tab Button -->
                        <ToggleButton x:Name="TabGrammarBtn"
                                      IsChecked="{x:Bind ViewModel.IsGrammarTabSelected, Mode=OneWay}"
                                      Click="TabGrammar_Click"
                                      CornerRadius="8" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8D2;" FontSize="14" />
                                <TextBlock Text="{x:Bind Loc.GetString('Grammar_NavTab')}" FontWeight="SemiBold" />
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10" Padding="8,1">
                                    <TextBlock Text="{x:Bind ViewModel.GrammarCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <!-- Add items button -->
                    <Button Grid.Column="2" CornerRadius="8" Padding="14,8"
                            Click="OpenAddDialog_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="{x:Bind Loc.GetString('Storage_BtnAddToStorage')}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 4. Filter and Search Bar -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        
                        <!-- Search Box -->
                        <TextBox x:Name="StorageSearchBox"
                                 PlaceholderText="{x:Bind Loc.GetString('Storage_Search_Placeholder')}"
                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                                 TextChanged="SearchBox_TextChanged"
                                 CornerRadius="8" Padding="12,7" />

                        <!-- Status Filter Options -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <ComboBox x:Name="StatusFilterComboBox"
                                      SelectedIndex="0" CornerRadius="8" MinWidth="150"
                                      SelectionChanged="FilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="{x:Bind Loc.GetString('Storage_FilterAll')}" Tag="All" />
                                <ComboBoxItem Content="{x:Bind Loc.GetString('Storage_FilterWeak')}" Tag="Weak" />
                                <ComboBoxItem Content="{x:Bind Loc.GetString('Storage_FilterLearning')}" Tag="Learning" />
                                <ComboBoxItem Content="{x:Bind Loc.GetString('Storage_FilterNew')}" Tag="New" />
                                <ComboBoxItem Content="{x:Bind Loc.GetString('Storage_FilterMastered')}" Tag="Mastered" />
                                <ComboBoxItem Content="{x:Bind Loc.GetString('Storage_FilterDueToday')}" Tag="DueToday" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 5. Empty State -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="40"
                        Visibility="{x:Bind ViewModel.IsEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE81C;" FontSize="28"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{x:Bind Loc.GetString('Storage_Empty_Title')}"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind Loc.GetString('Storage_Empty_Subtitle')}"
                                   FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   MaxWidth="520" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <Button Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Center" CornerRadius="8" Padding="16,8"
                                Click="OpenAddDialog_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="{x:Bind Loc.GetString('Storage_BtnAddToStorage')}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 6. Virtualized Storage Items List -->
                <ListView ItemsSource="{x:Bind ViewModel.StorageItems, Mode=OneWay}"
                          SelectionMode="None"
                          Visibility="{x:Bind ViewModel.IsEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,0,0,10" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dto:LearningStorageItemDto">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="18,14">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">

                                    <!-- Top Row: Badges and Title -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- Status Badge -->
                                        <Border CornerRadius="6" Padding="8,3"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{x:Bind Status}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{x:Bind Status, Converter={StaticResource StatusToBrushConverter}}" />
                                        </Border>

                                        <!-- Reason Added Badge -->
                                        <Border CornerRadius="6" Padding="8,3"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{x:Bind ReasonAdded}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>

                                        <!-- Word / Grammar Rule Title -->
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                        <!-- Subtitle (Phonetic / Structure formula) -->
                                        <TextBlock Text="{x:Bind Subtitle}"
                                                   FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Right Top Actions -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <!-- Audio button if word -->
                                        <Button Width="32" Height="32" Padding="0" CornerRadius="16"
                                                Tag="{x:Bind}"
                                                Click="CardAudioBtn_Click">
                                            <FontIcon Glyph="&#xE767;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Button>

                                        <!-- Mark as Mastered button -->
                                        <Button Tag="{x:Bind}" CornerRadius="6" Padding="10,5"
                                                Click="CardMasteredBtn_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                <TextBlock Text="Mastered" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <!-- More Options Menu -->
                                        <Button Width="32" Height="32" Padding="0" CornerRadius="16">
                                            <FontIcon Glyph="&#xE712;" FontSize="13" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Mark as Weak" Tag="{x:Bind}" Click="MenuMarkWeak_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Mark as Learning" Tag="{x:Bind}" Click="MenuMarkLearning_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE82D;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Edit Note" Tag="{x:Bind}" Click="MenuEditNote_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE70F;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Remove from Storage" Tag="{x:Bind}" Click="MenuRemove_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>

                                    <!-- Row 2: Definition or Explanation -->
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                               Text="{x:Bind DefinitionOrExplanation}"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />

                                    <!-- Row 3: Metrics & Note -->
                                    <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                            <!-- Retention -->
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="Retention:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind FormattedRetention}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>

                                            <!-- Interval -->
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="Interval:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind FormattedInterval}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Mistakes / Correct count -->
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="Mistakes:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind IncorrectCount}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                <TextBlock Text="• Correct:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind CorrectCount}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            </StackPanel>

                                            <!-- Note if exists -->
                                            <TextBlock Text="{x:Bind Note}" FontSize="11" FontStyle="Italic"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                        </StackPanel>
                                    </Grid>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 7. Pagination Bar -->
                <Grid ColumnDefinitions="*,Auto,*"
                      Visibility="{x:Bind ViewModel.IsEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                    <Button HorizontalAlignment="Left" CornerRadius="8" Padding="14,6"
                            IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                            Click="PrevPage_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE76B;" FontSize="11" />
                            <TextBlock Text="Previous" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PageDisplayInfo, Mode=OneWay}"
                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="2" HorizontalAlignment="Right" CornerRadius="8" Padding="14,6"
                            IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                            Click="NextPage_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Next" FontWeight="SemiBold" />
                            <FontIcon Glyph="&#xE76C;" FontSize="11" />
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- 8. Interactive Practice Modal Overlay -->
        <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{x:Bind ViewModel.IsPracticeActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              Canvas.ZIndex="30" Padding="30">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="16" MaxWidth="720" MaxHeight="640"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="32,28">
                
                <!-- Practice Content -->
                <StackPanel Spacing="20">
                    
                    <!-- Practice Header -->
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Loc.GetString('Storage_Practice_Title')}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind Loc.GetString('Storage_Practice_Subtitle')}"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="12" Padding="12,4" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{x:Bind ViewModel.PracticeProgressText, Mode=OneWay}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>

                        <Button Grid.Column="2" Width="32" Height="32" Padding="0" CornerRadius="16"
                                Click="ClosePractice_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- Practice In-Progress View -->
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsPracticeCompleted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                        
                        <!-- Question Card -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="12" Padding="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.CurrentQuestion.Prompt, Mode=OneWay}"
                                           FontSize="16" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentQuestion.SubPrompt, Mode=OneWay}"
                                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Answer Options List -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentQuestion.Options, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                            Padding="16,12" CornerRadius="8"
                                            Tag="{x:Bind}"
                                            Click="PracticeOption_Click">
                                        <TextBlock Text="{x:Bind}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Selected answer & Feedback info -->
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsPracticeAnswerSubmitted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8" Padding="14,10">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                  Visibility="{x:Bind ViewModel.IsCurrentAnswerCorrect, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                  Visibility="{x:Bind ViewModel.IsCurrentAnswerCorrect, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                                        <TextBlock Text="{x:Bind ViewModel.CurrentQuestion.Explanation, Mode=OneWay}"
                                                   FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Bottom Controls in Practice -->
                        <Grid Margin="0,8,0,0">
                            <Button Style="{ThemeResource AccentButtonStyle}"
                                    HorizontalAlignment="Right" CornerRadius="8" Padding="20,10"
                                    Visibility="{x:Bind ViewModel.IsPracticeAnswerSubmitted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                                    Click="SubmitPractice_Click">
                                <TextBlock Text="{x:Bind Loc.GetString('Storage_Practice_Submit')}" FontWeight="SemiBold" />
                            </Button>

                            <Button Style="{ThemeResource AccentButtonStyle}"
                                    HorizontalAlignment="Right" CornerRadius="8" Padding="20,10"
                                    Visibility="{x:Bind ViewModel.IsPracticeAnswerSubmitted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Click="NextPractice_Click">
                                <TextBlock Text="{x:Bind Loc.GetString('Storage_Practice_Next')}" FontWeight="SemiBold" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Practice Completed Summary Screen -->
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsPracticeCompleted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="28">
                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="28"
                                        Background="{ThemeResource SystemFillColorSuccessBrush}"
                                        HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="24" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{x:Bind Loc.GetString('Storage_Practice_ResultTitle')}"
                                           FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.PracticeResultSummaryText, Mode=OneWay}"
                                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Button Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Center" CornerRadius="8" Padding="24,10"
                                Click="ClosePractice_Click">
                            <TextBlock Text="{x:Bind Loc.GetString('Storage_Practice_Finish')}" FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>
