<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Lexora.Presentation.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Lexora.Presentation.Converters"
    xmlns:local="using:Lexora.Presentation">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HeatmapLevel0Brush" Color="#E1DFDD" />
                    <SolidColorBrush x:Key="HeatmapLevel1Brush" Color="#9BE9A8" />
                    <SolidColorBrush x:Key="HeatmapLevel2Brush" Color="#40C463" />
                    <SolidColorBrush x:Key="HeatmapLevel3Brush" Color="#30A14E" />
                    <SolidColorBrush x:Key="HeatmapLevel4Brush" Color="#216E39" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HeatmapLevel0Brush" Color="#2D333B" />
                    <SolidColorBrush x:Key="HeatmapLevel1Brush" Color="#0E4429" />
                    <SolidColorBrush x:Key="HeatmapLevel2Brush" Color="#006D32" />
                    <SolidColorBrush x:Key="HeatmapLevel3Brush" Color="#26A641" />
                    <SolidColorBrush x:Key="HeatmapLevel4Brush" Color="#39D353" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="HeatmapLevel0Brush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="HeatmapLevel1Brush" Color="{ThemeResource SystemColorHighlightColor}" Opacity="0.3" />
                    <SolidColorBrush x:Key="HeatmapLevel2Brush" Color="{ThemeResource SystemColorHighlightColor}" Opacity="0.5" />
                    <SolidColorBrush x:Key="HeatmapLevel3Brush" Color="{ThemeResource SystemColorHighlightColor}" Opacity="0.8" />
                    <SolidColorBrush x:Key="HeatmapLevel4Brush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Converters -->
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
            <converters:IntZeroToVisibilityConverter x:Key="IntZeroToVisibilityConverter" />
            <converters:HeatmapLevelToBrushConverter x:Key="HeatmapLevelToBrushConverter" />
            <converters:HeatmapLevelToForegroundConverter x:Key="HeatmapLevelToForegroundConverter" />
            <converters:ScoreTierToBrushConverter x:Key="ScoreTierToBrushConverter" />
            <converters:CorrectnessToBrushConverter x:Key="CorrectnessToBrushConverter" />
            <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
            <converters:RetentionToBrushConverter x:Key="RetentionToBrushConverter" />
            <converters:CefrToBrushConverter x:Key="CefrToBrushConverter" />
            <converters:ReviewRatingToBrushConverter x:Key="ReviewRatingToBrushConverter" />
            <converters:ReviewRatingToForegroundConverter x:Key="ReviewRatingToForegroundConverter" />

            <!-- Fallback Button Style -->
            <Style x:Key="DefaultButtonStyle" TargetType="Button" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
